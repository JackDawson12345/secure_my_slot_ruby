<main class="min-h-screen bg-slate-50 px-4 py-12 sm:px-6 lg:px-8">
  <section class="mx-auto max-w-xl">

    <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">

      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-rose-50 text-rose-600">
        <i data-lucide="server-crash" class="h-10 w-10"></i>
      </div>

      <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-900">
        Something went wrong
      </h1>

      <p class="mt-3 text-sm leading-6 text-slate-500">
        We have encountered an unexpected error while processing your request.
        Our team has been notified and we are looking into it.
      </p>


      <div class="mt-8 rounded-xl bg-slate-50 p-5 text-left">

        <div class="flex items-start gap-3">
          <div class="rounded-lg bg-indigo-50 p-2 text-indigo-600">
            <i data-lucide="info" class="h-5 w-5"></i>
          </div>

          <div>
            <h2 class="font-semibold text-slate-900">
              What can you do?
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Try refreshing the page or return to the homepage.
              If the problem continues, please contact support.
            </p>
          </div>
        </div>

      </div>


      <%= link_to root_path,
                  class: "mt-8 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700" do %>

        Return home

        <i data-lucide="arrow-right" class="h-4 w-4"></i>

      <% end %>

    </div>

  </section>
</main>