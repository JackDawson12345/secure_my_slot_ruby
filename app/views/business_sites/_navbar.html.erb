<header class="sticky top-0 z-50 border-b <%= website_colour_class("border", 200, 80) %> bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">

    <% if @business.business_setting.logo.attached? %>
      <%= image_tag @business.business_setting.logo,
                    alt: "#{@business.business_name} logo",
                    class: "h-16 rounded-xl object-contain" %>
    <% else %>
      <a href="/#top" class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl <%= website_colour_class("bg", 500) %> text-white shadow-lg <%= website_colour_class("shadow", 500, 20) %>">
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 20h16M6 20V9l6-5 6 5v11M9 20v-6h6v6"
              />
          </svg>
        </div>

        <div>
            <span class="block text-base font-bold leading-tight <%= website_colour_class("text", 950) %>">
              <%= @business.business_name %>
            </span>

          <span class="block text-xs font-medium <%= website_colour_class("text", 500) %>">
              Online booking
            </span>
        </div>
      </a>
    <% end %>

    <nav class="hidden items-center gap-8 md:flex">
      <a
        href="/#services"
        class="text-sm font-semibold <%= website_colour_class("text", 500) %> transition hover:<%= website_colour_class("text", 600) %>"
      >
        Services
      </a>

      <a
        href="/#about"
        class="text-sm font-semibold <%= website_colour_class("text", 500) %> transition hover:<%= website_colour_class("text", 600) %>"
      >
        About
      </a>

      <a
        href="/#location"
        class="text-sm font-semibold <%= website_colour_class("text", 500) %> transition hover:<%= website_colour_class("text", 600) %>"
      >
        Location
      </a>

      <% if @business.products.exists? %>
        <a
          href="/shop"
          class="text-sm font-semibold <%= website_colour_class("text", 500) %> transition hover:<%= website_colour_class("text", 600) %>"
        >
          Shop
        </a>
      <% end %>

      <a
        href="#booking"
        class="rounded-xl <%= website_colour_class("bg", 500) %> px-5 py-3 text-sm font-bold text-white shadow-lg <%= website_colour_class("shadow", 500, 20) %> transition hover:<%= website_colour_class("bg", 600) %>"
      >
        Book now
      </a>
    </nav>

    <a
      href="#booking"
      class="rounded-xl <%= website_colour_class("bg", 500) %> px-4 py-2.5 text-sm font-bold text-white md:hidden"
    >
      Book
    </a>
  </div>
</header>

<!-- Mobile Booking Bar -->
<div class="fixed inset-x-0 bottom-0 z-50 border-t <%= website_colour_class("border", 200) %> bg-white/95 p-3 shadow-[0_-10px_30px_rgba(15,23,42,0.08)] backdrop-blur md:hidden">
  <a
    href="#booking"
    class="flex w-full items-center justify-center gap-2 rounded-2xl <%= website_colour_class("bg", 500) %> px-5 py-4 font-black text-white"
  >
    Book an appointment

    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m9 18 6-6-6-6"
        />
    </svg>
  </a>
</div>
