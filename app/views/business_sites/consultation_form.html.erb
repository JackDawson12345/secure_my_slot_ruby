<% if @business.business_setting.booking_page_live == true %>

  <%
    structure =
      if @consultation_form&.structure.is_a?(String)
        JSON.parse(@consultation_form.structure) rescue []
      else
        @consultation_form&.structure || []
      end
  %>

  <!-- Header -->
  <header class="sticky top-0 z-50 border-b <%= website_colour_class("border", 200, 80) %> bg-white/90 backdrop-blur">

    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">

      <% if @business.business_setting.logo.attached? %>

        <%= link_to root_path do %>
          <%= image_tag @business.business_setting.logo,
                        alt: "#{@business.business_name} logo",
                        class: "h-16 rounded-xl object-contain" %>
        <% end %>

      <% else %>

        <%= link_to root_path,
                    class: "flex items-center gap-3" do %>

          <div class="flex h-11 w-11 items-center justify-center rounded-2xl <%= website_colour_class("bg", 500) %> text-white shadow-lg <%= website_colour_class("shadow", 500, 20) %>">

            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 20h16M6 20V9l6-5 6 5v11M9 20v-6h6v6"
                />
            </svg>

          </div>

          <div>

            <span class="block text-base font-bold leading-tight <%= website_colour_class("text", 950) %>">
              <%= @business.business_name %>
            </span>

            <span class="block text-xs font-medium <%= website_colour_class("text", 500) %>">
              Online consultation
            </span>

          </div>

        <% end %>

      <% end %>


      <%= link_to root_path,
                  class: "inline-flex items-center gap-2 rounded-xl border #{website_colour_class("border", 200)} bg-white px-4 py-2.5 text-sm font-bold #{website_colour_class("text", 700)} transition hover:#{website_colour_class("bg", 50)}" do %>

        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m15 18-6-6 6-6"
            />
        </svg>

        Back

      <% end %>

    </div>

  </header>


  <main class="min-h-[calc(100vh-150px)] <%= website_colour_class("bg", 50) %> py-10 sm:py-14 lg:py-16">

    <% if @consultation_form.present? && structure.present? %>

      <div class="mx-auto max-w-4xl px-5 lg:px-8">

        <!-- Page heading -->
        <div class="mb-8">

          <div class="mb-4 inline-flex items-center gap-2 rounded-full <%= website_colour_class("bg", 100) %> px-3 py-1.5 text-xs font-bold <%= website_colour_class("text", 700) %>">

            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h6m-6 4h6M9 8h6M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"
                />
            </svg>

            Consultation form

          </div>

          <h1 class="text-3xl font-black tracking-tight <%= website_colour_class("text", 950) %> sm:text-4xl">
            <%= @consultation_form.name %>
          </h1>

          <p class="mt-3 max-w-2xl text-base leading-7 <%= website_colour_class("text", 600) %>">
            Please complete the information below before your appointment.
          </p>

        </div>


        <!-- Booking information -->
        <% if @booking.present? %>

          <div class="mb-6 rounded-2xl border <%= website_colour_class("border", 200) %> bg-white p-5 shadow-sm">

            <div class="flex items-start gap-4">

              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl <%= website_colour_class("bg", 100) %> <%= website_colour_class("text", 600) %>">

                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"
                    />
                </svg>

              </div>

              <div>

                <p class="text-xs font-bold uppercase tracking-wide <%= website_colour_class("text", 500) %>">
                  Appointment
                </p>

                <% if @booking.respond_to?(:service) && @booking.service.present? %>
                  <p class="mt-1 font-bold <%= website_colour_class("text", 950) %>">
                    <%= @booking.service.name %>
                  </p>
                <% end %>

                <% if @booking.respond_to?(:date) && @booking.date.present? %>
                  <p class="mt-1 text-sm <%= website_colour_class("text", 600) %>">
                    <%= @booking.date.strftime("%A %-d %B %Y") %>

                    <% if @booking.respond_to?(:time) && @booking.time.present? %>
                      at <%= @booking.time.strftime("%H:%M") %>
                    <% end %>
                  </p>
                <% end %>

              </div>

            </div>

          </div>

        <% end %>


        <!-- Consultation form -->
        <div class="overflow-hidden rounded-3xl border <%= website_colour_class("border", 200) %> bg-white shadow-xl <%= website_colour_class("shadow", 500, 10) %>">

          <div class="border-b <%= website_colour_class("border", 100) %> px-6 py-5 sm:px-8">

            <h2 class="text-lg font-black <%= website_colour_class("text", 950) %>">
              Your details
            </h2>

            <p class="mt-1 text-sm <%= website_colour_class("text", 500) %>">
              Fields marked as required must be completed before submitting.
            </p>

          </div>


          <%= form_with(
                url: submit_business_site_consultation_form_path(
                  token: @booking.consultation_token
                ),
                method: :post,
                local: true
              ) do %>

            <div class="space-y-6 p-6 sm:p-8">

              <% structure.each do |row| %>

                <% next unless row["type"] == "row" %>

                <% columns = row["children"] || [] %>

                <div
                  class="
                    grid gap-5
                    <%= case columns.length
                        when 2
                          'md:grid-cols-2'
                        when 3
                          'md:grid-cols-3'
                        when 4
                          'md:grid-cols-4'
                        else
                          'grid-cols-1'
                        end
                  %>
                  "
                >

                  <% columns.each do |column| %>

                    <% next unless column["type"] == "column" %>

                    <div class="space-y-3">

                      <% (column["children"] || []).each do |field| %>

                        <% if field["type"] == "label" %>

                          <label class="block text-sm font-bold <%= website_colour_class("text", 900) %>">
                            <%= field["text"] %>
                          </label>


                        <% elsif field["type"] == "text" %>

                          <input
                            type="text"
                            name="consultation[<%= field["name"] %>]"
                            placeholder="<%= field["placeholder"] %>"
                            <%= "required" if field["required"] %>
                            class="w-full rounded-xl border <%= website_colour_class("border", 200) %> bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:<%= website_colour_class("border", 500) %> focus:ring-4 focus:<%= website_colour_class("ring", 500, 10) %>"
                          >


                        <% elsif field["type"] == "number" %>

                          <input
                            type="number"
                            name="consultation[<%= field["name"] %>]"
                            placeholder="<%= field["placeholder"] %>"
                            <%= "required" if field["required"] %>
                            class="w-full rounded-xl border <%= website_colour_class("border", 200) %> bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:<%= website_colour_class("border", 500) %> focus:ring-4 focus:<%= website_colour_class("ring", 500, 10) %>"
                          >


                        <% elsif field["type"] == "textarea" %>

    <textarea
      name="consultation[<%= field["name"] %>]"
      placeholder="<%= field["placeholder"] %>"
      <%= "required" if field["required"] %>
      rows="5"
      class="w-full resize-y rounded-xl border <%= website_colour_class("border", 200) %> bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:<%= website_colour_class("border", 500) %> focus:ring-4 focus:<%= website_colour_class("ring", 500, 10) %>"
    ></textarea>


                        <% elsif field["type"] == "select" %>

                          <select
                            name="consultation[<%= field["name"] %>]"
                            <%= "required" if field["required"] %>
                            class="w-full rounded-xl border <%= website_colour_class("border", 200) %> bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:<%= website_colour_class("border", 500) %> focus:ring-4 focus:<%= website_colour_class("ring", 500, 10) %>"
                          >

                            <option value="">
                              Please select
                            </option>

                            <% (field["options"] || []).each do |option| %>
                              <option value="<%= option %>">
                                <%= option %>
                              </option>
                            <% end %>

                          </select>


                        <% elsif field["type"] == "submit" %>

                          <button
                            type="submit"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl <%= website_colour_class("bg", 500) %> px-6 py-3.5 text-sm font-black text-white shadow-lg <%= website_colour_class("shadow", 500, 20) %> transition hover:<%= website_colour_class("bg", 600) %>"
                          >

                            <%= field["text"].presence || "Submit" %>

                            <svg
                              class="h-4 w-4"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="m9 18 6-6-6-6"
                                />
                            </svg>

                          </button>

                        <% end %>

                      <% end %>

                    </div>

                  <% end %>

                </div>

              <% end %>

            </div>

          <% end %>

        </div>


        <div class="mt-6 flex items-start gap-3 rounded-2xl <%= website_colour_class("bg", 100) %> px-5 py-4">

          <svg
            class="mt-0.5 h-5 w-5 shrink-0 <%= website_colour_class("text", 600) %>"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"
              />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m9 12 2 2 4-4"
              />
          </svg>

          <p class="text-sm leading-6 <%= website_colour_class("text", 700) %>">
            Your consultation information will be securely associated with your appointment.
          </p>

        </div>

      </div>

    <% else %>

      <div class="mx-auto max-w-xl px-5 py-20 text-center">

        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl <%= website_colour_class("bg", 100) %> <%= website_colour_class("text", 600) %>">

          <svg
            class="h-8 w-8"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v4m0 4h.01M10.3 3.7 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"
              />
          </svg>

        </div>

        <h1 class="mt-6 text-3xl font-black <%= website_colour_class("text", 950) %>">
          Consultation form unavailable
        </h1>

        <p class="mt-4 text-base leading-7 <%= website_colour_class("text", 600) %>">
          There is currently no consultation form available for this appointment.
        </p>

        <%= link_to root_path,
                    class: "mt-8 inline-flex items-center justify-center rounded-xl #{website_colour_class("bg", 500)} px-6 py-3 font-bold text-white transition hover:#{website_colour_class("bg", 600)}" do %>
          Return to <%= @business.business_name %>
        <% end %>

      </div>

    <% end %>

  </main>


  <!-- Footer -->
  <footer class="<%= website_colour_class("bg", 950) %> text-white">

    <div class="border-t border-white/10">

      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-8 md:flex-row md:items-center md:justify-between lg:px-8">

        <div>

          <p class="font-bold">
            <%= @business.business_name %>
          </p>

          <p class="mt-1 text-sm <%= website_colour_class("text", 500) %>">
            © <%= Time.current.year %>
            <%= @business.business_name %>.
            All rights reserved.
          </p>

        </div>


        <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold <%= website_colour_class("text", 400) %>">

          <a
            href="https://www.securemyslot.co.uk/privacy-policy"
            class="transition hover:text-white"
          >
            Privacy Policy
          </a>

          <a
            href="https://www.securemyslot.co.uk/terms-and-conditions"
            class="transition hover:text-white"
          >
            Terms & Conditions
          </a>

        </div>


        <a
          href="https://securemyslot.co.uk"
          class="text-sm font-semibold <%= website_colour_class("text", 500) %> transition hover:text-white"
        >
          Powered by
          <span class="font-black text-white">
            SecureMySlot
          </span>
        </a>

      </div>

    </div>

  </footer>


<% else %>

  <section class="flex min-h-screen items-center justify-center <%= website_colour_class("bg", 950) %> px-5">

    <div class="max-w-xl rounded-3xl bg-white p-10 text-center shadow-2xl">

      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl <%= website_colour_class("bg", 100) %> <%= website_colour_class("text", 600) %>">

        <svg
          class="h-8 w-8"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v4m0 4h.01M10.3 3.7 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"
            />
        </svg>

      </div>

      <h1 class="mt-6 text-3xl font-black <%= website_colour_class("text", 950) %>">
        This booking page is not live
      </h1>

      <p class="mt-4 text-lg leading-8 <%= website_colour_class("text", 600) %>">
        Online bookings are currently unavailable. Please check back soon or contact us directly to arrange an appointment.
      </p>

      <% if @business.business_setting.phone_number.present? %>

        <a
          href="tel:<%= @business.business_setting.phone_number %>"
          class="mt-8 inline-flex rounded-2xl <%= website_colour_class("bg", 500) %> px-7 py-4 font-bold text-white transition hover:<%= website_colour_class("bg", 600) %>"
        >
          Contact us
        </a>

      <% end %>

    </div>

  </section>

<% end %>