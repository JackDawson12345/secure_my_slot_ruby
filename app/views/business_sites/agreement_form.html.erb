<% if @business.business_setting.booking_page_live == true %>
  <!-- Header -->
  <header class="sticky top-0 z-50 border-b <%= website_colour_class("border", 200, 80) %> bg-white/90 backdrop-blur">

    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">

      <% if @business.business_setting.logo.attached? %>

        <%= link_to root_path do %>
          <%= image_tag @business.business_setting.logo,
                        alt: "#{@business.business_name} logo",
                        class: "h-16 rounded-xl object-contain" %>
        <% end %>

      <% else %>

        <%= link_to root_path,
                    class: "flex items-center gap-3" do %>

          <div class="flex h-11 w-11 items-center justify-center rounded-2xl <%= website_colour_class("bg", 500) %> text-white shadow-lg <%= website_colour_class("shadow", 500, 20) %>">

            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 20h16M6 20V9l6-5 6 5v11M9 20v-6h6v6"
                />
            </svg>

          </div>

          <div>

            <span class="block text-base font-bold leading-tight <%= website_colour_class("text", 950) %>">
              <%= @business.business_name %>
            </span>

            <span class="block text-xs font-medium <%= website_colour_class("text", 500) %>">
              Online consultation
            </span>

          </div>

        <% end %>

      <% end %>


      <%= link_to root_path,
                  class: "inline-flex items-center gap-2 rounded-xl border #{website_colour_class("border", 200)} bg-white px-4 py-2.5 text-sm font-bold #{website_colour_class("text", 700)} transition hover:#{website_colour_class("bg", 50)}" do %>

        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m15 18-6-6 6-6"
            />
        </svg>

        Back

      <% end %>

    </div>

  </header>

  <main class="min-h-[calc(100vh-150px)] <%= website_colour_class("bg", 50) %> py-10 sm:py-14 lg:py-16">
    <% if @agreement.present? && @agreement_status.present? %>
      <div class="mx-auto max-w-4xl px-5 lg:px-8">

        <!-- Page heading -->
        <div class="mb-8">

          <div class="mb-4 inline-flex items-center gap-2 rounded-full <%= website_colour_class("bg", 100) %> px-3 py-1.5 text-xs font-bold <%= website_colour_class("text", 700) %>">

            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h6m-6 4h6M9 8h6M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"
                />
            </svg>

            Consultation form

          </div>

          <h1 class="text-3xl font-black tracking-tight <%= website_colour_class("text", 950) %> sm:text-4xl">
            <%= @agreement.name %>
          </h1>

          <p class="mt-3 max-w-2xl text-base leading-7 <%= website_colour_class("text", 600) %>">
            Please complete the information below before your appointment.
          </p>

        </div>

          <%= form_with url: submit_business_site_agreement_form_path(token: params[:token]),
                        method: :post,
                        data: { controller: "signature-form", action: "submit->signature-form#submit" } do |form| %>
          <div class="mb-6 rounded-2xl border <%= website_colour_class("border", 200) %> bg-white p-5 shadow-sm">

            <div class="text-slate-700 whitespace-pre-line">
              <%= render_agreement_content(@agreement.content, @agreement_status) %>
            </div>

          </div>


          <% unless @agreement_status.status == "signed" %>

            <button
              type="submit"
              class="rounded-xl bg-green-600 px-6 py-3 font-bold text-white"
            >
              Sign agreement
            </button>

          <% end %>

        <% end %>


      </div>


    <% end %>
  </main>

  <!-- Footer -->
  <footer class="<%= website_colour_class("bg", 950) %> text-white">

    <div class="border-t border-white/10">

      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-8 md:flex-row md:items-center md:justify-between lg:px-8">

        <div>

          <p class="font-bold">
            <%= @business.business_name %>
          </p>

          <p class="mt-1 text-sm <%= website_colour_class("text", 500) %>">
            © <%= Time.current.year %>
            <%= @business.business_name %>.
            All rights reserved.
          </p>

        </div>


        <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold <%= website_colour_class("text", 400) %>">

          <a
            href="https://www.securemyslot.co.uk/privacy-policy"
            class="transition hover:text-white"
          >
            Privacy Policy
          </a>

          <a
            href="https://www.securemyslot.co.uk/terms-and-conditions"
            class="transition hover:text-white"
          >
            Terms & Conditions
          </a>

        </div>


        <a
          href="https://securemyslot.co.uk"
          class="text-sm font-semibold <%= website_colour_class("text", 500) %> transition hover:text-white"
        >
          Powered by
          <span class="font-black text-white">
            SecureMySlot
          </span>
        </a>

      </div>

    </div>

  </footer>
  <% else %>
  <section class="flex min-h-screen items-center justify-center <%= website_colour_class("bg", 950) %> px-5">

    <div class="max-w-xl rounded-3xl bg-white p-10 text-center shadow-2xl">

      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl <%= website_colour_class("bg", 100) %> <%= website_colour_class("text", 600) %>">

        <svg
          class="h-8 w-8"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v4m0 4h.01M10.3 3.7 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"
            />
        </svg>

      </div>

      <h1 class="mt-6 text-3xl font-black <%= website_colour_class("text", 950) %>">
        This booking page is not live
      </h1>

      <p class="mt-4 text-lg leading-8 <%= website_colour_class("text", 600) %>">
        Online bookings are currently unavailable. Please check back soon or contact us directly to arrange an appointment.
      </p>

      <% if @business.business_setting.phone_number.present? %>

        <a
          href="tel:<%= @business.business_setting.phone_number %>"
          class="mt-8 inline-flex rounded-2xl <%= website_colour_class("bg", 500) %> px-7 py-4 font-bold text-white transition hover:<%= website_colour_class("bg", 600) %>"
        >
          Contact us
        </a>

      <% end %>

    </div>

  </section>
<% end %>