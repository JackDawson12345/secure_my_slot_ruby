<%= render 'business_sites/navbar' %>


<main id="top">


  <!-- Shop Header -->
  <section class="<%= website_colour_class("bg", 50) %> py-20 sm:py-24">


    <div class="mx-auto max-w-7xl px-5 lg:px-8">


      <div class="mx-auto max-w-3xl text-center">


        <p class="text-sm font-bold uppercase tracking-[0.2em] <%= website_colour_class("text", 600) %>">
          Online shop
        </p>


        <h1 class="mt-3 text-4xl font-black tracking-tight <%= website_colour_class("text", 950) %> sm:text-6xl">
          Browse our products
        </h1>


        <p class="mt-5 text-lg leading-8 <%= website_colour_class("text", 600) %>">
          Explore our latest products and find the items that suit your needs.
          Add your favourites to your basket and checkout securely online.
        </p>


      </div>


    </div>


  </section>





  <!-- Shop Content -->
  <section class="py-16 sm:py-20">


    <div class="mx-auto max-w-7xl px-5 lg:px-8">



      <!-- Categories / Filters -->
      <div class="mb-10 flex flex-col gap-4 rounded-3xl border <%= website_colour_class("border", 200) %> bg-white p-5 shadow-card sm:flex-row sm:items-center sm:justify-between">


        <div>

          <h2 class="text-xl font-black <%= website_colour_class("text", 950) %>">
            Our products
          </h2>

          <p class="mt-1 text-sm <%= website_colour_class("text", 500) %>">
            Showing our latest available products.
          </p>

        </div>



        <select
          class="rounded-2xl border <%= website_colour_class("border", 300) %> px-4 py-3 text-sm font-semibold"
        >

          <option>
            Sort by latest
          </option>

          <option>
            Price low to high
          </option>

          <option>
            Price high to low
          </option>

        </select>


      </div>





      <!-- Products Grid -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

        <% @products.each do |product| %>
          <!-- Product Card -->
          <%= link_to '/shop/' + product.slug, class: 'group overflow-hidden rounded-3xl border' + website_colour_class("border", 200) + 'bg-white shadow-card transition hover:-translate-y-1 hover:shadow-soft' do %>



            <div class="relative aspect-square overflow-hidden <%= website_colour_class("bg", 50) %>">


              <% if product.featured_image.attached? %>

                <%= image_tag product.featured_image,
                                class:"flex h-full items-center justify-center object-cover border border-slate-200"%>
              <% else %>

                <div class="flex h-full items-center justify-center <%= website_colour_class("text", 600) %>">

                  <i data-lucide="package" class="h-14 w-14"></i>

                </div>

              <% end %>



              <span class="absolute left-4 top-4 rounded-full <%= website_colour_class("bg", 500) %> px-3 py-1 text-xs font-bold text-white">

              New

            </span>


            </div>





            <div class="p-5">
              <h3 class="text-lg font-black <%= website_colour_class("text", 950) %>">
                <%= product.name %>
              </h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 <%= website_colour_class("text", 600) %>">
                <%= truncate(product.short_description.to_plain_text, length: 50) %>
              </p>

              <div class="mt-5 flex items-center justify-between">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                    Price
                  </p>

                  <% price = product.sale_price.presence || product.regular_price %>

                  <p class="text-2xl font-black <%= website_colour_class("text", 950) %>">
                    £<%= number_with_precision(price, precision: 2) %>
                  </p>

                  <% if product.sale_price.present? %>
                    <p class="mt-1 text-sm text-slate-400 line-through">
                      £<%= number_with_precision(product.regular_price, precision: 2) %>
                    </p>
                  <% end %>
                </div>

                <button
                  class="flex h-11 w-11 items-center justify-center rounded-xl <%= website_colour_class("bg", 500) %> text-white transition hover:<%= website_colour_class("bg", 600) %>"
                >
                  <i data-lucide="shopping-cart" class="h-5 w-5"></i>
                </button>
              </div>


            </div>


          <% end %>

        <% end %>

      </div>





      <!-- Pagination -->
      <div class="mt-12 flex justify-center">


        <div class="rounded-2xl border <%= website_colour_class("border", 200) %> bg-white px-5 py-3 text-sm font-bold <%= website_colour_class("text", 700) %>">

          Pagination

        </div>


      </div>



    </div>


  </section>


</main>


<%= render 'business_sites/footer' %>