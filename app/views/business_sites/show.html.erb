<% if @business.business_setting.booking_page_live == true %>
  <!-- Header -->
  <header class="sticky top-0 z-50 border-b border-<%= @business.business_website.colour %>-200/80 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">


      <% if @business.business_setting.logo.attached? %>
        <%= image_tag @business.business_setting.logo,
                      alt: "#{@business.business_name} logo",
                      class: "h-10 rounded-xl object-contain" %>
        <% else %>
        <a href="#top" class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-<%= @business.business_website.colour %>-500 text-white shadow-lg shadow-<%= @business.business_website.colour %>-500/20">
            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 20h16M6 20V9l6-5 6 5v11M9 20v-6h6v6"
                />
            </svg>
          </div>

          <div>
            <span class="block text-base font-bold leading-tight text-<%= @business.business_website.colour %>-950">
              <%= @business.business_name %>
            </span>
            <span class="block text-xs font-medium text-<%= @business.business_website.colour %>-500">
              Online booking
            </span>
          </div>
        </a>
      <% end %>



      <nav class="hidden items-center gap-8 md:flex">
        <a
          href="#services"
          class="text-sm font-semibold text-<%= @business.business_website.colour %>-600 transition hover:text-<%= @business.business_website.colour %>-600"
        >
          Services
        </a>

        <a
          href="#about"
          class="text-sm font-semibold text-<%= @business.business_website.colour %>-600 transition hover:text-<%= @business.business_website.colour %>-600"
        >
          About
        </a>

        <a
          href="#location"
          class="text-sm font-semibold text-<%= @business.business_website.colour %>-600 transition hover:text-<%= @business.business_website.colour %>-600"
        >
          Location
        </a>

        <a
          href="#booking"
          class="rounded-xl bg-<%= @business.business_website.colour %>-500 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-<%= @business.business_website.colour %>-500/20 transition hover:bg-<%= @business.business_website.colour %>-600"
        >
          Book now
        </a>
      </nav>

      <a
        href="#booking"
        class="rounded-xl bg-<%= @business.business_website.colour %>-500 px-4 py-2.5 text-sm font-bold text-white md:hidden"
      >
        Book
      </a>
    </div>
  </header>

  <main id="top">

    <!-- Hero -->
    <section class="relative overflow-hidden bg-<%= @business.business_website.colour %>-950">
      <div class="absolute inset-0">
        <% if @business.business_website.hero_image.attached? %>
          <%= image_tag @business.business_website.hero_image,
                        alt: "#{@business.business_name} hero image",
                        class: "h-full w-full object-cover opacity-40" %>
        <% else %>
          <%= image_tag 'hero.jpg',
                        alt: "Hero image",
                        class: "h-full w-full object-cover opacity-40" %>
          <img
            src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=1800&q=85"
            alt="Professional barber working in the shop"
            class="h-full w-full object-cover opacity-40"
          >
        <% end %>

        <div class="absolute inset-0 bg-gradient-to-r from-<%= @business.business_website.colour %>-950 via-<%= @business.business_website.colour %>-950/30 to-<%= @business.business_website.colour %>-950/30"></div>

        <div
          class="absolute inset-0 opacity-20"
          style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.25) 1px, transparent 0); background-size: 24px 24px;"
        ></div>
      </div>

      <div class="relative mx-auto grid min-h-[650px] max-w-7xl items-center gap-12 px-5 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">

        <div class="max-w-3xl">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur">
              <span class="relative flex h-2.5 w-2.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
              </span>
            Accepting online bookings
          </div>

          <h1 class="max-w-3xl text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-7xl">
            <%= @business.business_website.hero['title'].presence || 'Book your next appointment online' %>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-<%= @business.business_website.colour %>-300 sm:text-xl">
            <%= @business.business_website.hero['sentence'].presence || 'Professional services delivered at a time that works for you. Choose your service, select an available appointment and confirm your booking in just a few simple steps.' %>

          </p>

          <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold text-<%= @business.business_website.colour %>-200">
            <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/10 px-4 py-3 backdrop-blur">
              <i data-lucide="<%= @business.business_website.hero['info_boxes'][0]['icon'].presence || 'check' %>" class="h-5 w-5"></i>
              <%= @business.business_website.hero['info_boxes'][0]['title'].presence || 'Instant confirmation' %>
            </div>

            <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/10 px-4 py-3 backdrop-blur">
              <i data-lucide="<%= @business.business_website.hero['info_boxes'][1]['icon'].presence || 'clock' %>" class="h-5 w-5"></i>
              <%= @business.business_website.hero['info_boxes'][1]['title'].presence || 'Live availability' %>
            </div>

            <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/10 px-4 py-3 backdrop-blur">
              <i data-lucide="<%= @business.business_website.hero['info_boxes'][2]['icon'].presence || 'smartphone' %>" class="h-5 w-5"></i>
              <%= @business.business_website.hero['info_boxes'][2]['title'].presence || 'Mobile friendly' %>
            </div>
          </div>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a
              href="#booking"
              class="inline-flex items-center justify-center gap-2 rounded-2xl bg-<%= @business.business_website.colour %>-500 px-7 py-4 text-base font-bold text-white shadow-xl shadow-<%= @business.business_website.colour %>-500/20 transition hover:-tran<%= @business.business_website.colour %>-y-0.5 hover:bg-<%= @business.business_website.colour %>-600"
            >
              Book an appointment

              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
              </svg>
            </a>

            <a
              href="tel:<%= @business.business_setting.phone_number %>"
              class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/20 bg-white/10 px-7 py-4 text-base font-bold text-white backdrop-blur transition hover:bg-white/20"
            >
              <svg class="h-5 w-5 text-<%= @business.business_website.colour %>-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"/>
              </svg>
              <%= @business.business_setting.phone_number %>
            </a>
          </div>
        </div>

        <!-- Opening Hours Card -->
        <div class="hidden lg:block">
          <div class="rounded-[2rem] border border-white/15 bg-white/10 p-3 shadow-2xl backdrop-blur-xl">
            <div class="rounded-[1.5rem] bg-white p-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-sm font-bold uppercase tracking-[0.18em] text-<%= @business.business_website.colour %>-600">
                    Opening hours
                  </p>
                  <h2 class="mt-2 text-2xl font-black text-<%= @business.business_website.colour %>-950">
                    Plan your visit
                  </h2>
                </div>

                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-<%= @business.business_website.colour %>-50 text-<%= @business.business_website.colour %>-600">
                  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="9"/>
                    <path stroke-linecap="round" d="M12 7v5l3 2"/>
                  </svg>
                </div>
              </div>



              <div class="mt-6 space-y-3">
                <% @business.opening_hours.each do |opening_hour| %>
                  <div class="flex items-center justify-between border-b border-<%= @business.business_website.colour %>-100 pb-3">
                    <span class="font-medium text-<%= @business.business_website.colour %>-600 capitalize"><%= opening_hour.day_of_week %></span>
                    <% if opening_hour.open == true %>
                      <span class="font-bold text-<%= @business.business_website.colour %>-900"><%= opening_hour.opens_at.strftime("%H:%M") %> – <%= opening_hour.closes_at.strftime("%H:%M") %></span>
                  <% else %>
                      <span class="font-bold text-<%= @business.business_website.colour %>-900">Closed</span>
                  <% end %>
                  </div>
                <% end %>
              </div>

              <% if @business.open_now? %>
                <div class="mt-6 flex items-center gap-3 rounded-2xl bg-emerald-50 p-4 text-sm text-emerald-800">
                  <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-500"></span>

                  <span>
        <strong>Open today.</strong>
        Appointments available.
      </span>
                </div>
              <% else %>
                <div class="mt-6 flex items-center gap-3 rounded-2xl bg-red-50 p-4 text-sm text-red-800">
                  <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-red-500"></span>

                  <span>
                    <strong>Closed.</strong>
                    Please check our opening hours.
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Business Summary -->
    <section class="border-b border-<%= @business.business_website.colour %>-200 bg-white">
      <div class="mx-auto grid max-w-7xl divide-y divide-<%= @business.business_website.colour %>-200 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:px-8">

        <div class="flex items-center gap-4 py-6 sm:px-6 sm:first:pl-0">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-<%= @business.business_website.colour %>-50 text-<%= @business.business_website.colour %>-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-4.35 7-11A7 7 0 1 0 5 10c0 6.65 7 11 7 11Z"/>
              <circle cx="12" cy="10" r="2"/>
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-<%= @business.business_website.colour %>-500">Location</p>
            <p class="font-bold text-<%= @business.business_website.colour %>-900"><%= @business.business_setting.address_line_1 %>, <%= @business.business_setting.town_or_city %>, <%= @business.business_setting.postcode %></p>
          </div>
        </div>

        <div class="flex items-center gap-4 py-6 sm:px-6">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-<%= @business.business_website.colour %>-50 text-<%= @business.business_website.colour %>-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="m3 11 2-2 4 4L19 3l2 2L9 17l-6-6Z"/>
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-<%= @business.business_website.colour %>-500">Appointments</p>
            <p class="font-bold text-<%= @business.business_website.colour %>-900">Instantly confirmed</p>
          </div>
        </div>

        <div class="flex items-center gap-4 py-6 sm:px-6 sm:last:pr-0">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-<%= @business.business_website.colour %>-50 text-<%= @business.business_website.colour %>-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M7 3v4m10-4v4M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z"/>
              <path stroke-linecap="round" d="M8 11h3m2 0h3m-8 4h3m2 0h3"/>
            </svg>
          </div>

          <div>
            <p class="text-sm font-semibold text-<%= @business.business_website.colour %>-500">Booking</p>
            <p class="font-bold text-<%= @business.business_website.colour %>-900">Available 24 hours a day</p>
          </div>
        </div>

      </div>
    </section>

    <!-- Services -->
    <section id="services" class="py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">

        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-<%= @business.business_website.colour %>-600">
            Our services
          </p>

          <h2 class="mt-3 text-3xl font-black tracking-tight text-<%= @business.business_website.colour %>-950 sm:text-5xl">
            <%= @business.business_website.services['title'].presence || 'Choose the right service' %>
          </h2>

          <p class="mt-5 text-lg leading-8 text-<%= @business.business_website.colour %>-600">
            <%= @business.business_website.services['sentence'].presence || 'Browse our available services and select the option that best matches your requirements. Full details, appointment lengths and prices are shown before you book.' %>
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">

          <% @business.services.each do |service| %>
            <article class="group rounded-3xl border border-<%= @business.business_website.colour %>-200 bg-white p-6 shadow-card transition hover:-tran<%= @business.business_website.colour %>-y-1 hover:border-<%= @business.business_website.colour %>-200 hover:shadow-soft">
              <div class="flex items-start justify-between gap-4">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-<%= @business.business_website.colour %>-50 text-<%= @business.business_website.colour %>-600">
                  <i
                    data-lucide="<%= service.icon.presence || 'calendar-check' %>"
                    class="h-6 w-6"
                  ></i>
                </div>

                <span class="rounded-full bg-<%= @business.business_website.colour %>-100 px-3 py-1.5 text-xs font-bold text-<%= @business.business_website.colour %>-600">
                  <%= service.minutes_duration %> mins
                </span>
              </div>

              <h3 class="mt-6 text-xl font-black text-<%= @business.business_website.colour %>-950">
                <%= service.name %>
              </h3>

              <p class="mt-3 leading-7 text-<%= @business.business_website.colour %>-600">
                <%= service.description %>
              </p>

              <div class="mt-6 flex items-end justify-between">
                <div>
  <span class="text-sm font-semibold text-<%= @business.business_website.colour %>-400">
    Price
  </span>

                  <p class="text-2xl font-black text-<%= @business.business_website.colour %>-950">
                    <%= number_to_currency(service.price, unit: "£") %>
                  </p>

                  <% if service.deposit_enabled? && service.deposit.present? %>
                    <p class="mt-1 text-xs font-bold text-<%= @business.business_website.colour %>-600">
                      <%= number_to_currency(service.deposit, unit: "£") %> deposit required
                    </p>
                  <% end %>
                </div>

                <a
                  href="#booking"
                  data-service-id="<%= service.id %>"
                  class="inline-flex items-center gap-2 text-sm font-bold text-<%= @business.business_website.colour %>-600 transition group-hover:gap-3"
                >
                  Select
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
                  </svg>
                </a>
              </div>
            </article>
          <% end %>

        </div>
      </div>
    </section>

    <!-- Booking Section -->
    <section id="booking" class="bg-<%= @business.business_website.colour %>-100 py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">

        <div class="mb-12 max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-<%= @business.business_website.colour %>-600">
            Book online
          </p>

          <h2 class="mt-3 text-3xl font-black tracking-tight text-<%= @business.business_website.colour %>-950 sm:text-5xl">
            Find your next available appointment
          </h2>

          <p class="mt-5 text-lg leading-8 text-<%= @business.business_website.colour %>-600">
            Choose your service, appointment date and preferred time.
          </p>
        </div>


        <%= form_with model: Booking.new,
                      url: bookings_path,
                      method: :post,
                      data: { turbo: false },
                      class: "grid gap-8 lg:grid-cols-[1fr_380px]",
                      id: "booking-form" do |form| %>


          <div class="space-y-8">


            <!-- Service -->
            <div class="rounded-3xl border border-<%= @business.business_website.colour %>-200 bg-white p-6 shadow-card sm:p-8">

              <h3 class="text-xl font-black text-<%= @business.business_website.colour %>-950">
                Select a service
              </h3>


              <div class="mt-7 grid gap-4 sm:grid-cols-2">


                <% @business.services.each do |service| %>

                  <div>

                    <input
                      class="service-radio peer sr-only"
                      type="radio"
                      name="booking[service_id]"
                      id="service-<%= service.id %>"
                      value="<%= service.id %>"
                      data-duration="<%= service.minutes_duration %>"
                      data-price="<%= service.price %>"
                      data-deposit-enabled="<%= service.deposit_enabled? %>"
                      data-deposit="<%= service.deposit || 0 %>"
                      required
                    >


                    <label
                      for="service-<%= service.id %>"
                      class="block cursor-pointer rounded-2xl border-2 border-<%= @business.business_website.colour %>-200 p-4 hover:border-<%= @business.business_website.colour %>-500"
                    >

                      <div class="flex justify-between">

                        <div>

                        <span class="service-name block font-bold text-<%= @business.business_website.colour %>-900">
                          <%= service.name %>
                        </span>


                          <span class="text-sm text-<%= @business.business_website.colour %>-500">
                            <%= service.minutes_duration %> minutes
                          </span>

                        </div>


                        <div class="text-right">
  <span class="block font-black text-<%= @business.business_website.colour %>-900">
    <%= number_to_currency(service.price, unit: "£") %>
  </span>

                          <% if service.deposit_enabled? && service.deposit.present? %>
    <span class="mt-1 block text-xs font-semibold text-<%= @business.business_website.colour %>-600">
      <%= number_to_currency(service.deposit, unit: "£") %> deposit
    </span>
                          <% end %>
                        </div>

                      </div>

                    </label>

                  </div>

                <% end %>


              </div>

            </div>




            <!-- Date -->
            <div class="rounded-3xl border border-<%= @business.business_website.colour %>-200 bg-white p-6 shadow-card sm:p-8">

              <h3 class="text-xl font-black text-<%= @business.business_website.colour %>-950">
                Choose a date
              </h3>


              <input
                type="date"
                name="booking[date]"
                id="booking-date"
                class="mt-6 w-full rounded-2xl border border-<%= @business.business_website.colour %>-300 px-4 py-4"
                required
              >


              <p class="mt-6 font-bold text-<%= @business.business_website.colour %>-700">
                Available times
              </p>

              <div
                id="time-options"
                class="mt-4"
              >

                <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-<%= @business.business_website.colour %>-200 bg-<%= @business.business_website.colour %>-50 px-6 py-10 text-center">

                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-<%= @business.business_website.colour %>-500 shadow-sm">

                    <svg
                      class="h-6 w-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 7V3m8 4V3M5 11h14M7 5h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 1 2-2Z"
                        />
                    </svg>

                  </div>


                  <p class="mt-4 text-base font-bold text-<%= @business.business_website.colour %>-900">
                    Choose your service and date
                  </p>


                  <p class="mt-2 max-w-sm text-sm leading-6 text-<%= @business.business_website.colour %>-500">
                    Available appointment times will appear here once you select your preferred service and booking date.
                  </p>

                </div>

              </div>


            </div>




            <!-- Customer Details -->
            <div class="rounded-3xl border border-<%= @business.business_website.colour %>-200 bg-white p-6 shadow-card sm:p-8">


              <h3 class="text-xl font-black text-<%= @business.business_website.colour %>-950">
                Your details
              </h3>


              <div class="mt-6 grid gap-5 sm:grid-cols-2">


                <input
                  type="text"
                  name="booking[first_name]"
                  placeholder="First name"
                  class="rounded-2xl border border-<%= @business.business_website.colour %>-300 px-4 py-3"
                  required
                >


                <input
                  type="text"
                  name="booking[last_name]"
                  placeholder="Last name"
                  class="rounded-2xl border border-<%= @business.business_website.colour %>-300 px-4 py-3"
                  required
                >


                <input
                  type="email"
                  name="booking[email]"
                  placeholder="Email"
                  class="rounded-2xl border border-<%= @business.business_website.colour %>-300 px-4 py-3"
                  required
                >


                <input
                  type="tel"
                  name="booking[phone_number]"
                  placeholder="Phone number"
                  class="rounded-2xl border border-<%= @business.business_website.colour %>-300 px-4 py-3"
                  required
                >


                <textarea
                  name="booking[notes]"
                  placeholder="Additional notes"
                  class="sm:col-span-2 rounded-2xl border border-<%= @business.business_website.colour %>-300 px-4 py-3"
                ></textarea>

                <div class="flex items-start gap-3">
                  <%= form.check_box :terms_accepted,
                                     required: true,
                                     class: "mt-1 h-4 w-4 rounded border-gray-300" %>

                  <%= form.label :terms_accepted, class: "text-sm text-gray-700" do %>
                    I agree to the terms and conditions
                  <% end %>
                </div>


              </div>


            </div>


          </div>





          <!-- Summary -->

          <aside>

            <div class="rounded-3xl border border-<%= @business.business_website.colour %>-200 bg-white p-6 shadow-soft lg:sticky lg:top-28">


