  <!-- Mobile Booking Bar -->
  <div class="fixed inset-x-0 bottom-0 z-50 border-t border-<%= @business.business_website.colour %>-200 bg-white/95 p-3 shadow-[0_-10px_30px_rgba(15,23,42,0.08)] backdrop-blur md:hidden">
    <a
      href="#booking"
      class="flex w-full items-center justify-center gap-2 rounded-2xl bg-<%= @business.business_website.colour %>-500 px-5 py-4 font-black text-white"
    >
      Book an appointment

      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
      </svg>
    </a>
  </div>

  <script>
      document.addEventListener("turbo:load", () => {
          const bookingForm = document.getElementById("booking-form");

          if (!bookingForm || bookingForm.dataset.initialised === "true") {
              return;
          }

          bookingForm.dataset.initialised = "true";

          const dateInput = document.getElementById("booking-date");
          const timeOptions = document.getElementById("time-options");

          const summaryService = document.getElementById("summary-service");
          const summaryDate = document.getElementById("summary-date");
          const summaryTime = document.getElementById("summary-time");
          const summaryDuration = document.getElementById("summary-duration");
          const summaryPrice = document.getElementById("summary-price");

          const summaryDepositRow = document.getElementById(
              "summary-deposit-row"
          );

          const summaryDeposit = document.getElementById(
              "summary-deposit"
          );

          const summaryPaymentNote = document.getElementById(
              "summary-payment-note"
          );

          const summaryDueLabel = document.getElementById(
              "summary-due-label"
          );

          const summaryDue = document.getElementById("summary-due");

          const paymentMessage = document.getElementById(
              "payment-message"
          );

          const bookingSubmitText = document.getElementById(
              "booking-submit-text"
          );

          const serviceInputs = document.querySelectorAll(
              ".service-radio"
          );

          const serviceLinks = document.querySelectorAll(
              "[data-service-id]"
          );

          const stripeReady = <%= @business.stripe_ready?.to_json %>;

          let selectedServiceId = null;

          function formatCurrency(amount) {
              return new Intl.NumberFormat("en-GB", {
                  style: "currency",
                  currency: "GBP"
              }).format(amount);
          }

          function updatePaymentSummary(input) {
              const price = Number.parseFloat(
                  input.dataset.price || "0"
              );

              const deposit = Number.parseFloat(
                  input.dataset.deposit || "0"
              );

              const depositEnabled =
                  input.dataset.depositEnabled === "true" &&
                  deposit > 0;

              summaryPrice.textContent = formatCurrency(price);

              if (depositEnabled) {
                  summaryDepositRow.classList.remove("hidden");
                  summaryDepositRow.classList.add("flex");

                  summaryDeposit.textContent = formatCurrency(deposit);

                  summaryPaymentNote.textContent =
                      `${formatCurrency(price - deposit)} remaining after deposit`;

                  summaryDueLabel.textContent = stripeReady
                      ? "Deposit due today"
                      : "Deposit required";

                  summaryDue.textContent = formatCurrency(deposit);

                  if (paymentMessage) {
                      paymentMessage.textContent = stripeReady
                          ? `You will be redirected to Stripe to securely pay the ${formatCurrency(deposit)} deposit.`
                          : `A ${formatCurrency(deposit)} deposit is required and will be arranged directly with the business.`;
                  }

                  if (bookingSubmitText) {
                      bookingSubmitText.textContent = stripeReady
                          ? `Pay ${formatCurrency(deposit)} deposit`
                          : "Confirm booking";
                  }
              } else {
                  summaryDepositRow.classList.add("hidden");
                  summaryDepositRow.classList.remove("flex");

                  summaryDeposit.textContent = "£0.00";

                  summaryPaymentNote.textContent = stripeReady
                      ? "Full payment due today"
                      : "Payment arranged with the business";

                  summaryDueLabel.textContent = stripeReady
                      ? "Amount due today"
                      : "Service price";

                  summaryDue.textContent = formatCurrency(price);

                  if (paymentMessage) {
                      paymentMessage.textContent = stripeReady
                          ? "You will be redirected to Stripe to securely pay for this appointment."
                          : "Payment will be arranged directly with the business.";
                  }

                  if (bookingSubmitText) {
                      bookingSubmitText.textContent = stripeReady
                          ? "Continue to secure payment"
                          : "Confirm booking";
                  }
              }
          }

          function selectService(input) {
              selectedServiceId = input.value;

              const label = document.querySelector(
                  `label[for="${input.id}"]`
              );

              const serviceName = label.querySelector(
                  ".service-name"
              );

              summaryService.textContent = serviceName
                  ? serviceName.textContent.trim()
                  : "Selected service";

              summaryDuration.textContent =
                  `${input.dataset.duration} minutes`;

              updatePaymentSummary(input);
              loadTimes();
          }

          serviceInputs.forEach((input) => {
              input.addEventListener("change", () => {
                  selectService(input);
              });
          });

          serviceLinks.forEach((link) => {
              link.addEventListener("click", () => {
                  const serviceId = link.dataset.serviceId;

                  const input = document.getElementById(
                      `service-${serviceId}`
                  );

                  if (!input) {
                      return;
                  }

                  input.checked = true;
                  input.dispatchEvent(
                      new Event("change", { bubbles: true })
                  );
              });
          });

          dateInput.addEventListener("change", () => {
              if (!dateInput.value) {
                  summaryDate.textContent = "Not selected";
                  return;
              }

              const selectedDate = new Date(
                  `${dateInput.value}T12:00:00`
              );

              summaryDate.textContent =
                  selectedDate.toLocaleDateString("en-GB", {
                      weekday: "short",
                      day: "numeric",
                      month: "long",
                      year: "numeric"
                  });

              summaryTime.textContent = "Not selected";

              loadTimes();
          });

          function loadTimes() {
              if (!selectedServiceId || !dateInput.value) {
                  return;
              }

              timeOptions.className = "mt-4";

              timeOptions.innerHTML = `
        <div class="rounded-2xl border border-<%= @business.business_website.colour %>-200 bg-<%= @business.business_website.colour %>-50 px-5 py-6 text-center">
          <p class="font-bold text-<%= @business.business_website.colour %>-900">
            Loading available times...
          </p>
        </div>
      `;

              fetch(
                  `/booking_slots?business_id=<%= @business.id %>&service_id=${selectedServiceId}&date=${dateInput.value}`
              )
                  .then((response) => {
                      if (!response.ok) {
                          throw new Error("Unable to load appointment times.");
                      }

                      return response.json();
                  })
                  .then((times) => {
                      timeOptions.innerHTML = "";

                      timeOptions.className =
                          "mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4";

                      if (times.length === 0) {
                          timeOptions.className = "mt-4";

                          timeOptions.innerHTML = `
              <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-6 text-center">
                <p class="font-bold text-red-700">
                  No available appointments
                </p>

                <p class="mt-1 text-sm text-red-600">
                  Please choose another date.
                </p>
              </div>
            `;

                          return;
                      }

                      times.forEach((time, index) => {
                          const safeTimeId = time.replace(
                              /[^a-zA-Z0-9]/g,
                              "-"
                          );

                          const inputId =
                              `time-${safeTimeId}-${index}`;

                          const wrapper = document.createElement("div");

                          wrapper.innerHTML = `
              <input
                class="time-radio peer sr-only"
                type="radio"
                name="booking[time]"
                id="${inputId}"
                value="${time}"
                required
              >

              <label
                for="${inputId}"
                class="block cursor-pointer rounded-xl border-2 border-<%= @business.business_website.colour %>-200 px-3 py-3 text-center font-bold text-<%= @business.business_website.colour %>-700 transition hover:border-<%= @business.business_website.colour %>-500 peer-checked:border-<%= @business.business_website.colour %>-500 peer-checked:bg-<%= @business.business_website.colour %>-50 peer-checked:text-<%= @business.business_website.colour %>-900"
              >
                ${time}
              </label>
            `;

                          timeOptions.appendChild(wrapper);

                          wrapper
                              .querySelector("input")
                              .addEventListener("change", () => {
                                  summaryTime.textContent = time;
                              });
                      });
                  })
                  .catch(() => {
                      timeOptions.className = "mt-4";

                      timeOptions.innerHTML = `
            <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-6 text-center">
              <p class="font-bold text-red-700">
                Appointment times could not be loaded
              </p>

              <p class="mt-1 text-sm text-red-600">
                Please try again.
              </p>
            </div>
          `;
                  });
          }
      });
  </script>
<% else %>
  <section class="flex min-h-screen items-center justify-center bg-<%= @business.business_website.colour %>-950 px-5">
    <div class="max-w-xl rounded-3xl bg-white p-10 text-center shadow-2xl">

      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-<%= @business.business_website.colour %>-100 text-<%= @business.business_website.colour %>-600">
        <svg
          class="h-8 w-8"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v4m0 4h.01M10.3 3.7 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"
            />
        </svg>
      </div>

      <h1 class="mt-6 text-3xl font-black text-<%= @business.business_website.colour %>-950">
        This booking page is not live
      </h1>

      <p class="mt-4 text-lg leading-8 text-<%= @business.business_website.colour %>-600">
        Online bookings are currently unavailable. Please check back soon or contact us directly to arrange an appointment.
      </p>

      <% if @business.phone_number.present? %>
        <a
          href="tel:<%= @business.phone_number %>"
          class="mt-8 inline-flex rounded-2xl bg-<%= @business.business_website.colour %>-500 px-7 py-4 font-bold text-white transition hover:bg-<%= @business.business_website.colour %>-600"
        >
          Contact us
        </a>
      <% end %>

    </div>
  </section>
<% end %>