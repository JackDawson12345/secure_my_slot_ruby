      href="#booking"
      class="flex w-full items-center justify-center gap-2 rounded-2xl bg-blue-500 px-5 py-4 font-black text-white"
    >
      Book an appointment

      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
      </svg>
    </a>
  </div>

  <script>
      document.addEventListener("DOMContentLoaded", () => {

          const dateInput = document.getElementById("booking-date");
          const timeOptions = document.getElementById("time-options");

          const summaryService = document.getElementById("summary-service");
          const summaryDate = document.getElementById("summary-date");
          const summaryTime = document.getElementById("summary-time");
          const summaryDuration = document.getElementById("summary-duration");
          const summaryPrice = document.getElementById("summary-price");


          let selectedServiceId = null;


          const serviceInputs = document.querySelectorAll(".service-radio");


          serviceInputs.forEach((input) => {

              input.addEventListener("change", () => {

                  selectedServiceId = input.value;


                  const label = document.querySelector(
                      `label[for="${input.id}"]`
                  );


                  summaryService.textContent =
                      label.querySelector("span").innerText.trim();


                  summaryDuration.textContent =
                      `${input.dataset.duration} minutes`;


                  summaryPrice.textContent =
                      `£${input.dataset.price}`;


                  loadTimes();

              });

          });



          dateInput.addEventListener("change", () => {


              const selectedDate = new Date(`${dateInput.value}T12:00:00`);


              summaryDate.textContent =
                  selectedDate.toLocaleDateString("en-GB", {
                      weekday: "short",
                      day: "numeric",
                      month: "long",
                      year: "numeric"
                  });


              loadTimes();

          });





          function loadTimes() {


              if (!selectedServiceId || !dateInput.value) {
                  return;
              }



              fetch(
                  `/booking_slots?business_id=<%= @business.id %>&service_id=${selectedServiceId}&date=${dateInput.value}`
              )

                  .then(response => response.json())

                  .then(times => {


                      timeOptions.innerHTML = "";

                      timeOptions.className =
                          "mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4";


                      if(times.length === 0) {

                          timeOptions.innerHTML = `
                      <p class="text-red-500">
                          No available appointments
                      </p>
                  `;

                          return;

                      }



                      times.forEach(time => {


                          const wrapper = document.createElement("div");


                          wrapper.innerHTML = `

                      <input
                          class="time-radio sr-only"
                          type="radio"
                          name="booking[time]"
                          id="time-${time}"
                          value="${time}"
                          required
                      >

                      <label
                          for="time-${time}"
                          class="block cursor-pointer rounded-xl border-2 border-blue-200 px-3 py-3 text-center font-bold text-blue-700 hover:border-blue-500"
                      >
                          ${time}
                      </label>

                  `;


                          timeOptions.appendChild(wrapper);



                          wrapper.querySelector("input")
                              .addEventListener("change", () => {

                                  summaryTime.textContent = time;

                              });


                      });


                  });


          }


      });
  </script>
