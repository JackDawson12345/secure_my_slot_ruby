<%= render 'business_sites/navbar' %>


<main id="top">


  <!-- Header -->
  <section class="<%= website_colour_class("bg", 50) %> py-20 sm:py-24">

    <div class="mx-auto max-w-7xl px-5 lg:px-8">

      <div class="mx-auto max-w-3xl text-center">

        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full <%= website_colour_class("bg", 500) %> text-white">

          <i data-lucide="check" class="h-10 w-10"></i>

        </div>


        <p class="mt-8 text-sm font-bold uppercase tracking-[0.2em] <%= website_colour_class("text", 600) %>">
          Order confirmed
        </p>


        <h1 class="mt-3 text-4xl font-black tracking-tight <%= website_colour_class("text", 950) %> sm:text-6xl">
          Thank you for your order
        </h1>


        <p class="mt-5 text-lg leading-8 <%= website_colour_class("text", 600) %>">
          Your order has been received and we will begin processing it shortly.
        </p>

      </div>

    </div>

  </section>





  <!-- Order Details -->
  <section class="py-16 sm:py-20">


    <div class="mx-auto max-w-5xl px-5 lg:px-8">


      <div class="grid gap-8 lg:grid-cols-[1fr_350px]">


        <!-- Items -->
        <section class="rounded-3xl border <%= website_colour_class("border", 200) %> bg-white p-6 shadow-card sm:p-8">


          <div class="flex items-center justify-between">

            <div>

              <p class="text-sm font-bold uppercase tracking-[0.2em] <%= website_colour_class("text", 600) %>">
                Order details
              </p>

              <h2 class="mt-2 text-2xl font-black <%= website_colour_class("text", 950) %>">
                Order items
              </h2>

            </div>


            <span class="rounded-full <%= website_colour_class("bg", 100) %> px-4 py-2 text-sm font-bold <%= website_colour_class("text", 700) %>">

              <%= @order.status.humanize %>

            </span>


          </div>




          <div class="mt-8 space-y-5">


            <% @order.order_items.each do |item| %>

              <div class="flex items-center gap-5 rounded-2xl border <%= website_colour_class("border", 200) %> p-4">


                <div class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-xl <%= website_colour_class("bg", 50) %>">


                  <% if item.product.featured_image.attached? %>

                    <%= image_tag item.product.featured_image,
                                  class:"h-full w-full object-cover" %>

                  <% else %>

                    <i data-lucide="package"
                       class="h-8 w-8 <%= website_colour_class("text", 600) %>">
                    </i>

                  <% end %>


                </div>



                <div class="flex-1">

                  <h3 class="font-black <%= website_colour_class("text", 950) %>">
                    <%= item.product.name %>
                  </h3>


                  <p class="mt-1 text-sm <%= website_colour_class("text", 600) %>">
                    Quantity: <%= item.quantity %>
                  </p>

                </div>



                <div class="text-right">

                  <p class="font-black <%= website_colour_class("text", 950) %>">

                    £<%= number_with_precision(
                           item.price * item.quantity,
                           precision: 2
                         ) %>

                  </p>

                </div>


              </div>


            <% end %>


          </div>


        </section>





        <!-- Summary -->
        <aside>


          <div class="rounded-3xl border <%= website_colour_class("border", 200) %> bg-white p-6 shadow-soft lg:sticky lg:top-28">


            <h2 class="text-2xl font-black <%= website_colour_class("text", 950) %>">
              Summary
            </h2>


            <div class="mt-6 space-y-4">


              <div class="flex justify-between border-b pb-4">

                <span class="text-sm font-semibold text-slate-500">
                  Order number
                </span>


                <span class="font-bold">
                  #<%= @order.public_id.split("-").first.upcase %>
                </span>

              </div>



              <div class="flex justify-between border-b pb-4">

                <span class="text-sm font-semibold text-slate-500">
                  Payment
                </span>


                <span class="font-bold">
                  <%= @order.payment_method.humanize %>
                </span>

              </div>



              <div class="flex justify-between pt-3">

                <span class="text-lg font-black">
                  Total
                </span>


                <span class="text-3xl font-black <%= website_colour_class("text", 950) %>">

                  £<%= number_with_precision(
                         @order.amount,
                         precision: 2
                       ) %>

                </span>

              </div>


            </div>



            <div class="mt-8 rounded-2xl <%= website_colour_class("bg", 50) %> p-5">


              <p class="text-sm leading-6 <%= website_colour_class("text", 600) %>">

                <% if @order.payment_method == "cash" %>

                  Your order has been placed. Payment will be collected when you collect your items.

                <% else %>

                  Your payment has been received securely through Stripe.

                <% end %>

              </p>


            </div>


          </div>


        </aside>


      </div>


    </div>


  </section>


</main>


<%= render 'business_sites/footer' %>