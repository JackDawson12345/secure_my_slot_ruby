<div>
  <input
    class="agent-radio peer sr-only"
    type="radio"
    name="booking[agent_selection]"
    id="agent-any"
    value="any"
    required
  >

  <label
    for="agent-any"
    class="block cursor-pointer rounded-2xl border-2 <%= website_colour_class("border", 200) %> p-4 transition hover:<%= website_colour_class("border", 500) %> peer-checked:<%= website_colour_class("border", 500) %> peer-checked:<%= website_colour_class("bg", 50) %>"
  >
    <div class="flex justify-between gap-4">
      <div>
        <span class="agent-name block font-bold <%= website_colour_class("text", 900) %>">
          Automatically Assign Agent
        </span>

        <span class="agent-name mt-2 block text-sm font-base <%= website_colour_class("text", 700) %>">
          Select this option if you don’t have a preferred agent and would like the earliest available time slot.
        </span>
      </div>
    </div>
  </label>
</div>