<!-- app/views/business_agent/bookings/index.html.erb -->

<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Bookings
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        View your bookings and appointments across <%= @business.business_name %>.
      </p>
    </div>
  </section>


  <!-- Flash messages -->
  <%= render "business_portal/shared/flash_messages" %>


  <!-- Booking ownership -->
  <section class="mt-8">
    <div class="inline-flex w-full gap-1 rounded-xl bg-slate-100 p-1 sm:w-auto">

      <!-- My bookings -->
      <%= link_to business_agent_bookings_path(
                    request.query_parameters
                           .except("page", "view")
                           .merge(view: "mine")
                  ),
                  class: "flex flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition sm:flex-none #{
                    @booking_view == "mine" ?
                      'bg-white text-slate-900 shadow-sm' :
                      'text-slate-500 hover:bg-white hover:text-slate-900'
                  }" do %>

        <i data-lucide="user" class="h-4 w-4"></i>

        <span>
          My bookings
        </span>

        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">
          <%= @my_bookings_count %>
        </span>

      <% end %>


      <!-- All bookings -->
      <%= link_to business_agent_bookings_path(
                    request.query_parameters
                           .except("page", "view")
                           .merge(view: "all")
                  ),
                  class: "flex flex-1 items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition sm:flex-none #{
                    @booking_view == "all" ?
                      'bg-white text-slate-900 shadow-sm' :
                      'text-slate-500 hover:bg-white hover:text-slate-900'
                  }" do %>

        <i data-lucide="users" class="h-4 w-4"></i>

        <span>
          All bookings
        </span>

        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">
          <%= @all_bookings_count %>
        </span>

      <% end %>

    </div>
  </section>


  <!-- Booking statistics -->
  <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <!-- Today -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Today
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @today_count %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="calendar-days" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        <%= @today_confirmed_count %> confirmed,
        <%= @today_pending_count %> pending
      </p>
    </article>


    <!-- Upcoming -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Upcoming
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @upcoming_count %>
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="clock-3" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        Over the next 7 days
      </p>
    </article>


    <!-- Completed -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Completed
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @completed_count %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="circle-check-big" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        This month
      </p>
    </article>


    <!-- Cancelled -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Cancelled
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @cancelled_count %>
          </p>
        </div>

        <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
          <i data-lucide="calendar-x" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        This month
      </p>
    </article>

  </section>


  <!-- Booking filters and list -->
  <section class="mt-8 overflow-visible rounded-2xl border border-slate-200 bg-white shadow-sm">

    <!-- Filter toolbar -->
    <div class="border-b border-slate-200 p-5 sm:p-6">

      <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">

        <!-- Status tabs -->
        <div class="flex w-full gap-1 overflow-x-auto rounded-xl bg-slate-100 p-1 xl:w-auto">

          <!-- All -->
          <%= link_to "All bookings",
                      business_agent_bookings_path(
                        request.query_parameters.except("page", "status")
                      ),
                      class: "shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition #{
                        params[:status].blank? ?
                          'bg-white text-slate-900 shadow-sm' :
                          'text-slate-500 hover:bg-white hover:text-slate-900'
                      }" %>


          <!-- Confirmed -->
          <%= link_to "Confirmed",
                      business_agent_bookings_path(
                        request.query_parameters
                               .except("page")
                               .merge(status: "confirmed")
                      ),
                      class: "shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition #{
                        params[:status] == 'confirmed' ?
                          'bg-white text-slate-900 shadow-sm' :
                          'text-slate-500 hover:bg-white hover:text-slate-900'
                      }" %>


          <!-- Pending -->
          <%= link_to "Pending",
                      business_agent_bookings_path(
                        request.query_parameters
                               .except("page")
                               .merge(status: "pending")
                      ),
                      class: "shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition #{
                        params[:status] == 'pending' ?
                          'bg-white text-slate-900 shadow-sm' :
                          'text-slate-500 hover:bg-white hover:text-slate-900'
                      }" %>


          <!-- Completed -->
          <%= link_to "Completed",
                      business_agent_bookings_path(
                        request.query_parameters
                               .except("page")
                               .merge(status: "completed")
                      ),
                      class: "shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition #{
                        params[:status] == 'completed' ?
                          'bg-white text-slate-900 shadow-sm' :
                          'text-slate-500 hover:bg-white hover:text-slate-900'
                      }" %>


          <!-- Cancelled -->
          <%= link_to "Cancelled",
                      business_agent_bookings_path(
                        request.query_parameters
                               .except("page")
                               .merge(status: "cancelled")
                      ),
                      class: "shrink-0 rounded-lg px-4 py-2 text-sm font-semibold transition #{
                        params[:status] == 'cancelled' ?
                          'bg-white text-slate-900 shadow-sm' :
                          'text-slate-500 hover:bg-white hover:text-slate-900'
                      }" %>

        </div>


        <!-- Search and filters -->
        <div class="flex flex-col gap-3 sm:flex-row">

          <!-- Search -->
          <%= form_with url: business_agent_bookings_path,
                        method: :get,
                        local: true,
                        class: "flex gap-2" do |form| %>

            <!-- Keep current booking ownership -->
            <%= hidden_field_tag :view, @booking_view %>

            <!-- Keep current filters -->
            <% params.permit(
              :status,
              :service_id,
              :date_from,
              :date_to
            ).each do |key, value| %>

              <% if value.present? %>
                <%= hidden_field_tag key, value %>
              <% end %>

            <% end %>


            <div class="relative min-w-0 sm:w-72">

              <i
                data-lucide="search"
                class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
              ></i>

              <%= form.search_field :q,
                                    value: params[:q],
                                    placeholder: "Search bookings...",
                                    class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

            </div>


            <%= form.submit "Search",
                            class: "cursor-pointer rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700" %>

          <% end %>


          <!-- Filters dropdown -->
          <details class="relative">

            <summary
              class="inline-flex cursor-pointer list-none items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
            >

              <i data-lucide="sliders-horizontal" class="h-4 w-4"></i>

              Filters

              <% if params[:service_id].present? ||
                    params[:date_from].present? ||
                    params[:date_to].present? %>

                <span class="h-2 w-2 rounded-full bg-indigo-600"></span>

              <% end %>

            </summary>


            <div class="absolute right-0 z-50 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-2xl border border-slate-200 bg-white p-5 shadow-xl">

              <%= form_with url: business_agent_bookings_path,
                            method: :get,
                            local: true do |form| %>

                <!-- Keep ownership -->
                <%= hidden_field_tag :view, @booking_view %>


                <% if params[:status].present? %>
                  <%= hidden_field_tag :status, params[:status] %>
                <% end %>


                <% if params[:q].present? %>
                  <%= hidden_field_tag :q, params[:q] %>
                <% end %>


                <!-- Service -->
                <div>

                  <%= form.label :service_id,
                                 "Service",
                                 class: "text-sm font-semibold text-slate-700" %>


                  <%= form.select :service_id,
                                  options_from_collection_for_select(
                                    @services,
                                    :id,
                                    :name,
                                    params[:service_id]
                                  ),
                                  {
                                    include_blank: "All services"
                                  },
                                  class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

                </div>


                <!-- From date -->
                <div class="mt-4">

                  <%= form.label :date_from,
                                 "From date",
                                 class: "text-sm font-semibold text-slate-700" %>

                  <%= form.date_field :date_from,
                                      value: params[:date_from],
                                      class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

                </div>


                <!-- To date -->
                <div class="mt-4">

                  <%= form.label :date_to,
                                 "To date",
                                 class: "text-sm font-semibold text-slate-700" %>

                  <%= form.date_field :date_to,
                                      value: params[:date_to],
                                      class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

                </div>


                <div class="mt-5 flex gap-2">

                  <%= form.submit "Apply filters",
                                  class: "flex-1 cursor-pointer rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700" %>


                  <%= link_to "Clear",
                              business_agent_bookings_path(
                                view: @booking_view,
                                status: params[:status],
                                q: params[:q]
                              ),
                              class: "rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>

                </div>

              <% end %>

            </div>

          </details>

        </div>

      </div>


      <!-- Active filters -->
      <% if params[:q].present? ||
            params[:service_id].present? ||
            params[:date_from].present? ||
            params[:date_to].present? %>

        <div class="mt-4 flex flex-wrap items-center gap-2">

          <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">
            Active filters
          </span>


          <% if params[:q].present? %>

            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
              Search: <%= params[:q] %>
            </span>

          <% end %>


          <% if params[:service_id].present? %>

            <% selected_service =
                 @services.find do |service|
                   service.id.to_s == params[:service_id].to_s
                 end %>

            <% if selected_service %>

              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
                <%= selected_service.name %>
              </span>

            <% end %>

          <% end %>


          <% if params[:date_from].present? %>

            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
              From
              <%= Date.parse(params[:date_from]).strftime("%-d %b %Y") rescue params[:date_from] %>
            </span>

          <% end %>


          <% if params[:date_to].present? %>

            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
              To
              <%= Date.parse(params[:date_to]).strftime("%-d %b %Y") rescue params[:date_to] %>
            </span>

          <% end %>


          <%= link_to "Clear all",
                      business_agent_bookings_path(
                        view: @booking_view,
                        status: params[:status]
                      ),
                      class: "text-xs font-semibold text-indigo-600 hover:text-indigo-700" %>

        </div>

      <% end %>

    </div>


    <!-- Desktop bookings table -->
    <div class="hidden overflow-x-auto lg:block">

      <table class="min-w-full">

        <thead class="bg-slate-50">

        <tr>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Customer
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Service
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Date and time
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Price
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Status
          </th>

          <th scope="col" class="px-6 py-4">
            <span class="sr-only">Actions</span>
          </th>

        </tr>

        </thead>


        <tbody class="divide-y divide-slate-100 bg-white">

        <% @bookings.each do |booking| %>

          <%
            first_name =
              booking.user&.first_name.presence ||
              booking.user&.email.to_s.split("@").first.to_s.titleize

            last_name =
              booking.user&.last_name.presence

            full_name =
              [first_name, last_name].compact.join(" ")

            initials =
              [first_name, last_name]
                .compact
                .filter_map { |name| name.to_s.first }
                .join
                .upcase

            is_mine =
              booking.agent_id == @business_agent.id

            status_classes =
              case booking.status
              when "confirmed"
                "bg-emerald-50 text-emerald-700"
              when "pending"
                "bg-amber-50 text-amber-700"
              when "completed"
                "bg-blue-50 text-blue-700"
              when "cancelled", "canceled"
                "bg-rose-50 text-rose-700"
              else
                "bg-slate-100 text-slate-700"
              end

            dot_classes =
              case booking.status
              when "confirmed"
                "bg-emerald-500"
              when "pending"
                "bg-amber-500"
              when "completed"
                "bg-blue-500"
              when "cancelled", "canceled"
                "bg-rose-500"
              else
                "bg-slate-500"
              end
          %>


          <tr class="transition hover:bg-slate-50">

            <!-- Customer -->
            <td class="whitespace-nowrap px-6 py-4">

              <div class="flex items-center gap-3">

                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full <%= is_mine ? 'bg-indigo-100 text-indigo-700' : 'bg-slate-100 text-slate-600' %> text-sm font-semibold">
                  <%= initials.presence || "CU" %>
                </div>


                <div>

                  <div class="flex items-center gap-2">

                    <p class="text-sm font-semibold text-slate-900">
                      <%= full_name %>
                    </p>


                    <% if @booking_view == "all" && is_mine %>

                        <span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2 py-0.5 text-[11px] font-semibold text-indigo-700">

                          <i
                            data-lucide="user-check"
                            class="h-3 w-3"
                          ></i>

                          Yours

                        </span>

                    <% end %>

                  </div>


                  <p class="mt-0.5 text-xs text-slate-500">
                    <%= booking.user&.email %>
                  </p>

                </div>

              </div>

            </td>


            <!-- Service -->
            <td class="whitespace-nowrap px-6 py-4">

              <p class="text-sm font-medium text-slate-900">
                <%= booking.service&.name || "Service unavailable" %>
              </p>


              <% if booking.service&.minutes_duration.present? %>

                <p class="mt-0.5 text-xs text-slate-500">
                  <%= booking.service.minutes_duration %> minutes
                </p>

              <% end %>

            </td>


            <!-- Date -->
            <td class="whitespace-nowrap px-6 py-4">

              <p class="text-sm font-medium text-slate-900">
                <%= booking.date.strftime("%A, %-d %B") %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= booking.time.strftime("%-I:%M %P") %>
              </p>

            </td>


            <!-- Price -->
            <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-slate-900">

              <%= number_to_currency(
                    booking.amount || 0,
                    unit: "£"
                  ) %>

            </td>


            <!-- Status -->
            <td class="whitespace-nowrap px-6 py-4">

                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold capitalize <%= status_classes %>">

                  <span class="h-1.5 w-1.5 rounded-full <%= dot_classes %>"></span>

                  <%= booking.status.to_s.titleize %>

                </span>

            </td>


            <!-- Actions -->
            <td class="whitespace-nowrap px-6 py-4 text-right">

              <%= link_to business_agent_booking_path(booking),
                          aria: {
                            label: "Open booking"
                          },
                          class: "inline-flex rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" do %>

                <i
                  data-lucide="ellipsis"
                  class="h-5 w-5"
                ></i>

              <% end %>

            </td>

          </tr>

        <% end %>


        <% if @bookings.empty? %>

          <tr>

            <td
              colspan="6"
              class="px-6 py-16 text-center"
            >

              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
                <i
                  data-lucide="calendar-x"
                  class="h-6 w-6"
                ></i>
              </div>


              <p class="mt-4 font-semibold text-slate-900">
                No bookings found
              </p>


              <p class="mt-1 text-sm text-slate-500">

                <% if @booking_view == "mine" %>
                  You don't have any bookings matching these filters.
                <% else %>
                  Try changing your search or filters.
                <% end %>

              </p>

            </td>

          </tr>

        <% end %>

        </tbody>

      </table>

    </div>


    <!-- Mobile booking cards -->
    <div class="divide-y divide-slate-100 lg:hidden">

      <% @bookings.each do |booking| %>

        <%
          first_name =
            booking.user&.first_name.presence ||
            booking.user&.email.to_s.split("@").first.to_s.titleize

          last_name =
            booking.user&.last_name.presence

          full_name =
            [first_name, last_name].compact.join(" ")

          initials =
            [first_name, last_name]
              .compact
              .filter_map { |name| name.to_s.first }
              .join
              .upcase

          is_mine =
            booking.agent_id == @business_agent.id

          status_classes =
            case booking.status
            when "confirmed"
              "bg-emerald-50 text-emerald-700"
            when "pending"
              "bg-amber-50 text-amber-700"
            when "completed"
              "bg-blue-50 text-blue-700"
            when "cancelled", "canceled"
              "bg-rose-50 text-rose-700"
            else
              "bg-slate-100 text-slate-700"
            end

          dot_classes =
            case booking.status
            when "confirmed"
              "bg-emerald-500"
            when "pending"
              "bg-amber-500"
            when "completed"
              "bg-blue-500"
            when "cancelled", "canceled"
              "bg-rose-500"
            else
              "bg-slate-500"
            end
        %>


        <article class="p-5">

          <div class="flex items-start justify-between gap-4">

            <div class="flex min-w-0 items-center gap-3">

              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full <%= is_mine ? 'bg-indigo-100 text-indigo-700' : 'bg-slate-100 text-slate-600' %> text-sm font-semibold">
                <%= initials.presence || "CU" %>
              </div>


              <div class="min-w-0">

                <div class="flex flex-wrap items-center gap-2">

                  <p class="truncate font-semibold text-slate-900">
                    <%= full_name %>
                  </p>


                  <% if @booking_view == "all" && is_mine %>

                    <span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2 py-0.5 text-[11px] font-semibold text-indigo-700">

                      <i
                        data-lucide="user-check"
                        class="h-3 w-3"
                      ></i>

                      Yours

                    </span>

                  <% end %>

                </div>


                <p class="mt-0.5 truncate text-sm text-slate-500">
                  <%= booking.service&.name || "Service unavailable" %>
                </p>

              </div>

            </div>


            <%= link_to business_agent_booking_path(booking),
                        aria: {
                          label: "Open booking"
                        },
                        class: "rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" do %>

              <i
                data-lucide="ellipsis"
                class="h-5 w-5"
              ></i>

            <% end %>

          </div>


          <!-- Date / Time -->
          <div class="mt-4 grid grid-cols-2 gap-3">

            <div class="rounded-xl bg-slate-50 p-3">

              <p class="text-xs font-medium text-slate-500">
                Date
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-900">
                <%= booking.date.strftime("%-d %B") %>
              </p>

            </div>


            <div class="rounded-xl bg-slate-50 p-3">

              <p class="text-xs font-medium text-slate-500">
                Time
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-900">
                <%= booking.time.strftime("%-I:%M %P") %>
              </p>

            </div>

          </div>


          <!-- Status / price -->
          <div class="mt-4 flex items-center justify-between">

            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold capitalize <%= status_classes %>">

              <span class="h-1.5 w-1.5 rounded-full <%= dot_classes %>"></span>

              <%= booking.status.to_s.titleize %>

            </span>


            <p class="text-sm font-bold text-slate-900">

              <%= number_to_currency(
                    booking.amount || 0,
                    unit: "£"
                  ) %>

            </p>

          </div>

        </article>

      <% end %>


      <% if @bookings.empty? %>

        <div class="px-5 py-14 text-center">

          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">

            <i
              data-lucide="calendar-x"
              class="h-6 w-6"
            ></i>

          </div>


          <p class="mt-4 font-semibold text-slate-900">
            No bookings found
          </p>


          <p class="mt-1 text-sm text-slate-500">

            <% if @booking_view == "mine" %>
              You don't have any bookings matching these filters.
            <% else %>
              Try changing your search or filters.
            <% end %>

          </p>

        </div>

      <% end %>

    </div>


    <!-- Pagination -->
    <% if @total_bookings.positive? %>

      <div class="flex flex-col gap-4 border-t border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">

        <p class="text-sm text-slate-500">

          Showing

          <span class="font-semibold text-slate-900">
            <%= @booking_start %>
          </span>

          to

          <span class="font-semibold text-slate-900">
            <%= @booking_end %>
          </span>

          of

          <span class="font-semibold text-slate-900">
            <%= @total_bookings %>
          </span>

          bookings

        </p>


        <% if @total_pages > 1 %>

          <%
            start_page = [@current_page - 2, 1].max
            end_page = [start_page + 4, @total_pages].min
            start_page = [end_page - 4, 1].max
          %>


          <div class="flex items-center gap-2">

            <!-- Previous -->
            <% if @current_page > 1 %>

              <%= link_to business_agent_bookings_path(
                            request.query_parameters.merge(
                              page: @current_page - 1
                            )
                          ),
                          class: "inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" do %>

                <i
                  data-lucide="chevron-left"
                  class="h-4 w-4"
                ></i>

                Previous

              <% end %>

            <% else %>

              <button
                type="button"
                disabled
                class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400"
              >

                <i
                  data-lucide="chevron-left"
                  class="h-4 w-4"
                ></i>

                Previous

              </button>

            <% end %>


            <!-- First page -->
            <% if start_page > 1 %>

              <%= link_to "1",
                          business_agent_bookings_path(
                            request.query_parameters.merge(
                              page: 1
                            )
                          ),
                          class: "hidden h-9 w-9 items-center justify-center rounded-lg text-sm font-medium text-slate-600 transition hover:bg-slate-100 sm:flex" %>


              <% if start_page > 2 %>

                <span class="hidden px-1 text-sm text-slate-400 sm:inline">
                  ...
                </span>

              <% end %>

            <% end %>


            <!-- Page numbers -->
            <% (start_page..end_page).each do |page| %>

              <% if page == @current_page %>

                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-sm font-semibold text-white">
                  <%= page %>
                </span>

              <% else %>

                <%= link_to page,
                            business_agent_bookings_path(
                              request.query_parameters.merge(
                                page: page
                              )
                            ),
                            class: "hidden h-9 w-9 items-center justify-center rounded-lg text-sm font-medium text-slate-600 transition hover:bg-slate-100 sm:flex" %>

              <% end %>

            <% end %>


            <!-- Last page -->
            <% if end_page < @total_pages %>

              <% if end_page < @total_pages - 1 %>

                <span class="hidden px-1 text-sm text-slate-400 sm:inline">
                  ...
                </span>

              <% end %>


              <%= link_to @total_pages,
                          business_agent_bookings_path(
                            request.query_parameters.merge(
                              page: @total_pages
                            )
                          ),
                          class: "hidden h-9 w-9 items-center justify-center rounded-lg text-sm font-medium text-slate-600 transition hover:bg-slate-100 sm:flex" %>

            <% end %>


            <!-- Next -->
            <% if @current_page < @total_pages %>

              <%= link_to business_agent_bookings_path(
                            request.query_parameters.merge(
                              page: @current_page + 1
                            )
                          ),
                          class: "inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" do %>

                Next

                <i
                  data-lucide="chevron-right"
                  class="h-4 w-4"
                ></i>

              <% end %>

            <% else %>

              <button
                type="button"
                disabled
                class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400"
              >

                Next

                <i
                  data-lucide="chevron-right"
                  class="h-4 w-4"
                ></i>

              </button>

            <% end %>

          </div>

        <% end %>

      </div>

    <% end %>

  </section>

</main>