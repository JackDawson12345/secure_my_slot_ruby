<!-- Business Agent Dashboard -->
<main class="p-4 sm:p-6 lg:p-8">

  <!-- Welcome banner -->
  <section
    class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 p-6 text-white shadow-lg shadow-indigo-200 sm:p-8"
  >
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">

      <div>
        <p class="mb-2 text-sm font-medium text-indigo-100">
          <%= Date.current.strftime("%A, %-d %B") %>
        </p>

        <h1 class="text-2xl font-bold sm:text-3xl">
          Welcome back, <%= current_user.first_name.presence || "there" %>
        </h1>

        <p class="mt-2 max-w-xl text-sm leading-6 text-indigo-100 sm:text-base">
          <% if @next_booking.present? %>
            You have <%= pluralize(@today_bookings_count, "booking") %>
            today. Your next appointment is at
            <%= @next_booking.time.strftime("%-I:%M %P") %>.
          <% elsif @today_bookings_count.positive? %>
            You have no more appointments scheduled for today.
          <% else %>
            You have no appointments scheduled for today.
          <% end %>
        </p>
      </div>

      <%= link_to business_agent_bookings_path,
                  class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 sm:w-auto" do %>
        <i data-lucide="calendar-days" class="h-4 w-4"></i>
        View my bookings
      <% end %>

    </div>
  </section>


  <!-- Statistics -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <!-- Today's bookings -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Today's Bookings
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
            <%= @today_bookings_count %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="calendar-days" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        Appointments assigned to you today
      </p>
    </article>


    <!-- This week -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            This Week
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
            <%= @this_week_bookings_count %>
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="calendar-range" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        Your appointments this week
      </p>
    </article>


    <!-- Completed -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Completed
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
            <%= @completed_bookings_count %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="circle-check" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        Appointments completed this month
      </p>
    </article>


    <!-- Upcoming -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Upcoming
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
            <%= @upcoming_bookings_count %>
          </p>
        </div>

        <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
          <i data-lucide="clock-3" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        Future appointments assigned to you
      </p>
    </article>

  </section>


  <!-- Main content -->
  <div class="mt-8 grid gap-8 xl:grid-cols-[1fr_340px]">

    <!-- Today's appointments -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-5 sm:px-6">

        <div>
          <h2 class="text-lg font-bold text-slate-900">
            Today's appointments
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Appointments assigned to you today.
          </p>
        </div>

        <%= link_to "View all",
                    business_agent_bookings_path,
                    class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>

      </div>


      <div class="divide-y divide-slate-100">

        <% @today_bookings.each do |booking| %>

          <% customer_name = [
            booking.user.first_name,
            booking.user.last_name
          ].compact.join(" ") %>

          <% customer_name =
               booking.user.email.split("@").first.titleize if customer_name.blank? %>

          <% initials = [
            booking.user.first_name,
            booking.user.last_name
          ].compact.filter_map { |name| name.first }.join.upcase %>

          <% initials =
               customer_name.split.map { |name| name.first }.first(2).join.upcase if initials.blank? %>

          <% status_classes =
               case booking.status
               when "confirmed"
                 "bg-emerald-50 text-emerald-700"
               when "pending"
                 "bg-amber-50 text-amber-700"
               when "cancelled", "canceled"
                 "bg-rose-50 text-rose-700"
               when "completed"
                 "bg-blue-50 text-blue-700"
               else
                 "bg-slate-100 text-slate-600"
               end
          %>


          <div class="flex items-center gap-4 px-5 py-4 transition hover:bg-slate-50 sm:px-6">

            <!-- Time -->
            <div class="hidden w-16 rounded-xl bg-slate-100 px-2 py-3 text-center sm:block">
              <p class="text-sm font-bold text-slate-800">
                <%= booking.time.strftime("%-I:%M") %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= booking.time.strftime("%P") %>
              </p>
            </div>


            <!-- Customer -->
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
              <%= initials %>
            </div>


            <div class="min-w-0 flex-1">

              <div class="flex items-center gap-2">

                <p class="truncate font-semibold text-slate-900">
                  <%= customer_name %>
                </p>

                <span class="hidden rounded-full px-2.5 py-1 text-xs font-semibold sm:inline-flex <%= status_classes %>">
                  <%= booking.status.titleize %>
                </span>

              </div>

              <p class="mt-1 truncate text-sm text-slate-500">

                <span class="sm:hidden">
                  <%= booking.time.strftime("%-I:%M %P") %> ·
                </span>

                <%= booking.service&.name || "Booking" %>

              </p>

            </div>


            <%= link_to business_agent_booking_path(booking),
                        class: "rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" do %>
              <i data-lucide="chevron-right" class="h-5 w-5"></i>
            <% end %>

          </div>

        <% end %>


        <% if @today_bookings.empty? %>

          <div class="px-5 py-12 text-center sm:px-6">

            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
              <i data-lucide="calendar-x" class="h-6 w-6"></i>
            </div>

            <p class="mt-4 font-semibold text-slate-900">
              No appointments today
            </p>

            <p class="mt-1 text-sm text-slate-500">
              You don't have any appointments assigned to you today.
            </p>

          </div>

        <% end %>

      </div>

    </section>


    <!-- Right column -->
    <aside class="space-y-6">


      <!-- Business details -->
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

        <div class="flex items-center gap-3">

          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            <i data-lucide="building-2" class="h-5 w-5"></i>
          </div>

          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
              Working at
            </p>

            <h2 class="font-bold text-slate-900">
              <%= @business.business_name %>
            </h2>
          </div>

        </div>


        <div class="mt-5 space-y-4 border-t border-slate-100 pt-5">

          <% if @business.respond_to?(:phone_number) && @business.phone_number.present? %>
            <div class="flex items-start gap-3">
              <i data-lucide="phone" class="mt-0.5 h-4 w-4 text-slate-400"></i>

              <div>
                <p class="text-xs font-medium text-slate-400">
                  Phone
                </p>

                <p class="mt-0.5 text-sm font-medium text-slate-700">
                  <%= @business.phone_number %>
                </p>
              </div>
            </div>
          <% end %>


          <% if @business.respond_to?(:email) && @business.email.present? %>
            <div class="flex items-start gap-3">
              <i data-lucide="mail" class="mt-0.5 h-4 w-4 text-slate-400"></i>

              <div class="min-w-0">
                <p class="text-xs font-medium text-slate-400">
                  Email
                </p>

                <p class="mt-0.5 truncate text-sm font-medium text-slate-700">
                  <%= @business.email %>
                </p>
              </div>
            </div>
          <% end %>

        </div>


        <div class="mt-5 rounded-xl bg-slate-50 p-3">

          <div class="flex gap-2">

            <i data-lucide="eye" class="mt-0.5 h-4 w-4 shrink-0 text-slate-400"></i>

            <p class="text-xs leading-5 text-slate-500">
              Business information is managed by the business owner and is read only for agents.
            </p>

          </div>

        </div>

      </section>


      <!-- Next booking -->
      <section class="rounded-2xl bg-slate-950 p-5 text-white shadow-sm">

        <div class="flex items-center justify-between">

          <div>
            <p class="text-sm font-medium text-slate-400">
              Your next booking
            </p>

            <p class="mt-2 text-3xl font-bold">
              <% if @next_booking.present? %>
                <%= @next_booking.time.strftime("%-I:%M %P") %>
              <% else %>
                None
              <% end %>
            </p>
          </div>

          <div class="rounded-xl bg-white/10 p-3">
            <i data-lucide="clock-3" class="h-5 w-5"></i>
          </div>

        </div>


        <div class="mt-5 border-t border-white/10 pt-5">

          <% if @next_booking.present? %>

            <% next_customer_name = [
              @next_booking.user.first_name,
              @next_booking.user.last_name
            ].compact.join(" ") %>

            <% next_customer_name =
                 @next_booking.user.email.split("@").first.titleize if next_customer_name.blank? %>

            <p class="font-semibold">
              <%= next_customer_name %>
            </p>

            <p class="mt-1 text-sm text-slate-400">
              <%= @next_booking.service&.name || "Booking" %>
            </p>

            <%= link_to business_agent_booking_path(@next_booking),
                        class: "mt-5 flex w-full items-center justify-center rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-slate-100" do %>
              View appointment
            <% end %>

          <% else %>

            <p class="text-sm text-slate-400">
              You don't have any more bookings scheduled today.
            </p>

          <% end %>

        </div>

      </section>


      <!-- Business access -->
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

        <h2 class="text-lg font-bold text-slate-900">
          Business information
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          View information about <%= @business.business_name %>.
        </p>

        <div class="mt-5 space-y-3">

          <%= link_to "#",
                      class: "flex items-center gap-3 rounded-xl border border-slate-200 p-3 transition hover:border-indigo-200 hover:bg-indigo-50" do %>

            <div class="rounded-lg bg-indigo-100 p-2 text-indigo-600">
              <i data-lucide="briefcase-business" class="h-5 w-5"></i>
            </div>

            <div class="flex-1">
              <p class="text-sm font-semibold text-slate-900">
                Services
              </p>

              <p class="text-xs text-slate-500">
                View available services
              </p>
            </div>

            <i data-lucide="chevron-right" class="h-4 w-4 text-slate-400"></i>

          <% end %>


          <%= link_to "#",
                      class: "flex items-center gap-3 rounded-xl border border-slate-200 p-3 transition hover:border-indigo-200 hover:bg-indigo-50" do %>

            <div class="rounded-lg bg-violet-100 p-2 text-violet-600">
              <i data-lucide="clock-3" class="h-5 w-5"></i>
            </div>

            <div class="flex-1">
              <p class="text-sm font-semibold text-slate-900">
                Opening hours
              </p>

              <p class="text-xs text-slate-500">
                View business opening hours
              </p>
            </div>

            <i data-lucide="chevron-right" class="h-4 w-4 text-slate-400"></i>

          <% end %>

        </div>

      </section>

    </aside>

  </div>

</main>