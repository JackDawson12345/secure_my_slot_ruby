<main class="p-4 sm:p-6 lg:p-8">

  <div class="mx-auto">

    <!-- Back -->
    <div class="mb-6">

      <%= link_to business_agent_services_path,
                  class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-indigo-600" do %>

        <i
          data-lucide="arrow-left"
          class="h-4 w-4"
        ></i>

        Back to services

      <% end %>

    </div>


    <!-- Service -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <!-- Header -->
      <header class="border-b border-slate-200 p-6 sm:p-8">

        <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

          <div class="flex items-start gap-5">

            <!-- Service image -->
            <div class="relative flex h-24 w-24 shrink-0 items-center justify-center">

              <% if @service.image.attached? %>

                <%= image_tag @service.image.variant(
                  resize_to_fill: [200, 200]
                ),
                              class: "h-24 w-24 rounded-3xl border border-slate-200 object-cover" %>

              <% else %>

                <div class="flex h-24 w-24 items-center justify-center rounded-3xl bg-indigo-50 text-indigo-600">

                  <i
                    data-lucide="<%= @service.icon.presence || 'calendar-check' %>"
                    class="h-8 w-8"
                  ></i>

                </div>

              <% end %>


              <!-- Icon overlay -->
              <% if @service.image.attached? %>

                <div class="absolute -bottom-2 -right-2 flex h-9 w-9 items-center justify-center rounded-xl border-2 border-white bg-indigo-50 text-indigo-600 shadow-sm">

                  <i
                    data-lucide="<%= @service.icon.presence || 'calendar-check' %>"
                    class="h-4 w-4"
                  ></i>

                </div>

              <% end %>

            </div>


            <!-- Service information -->
            <div>

              <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                <%= @service.name %>
              </h1>


              <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-500">

                <%= @service.description.presence ||
                      "No description has been added." %>

              </p>


              <% if @service.service_category.present? %>

                <div class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700">

                  <i
                    data-lucide="folder"
                    class="h-3.5 w-3.5"
                  ></i>

                  <%= @service.service_category.name %>

                </div>

              <% end %>

            </div>

          </div>


          <!-- Status -->
          <% if @service.status == "active" %>

            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">

              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>

              Active

            </span>

          <% else %>

            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">

              <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>

              Inactive

            </span>

          <% end %>

        </div>

      </header>


      <!-- Service details -->
      <div class="grid gap-5 p-6 sm:grid-cols-2 lg:grid-cols-3 sm:p-8">

        <!-- Duration -->
        <article class="rounded-xl bg-slate-50 p-5">

          <div class="flex items-center gap-3">

            <div class="rounded-lg bg-white p-2 text-indigo-600 shadow-sm">

              <i
                data-lucide="clock-3"
                class="h-5 w-5"
              ></i>

            </div>


            <div>

              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                Duration
              </p>


              <p class="mt-1 font-bold text-slate-900">

                <% if @service.minutes_duration.present? %>

                  <%= @service.minutes_duration %> minutes

                <% else %>

                  Not specified

                <% end %>

              </p>

            </div>

          </div>

        </article>


        <!-- Price -->
        <article class="rounded-xl bg-slate-50 p-5">

          <div class="flex items-center gap-3">

            <div class="rounded-lg bg-white p-2 text-emerald-600 shadow-sm">

              <i
                data-lucide="badge-pound-sterling"
                class="h-5 w-5"
              ></i>

            </div>


            <div>

              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                Price
              </p>


              <p class="mt-1 font-bold text-slate-900">

                <%= number_to_currency(
                      @service.price || 0,
                      unit: "£"
                    ) %>

              </p>

            </div>

          </div>

        </article>


        <!-- Deposit -->
        <article class="rounded-xl bg-slate-50 p-5">

          <div class="flex items-center gap-3">

            <div class="rounded-lg bg-white p-2 text-amber-600 shadow-sm">

              <i
                data-lucide="wallet-cards"
                class="h-5 w-5"
              ></i>

            </div>


            <div>

              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                Deposit
              </p>


              <% if @service.deposit_enabled? &&
                    @service.deposit.present? %>

                <p class="mt-1 font-bold text-slate-900">

                  <%= number_to_currency(
                        @service.deposit,
                        unit: "£"
                      ) %>

                </p>

                <p class="mt-1 text-xs text-slate-500">
                  Required when booking
                </p>

              <% else %>

                <p class="mt-1 font-bold text-slate-900">
                  Not required
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  Customers pay no deposit
                </p>

              <% end %>

            </div>

          </div>

        </article>

      </div>

    </section>


    <!-- Read only notice -->
    <section class="mt-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-5">

      <div class="flex items-start gap-3">

        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm">

          <i
            data-lucide="eye"
            class="h-4 w-4"
          ></i>

        </div>


        <div>

          <p class="text-sm font-semibold text-indigo-900">
            Service information
          </p>

          <p class="mt-1 text-sm leading-6 text-indigo-700">
            Service details are managed by the business. You can view this information but can't make changes.
          </p>

        </div>

      </div>

    </section>

  </div>

</main>