<%# app/views/business_agent/services/index.html.erb %>

<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>

      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Services
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        View the services available at <%= @business.business_name %>.
      </p>

    </div>

  </section>


  <!-- Flash messages -->
  <%= render "business_portal/shared/flash_messages" %>


  <!-- Service statistics -->
  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <!-- Total services -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Total Services
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @total_services %>
          </p>

        </div>


        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">

          <i
            data-lucide="briefcase-business"
            class="h-5 w-5"
          ></i>

        </div>

      </div>


      <p class="mt-4 text-sm text-slate-500">

        <%= pluralize(
              @active_services_count,
              "active service"
            ) %>,

        <%= pluralize(
              @inactive_services_count,
              "inactive service"
            ) %>

      </p>

    </article>


    <!-- Active -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Active Services
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @active_services_count %>
          </p>

        </div>


        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">

          <i
            data-lucide="circle-check"
            class="h-5 w-5"
          ></i>

        </div>

      </div>


      <p class="mt-4 text-sm text-slate-500">
        Available for customer bookings
      </p>

    </article>


    <!-- Average price -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Average Price
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">

            <%= number_to_currency(
                  @average_price,
                  unit: "£"
                ) %>

          </p>

        </div>


        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">

          <i
            data-lucide="badge-pound-sterling"
            class="h-5 w-5"
          ></i>

        </div>

      </div>


      <p class="mt-4 text-sm text-slate-500">
        Across active services
      </p>

    </article>


    <!-- Inactive -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Inactive Services
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @inactive_services_count %>
          </p>

        </div>


        <div class="rounded-xl bg-slate-100 p-3 text-slate-600">

          <i
            data-lucide="circle-pause"
            class="h-5 w-5"
          ></i>

        </div>

      </div>


      <p class="mt-4 text-sm text-slate-500">
        Not available for new bookings
      </p>

    </article>

  </section>


  <!-- Services panel -->
  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

    <!-- Toolbar -->
    <div class="border-b border-slate-200 p-5 sm:p-6">

      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

        <div>

          <h2 class="text-lg font-bold text-slate-900">
            All Services
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            View service details, duration, pricing and availability.
          </p>

        </div>


        <!-- Search -->
        <%= form_with url: business_agent_services_path,
                      method: :get,
                      local: true,
                      class: "flex gap-2" do |form| %>

          <div class="relative min-w-0 sm:w-72">

            <i
              data-lucide="search"
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
            ></i>


            <%= form.search_field :q,
                                  value: params[:q],
                                  placeholder: "Search services...",
                                  class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

          </div>


          <%= form.submit "Search",
                          class: "cursor-pointer rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700" %>

        <% end %>

      </div>


      <!-- Search indicator -->
      <% if params[:q].present? %>

        <div class="mt-4 flex flex-wrap items-center gap-2">

          <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">
            Search
          </span>


          <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">

            <%= params[:q] %>

            <%= link_to business_agent_services_path,
                        aria: {
                          label: "Clear search"
                        },
                        class: "text-slate-400 transition hover:text-slate-700" do %>

              <i
                data-lucide="x"
                class="h-3.5 w-3.5"
              ></i>

            <% end %>

          </span>

        </div>

      <% end %>

    </div>


    <% if @services.any? %>

      <!-- Services grid -->
      <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6 xl:grid-cols-3">

        <% @services.each do |service| %>

          <article
            class="<%= service.status == 'active' ? 'bg-white' : 'bg-slate-50' %> rounded-2xl border border-slate-200 p-5 transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md"
          >

            <!-- Image / status -->
            <div class="flex items-start justify-between gap-4">

              <div class="relative flex h-20 w-20 items-center justify-center">

                <% if service.image.attached? %>

                  <%= image_tag service.image.variant(
                    resize_to_fill: [160, 160]
                  ),
                                class: "h-20 w-20 rounded-2xl border border-slate-200 object-cover" %>

                <% else %>

                  <div class="<%= service.status == 'active' ? 'bg-indigo-50 text-indigo-600' : 'bg-slate-200 text-slate-600' %> flex h-20 w-20 items-center justify-center rounded-2xl">

                    <i
                      data-lucide="<%= service.icon.presence || 'calendar-check' %>"
                      class="h-7 w-7"
                    ></i>

                  </div>

                <% end %>


                <% if service.image.attached? %>

                  <div class="<%= service.status == 'active' ? 'bg-indigo-50 text-indigo-600' : 'bg-slate-200 text-slate-600' %> absolute -bottom-2 -right-2 flex h-12 w-12 items-center justify-center rounded-xl border-2 border-white shadow-sm">

                    <i
                      data-lucide="<%= service.icon.presence || 'calendar-check' %>"
                      class="h-6 w-6"
                    ></i>

                  </div>

                <% end %>

              </div>


              <!-- Status -->
              <% if service.status == "active" %>

                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">

                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>

                  Active

                </span>

              <% else %>

                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600">

                  <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>

                  Inactive

                </span>

              <% end %>

            </div>


            <!-- Service information -->
            <div class="mt-7">

              <h3 class="font-bold text-slate-900">
                <%= service.name %>
              </h3>


              <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">

                <%= service.description.presence ||
                      "No description has been added for this service." %>

              </p>


              <% if service.service_category.present? %>

                <div class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700">

                  <i
                    data-lucide="folder"
                    class="h-3.5 w-3.5"
                  ></i>

                  <%= service.service_category.name %>

                </div>

              <% end %>

            </div>


            <!-- Details -->
            <div class="mt-5 grid grid-cols-2 gap-3">

              <!-- Duration -->
              <div class="<%= service.status == 'active' ? 'bg-slate-50' : 'bg-white' %> rounded-xl p-3">

                <p class="text-xs font-medium text-slate-500">
                  Duration
                </p>


                <div class="mt-1 flex items-center gap-1.5">

                  <i
                    data-lucide="clock-3"
                    class="h-4 w-4 text-slate-400"
                  ></i>


                  <p class="text-sm font-semibold text-slate-900">

                    <% if service.minutes_duration.present? %>
                      <%= service.minutes_duration %> minutes
                    <% else %>
                      —
                    <% end %>

                  </p>

                </div>

              </div>


              <!-- Price -->
              <div class="<%= service.status == 'active' ? 'bg-slate-50' : 'bg-white' %> rounded-xl p-3">

                <p class="text-xs font-medium text-slate-500">
                  Price
                </p>


                <div class="mt-1 flex items-center gap-1.5">

                  <i
                    data-lucide="badge-pound-sterling"
                    class="h-4 w-4 text-slate-400"
                  ></i>

                  <p class="text-sm font-semibold text-slate-900">

                    <%= number_to_currency(
                          service.price || 0,
                          unit: "£"
                        ) %>

                  </p>

                </div>

              </div>

            </div>


            <!-- Read only footer -->
            <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">

              <%= link_to business_agent_service_path(service),
                          class: "inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 transition hover:text-indigo-700" do %>

                View service

                <i
                  data-lucide="arrow-right"
                  class="h-4 w-4"
                ></i>

              <% end %>


              <% if service.status == "active" %>

    <span class="text-xs font-semibold text-emerald-600">
      Available
    </span>

              <% else %>

    <span class="text-xs font-semibold text-slate-400">
      Unavailable
    </span>

              <% end %>

            </div>

          </article>

        <% end %>

      </div>


    <% else %>

      <!-- Empty state -->
      <div class="px-5 py-16 text-center sm:px-6">

        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">

          <% if params[:q].present? %>

            <i
              data-lucide="search-x"
              class="h-6 w-6"
            ></i>

          <% else %>

            <i
              data-lucide="briefcase-business"
              class="h-6 w-6"
            ></i>

          <% end %>

        </div>


        <% if params[:q].present? %>

          <h3 class="mt-4 text-lg font-bold text-slate-900">
            No services found
          </h3>

          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
            No services match "<%= params[:q] %>". Try another search term.
          </p>


          <%= link_to "Clear search",
                      business_agent_services_path,
                      class: "mt-6 inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>


        <% else %>

          <h3 class="mt-4 text-lg font-bold text-slate-900">
            No services available
          </h3>

          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
            There are currently no services available for this business.
          </p>

        <% end %>

      </div>

    <% end %>

  </section>

</main>