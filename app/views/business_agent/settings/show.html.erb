<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Account Settings
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        Update your personal details and contact information.
      </p>
    </div>

    <button
      type="submit"
      form="settingsForm"
      class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
    >
      <i data-lucide="save" class="h-4 w-4"></i>
      Save changes
    </button>

  </section>


  <% if @user.errors.any? %>

    <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">

      <p class="font-semibold">
        There was a problem saving your changes:
      </p>

      <ul class="mt-2 list-disc list-inside">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>

  <% end %>

  <!-- Flash messages -->
  <%= render 'business_portal/shared/flash_messages' %>


  <!-- Profile summary -->
  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

    <div class="bg-slate-950 px-5 py-6 text-white sm:px-6">

      <div class="flex items-center gap-4">

        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-500 text-xl font-bold">
          <%= @user.first_name.first %><%= @user.last_name.first %>
        </div>


        <div>

          <h2 class="text-lg font-bold">
            <%= @user.first_name %> <%= @user.last_name %>
          </h2>


          <p class="mt-1 text-sm text-slate-300">
            <%= @user.email %>
          </p>


          <p class="mt-1 text-xs text-slate-400">
            Agent since <%= @user.created_at.strftime("%B %Y") %>
          </p>

        </div>

      </div>

    </div>

  </section>



  <%= form_with model: @user,
                url: business_agent_settings_path,
                method: :patch,
                id: "settingsForm",
                class: "mt-8" do |form| %>


    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


      <!-- Header -->
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">

        <div class="flex items-start gap-3">

          <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
            <i data-lucide="user-round" class="h-5 w-5"></i>
          </div>


          <div>

            <h3 class="text-lg font-bold text-slate-900">
              Personal details
            </h3>


            <p class="mt-1 text-sm text-slate-500">
              Update the details linked to your agent account.
            </p>

          </div>

        </div>

      </div>



      <!-- Fields -->
      <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">


        <div>

          <%= form.label :first_name,
                         class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= form.text_field :first_name,
                              class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

        </div>



        <div>

          <%= form.label :last_name,
                         class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= form.text_field :last_name,
                              class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

        </div>



        <div class="sm:col-span-2">

          <%= form.label :email,
                         class: "mb-2 block text-sm font-semibold text-slate-700" %>


          <div class="relative">

            <i data-lucide="mail"
               class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
            </i>


            <%= form.email_field :email,
                                 class: "w-full rounded-xl border border-slate-200 py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

          </div>

        </div>




        <div>

          <%= form.label :phone_number,
                         class: "mb-2 block text-sm font-semibold text-slate-700" %>


          <div class="relative">

            <i data-lucide="phone"
               class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400">
            </i>


            <%= form.telephone_field :phone_number,
                                     class: "w-full rounded-xl border border-slate-200 py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

          </div>

        </div>


      </div>


    </section>


    <!-- Security -->
    <section
      id="security"
      class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >

      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">

        <div class="flex items-start gap-3">

          <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
            <i data-lucide="shield-check" class="h-5 w-5"></i>
          </div>


          <div>

            <h3 class="text-lg font-bold text-slate-900">
              Security
            </h3>


            <p class="mt-1 text-sm text-slate-500">
              Keep your account secure by updating your password.
            </p>

          </div>

        </div>

      </div>



      <div class="grid gap-5 p-5 sm:p-6">


        <div>

          <%= form.label :current_password,
                         "Current password",
                         class: "mb-2 block text-sm font-semibold text-slate-700" %>


          <%= password_field_tag :current_password,
                                 nil,
                                 autocomplete: "current-password",
                                 placeholder: "Enter your current password",
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>


          <p class="mt-2 text-xs text-slate-500">
            Only required when changing your password.
          </p>

        </div>



        <div class="grid gap-5 sm:grid-cols-2">


          <div>

            <%= form.label :password,
                           "New password",
                           class: "mb-2 block text-sm font-semibold text-slate-700" %>


            <%= form.password_field :password,
                                    id: "password",
                                    autocomplete: "new-password",
                                    placeholder: "Enter a new password",
                                    class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

          </div>



          <div>

            <%= form.label :password_confirmation,
                           "Confirm new password",
                           class: "mb-2 block text-sm font-semibold text-slate-700" %>


            <%= form.password_field :password_confirmation,
                                    id: "passwordConfirmation",
                                    autocomplete: "new-password",
                                    placeholder: "Repeat your new password",
                                    class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

          </div>


        </div>



        <!-- Password requirements -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">

          <p class="text-sm font-semibold text-slate-900">
            Password requirements
          </p>


          <div class="mt-3 grid gap-2 text-sm text-slate-500 sm:grid-cols-2">


        <span id="lengthCheck" class="flex items-center gap-2">
          <i data-lucide="circle-check" class="h-4 w-4"></i>
          At least 8 characters
        </span>


            <span id="uppercaseCheck" class="flex items-center gap-2">
          <i data-lucide="circle-check" class="h-4 w-4"></i>
          One uppercase letter
        </span>


            <span id="numberCheck" class="flex items-center gap-2">
          <i data-lucide="circle-check" class="h-4 w-4"></i>
          One number
        </span>


            <span id="specialCheck" class="flex items-center gap-2">
          <i data-lucide="circle-check" class="h-4 w-4"></i>
          One special character
        </span>


          </div>

        </div>


      </div>


    </section>


    <!-- Bottom actions -->
    <div class="mt-8 flex justify-end rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700"
      >

        <i data-lucide="save" class="h-4 w-4"></i>

        Save changes

      </button>

    </div>


  <% end %>


</main>


<script>
    document.addEventListener("turbo:load", () => {

        const password = document.getElementById("password");

        if (!password) return;


        const checks = {
            length: document.getElementById("lengthCheck"),
            uppercase: document.getElementById("uppercaseCheck"),
            number: document.getElementById("numberCheck"),
            special: document.getElementById("specialCheck")
        };


        function updateCheck(element, valid) {

            if (valid) {
                element.classList.remove("text-slate-500");
                element.classList.add("text-emerald-600");
            } else {
                element.classList.remove("text-emerald-600");
                element.classList.add("text-slate-500");
            }

        }



        password.addEventListener("input", () => {

            const value = password.value;


            updateCheck(
                checks.length,
                value.length >= 8
            );


            updateCheck(
                checks.uppercase,
                /[A-Z]/.test(value)
            );


            updateCheck(
                checks.number,
                /\d/.test(value)
            );


            updateCheck(
                checks.special,
                /[^A-Za-z0-9]/.test(value)
            );


        });


    });
</script>