<%# app/views/business_agent/opening_hours/index.html.erb %>

<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Opening Hours
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        View the business opening hours, breaks and booking availability.
      </p>
    </div>


    <div class="inline-flex w-fit items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 shadow-sm">
      <i data-lucide="eye" class="h-4 w-4 text-indigo-600"></i>
      View only
    </div>

  </section>


  <!-- Flash messages -->
  <%= render "business_portal/shared/flash_messages" %>


  <!-- Information -->
  <section class="mt-8 flex flex-col gap-4 rounded-2xl border border-indigo-100 bg-indigo-50 p-5 sm:flex-row sm:items-center sm:justify-between">

    <div class="flex items-start gap-3">

      <div class="rounded-xl bg-indigo-100 p-2.5 text-indigo-600">
        <i data-lucide="info" class="h-5 w-5"></i>
      </div>

      <div>
        <h2 class="font-semibold text-indigo-950">
          Customer booking availability
        </h2>

        <p class="mt-1 text-sm leading-6 text-indigo-700">
          Customers can only book appointments during the opening hours shown below.
        </p>
      </div>

    </div>


    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-indigo-700 shadow-sm">
      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
      Business availability
    </span>

  </section>


  <!-- Main content -->
  <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1fr)_340px]">

    <!-- Weekly hours -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">

        <div class="flex items-center gap-3">

          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            <i data-lucide="calendar-days" class="h-5 w-5"></i>
          </div>

          <div>
            <h2 class="text-lg font-bold text-slate-900">
              Weekly Hours
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              The business's standard weekly availability.
            </p>
          </div>

        </div>

      </div>


      <div class="divide-y divide-slate-100">

        <% @opening_hours.each do |opening_hour| %>

          <div class="p-5 sm:px-6">

            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

              <!-- Day -->
              <div class="flex items-center gap-3">

                <div class="<%= opening_hour.open? ? 'bg-indigo-50 text-indigo-600' : 'bg-slate-100 text-slate-400' %> flex h-10 w-10 shrink-0 items-center justify-center rounded-xl">

                  <i
                    data-lucide="<%= opening_hour.open? ? 'calendar-check' : 'calendar-x' %>"
                    class="h-5 w-5"
                  ></i>

                </div>


                <div>

                  <p class="font-bold text-slate-900">
                    <%= opening_hour.day_name %>
                  </p>


                  <% if opening_hour.open? %>

                    <span class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      Open
                    </span>

                  <% else %>

                    <span class="mt-1 inline-flex items-center gap-1.5 text-xs font-semibold text-slate-400">
                      <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                      Closed
                    </span>

                  <% end %>

                </div>

              </div>


              <!-- Opening time -->
              <% if opening_hour.open? &&
                    opening_hour.opens_at.present? &&
                    opening_hour.closes_at.present? %>

                <div class="sm:text-right">

                  <div class="inline-flex items-center gap-2 rounded-xl bg-slate-50 px-4 py-2.5">

                    <i
                      data-lucide="clock-3"
                      class="h-4 w-4 text-slate-400"
                    ></i>

                    <span class="text-sm font-semibold text-slate-900">

                      <%= opening_hour.opens_at.strftime("%-I:%M %P") %>

                      <span class="mx-1 text-slate-400">
                        –
                      </span>

                      <%= opening_hour.closes_at.strftime("%-I:%M %P") %>

                    </span>

                  </div>

                </div>

              <% elsif opening_hour.open? %>

                <div class="inline-flex items-center gap-2 rounded-xl bg-amber-50 px-4 py-2.5 text-sm font-semibold text-amber-700">

                  <i data-lucide="triangle-alert" class="h-4 w-4"></i>

                  Hours not set

                </div>

              <% end %>

            </div>


            <!-- Breaks -->
            <% if opening_hour.open? && opening_hour.breaks.any? %>

              <div class="mt-4 border-t border-slate-100 pt-4">

                <div class="flex items-start gap-3">

                  <div class="mt-0.5 text-amber-500">
                    <i data-lucide="coffee" class="h-4 w-4"></i>
                  </div>


                  <div class="min-w-0 flex-1">

                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                      Breaks
                    </p>


                    <div class="mt-2 flex flex-wrap gap-2">

                      <% opening_hour.breaks.each do |break_record| %>

                        <% if break_record.starts_at.present? &&
                              break_record.ends_at.present? %>

                          <span class="inline-flex items-center gap-1.5 rounded-lg bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700">

                            <i
                              data-lucide="clock"
                              class="h-3.5 w-3.5"
                            ></i>

                            <%= break_record.starts_at.strftime("%-I:%M %P") %>

                            <span>–</span>

                            <%= break_record.ends_at.strftime("%-I:%M %P") %>

                          </span>

                        <% end %>

                      <% end %>

                    </div>

                  </div>

                </div>

              </div>

            <% end %>

          </div>

        <% end %>

      </div>

    </section>


    <!-- Sidebar -->
    <aside class="space-y-6">

      <!-- Booking settings -->
      <% if @booking_setting.present? %>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

          <div class="flex items-start justify-between gap-4">

            <div>
              <h2 class="text-lg font-bold text-slate-900">
                Booking Settings
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Current customer booking preferences.
              </p>
            </div>


            <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
              <i data-lucide="settings-2" class="h-5 w-5"></i>
            </div>

          </div>


          <div class="mt-5 divide-y divide-slate-100">

            <!-- Booking interval -->
            <div class="flex items-center justify-between gap-4 py-3 first:pt-0">

              <div class="flex items-center gap-2">

                <i
                  data-lucide="clock-3"
                  class="h-4 w-4 shrink-0 text-slate-400"
                ></i>

                <span class="text-sm text-slate-500">
                  Booking interval
                </span>

              </div>


              <span class="shrink-0 text-sm font-semibold text-slate-900">
                <%= pluralize(
                      @booking_setting.booking_interval_minutes,
                      "minute"
                    ) %>
              </span>

            </div>


            <!-- Minimum notice -->
            <div class="flex items-center justify-between gap-4 py-3">

              <div class="flex items-center gap-2">

                <i
                  data-lucide="timer"
                  class="h-4 w-4 shrink-0 text-slate-400"
                ></i>

                <span class="text-sm text-slate-500">
                  Minimum notice
                </span>

              </div>


              <span class="shrink-0 text-sm font-semibold text-slate-900">

                <% notice_minutes =
                     @booking_setting.minimum_notice_minutes.to_i %>

                <% if notice_minutes >= 1440 &&
                      (notice_minutes % 1440).zero? %>

                  <%= pluralize(
                        notice_minutes / 1440,
                        "day"
                      ) %>

                <% elsif notice_minutes >= 60 &&
                         (notice_minutes % 60).zero? %>

                  <%= pluralize(
                        notice_minutes / 60,
                        "hour"
                      ) %>

                <% else %>

                  <%= pluralize(
                        notice_minutes,
                        "minute"
                      ) %>

                <% end %>

              </span>

            </div>


            <!-- Advance booking -->
            <div class="flex items-center justify-between gap-4 py-3">

              <div class="flex items-center gap-2">

                <i
                  data-lucide="calendar-range"
                  class="h-4 w-4 shrink-0 text-slate-400"
                ></i>

                <span class="text-sm text-slate-500">
                  Book in advance
                </span>

              </div>


              <span class="shrink-0 text-sm font-semibold text-slate-900">
                <%= pluralize(
                      @booking_setting.advance_booking_days,
                      "day"
                    ) %>
              </span>

            </div>


            <!-- Buffer -->
            <div class="flex items-center justify-between gap-4 py-3 last:pb-0">

              <div class="flex items-center gap-2">

                <i
                  data-lucide="between-horizontal-start"
                  class="h-4 w-4 shrink-0 text-slate-400"
                ></i>

                <span class="text-sm text-slate-500">
                  Booking buffer
                </span>

              </div>


              <span class="shrink-0 text-sm font-semibold text-slate-900">

                <% if @booking_setting.buffer_minutes.to_i.positive? %>

                  <%= pluralize(
                        @booking_setting.buffer_minutes,
                        "minute"
                      ) %>

                <% else %>

                  None

                <% end %>

              </span>

            </div>

          </div>

        </section>

      <% end %>


      <!-- Weekly summary -->
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

        <div class="flex items-start justify-between gap-4">

          <div>

            <h2 class="text-lg font-bold text-slate-900">
              Weekly Summary
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-500">
              A quick overview of business availability.
            </p>

          </div>


          <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">

            <i
              data-lucide="calendar-range"
              class="h-5 w-5"
            ></i>

          </div>

        </div>


        <% open_days = @opening_hours.select(&:open?) %>


        <div class="mt-5">

          <p class="text-3xl font-bold tracking-tight text-slate-900">
            <%= open_days.count %>
          </p>

          <p class="mt-1 text-sm text-slate-500">
            <%= "day".pluralize(open_days.count) %> open each week
          </p>

        </div>


        <!-- Day indicators -->
        <div class="mt-5 flex flex-wrap gap-2">

          <% @opening_hours.each do |opening_hour| %>

            <div
              title="<%= opening_hour.day_name %> — <%= opening_hour.open? ? 'Open' : 'Closed' %>"
              class="<%= opening_hour.open? ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-400' %> flex h-9 w-9 items-center justify-center rounded-lg text-xs font-bold"
            >
              <%= opening_hour.day_name.first(2) %>
            </div>

          <% end %>

        </div>


        <!-- Open days -->
        <% if open_days.any? %>

          <div class="mt-5 border-t border-slate-100 pt-4">

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Open
            </p>


            <div class="mt-3 space-y-2">

              <% open_days.each do |opening_hour| %>

                <div class="flex items-center justify-between gap-3 text-sm">

                  <span class="font-medium text-slate-600">
                    <%= opening_hour.day_name %>
                  </span>


                  <% if opening_hour.opens_at.present? &&
                        opening_hour.closes_at.present? %>

                    <span class="text-xs font-semibold text-slate-900">

                      <%= opening_hour.opens_at.strftime("%-I:%M %P") %>

                      –

                      <%= opening_hour.closes_at.strftime("%-I:%M %P") %>

                    </span>

                  <% else %>

                    <span class="text-xs font-semibold text-amber-600">
                      Hours not set
                    </span>

                  <% end %>

                </div>

              <% end %>

            </div>

          </div>

        <% end %>

      </section>


      <!-- Read only notice -->
      <section class="rounded-2xl border border-indigo-100 bg-indigo-50 p-5">

        <div class="flex items-start gap-3">

          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm">

            <i
              data-lucide="eye"
              class="h-4 w-4"
            ></i>

          </div>


          <div>

            <h3 class="text-sm font-semibold text-indigo-950">
              View only
            </h3>

            <p class="mt-1 text-sm leading-6 text-indigo-700">
              Opening hours and booking availability are managed by the business.
            </p>

          </div>

        </div>

      </section>

    </aside>

  </div>

</main>