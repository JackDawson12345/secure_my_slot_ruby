<main class="min-h-screen bg-slate-50">
  <section class="relative overflow-hidden py-12 sm:py-16 lg:py-20">
    <!-- Background decoration -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[520px] bg-gradient-to-b from-indigo-50 via-slate-50 to-transparent"
    ></div>

    <div
      class="pointer-events-none absolute -left-32 top-24 h-80 w-80 rounded-full bg-indigo-200/40 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -right-32 top-16 h-80 w-80 rounded-full bg-violet-200/40 blur-3xl"
    ></div>

    <div
      class="relative mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start lg:px-8"
    >
      <!-- Left content -->
      <aside class="lg:sticky lg:top-28">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm"
        >
          <i data-lucide="user-round" class="h-4 w-4"></i>
          Customer account
        </span>

        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Book appointments
          <span class="text-indigo-600">with ease.</span>
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
          Create your SecureMySlot customer account to manage your appointments,
          booking information and account preferences.
        </p>

        <div class="mt-8 space-y-5">
          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600"
            >
              <i data-lucide="calendar-check-2" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                Manage your appointments
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                View your upcoming and previous bookings from one simple
                dashboard.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-600"
            >
              <i data-lucide="clock-3" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                Book available times
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Choose a service and select an appointment time that works for
                you.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600"
            >
              <i data-lucide="bell-ring" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                Receive booking updates
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Keep track of confirmations, cancellations and appointment
                reminders.
              </p>
            </div>
          </div>
        </div>

        <div
          class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
        >
          <div class="flex items-start gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-950 text-white"
            >
              <i data-lucide="shield-check" class="h-5 w-5"></i>
            </span>

            <div>
              <p class="font-bold text-slate-900">
                Your details are protected
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Your account information is securely stored and can be updated
                from your customer dashboard.
              </p>
            </div>
          </div>
        </div>

        <p class="mt-6 text-sm text-slate-500">
          Already have an account?

          <%= link_to "Sign in",
                      new_user_session_path,
                      class: "font-semibold text-indigo-600 transition hover:text-indigo-700" %>
        </p>
      </aside>

      <!-- Registration form -->
      <div
        class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60"
      >
        <div class="border-b border-slate-200 px-5 py-6 sm:px-8">
          <div class="flex items-start gap-4">
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-600 text-white"
            >
              <i data-lucide="user-plus" class="h-6 w-6"></i>
            </span>

            <div>
              <h2 class="text-2xl font-bold tracking-tight text-slate-950">
                Create your customer account
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Enter your details below to get started.
              </p>
            </div>
          </div>
        </div>

        <%= form_for(
              resource,
              as: resource_name,
              url: registration_path(resource_name),
              html: {
                class: "divide-y divide-slate-200"
              }
            ) do |f| %>

          <% if resource.errors.any? %>
            <div class="m-5 rounded-xl border border-rose-200 bg-rose-50 p-4 sm:m-8">
              <div class="flex items-start gap-3">
                <i
                  data-lucide="circle-alert"
                  class="mt-0.5 h-5 w-5 shrink-0 text-rose-600"
                ></i>

                <div>
                  <p class="text-sm font-bold text-rose-900">
                    Please correct the following errors:
                  </p>

                  <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-rose-700">
                    <% resource.errors.full_messages.uniq.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Personal details -->
          <fieldset class="p-5 sm:p-8">
            <div class="mb-6">
              <legend class="text-lg font-bold text-slate-950">
                Your details
              </legend>

              <p class="mt-1 text-sm text-slate-500">
                Add the contact details that will be used for your bookings.
              </p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <%= f.label :first_name,
                            "First name",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <%= f.text_field :first_name,
                                 autofocus: true,
                                 autocomplete: "given-name",
                                 placeholder: "Enter your first name",
                                 required: true,
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>

              <div>
                <%= f.label :last_name,
                            "Last name",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <%= f.text_field :last_name,
                                 autocomplete: "family-name",
                                 placeholder: "Enter your last name",
                                 required: true,
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>

              <div class="sm:col-span-2">
                <%= f.label :email,
                            "Email address",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <div class="relative">
                  <i
                    data-lucide="mail"
                    class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                  ></i>

                  <%= f.email_field :email,
                                    autocomplete: "email",
                                    placeholder: "you@example.com",
                                    required: true,
                                    class: "w-full rounded-xl border border-slate-200 py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
                </div>
              </div>

              <div class="sm:col-span-2">
                <%= f.label :phone_number,
                            "Phone number",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <div class="relative">
                  <i
                    data-lucide="phone"
                    class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                  ></i>

                  <%= f.telephone_field :phone_number,
                                        autocomplete: "tel",
                                        placeholder: "Enter your phone number",
                                        required: true,
                                        class: "w-full rounded-xl border border-slate-200 py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
                </div>

                <p class="mt-2 text-xs leading-5 text-slate-500">
                  Businesses may use this number to contact you about your
                  appointments.
                </p>
              </div>
            </div>
          </fieldset>

          <!-- Password -->
          <fieldset class="p-5 sm:p-8">
            <div class="mb-6">
              <legend class="text-lg font-bold text-slate-950">
                Create a password
              </legend>

              <p class="mt-1 text-sm text-slate-500">
                Choose a secure password for your customer account.
              </p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <%= f.label :password,
                            "Password",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <div class="relative">
                  <%= f.password_field :password,
                                       autocomplete: "new-password",
                                       placeholder: "Create a password",
                                       minlength: @minimum_password_length,
                                       required: true,
                                       class: "w-full rounded-xl border border-slate-200 py-3 pl-4 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

                  <button
                    type="button"
                    data-password-toggle="user_password"
                    aria-label="Show password"
                    class="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                  >
                    <i data-lucide="eye" class="h-4 w-4"></i>
                  </button>
                </div>
              </div>

              <div>
                <%= f.label :password_confirmation,
                            "Confirm password",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <div class="relative">
                  <%= f.password_field :password_confirmation,
                                       autocomplete: "new-password",
                                       placeholder: "Repeat your password",
                                       minlength: @minimum_password_length,
                                       required: true,
                                       class: "w-full rounded-xl border border-slate-200 py-3 pl-4 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

                  <button
                    type="button"
                    data-password-toggle="user_password_confirmation"
                    aria-label="Show password confirmation"
                    class="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                  >
                    <i data-lucide="eye" class="h-4 w-4"></i>
                  </button>
                </div>
              </div>
            </div>

            <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-sm font-semibold text-slate-900">
                Your password should include:
              </p>

              <div class="mt-3 grid gap-2 text-sm text-slate-500 sm:grid-cols-2">
                <span class="flex items-center gap-2">
                  <i
                    data-lucide="circle-check"
                    class="h-4 w-4 text-emerald-500"
                  ></i>

                  At least <%= @minimum_password_length || 8 %> characters
                </span>

                <span class="flex items-center gap-2">
                  <i
                    data-lucide="circle-check"
                    class="h-4 w-4 text-emerald-500"
                  ></i>

                  One uppercase letter
                </span>

                <span class="flex items-center gap-2">
                  <i
                    data-lucide="circle-check"
                    class="h-4 w-4 text-emerald-500"
                  ></i>

                  One number
                </span>

                <span class="flex items-center gap-2">
                  <i
                    data-lucide="circle-check"
                    class="h-4 w-4 text-emerald-500"
                  ></i>

                  One special character
                </span>
              </div>
            </div>
          </fieldset>

          <!-- Terms and submit -->
          <div class="p-5 sm:p-8">
            <label class="flex cursor-pointer items-start gap-3">
              <%= check_box_tag "user[terms_accepted]",
                                "1",
                                params.dig(:user, :terms_accepted) == "1",
                                required: true,
                                class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>

              <span class="text-sm leading-6 text-slate-600">
                I agree to the

                <%= link_to "Terms of Service",
                            "#",
                            class: "font-semibold text-indigo-600 transition hover:text-indigo-700" %>

                and

                <%= link_to "Privacy Policy",
                            "#",
                            class: "font-semibold text-indigo-600 transition hover:text-indigo-700" %>.
              </span>
            </label>

            <label class="mt-4 flex cursor-pointer items-start gap-3">
              <%= check_box_tag "user[marketing_consent]",
                                "1",
                                params.dig(:user, :marketing_consent) == "1",
                                class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>

              <span class="text-sm leading-6 text-slate-600">
                Send me occasional booking tips and SecureMySlot updates.
              </span>
            </label>

            <%= f.button type: :submit,
                         class: "mt-7 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
              Create customer account

              <i data-lucide="arrow-right" class="h-4 w-4"></i>
            <% end %>

            <p class="mt-5 text-center text-sm text-slate-500">
              Already registered?

              <%= link_to "Sign in to your account",
                          new_user_session_path,
                          class: "font-semibold text-indigo-600 transition hover:text-indigo-700" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</main>

<script>
    function initialiseCustomerSignUp() {
        if (window.lucide) {
            lucide.createIcons();
        }

        document
            .querySelectorAll("[data-password-toggle]")
            .forEach((button) => {
                if (button.dataset.initialised === "true") return;

                button.dataset.initialised = "true";

                button.addEventListener("click", () => {
                    const inputId = button.dataset.passwordToggle;
                    const input = document.getElementById(inputId);

                    if (!input) return;

                    const showingPassword = input.type === "text";

                    input.type = showingPassword
                        ? "password"
                        : "text";

                    button.setAttribute(
                        "aria-label",
                        showingPassword
                            ? "Show password"
                            : "Hide password"
                    );

                    button.innerHTML = showingPassword
                        ? '<i data-lucide="eye" class="h-4 w-4"></i>'
                        : '<i data-lucide="eye-off" class="h-4 w-4"></i>';

                    if (window.lucide) {
                        lucide.createIcons();
                    }
                });
            });
    }

    document.addEventListener(
        "DOMContentLoaded",
        initialiseCustomerSignUp
    );

    document.addEventListener(
        "turbo:load",
        initialiseCustomerSignUp
    );
</script>