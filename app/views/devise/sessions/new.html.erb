<main class="min-h-screen bg-slate-50">
  <section class="relative overflow-hidden py-12 sm:py-16 lg:py-20">
    <!-- Background decoration -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[520px] bg-gradient-to-b from-indigo-50 via-slate-50 to-transparent"
    ></div>

    <div
      class="pointer-events-none absolute -left-32 top-24 h-80 w-80 rounded-full bg-indigo-200/40 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -right-32 top-16 h-80 w-80 rounded-full bg-violet-200/40 blur-3xl"
    ></div>

    <div
      class="relative mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:px-8"
    >
      <!-- Left content -->
      <aside>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm"
        >
          <i data-lucide="log-in" class="h-4 w-4"></i>
          Secure account access
        </span>

        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Welcome back to
          <span class="text-indigo-600">SecureMySlot.</span>
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
          Sign in to manage your appointments, customers, services and account
          settings.
        </p>

        <div class="mt-8 space-y-5">
          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600"
            >
              <i data-lucide="calendar-check-2" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                View your bookings
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Access upcoming appointments and review previous bookings from
                your dashboard.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-600"
            >
              <i data-lucide="settings-2" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                Manage your account
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Update your contact details, preferences and account settings.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600"
            >
              <i data-lucide="building-2" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                One sign-in for every account
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Customers and businesses can securely access their account from
                the same sign-in page.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start gap-3">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-950 text-white"
            >
              <i data-lucide="shield-check" class="h-5 w-5"></i>
            </span>

            <div>
              <p class="font-bold text-slate-900">
                Secure account access
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Your login details are securely protected and should never be
                shared with anyone.
              </p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Sign-in form -->
      <div
        class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60"
      >
        <div class="border-b border-slate-200 px-5 py-6 sm:px-8">
          <div class="flex items-start gap-4">
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-600 text-white"
            >
              <i data-lucide="lock-keyhole" class="h-6 w-6"></i>
            </span>

            <div>
              <h2 class="text-2xl font-bold tracking-tight text-slate-950">
                Sign in to your account
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Enter your email address and password to continue.
              </p>
            </div>
          </div>
        </div>

        <%= form_for(
              resource,
              as: resource_name,
              url: session_path(resource_name),
              html: {
                class: "p-5 sm:p-8"
              }
            ) do |f| %>

          <% if flash[:alert].present? %>
            <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4">
              <div class="flex items-start gap-3">
                <i
                  data-lucide="circle-alert"
                  class="mt-0.5 h-5 w-5 shrink-0 text-rose-600"
                ></i>

                <p class="text-sm font-medium leading-6 text-rose-700">
                  <%= flash[:alert] %>
                </p>
              </div>
            </div>
          <% end %>

          <% if flash[:notice].present? %>
            <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
              <div class="flex items-start gap-3">
                <i
                  data-lucide="circle-check"
                  class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600"
                ></i>

                <p class="text-sm font-medium leading-6 text-emerald-700">
                  <%= flash[:notice] %>
                </p>
              </div>
            </div>
          <% end %>

          <div>
            <%= f.label :email,
                        "Email address",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

            <div class="relative">
              <i
                data-lucide="mail"
                class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
              ></i>

              <%= f.email_field :email,
                                autofocus: true,
                                autocomplete: "email",
                                placeholder: "you@example.com",
                                required: true,
                                class: "w-full rounded-xl border border-slate-200 py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
            </div>
          </div>

          <div class="mt-5">
            <div class="mb-2 flex items-center justify-between gap-4">
              <%= f.label :password,
                          "Password",
                          class: "block text-sm font-semibold text-slate-700" %>

              <%= link_to "Forgot your password?",
                          new_password_path(resource_name),
                          class: "text-sm font-semibold text-indigo-600 transition hover:text-indigo-700" %>
            </div>

            <div class="relative">
              <%= f.password_field :password,
                                   autocomplete: "current-password",
                                   placeholder: "Enter your password",
                                   required: true,
                                   class: "w-full rounded-xl border border-slate-200 py-3 pl-4 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

              <button
                type="button"
                data-password-toggle="user_password"
                aria-label="Show password"
                class="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
              >
                <i data-lucide="eye" class="h-4 w-4"></i>
              </button>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <label class="mt-5 flex cursor-pointer items-center gap-3">
              <%= f.check_box :remember_me,
                              class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>

              <span class="text-sm text-slate-600">
                Keep me signed in
              </span>
            </label>
          <% end %>

          <%= f.button type: :submit,
                       class: "mt-7 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
            Sign in
            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          <% end %>

          <div class="my-7 flex items-center gap-4">
            <div class="h-px flex-1 bg-slate-200"></div>

            <span class="text-xs font-medium uppercase tracking-wider text-slate-400">
              New to SecureMySlot?
            </span>

            <div class="h-px flex-1 bg-slate-200"></div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <%= link_to new_user_registration_path,
                        class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700" do %>
              <i data-lucide="user-plus" class="h-4 w-4"></i>
              Customer sign-up
            <% end %>

            <%= link_to business_sign_up_path,
                        class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700" do %>
              <i data-lucide="briefcase-business" class="h-4 w-4"></i>
              Business sign-up
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</main>

<script>
    function initialiseSignIn() {
        if (window.lucide) {
            lucide.createIcons();
        }

        document
            .querySelectorAll("[data-password-toggle]")
            .forEach((button) => {
                if (button.dataset.initialised === "true") return;

                button.dataset.initialised = "true";

                button.addEventListener("click", () => {
                    const inputId = button.dataset.passwordToggle;
                    const input = document.getElementById(inputId);

                    if (!input) return;

                    const showingPassword = input.type === "text";

                    input.type = showingPassword
                        ? "password"
                        : "text";

                    button.setAttribute(
                        "aria-label",
                        showingPassword
                            ? "Show password"
                            : "Hide password"
                    );

                    button.innerHTML = showingPassword
                        ? '<i data-lucide="eye" class="h-4 w-4"></i>'
                        : '<i data-lucide="eye-off" class="h-4 w-4"></i>';

                    if (window.lucide) {
                        lucide.createIcons();
                    }
                });
            });
    }

    document.addEventListener(
        "DOMContentLoaded",
        initialiseSignIn
    );

    document.addEventListener(
        "turbo:load",
        initialiseSignIn
    );
</script>