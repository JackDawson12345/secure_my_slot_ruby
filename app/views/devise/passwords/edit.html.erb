<main class="min-h-screen bg-slate-50">
  <section class="relative overflow-hidden py-12 sm:py-16 lg:py-20">

    <!-- Background decoration -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[520px] bg-gradient-to-b from-indigo-50 via-slate-50 to-transparent"
    ></div>

    <div
      class="pointer-events-none absolute -left-32 top-24 h-80 w-80 rounded-full bg-indigo-200/40 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -right-32 top-16 h-80 w-80 rounded-full bg-violet-200/40 blur-3xl"
    ></div>


    <div
      class="relative mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:px-8"
    >

      <!-- Left content -->
      <aside>

        <span
          class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm"
        >
          <i data-lucide="shield-keyhole" class="h-4 w-4"></i>
          Create a new password
        </span>


        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Secure your
          <span class="text-indigo-600">account.</span>
        </h1>


        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
          Choose a new password for your SecureMySlot account.
          Once updated, you can use it the next time you sign in.
        </p>


        <div class="mt-8 space-y-5">

          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600"
            >
              <i data-lucide="key-round" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                Choose a strong password
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Use a password that is difficult to guess and that you
                do not use for other accounts.
              </p>
            </div>
          </div>


          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-600"
            >
              <i data-lucide="check-check" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                Confirm your new password
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Enter your new password twice so we can make sure
                everything has been entered correctly.
              </p>
            </div>
          </div>


          <div class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600"
            >
              <i data-lucide="log-in" class="h-5 w-5"></i>
            </span>

            <div>
              <h2 class="font-bold text-slate-900">
                Continue securely
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                After changing your password, your new details will be
                used for future SecureMySlot sign-ins.
              </p>
            </div>
          </div>

        </div>


        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start gap-3">

            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-950 text-white"
            >
              <i data-lucide="shield-check" class="h-5 w-5"></i>
            </span>

            <div>
              <p class="font-bold text-slate-900">
                Keep your account protected
              </p>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Never share your password or password reset link with
                anyone else.
              </p>
            </div>

          </div>
        </div>

      </aside>


      <!-- Change password form -->
      <div
        class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60"
      >

        <div class="border-b border-slate-200 px-5 py-6 sm:px-8">

          <div class="flex items-start gap-4">

            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-600 text-white"
            >
              <i data-lucide="lock-keyhole" class="h-6 w-6"></i>
            </span>

            <div>

              <h2 class="text-2xl font-bold tracking-tight text-slate-950">
                Change your password
              </h2>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Enter and confirm the new password for your account.
              </p>

            </div>

          </div>

        </div>


        <%= form_for(
              resource,
              as: resource_name,
              url: password_path(resource_name),
              html: {
                method: :put,
                class: "p-5 sm:p-8"
              }
            ) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <%= f.hidden_field :reset_password_token %>


          <div>

            <div class="mb-2 flex items-center justify-between gap-4">

              <%= f.label :password,
                          "New password",
                          class: "block text-sm font-semibold text-slate-700" %>

              <% if @minimum_password_length %>
                <span class="text-xs font-medium text-slate-400">
                  <%= @minimum_password_length %> characters minimum
                </span>
              <% end %>

            </div>


            <div class="relative">

              <%= f.password_field :password,
                                   autofocus: true,
                                   autocomplete: "new-password",
                                   placeholder: "Enter your new password",
                                   required: true,
                                   class: "w-full rounded-xl border border-slate-200 py-3 pl-4 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

              <button
                type="button"
                data-password-toggle="user_password"
                aria-label="Show password"
                class="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
              >
                <i data-lucide="eye" class="h-4 w-4"></i>
              </button>

            </div>

          </div>


          <div class="mt-5">

            <%= f.label :password_confirmation,
                        "Confirm new password",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>


            <div class="relative">

              <%= f.password_field :password_confirmation,
                                   autocomplete: "new-password",
                                   placeholder: "Confirm your new password",
                                   required: true,
                                   class: "w-full rounded-xl border border-slate-200 py-3 pl-4 pr-12 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

              <button
                type="button"
                data-password-toggle="user_password_confirmation"
                aria-label="Show password"
                class="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
              >
                <i data-lucide="eye" class="h-4 w-4"></i>
              </button>

            </div>

          </div>


          <%= f.button type: :submit,
                       class: "mt-7 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>

            Change my password

            <i data-lucide="arrow-right" class="h-4 w-4"></i>

          <% end %>


          <div class="my-7 flex items-center gap-4">

            <div class="h-px flex-1 bg-slate-200"></div>

            <span class="text-xs font-medium uppercase tracking-wider text-slate-400">
              Back to your account
            </span>

            <div class="h-px flex-1 bg-slate-200"></div>

          </div>


          <%= link_to new_session_path(resource_name),
                      class: "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700" do %>

            <i data-lucide="arrow-left" class="h-4 w-4"></i>

            Back to sign in

          <% end %>

        <% end %>

      </div>

    </div>

  </section>
</main>


<script>
    function initialisePasswordChange() {
        if (window.lucide) {
            lucide.createIcons();
        }

        document
            .querySelectorAll("[data-password-toggle]")
            .forEach((button) => {

                if (button.dataset.initialised === "true") return;

                button.dataset.initialised = "true";

                button.addEventListener("click", () => {

                    const inputId =
                        button.dataset.passwordToggle;

                    const input =
                        document.getElementById(inputId);

                    if (!input) return;


                    const showingPassword =
                        input.type === "text";


                    input.type =
                        showingPassword
                            ? "password"
                            : "text";


                    button.setAttribute(
                        "aria-label",
                        showingPassword
                            ? "Show password"
                            : "Hide password"
                    );


                    button.innerHTML =
                        showingPassword
                            ? '<i data-lucide="eye" class="h-4 w-4"></i>'
                            : '<i data-lucide="eye-off" class="h-4 w-4"></i>';


                    if (window.lucide) {
                        lucide.createIcons();
                    }

                });
            });
    }


    document.addEventListener(
        "DOMContentLoaded",
        initialisePasswordChange
    );

    document.addEventListener(
        "turbo:load",
        initialisePasswordChange
    );
</script>