<!DOCTYPE html>
<html>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: Arial, sans-serif; color: #0f172a;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; padding: 40px 20px;">
  <tr>
    <td align="center">

      <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden;">

        <tr>
          <td style="padding: 32px;">

            <h1 style="margin: 0 0 16px; font-size: 26px; line-height: 1.3;">
              Your agreement is ready to sign
            </h1>

            <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #475569;">
              Your agreement has been prepared and is now ready for you to review and sign.
            </p>


            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-radius: 10px; margin-bottom: 24px;">

              <tr>
                <td style="padding: 24px;">

                  <h2 style="margin: 0 0 18px; font-size: 18px;">
                    Agreement details
                  </h2>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    Please take the time to review the agreement carefully before signing.
                  </p>

                  <p style="margin: 0; font-size: 15px; color: #475569;">
                    Once signed, the agreement will be securely stored and confirmed.
                  </p>

                </td>
              </tr>

            </table>


            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 24px;">

              <tr>
                <td align="center">

                  <% byebug %>

                  <a href="<%= "http://" + @business.page_address + ".securemyslot.co.uk/agreement-form?token=" + @agreement_status.token %>" style="display: inline-block; background-color: #0f172a; color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-size: 16px; font-weight: bold;">
                    Review and Sign Agreement
                  </a>

                </td>
              </tr>

            </table>


            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #475569;">
              If you have any questions about the agreement or need any assistance, please contact us before signing.
            </p>

          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>
</body>
</html>