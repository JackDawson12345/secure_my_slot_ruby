<!DOCTYPE html>
<html>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: Arial, sans-serif; color: #0f172a;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; padding: 40px 20px;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden;">
        <tr>
          <td style="padding: 32px;">

            <h1 style="margin: 0 0 16px; font-size: 26px; line-height: 1.3;">
              Payment received
            </h1>

            <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #475569;">
              Thank you. Your payment to <strong><%= @business.business_name %></strong> has been received successfully.
            </p>

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f0fdf4; border-radius: 10px; margin-bottom: 20px;">
              <tr>
                <td style="padding: 24px;">

                  <h2 style="margin: 0 0 10px; font-size: 18px; color: #166534;">
                    Payment confirmed
                  </h2>

                  <p style="margin: 0; font-size: 24px; font-weight: bold; color: #166534;">
                    £<%= number_with_precision(@payment_amount, precision: 2) %>
                  </p>

                </td>
              </tr>
            </table>

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-radius: 10px; margin-bottom: 24px;">
              <tr>
                <td style="padding: 24px;">

                  <h2 style="margin: 0 0 18px; font-size: 18px;">
                    Booking details
                  </h2>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Service:</strong>
                    <%= @booking.service.name %>
                  </p>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Date:</strong>
                    <%= @booking.date.strftime("%A, %d %B %Y") %>
                  </p>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Time:</strong>
                    <%= @booking.time.strftime("%H:%M") %>
                  </p>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Total booking price:</strong>
                    £<%= number_with_precision(@booking.amount, precision: 2) %>
                  </p>

                  <p style="margin: 0; font-size: 15px; color: #475569;">
                    <strong>Total paid:</strong>
                    £<%= number_with_precision(@booking.amount_paid, precision: 2) %>
                  </p>

                </td>
              </tr>
            </table>

            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #475569;">
              Your payment has been recorded against your booking.
            </p>

          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>