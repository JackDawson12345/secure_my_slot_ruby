<section class="flex min-h-screen items-center justify-center bg-slate-50 px-5 py-16">
  <div class="w-full max-w-xl rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-xl sm:p-12">

    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
      <svg
        class="h-8 w-8"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m5 13 4 4L19 7"
          />
      </svg>
    </div>

    <h1 class="mt-6 text-3xl font-black text-slate-900">
      <% if @booking.payment_status == "paid" %>
        Payment completed
      <% else %>
        Booking confirmed
      <% end %>
    </h1>

    <p class="mt-4 text-lg leading-8 text-slate-600">
      <% if @booking.payment_status == "paid" %>
        Your payment has been received and your appointment has been booked.
      <% else %>
        Your appointment has been booked successfully. No online payment was required.
      <% end %>
    </p>

    <div class="mt-8 rounded-2xl bg-slate-50 p-6 text-left">

      <div class="flex justify-between gap-4 border-b border-slate-200 pb-4">
        <span class="text-slate-500">
          Service
        </span>

        <span class="text-right font-bold text-slate-900">
          <%= @booking.service.name %>
        </span>
      </div>

      <div class="flex justify-between gap-4 border-b border-slate-200 py-4">
        <span class="text-slate-500">
          Date
        </span>

        <span class="text-right font-bold text-slate-900">
          <%= @booking.date.strftime("%d %B %Y") %>
        </span>
      </div>

      <div class="flex justify-between gap-4 border-b border-slate-200 py-4">
        <span class="text-slate-500">
          Time
        </span>

        <span class="text-right font-bold text-slate-900">
          <%= @booking.time.strftime("%I:%M %p") %>
        </span>
      </div>

      <div class="flex justify-between gap-4 border-b border-slate-200 py-4">
        <span class="text-slate-500">
          Duration
        </span>

        <span class="text-right font-bold text-slate-900">
          <%= @booking.service.minutes_duration %> minutes
        </span>
      </div>

      <div class="flex justify-between gap-4 border-b border-slate-200 py-4">
        <span class="text-slate-500">
          Service price
        </span>

        <span class="text-right font-bold text-slate-900">
          <%= number_to_currency(
                @booking.service.price,
                unit: "£"
              ) %>
        </span>
      </div>

      <% if @booking.payment_status == "paid" %>
        <div class="flex justify-between gap-4 border-b border-slate-200 py-4">
          <span class="text-slate-500">
            Amount paid
          </span>

          <span class="text-right font-bold text-emerald-600">
            <%= number_to_currency(
                  @booking.amount_paid || 0,
                  unit: "£"
                ) %>
          </span>
        </div>

        <% if @booking.service.deposit_enabled? && @booking.service.deposit.to_d.positive? %>
          <% remaining_balance =
               [
                 @booking.service.price.to_d - @booking.amount_paid.to_d,
                 0
               ].max %>

          <div class="flex justify-between gap-4 pt-4">
            <span class="text-slate-500">
              Remaining balance
            </span>

            <span class="text-right font-bold text-slate-900">
              <%= number_to_currency(
                    remaining_balance,
                    unit: "£"
                  ) %>
            </span>
          </div>
        <% else %>
          <div class="flex justify-between gap-4 pt-4">
            <span class="text-slate-500">
              Payment status
            </span>

            <span class="text-right font-bold text-emerald-600">
              Paid
            </span>
          </div>
        <% end %>

      <% else %>

        <div class="flex justify-between gap-4 pt-4">
          <span class="text-slate-500">
            Payment
          </span>

          <span class="text-right font-bold text-slate-900">
            <% if @booking.service.price.to_d.zero? %>
              No payment required
            <% else %>
              Pay directly to the business
            <% end %>
          </span>
        </div>

      <% end %>

    </div>

    <% if @booking.status == "confirmed" %>
      <div class="mt-6 rounded-2xl bg-emerald-50 p-4 text-left">
        <div class="flex items-start gap-3">
          <svg
            class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m5 13 4 4L19 7"
              />
          </svg>

          <div>
            <p class="font-bold text-emerald-900">
              Appointment confirmed
            </p>

            <p class="mt-1 text-sm leading-6 text-emerald-700">
              Your appointment has been confirmed by
              <%= @booking.business.business_name %>.
            </p>
          </div>
        </div>
      </div>

    <% elsif @booking.status == "pending" %>

      <div class="mt-6 rounded-2xl bg-amber-50 p-4 text-left">
        <div class="flex items-start gap-3">
          <svg
            class="mt-0.5 h-5 w-5 shrink-0 text-amber-600"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="9"/>
            <path
              stroke-linecap="round"
              d="M12 7v5l3 2"
              />
          </svg>

          <div>
            <p class="font-bold text-amber-900">
              Booking request received
            </p>

            <p class="mt-1 text-sm leading-6 text-amber-700">
              Your booking has been submitted and is waiting for confirmation from
              <%= @booking.business.business_name %>.
            </p>
          </div>
        </div>
      </div>

    <% end %>

    <%= link_to "Return to booking page",
                business_site_url(
                  subdomain: @booking.business.page_address
                ),
                class: "mt-8 inline-flex rounded-2xl bg-blue-500 px-6 py-4 font-bold text-white transition hover:bg-blue-600" %>

  </div>
</section>