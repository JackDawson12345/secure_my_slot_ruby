<h2>Application Error</h2>

<h3>Error</h3>
<p>
  <%= @exception.class %>
</p>

<p>
  <%= @exception.message %>
</p>


<h3>URL</h3>

<p>
  <%= @request.original_url %>
</p>


<h3>User</h3>

<% if @user %>

  <p>
    ID: <%= @user.id %><br>
    Email: <%= @user.email %><br>
    Role: <%= @user.role %>
  </p>

<% else %>

  <p>
    Guest user
  </p>

<% end %>


<h3>Backtrace</h3>

<pre>
  <%= @exception.backtrace.first(20).join("\n") %>
</pre>