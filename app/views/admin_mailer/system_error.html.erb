<h2>Application Error</h2>

<h3>Error</h3>

<p>
  <strong>Type:</strong>
  <%= @exception[:class] %>
</p>

<p>
  <strong>Message:</strong>
  <%= @exception[:message] %>
</p>


<h3>URL</h3>

<p>
  <%= @request[:url] %>
</p>


<h3>Request Details</h3>

<p>
  <strong>Method:</strong>
  <%= @request[:method] %>
</p>

<p>
  <strong>Request ID:</strong>
  <%= @request[:request_id] %>
</p>

<p>
  <strong>IP:</strong>
  <%= @request[:ip] %>
</p>


<h3>User</h3>

<% if @user %>

  <p>
    ID: <%= @user[:id] %><br>
    Email: <%= @user[:email] %><br>
    Role: <%= @user[:role] %>
  </p>

<% else %>

  <p>
    Guest user
  </p>

<% end %>


<h3>Backtrace</h3>

<pre>
  <%= @exception[:backtrace].join("\n") %>
</pre>