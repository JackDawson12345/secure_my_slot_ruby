<!-- Booking history content -->
<main class="p-4 sm:p-6 lg:p-8">
  <!-- Page heading -->
  <section
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Booking History
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        View completed and cancelled appointments from your account.
      </p>
    </div>
  </section>

  <!-- Summary cards -->
  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Total bookings -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Previous Bookings
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @total_bookings.to_s %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="history" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <% if @first_booking %>
          Since <%= @first_booking.date.strftime("%B %Y") %>
        <% else %>
          No bookings yet
        <% end %>
      </p>
    </article>

    <!-- Completed -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Completed
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @bookings_completed.to_s %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="circle-check-big" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <%= @completion_rate %>% completion rate
      </p>
    </article>

    <!-- Cancelled -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Cancelled
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @bookings_canceled.to_s %>
          </p>
        </div>

        <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
          <i data-lucide="calendar-x" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <%= @bookings_canceled %> cancelled appointment<%= "s" unless @bookings_canceled == 1 %>
      </p>
    </article>

    <!-- Total spent -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Total Spent
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= number_to_currency(@total_spent, unit: "£") %>
          </p>
        </div>

        <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
          <i data-lucide="wallet-cards" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Across Previous Bookings
      </p>
    </article>
  </section>

  <!-- Most booked service -->
  <% if @most_booked_service.present? %>
    <section
      class="mt-8 overflow-hidden rounded-2xl bg-slate-950 p-5 text-white shadow-sm sm:p-6"
    >
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="flex items-start gap-4">
          <div class="rounded-2xl bg-white/10 p-4">
            <i data-lucide="sparkles" class="h-6 w-6 text-indigo-300"></i>
          </div>

          <div>
            <p class="text-sm font-medium text-slate-400">
              Your most booked service
            </p>

            <h3 class="mt-1 text-xl font-bold">
              <%= @most_booked_service[:name] %>
            </h3>

            <p class="mt-2 text-sm leading-6 text-slate-300">
              You have booked this service <%= @most_booked_service[:count] %> time<%= "s" unless @most_booked_service[:count] == 1 %>, most recently on
              <%= @most_booked_service[:last_booked_on].strftime("%-d %B %Y") %>.
            </p>
          </div>
        </div>

        <a
          href="#"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:bg-slate-100 sm:w-auto"
        >
          <i data-lucide="refresh-cw" class="h-4 w-4"></i>
          Book this service again
        </a>
      </div>
    </section>
  <% end %>

  <!-- Booking history panel -->
  <section
    class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  >
    <!-- Search and filters -->
    <div class="border-b border-slate-200 p-5 sm:p-6">
      <%= form_with url: account_booking_history_path, method: :get, local: true,
                    class: "flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between" do |f| %>
        <div>
          <h3 class="text-lg font-bold text-slate-900">
            Previous appointments
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Search and filter your completed or cancelled bookings.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 xl:flex">
          <!-- Search -->
          <div class="relative sm:col-span-2 xl:w-64">
            <i
              data-lucide="search"
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
            ></i>

            <%= f.text_field :query,
                             value: @query,
                             placeholder: "Search booking history...",
                             type: "search",
                             class: "w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
          </div>

          <!-- Status -->
          <%= f.select :status,
                       options_for_select(
                         ["All statuses"] + Account::BookingHistoryController::STATUS_OPTIONS,
                         @status || "All statuses"
                       ),
                       {},
                       class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100",
                       onchange: "this.form.requestSubmit()" %>

          <!-- Date -->
          <%= f.select :date_range,
                       options_for_select(
                         ["All dates"] + Account::BookingHistoryController::DATE_RANGE_OPTIONS,
                         @date_range || "All dates"
                       ),
                       {},
                       class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100",
                       onchange: "this.form.requestSubmit()" %>
        </div>
      <% end %>

      <!-- Active filters -->
      <% if @query.present? || @status.present? || @date_range.present? %>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-slate-500">
            Active filters:
          </span>

          <% if @query.present? %>
            <%= link_to account_booking_history_path(status: @status, date_range: @date_range),
                        class: "inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700" do %>
              &ldquo;<%= @query %>&rdquo;
              <i data-lucide="x" class="h-3.5 w-3.5"></i>
            <% end %>
          <% end %>

          <% if @status.present? %>
            <%= link_to account_booking_history_path(query: @query, date_range: @date_range),
                        class: "inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700" do %>
              <%= @status %>
              <i data-lucide="x" class="h-3.5 w-3.5"></i>
            <% end %>
          <% end %>

          <% if @date_range.present? %>
            <%= link_to account_booking_history_path(query: @query, status: @status),
                        class: "inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700" do %>
              <%= @date_range %>
              <i data-lucide="x" class="h-3.5 w-3.5"></i>
            <% end %>
          <% end %>

          <%= link_to "Clear all", account_booking_history_path,
                      class: "text-xs font-semibold text-indigo-600 transition hover:text-indigo-700" %>
        </div>
      <% end %>
    </div>

    <% if @booking_history.empty? %>
      <!-- Empty state -->
      <div class="flex flex-col items-center gap-3 px-6 py-16 text-center">
        <div class="rounded-full bg-slate-100 p-4 text-slate-400">
          <i data-lucide="calendar-search" class="h-6 w-6"></i>
        </div>

        <p class="text-sm font-semibold text-slate-900">
          No bookings match your filters
        </p>

        <p class="max-w-sm text-sm text-slate-500">
          Try adjusting your search term, status, or date range.
        </p>

        <% if @query.present? || @status.present? || @date_range.present? %>
          <%= link_to "Clear all filters", account_booking_history_path,
                      class: "mt-2 inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
        <% end %>
      </div>
    <% else %>
      <!-- Desktop table -->
      <div class="hidden overflow-x-auto lg:block">
        <table class="min-w-full">
          <thead class="bg-slate-50">
          <tr>
            <th
              class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Service
            </th>

            <th
              class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Date and Time
            </th>

            <th
              class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Business
            </th>

            <th
              class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Price
            </th>

            <th
              class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Status
            </th>

            <th
              class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Actions
            </th>
          </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">
          <% @booking_history.each do |booking| %>
            <tr class="transition hover:bg-slate-50">
              <td class="px-6 py-5">
                <div class="flex items-center gap-3">
                  <div
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"
                  >
                    <i data-lucide="sparkles" class="h-5 w-5"></i>
                  </div>

                  <div>
                    <p class="font-semibold text-slate-900">
                      <%= booking.service.name %>
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                      <%= booking.service.minutes_duration %> minutes
                    </p>
                  </div>
                </div>
              </td>

              <td class="whitespace-nowrap px-6 py-5">
                <p class="text-sm font-medium text-slate-900">
                  <%= booking.date.strftime("%-d %B %Y") %>
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  <%= booking.time.strftime("%-I:%M %p") %>
                </p>
              </td>

              <td class="whitespace-nowrap px-6 py-5">
                <p class="text-sm font-medium text-slate-900">
                  <%= booking.business.business_name %>
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  <%= booking.business.business_setting.town_or_city %>, <span class="uppercase"><%= booking.business.business_setting.postcode %></span>
                </p>
              </td>

              <td class="whitespace-nowrap px-6 py-5">
                <p class="text-sm font-semibold text-slate-900">
                  <%= number_to_currency(booking.service.price, unit: "£") %>
                </p>
              </td>

              <td class="whitespace-nowrap px-6 py-5">
                <%
                  status_classes =
                    case booking.status
                    when "confirmed"
                      {
                        badge: "bg-blue-50 text-blue-700",
                        dot: "bg-blue-500"
                      }
                    when "pending"
                      {
                        badge: "bg-amber-50 text-amber-700",
                        dot: "bg-amber-500"
                      }
                    when "cancelled"
                      {
                        badge: "bg-amber-50 text-amber-700",
                        dot: "bg-amber-500"
                      }
                    when "completed"
                      {
                        badge: "bg-emerald-50 text-emerald-700",
                        dot: "bg-emerald-500"
                      }
                    else
                      {
                        badge: "bg-slate-100 text-slate-700",
                        dot: "bg-slate-500"
                      }
                    end
                %>

                <span class="capitalize inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= status_classes[:badge] %>">
                  <span class="h-1.5 w-1.5 rounded-full <%= status_classes[:dot] %>"></span>
                  <%= booking.status %>
                </span>
              </td>

              <td class="whitespace-nowrap px-6 py-5">
                <div class="flex justify-end gap-2">
                  <%= link_to 'http://' + booking.business.page_address + '.lvh.me:3000',
                              class: "inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
                    <i data-lucide="refresh-cw" class="h-4 w-4"></i>
                    Rebook
                  <% end %>

                  <button
                    type="button"
                    aria-label="Open booking options"
                    class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                  >
                    <i data-lucide="ellipsis" class="h-5 w-5"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>

      <!-- Mobile booking history -->
      <div class="divide-y divide-slate-100 lg:hidden">
        <% @booking_history.each do |booking| %>
          <%
            status_classes =
              case booking.status
              when "confirmed"
                {
                  badge: "bg-blue-50 text-blue-700",
                  dot: "bg-blue-500"
                }
              when "pending"
                {
                  badge: "bg-amber-50 text-amber-700",
                  dot: "bg-amber-500"
                }
              when "cancelled"
                {
                  badge: "bg-red-50 text-red-700",
                  dot: "bg-red-500"
                }
              when "completed"
                {
                  badge: "bg-emerald-50 text-emerald-700",
                  dot: "bg-emerald-500"
                }
              else
                {
                  badge: "bg-slate-100 text-slate-700",
                  dot: "bg-slate-500"
                }
              end
          %>

          <article class="p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="flex min-w-0 items-start gap-3">
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"
                >
                  <i data-lucide="sparkles" class="h-5 w-5"></i>
                </div>

                <div class="min-w-0">
                  <p class="truncate font-semibold text-slate-900">
                    <%= booking.service.name %>
                  </p>

                  <p class="mt-1 truncate text-sm text-slate-500">
                    <%= booking.business.business_name %>
                  </p>

                  <p class="mt-1 text-xs text-slate-400">
                    <%= booking.service.minutes_duration %> minutes
                  </p>
                </div>
              </div>

              <span
                class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold capitalize <%= status_classes[:badge] %>"
              >
            <span
              class="h-1.5 w-1.5 rounded-full <%= status_classes[:dot] %>"
            ></span>

                <%= booking.status %>
              </span>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-slate-50 p-3">
                <p class="text-xs text-slate-500">
                  Date and time
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-900">
                  <%= booking.date.strftime("%-d %B %Y") %>
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  <%= booking.time.strftime("%-I:%M %p") %>
                </p>
              </div>

              <div class="rounded-xl bg-slate-50 p-3">
                <p class="text-xs text-slate-500">
                  Price
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-900">
                  <%= number_to_currency(booking.service.price, unit: "£") %>
                </p>
              </div>
            </div>

            <div class="mt-3 rounded-xl bg-slate-50 p-3">
              <p class="text-xs text-slate-500">
                Location
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-900">
                <%= booking.business.business_setting.town_or_city %>,
                <span class="uppercase">
                  <%= booking.business.business_setting.postcode %>
                </span>
              </p>
            </div>

            <div
              class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4"
            >
              <%= link_to 'http://' + booking.business.page_address + '.lvh.me:3000',
                          class: "inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
                <i data-lucide="refresh-cw" class="h-4 w-4"></i>
                Rebook
              <% end %>

              <button
                type="button"
                aria-label="Open booking options"
                class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
              >
                <i data-lucide="ellipsis" class="h-5 w-5"></i>
              </button>
            </div>
          </article>
        <% end %>
      </div>

      <!-- Pagination -->
      <div
        class="flex flex-col gap-4 border-t border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p class="text-sm text-slate-500">
          Showing
          <span class="font-semibold text-slate-900">
            <%= @total_past_bookings.zero? ? 0 : ((@page - 1) * @per_page) + 1 %>
          </span>
          to
          <span class="font-semibold text-slate-900">
            <%= [@page * @per_page, @total_past_bookings].min %>
          </span>
          of
          <span class="font-semibold text-slate-900"><%= @total_past_bookings %></span>
          previous bookings
        </p>

        <div class="flex items-center gap-2">
          <% if @page > 1 %>
            <%= link_to account_booking_history_path(page: @page - 1, query: @query, status: @status, date_range: @date_range),
                        class: "inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" do %>
              <i data-lucide="chevron-left" class="h-4 w-4"></i>
              Previous
            <% end %>
          <% else %>
            <button
              type="button"
              disabled
              class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400 disabled:cursor-not-allowed"
            >
              <i data-lucide="chevron-left" class="h-4 w-4"></i>
              Previous
            </button>
          <% end %>

          <% @total_pages.times do |i| %>
            <% page_number = i + 1 %>
            <%= link_to page_number, account_booking_history_path(page: page_number, query: @query, status: @status, date_range: @date_range),
                        class: (page_number == @page ?
                                  "flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-sm font-semibold text-white" :
                                  "flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-sm font-semibold text-slate-700 transition hover:bg-slate-50") %>
          <% end %>

          <% if @page < @total_pages %>
            <%= link_to account_booking_history_path(page: @page + 1, query: @query, status: @status, date_range: @date_range),
                        class: "inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50" do %>
              Next
              <i data-lucide="chevron-right" class="h-4 w-4"></i>
            <% end %>
          <% else %>
            <button
              type="button"
              disabled
              class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400 disabled:cursor-not-allowed"
            >
              Next
              <i data-lucide="chevron-right" class="h-4 w-4"></i>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  <!-- Help panel -->
  <section
    class="mt-8 flex flex-col gap-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-6"
  >
    <div class="flex items-start gap-4">
      <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
        <i data-lucide="circle-help" class="h-5 w-5"></i>
      </div>

      <div>
        <h3 class="font-bold text-slate-900">
          Need help with a previous booking?
        </h3>

        <p class="mt-1 text-sm leading-6 text-slate-500">
          Contact the business directly if you have a question about an
          appointment or payment.
        </p>
      </div>
    </div>
  </section>
</main>
