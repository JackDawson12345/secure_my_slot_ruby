<% next_slot = local_assigns.fetch(:next_slot) { BusinessNextAvailableSlot.new(business).call } %>

<article class="<%= if business.subscription_level == 'ultimate'
                      'relative overflow-visible border-2 border-indigo-500 bg-gradient-to-br from-indigo-50 via-white to-purple-50 shadow-lg shadow-indigo-100 pt-7'
                    else
                      'border-slate-200 bg-white shadow-sm'
                    end %> rounded-2xl border p-5 transition hover:shadow-md sm:p-6">
  <% if business.subscription_level == 'ultimate' %>
    <div class="absolute right-5 top-0 -translate-y-1/2">
    <span class="inline-flex items-center gap-1 rounded-full bg-indigo-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white shadow-sm">
      <i data-lucide="crown" class="h-3.5 w-3.5"></i>
      Ultimate
    </span>
    </div>
  <% end %>

  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-start gap-4">
      <% if business.business_setting.logo.attached? %>
        <div class="<%= business.subscription_level == 'ultimate' ?
                          'flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-200 text-lg font-bold text-indigo-700 ring-4 ring-indigo-100' :
                          'flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-100 text-lg font-bold text-indigo-700' %>">
          <%= image_tag business.business_setting.logo,
                        alt: "#{business.business_name} logo",
                        class: "h-10 w-10 rounded-xl object-contain" %>
        </div>
      <% else %>
        <div class="<%= business.subscription_level == 'ultimate' ?
                          'flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-200 text-lg font-bold text-indigo-700 ring-4 ring-indigo-100' :
                          'flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-100 text-lg font-bold text-indigo-700' %>">
          <%= business.business_name.first(2) %>
        </div>
      <% end %>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h4 class="<%= business.subscription_level == 'ultimate' ?
                           'text-base font-extrabold text-indigo-950' :
                           'text-base font-bold text-slate-900' %>">
            <%= business.business_name %>
          </h4>
          <% if business.open_today? %>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              Open today
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700">
              <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
              Closed today
            </span>
          <% end %>
        </div>
        <p class="mt-1 text-sm text-slate-500">
          <%= business_category_name(business.business_setting.business_category) %>
        </p>

        <%
          customer_has_address = current_user.customer_setting&.postcode.present?

          business_address = [
            business.business_setting&.address_line_1,
            business.business_setting&.town_or_city,
            business.business_setting&.postcode
          ].compact_blank
        %>

        <% if business_address.any? %>
          <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500">
    <span class="inline-flex items-center gap-1">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="-0.5 -0.5 16 16"
        fill="none"
        stroke="#64748b"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="feather feather-map-pin"
        height="16"
        width="16"
      >
        <path
          d="M13.125 6.25c0 4.375 -5.625 8.125 -5.625 8.125s-5.625 -3.75 -5.625 -8.125a5.625 5.625 0 0 1 11.25 0z"
          stroke-width="1"
        ></path>

        <path
          d="M5.625 6.25a1.875 1.875 0 1 0 3.75 0 1.875 1.875 0 1 0 -3.75 0"
          stroke-width="1"
        ></path>
      </svg>

      <% if customer_has_address %>
        <span>
          <%= business.distance_to_customer(current_user) %> mi
          <span class="mx-1">&middot;</span>
        </span>
      <% end %>

      <span>
        <%= business.business_setting&.address_line_1 %>

        <% if business.business_setting&.address_line_1.present? && business.business_setting&.town_or_city.present? %>
          ,
        <% end %>

        <%= business.business_setting&.town_or_city %>

        <% if business.business_setting&.postcode.present? %>
          <span class="uppercase">
            <%= business.business_setting.postcode %>
          </span>
        <% end %>
      </span>
    </span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex shrink-0 flex-col items-stretch gap-2 sm:items-end">
      <p class="text-sm text-slate-500 sm:text-right">Next slot</p>
      <p class="text-sm font-semibold text-slate-900 sm:text-right">
        <%= format_next_slot(next_slot) %>
      </p>

      <% if next_slot %>
        <a href="http://<%= business.page_address %>.securemyslot.co.uk"
           class="mt-1 inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500">
          Book now
          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>
      <% else %>
        <span class="mt-1 inline-flex items-center justify-center gap-2 rounded-xl bg-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-500">
          Fully booked
        </span>
      <% end %>
    </div>
  </div>
</article>