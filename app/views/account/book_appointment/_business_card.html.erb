<% next_slot = local_assigns.fetch(:next_slot) { BusinessNextAvailableSlot.new(business).call } %>

<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md sm:p-6">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-start gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-100 text-lg font-bold text-indigo-700">
        TB
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h4 class="text-base font-bold text-slate-900"><%= business.business_name %></h4>
          <% if business.open_today? %>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              Open today
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
              <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
              Closed today
            </span>
          <% end %>
        </div>
        <p class="mt-1 text-sm text-slate-500"><%= business.business_setting.business_category %></p>

        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500">
          <span class="inline-flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="-0.5 -0.5 16 16" fill="none" stroke="#64748b" stroke-linecap="round" stroke-linejoin="round" class="feather feather-map-pin" id="Map-Pin--Streamline-Feather" height="16" width="16">
  <desc>
    Map Pin Streamline Icon: https://streamlinehq.com
  </desc>
  <path d="M13.125 6.25c0 4.375 -5.625 8.125 -5.625 8.125s-5.625 -3.75 -5.625 -8.125a5.625 5.625 0 0 1 11.25 0z" stroke-width="1"></path>
  <path d="M5.625 6.25a1.875 1.875 0 1 0 3.75 0 1.875 1.875 0 1 0 -3.75 0" stroke-width="1"></path>
</svg>
            <%= business.distance_to_customer(current_user) %> mi &middot; <%= business.business_setting.address_line_1 %>, <%= business.business_setting.town_or_city %>, <span class="uppercase"><%= business.business_setting.postcode %></span>
          </span>
        </div>
      </div>
    </div>

    <div class="flex shrink-0 flex-col items-stretch gap-2 sm:items-end">
      <p class="text-sm text-slate-500 sm:text-right">Next slot</p>
      <p class="text-sm font-semibold text-slate-900 sm:text-right">
        <%= format_next_slot(next_slot) %>
      </p>

      <% if next_slot %>
        <a href="http://<%= business.page_address %>.lvh.me:3000"
           class="mt-1 inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500">
          Book now
          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>
      <% else %>
        <span class="mt-1 inline-flex items-center justify-center gap-2 rounded-xl bg-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-500">
          Fully booked
        </span>
      <% end %>
    </div>
  </div>
</article>