<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        My Orders
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Keep track of your purchases and order history.
      </p>
    </div>

  </section>


  <!-- Summary cards -->
  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">
        Total Orders
      </p>

      <p class="mt-2 text-3xl font-bold text-slate-900">
        <%= @orders.count %>
      </p>

      <p class="mt-4 text-sm text-slate-500">
        Orders placed with businesses
      </p>
    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">
        Pending
      </p>

      <p class="mt-2 text-3xl font-bold text-slate-900">
        <%= @orders.where(status: "pending").count %>
      </p>

      <p class="mt-4 text-sm text-slate-500">
        Waiting for processing
      </p>
    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">
        Completed
      </p>

      <p class="mt-2 text-3xl font-bold text-slate-900">
        <%= @orders.where(status: "completed").count %>
      </p>

      <p class="mt-4 text-sm text-slate-500">
        Successfully completed orders
      </p>
    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">
        Total Spent
      </p>

      <p class="mt-2 text-3xl font-bold text-slate-900">
        <%= number_to_currency(@orders.sum(:amount), unit: "£") %>
      </p>

      <p class="mt-4 text-sm text-slate-500">
        Across all purchases
      </p>
    </article>

  </section>


  <!-- Orders panel -->
  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


    <div class="border-b border-slate-200 p-5 sm:p-6">

      <h3 class="text-lg font-bold text-slate-900">
        Order History
      </h3>

      <p class="mt-1 text-sm text-slate-500">
        View your previous purchases and order details.
      </p>

    </div>


    <% if @orders.empty? %>

      <div class="flex flex-col items-center gap-3 px-6 py-16 text-center">

        <div class="rounded-full bg-slate-100 p-4 text-slate-400">
          <i data-lucide="shopping-bag" class="h-6 w-6"></i>
        </div>


        <p class="text-sm font-semibold text-slate-900">
          No orders found
        </p>


        <p class="max-w-sm text-sm text-slate-500">
          Your purchases will appear here once you place an order.
        </p>

      </div>


    <% else %>


      <!-- Desktop -->
      <div class="hidden overflow-x-auto lg:block">

        <table class="min-w-full">

          <thead class="bg-slate-50">

          <tr>

            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Order
            </th>


            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Business
            </th>


            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Date
            </th>


            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Payment
            </th>


            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Amount
            </th>


            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              Status
            </th>


            <th></th>

          </tr>

          </thead>


          <tbody class="divide-y divide-slate-100">


          <% @orders.each do |order| %>

            <%
              status_classes =
                case order.status
                when "completed"
                  "bg-emerald-50 text-emerald-700"
                when "pending"
                  "bg-amber-50 text-amber-700"
                when "cancelled"
                  "bg-rose-50 text-rose-700"
                else
                  "bg-slate-100 text-slate-700"
                end
            %>


            <tr class="transition hover:bg-slate-50">


              <td class="px-6 py-5">

                <p class="font-semibold text-slate-900">
                  Order #<%= order.id %>
                </p>

                <p class="mt-1 text-xs text-slate-500">
                  <%= order.public_id %>
                </p>

              </td>


              <td class="px-6 py-5">

                <p class="text-sm font-medium text-slate-900">
                  <%= order.business.business_name %>
                </p>

              </td>


              <td class="px-6 py-5">

                <p class="text-sm text-slate-900">
                  <%= order.created_at.strftime("%-d %B %Y") %>
                </p>

              </td>


              <td class="px-6 py-5">

                <p class="text-sm capitalize text-slate-700">
                  <%= order.payment_method %>
                </p>

              </td>


              <td class="px-6 py-5">

                <p class="font-semibold text-slate-900">
                  <%= number_to_currency(order.amount, unit: "£") %>
                </p>

              </td>


              <td class="px-6 py-5">

                  <span class="capitalize rounded-full px-2.5 py-1 text-xs font-semibold <%= status_classes %>">
                    <%= order.status %>
                  </span>

              </td>


              <td class="px-6 py-5 text-right">

                <%= link_to account_order_path(order),
                            class: "inline-flex items-center gap-2 text-sm font-semibold text-indigo-600" do %>

                  View
                  <i data-lucide="arrow-right" class="h-4 w-4"></i>

                <% end %>

              </td>


            </tr>

          <% end %>


          </tbody>

        </table>

      </div>


      <!-- Mobile -->
      <div class="divide-y divide-slate-100 lg:hidden">

        <% @orders.each do |order| %>

          <article class="p-5">


            <div class="flex items-start justify-between">

              <div>

                <p class="font-semibold text-slate-900">
                  Order #<%= order.id %>
                </p>


                <p class="mt-1 text-sm text-slate-500">
                  <%= order.business.business_name %>
                </p>

              </div>


              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold capitalize text-slate-700">
                <%= order.status %>
              </span>

            </div>


            <div class="mt-4 grid grid-cols-2 gap-3">

              <div class="rounded-xl bg-slate-50 p-3">

                <p class="text-xs text-slate-500">
                  Date
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-900">
                  <%= order.created_at.strftime("%-d %B %Y") %>
                </p>

              </div>


              <div class="rounded-xl bg-slate-50 p-3">

                <p class="text-xs text-slate-500">
                  Amount
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-900">
                  <%= number_to_currency(order.amount, unit: "£") %>
                </p>

              </div>

            </div>


            <div class="mt-4 border-t border-slate-100 pt-4 text-right">

              <%= link_to account_order_path(order),
                          class: "text-sm font-semibold text-indigo-600" do %>

                View order →

              <% end %>

            </div>


          </article>

        <% end %>


      </div>


    <% end %>


  </section>


</main>