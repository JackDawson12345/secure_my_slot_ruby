<%
  service = @booking.service

  current_end_time =
    @booking.time + service.minutes_duration.minutes
%>

<main class="p-4 sm:p-6 lg:p-8">

  <div class="mb-6">
    <%= link_to account_show_booking_path(@booking),
                class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-indigo-600" do %>
      <i data-lucide="arrow-left" class="h-4 w-4"></i>
      Back to booking
    <% end %>
  </div>

  <section>
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
      Reschedule booking
    </h2>

    <p class="mt-2 text-sm text-slate-500">
      Choose a new date and available appointment time.
    </p>
  </section>

  <!-- Current appointment -->
  <section class="mt-8 overflow-hidden rounded-2xl border border-indigo-200 bg-white shadow-sm">
    <div class="border-b border-indigo-100 bg-indigo-50 px-5 py-4 sm:px-6">
      <div class="flex items-center gap-3">
        <div class="rounded-xl bg-white p-2.5 text-indigo-600 shadow-sm">
          <i data-lucide="calendar-clock" class="h-5 w-5"></i>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
            Current appointment
          </p>

          <h3 class="mt-0.5 font-bold text-slate-900">
            <%= service.name %>
          </h3>
        </div>
      </div>
    </div>

    <div class="p-5 sm:p-6">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center">

        <div class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-2xl bg-indigo-600 text-white">
          <span class="text-xs font-semibold uppercase tracking-wide">
            <%= @booking.date.strftime("%b") %>
          </span>

          <span class="text-3xl font-bold leading-none">
            <%= @booking.date.day %>
          </span>
        </div>

        <div>
          <p class="text-lg font-bold text-slate-900">
            <%= @booking.date.strftime("%A, %-d %B %Y") %>
          </p>

          <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500">
            <span class="inline-flex items-center gap-2">
              <i data-lucide="clock-3" class="h-4 w-4 text-slate-400"></i>

              <%= @booking.time.strftime("%-I:%M %p") %>
              to
              <%= current_end_time.strftime("%-I:%M %p") %>
            </span>

            <span class="inline-flex items-center gap-2">
              <i data-lucide="hourglass" class="h-4 w-4 text-slate-400"></i>

              <%= service.minutes_duration %> minutes
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <%= form_with url: account_update_reschedule_booking_path(@booking),
                method: :patch,
                local: true,
                id: "reschedule-form" do %>

    <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <h3 class="text-lg font-bold text-slate-900">
          Choose a new appointment
        </h3>

        <p class="mt-1 text-sm text-slate-500">
          Select a date to see the available appointment times.
        </p>
      </div>

      <div class="grid lg:grid-cols-2">

        <!-- Date -->
        <div class="border-b border-slate-200 p-5 sm:p-6 lg:border-b-0 lg:border-r">

          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
              <i data-lucide="calendar-days" class="h-5 w-5"></i>
            </div>

            <div>
              <h4 class="font-bold text-slate-900">
                Select a date
              </h4>

              <p class="mt-0.5 text-xs text-slate-500">
                Choose the day you would like your appointment.
              </p>
            </div>
          </div>

          <div class="mt-6">
            <label
              for="date"
              class="mb-2 block text-sm font-semibold text-slate-700"
            >
              Appointment date
            </label>

            <div class="relative">
              <i
                data-lucide="calendar"
                class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
              ></i>

              <%= date_field_tag :date,
                                 @booking.date,
                                 min: Date.current,
                                 id: "reschedule-date",
                                 class: "w-full rounded-xl border border-slate-200 bg-white py-3 pl-10 pr-4 text-sm font-medium text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
            </div>
          </div>

          <div
            id="selected-date-card"
            class="mt-5 rounded-xl border border-indigo-100 bg-indigo-50 p-4"
          >
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm">
                <i data-lucide="calendar-check-2" class="h-5 w-5"></i>
              </div>

              <div>
                <p class="text-xs font-medium text-indigo-600">
                  Selected date
                </p>

                <p
                  id="selected-date-text"
                  class="mt-0.5 text-sm font-bold text-slate-900"
                >
                  <%= @booking.date.strftime("%A, %-d %B %Y") %>
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- Time -->
        <div class="p-5 sm:p-6">

          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
              <i data-lucide="clock-3" class="h-5 w-5"></i>
            </div>

            <div>
              <h4 class="font-bold text-slate-900">
                Select a time
              </h4>

              <p class="mt-0.5 text-xs text-slate-500">
                Available times for your selected date.
              </p>
            </div>
          </div>

          <div
            id="slots-container"
            class="mt-6"
          >
            <div class="flex items-center justify-center py-12 text-sm text-slate-400">
              Select a date to view available times.
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Actions -->
    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

        <%= link_to account_show_booking_path(@booking),
                    class: "inline-flex items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
          Cancel
        <% end %>

        <button
          type="submit"
          id="confirm-reschedule"
          disabled
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <i data-lucide="calendar-check-2" class="h-4 w-4"></i>
          Confirm reschedule
        </button>

      </div>
    </section>

  <% end %>

</main>

<script>
    function initialiseRescheduleBooking() {
        const dateInput = document.getElementById("reschedule-date");
        const slotsContainer = document.getElementById("slots-container");
        const selectedDateText = document.getElementById("selected-date-text");
        const confirmButton = document.getElementById("confirm-reschedule");

        if (!dateInput || !slotsContainer) return;

        const slotsUrl = "<%= account_reschedule_booking_slots_path(@booking) %>";

        function formatDate(dateString) {
            const date = new Date(`${dateString}T12:00:00`);

            return date.toLocaleDateString("en-GB", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric"
            });
        }

        function formatTime(time) {
            const [hours, minutes] = time.split(":");

            const date = new Date();
            date.setHours(parseInt(hours));
            date.setMinutes(parseInt(minutes));

            return date.toLocaleTimeString("en-GB", {
                hour: "numeric",
                minute: "2-digit",
                hour12: true
            });
        }

        function loadingState() {
            slotsContainer.innerHTML = `
        <div class="flex items-center justify-center gap-3 py-12 text-sm text-slate-500">
          <svg
            class="h-5 w-5 animate-spin"
            viewBox="0 0 24 24"
            fill="none"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>

            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
            ></path>
          </svg>

          Checking availability...
        </div>
      `;
        }

        function emptyState() {
            slotsContainer.innerHTML = `
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-slate-200 px-6 py-10 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
            <i data-lucide="calendar-x" class="h-5 w-5"></i>
          </div>

          <p class="mt-4 text-sm font-semibold text-slate-900">
            No times available
          </p>

          <p class="mt-1 max-w-xs text-sm text-slate-500">
            There are no available appointment times on this date. Try another day.
          </p>
        </div>
      `;

            confirmButton.disabled = true;

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        function errorState() {
            slotsContainer.innerHTML = `
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
          <div class="flex items-start gap-3">
            <i
              data-lucide="circle-alert"
              class="mt-0.5 h-5 w-5 shrink-0 text-rose-500"
            ></i>

            <div>
              <p class="text-sm font-semibold text-rose-700">
                Unable to load availability
              </p>

              <p class="mt-1 text-sm text-rose-600">
                Please try selecting the date again.
              </p>
            </div>
          </div>
        </div>
      `;

            confirmButton.disabled = true;

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        function renderSlots(slots) {
            if (!slots.length) {
                emptyState();
                return;
            }

            slotsContainer.innerHTML = `
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          ${slots.map(slot => `
            <label class="cursor-pointer">
              <input
                type="radio"
                name="time"
                value="${slot}"
                class="peer sr-only"
                required
              >

              <span class="flex items-center justify-center rounded-xl border border-slate-200 px-3 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:bg-indigo-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-600 peer-checked:text-white peer-focus:ring-2 peer-focus:ring-indigo-100">
                ${formatTime(slot)}
              </span>
            </label>
          `).join("")}
        </div>
      `;

            confirmButton.disabled = true;

            slotsContainer
                .querySelectorAll('input[name="time"]')
                .forEach(input => {
                    input.addEventListener("change", () => {
                        confirmButton.disabled = false;
                    });
                });
        }

        async function loadSlots() {
            const selectedDate = dateInput.value;

            if (!selectedDate) {
                slotsContainer.innerHTML = "";
                confirmButton.disabled = true;
                return;
            }

            selectedDateText.textContent = formatDate(selectedDate);

            confirmButton.disabled = true;

            loadingState();

            try {
                const response = await fetch(
                    `${slotsUrl}?date=${encodeURIComponent(selectedDate)}`,
                    {
                        headers: {
                            "Accept": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error("Unable to load slots");
                }

                const data = await response.json();

                renderSlots(data.slots || []);
            } catch (error) {
                console.error(error);

                errorState();
            }
        }

        dateInput.addEventListener("change", loadSlots);

        loadSlots();
    }

    document.addEventListener(
        "turbo:load",
        initialiseRescheduleBooking
    );
</script>