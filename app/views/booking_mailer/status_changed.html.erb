<!DOCTYPE html>
<html>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: Arial, sans-serif; color: #0f172a;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; padding: 40px 20px;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden;">
        <tr>
          <td style="padding: 32px;">

            <h1 style="margin: 0 0 16px; font-size: 26px; line-height: 1.3;">
              Your booking has been updated
            </h1>

            <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #475569;">
              Your booking with <strong><%= @business.business_name %></strong> has been updated.
            </p>

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-radius: 10px; margin-bottom: 20px;">
              <tr>
                <td style="padding: 24px; text-align: center;">
                  <p style="margin: 0 0 8px; font-size: 14px; color: #64748b;">
                    Booking status
                  </p>

                  <p style="margin: 0; font-size: 22px; font-weight: bold; color: #0f172a;">
                    <%= @booking.status.to_s.humanize %>
                  </p>
                </td>
              </tr>
            </table>

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-radius: 10px; margin-bottom: 24px;">
              <tr>
                <td style="padding: 24px;">

                  <h2 style="margin: 0 0 18px; font-size: 18px;">
                    Booking details
                  </h2>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Business:</strong>
                    <%= @business.business_name %>
                  </p>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Service:</strong>
                    <%= @service.name %>
                  </p>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Date:</strong>
                    <%= @booking.date.strftime("%A, %d %B %Y") %>
                  </p>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Time:</strong>
                    <%= @booking.time.strftime("%H:%M") %>
                  </p>

                  <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                    <strong>Service price:</strong>
                    £<%= number_with_precision(@service.price || 0, precision: 2) %>
                  </p>

                  <% if (@booking.amount_paid || 0) > 0 && @booking.status.to_s != "completed" %>
                    <p style="margin: 0 0 10px; font-size: 15px; color: #475569;">
                      <strong>Amount paid:</strong>
                      £<%= number_with_precision(@booking.amount_paid, precision: 2) %>
                    </p>
                  <% end %>

                  <% if @remaining_balance > 0 && @booking.status.to_s != "completed" %>
                    <p style="margin: 0; font-size: 15px; color: #475569;">
                      <strong>Remaining balance:</strong>
                      £<%= number_with_precision(@remaining_balance, precision: 2) %>
                    </p>
                  <% end %>

                </td>
              </tr>
            </table>

            <% if @booking.status.to_s == "confirmed" %>
              <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #475569;">
                Your appointment has been confirmed and is scheduled to go ahead at the date and time shown above.
              </p>
            <% elsif @booking.status.to_s == "cancelled" %>
              <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #475569;">
                Your appointment has been cancelled and will no longer take place.
              </p>
            <% elsif @booking.status.to_s == "completed" %>
              <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #475569;">
                Your appointment has been marked as completed.
              </p>
            <% else %>
              <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #475569;">
                The status of your appointment has changed. Please review the booking details above.
              </p>
            <% end %>

            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #475569;">
              You can view your booking and appointment details from your SecureMySlot account.
            </p>

          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>