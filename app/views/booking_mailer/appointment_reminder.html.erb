<!-- app/views/booking_mailer/appointment_reminder.html.erb -->

<h1>Your appointment is coming up</h1>

<p>Hi <%= @user.first_name %>,</p>

<p>
  This is a reminder that your appointment with
  <strong><%= @business.business_name %></strong>
  starts in approximately one hour.
</p>

<p>
  <strong>Service:</strong>
  <%= @service.name %>
</p>

<p>
  <strong>Date:</strong>
  <%= @booking.date.strftime("%-d %B %Y") %>
</p>

<p>
  <strong>Time:</strong>
  <%= @booking.time.strftime("%-I:%M %p") %>
</p>

<% if @remaining_balance.positive? %>
  <p>
    <strong>Remaining balance:</strong>
    <%= number_to_currency(@remaining_balance, unit: "£") %>
  </p>

  <p>
    You currently have
    <strong><%= number_to_currency(@remaining_balance, unit: "£") %></strong>
    remaining to pay for this appointment.
  </p>
<% end %>

<% if @consultation_required %>

  <h2>Complete your consultation form</h2>

  <p>
    Please complete your consultation form before your appointment.
  </p>

  <p>
    <%= link_to "Complete consultation form",
                @consultation_form_url %>
  </p>

<% end %>

<p>We look forward to seeing you.</p>