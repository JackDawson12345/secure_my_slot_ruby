<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <style>
      body {
          font-family: Arial, sans-serif;
          font-size: 14px;
          line-height: 1.5;
          color: #0f172a;
          margin: 0;
      }

      h1 {
          font-size: 24px;
          margin: 0 0 6px;
      }

      h2 {
          font-size: 17px;
          margin: 28px 0 12px;
          padding-bottom: 8px;
          border-bottom: 1px solid #e2e8f0;
      }

      .muted {
          color: #64748b;
      }

      .details {
          width: 100%;
          border-collapse: collapse;
      }

      .details td {
          padding: 9px 0;
          vertical-align: top;
          border-bottom: 1px solid #f1f5f9;
      }

      .details .label {
          width: 35%;
          color: #64748b;
          font-weight: bold;
          padding-right: 20px;
      }

      .response {
          margin-bottom: 18px;
      }

      .response-label {
          font-size: 12px;
          color: #64748b;
          font-weight: bold;
          margin-bottom: 4px;
      }

      .response-value {
          padding: 10px 12px;
          background: #f8fafc;
          border: 1px solid #e2e8f0;
          border-radius: 4px;
      }
  </style>
</head>

<body>
<%= yield %>
</body>
</html>