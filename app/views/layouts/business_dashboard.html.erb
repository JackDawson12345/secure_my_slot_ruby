<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Secure My Slot" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <%= favicon_link_tag "secure-fav-icon.png", type: "image/png" %>
  <%= favicon_link_tag "secure-fav-icon.png", rel: "apple-touch-icon" %>

  <%# Includes all stylesheet files in app/assets/stylesheets %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-slate-50 text-slate-900">
  <div class="min-h-screen">
    <!-- Mobile overlay -->
    <button
      id="sidebarOverlay"
      type="button"
      aria-label="Close navigation"
      class="fixed inset-0 z-40 hidden bg-slate-950/50 lg:hidden"
    ></button>

    <!-- Sidebar -->
    <aside
      id="sidebar"
      class="fixed inset-y-0 left-0 z-50 flex w-72 min-h-0 -translate-x-full flex-col bg-slate-950 text-white transition-transform duration-300 lg:translate-x-0"
    >
      <!-- Logo -->
      <div
        class="flex h-20 items-center justify-between border-b border-white/10 px-6"
      >
        <div>
          <%= image_tag 'secure-white-logo.png.png', class: 'h-14 py-2' %>
        </div>

        <button
          id="closeSidebar"
          type="button"
          aria-label="Close sidebar"
          class="rounded-lg p-2 text-slate-400 transition hover:bg-white/10 hover:text-white lg:hidden"
        >
          <i data-lucide="x" class="h-5 w-5"></i>
        </button>
      </div>

      <!-- Navigation -->
      <nav class="min-h-0 flex-1 overflow-y-auto space-y-2 px-4 py-6">
        <%= link_to business_dashboard_path,
                    class: [
                      "flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition",
                      controller_name == "dashboard" ?
                        "bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-950/30" :
                        "font-medium text-slate-300 hover:bg-white/10 hover:text-white"
                    ] do %>
          <i data-lucide="layout-dashboard" class="h-5 w-5"></i>
          <span>Dashboard</span>
        <% end %>

        <!-- Bookings -->
        <div data-controller="dropdown">

          <button type="button"
                  data-action="click->dropdown#toggle"
                  class="
            flex w-full items-center justify-between gap-3 rounded-xl px-4 py-3 text-sm transition
            <%= controller_name == "bookings" ?
                                           "bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-950/30" :
                                           "font-medium text-slate-300 hover:bg-white/10 hover:text-white" %>
          ">

            <div class="flex items-center gap-3">
              <i data-lucide="calendar-days" class="h-5 w-5"></i>
              <span>Bookings</span>
            </div>

            <i data-dropdown-target="icon"
               data-lucide="chevron-down"
               class="h-4 w-4 transition-transform">
            </i>

          </button>


          <div data-dropdown-target="menu"
               class="mt-2 space-y-1 pl-4 <%= controller_name == "bookings" ? "" : "hidden" %>">

            <%= link_to business_bookings_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "bookings" && action_name == "index" && params[:status].blank? ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              All Bookings
            <% end %>

            <%= link_to business_bookings_path(status: "confirmed"),
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          params[:status] == "confirmed" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Confirmed Bookings
            <% end %>


            <%= link_to business_bookings_path(status: "pending"),
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          params[:status] == "pending" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Pending Bookings
            <% end %>


            <%= link_to business_add_booking_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          action_name == "add_booking" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Add New Booking
            <% end %>

          </div>

        </div>

        <%= link_to business_customers_path,
                    class: [
                      "flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition",
                      controller_name == "customers" ?
                        "bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-950/30" :
                        "font-medium text-slate-300 hover:bg-white/10 hover:text-white"
                    ] do %>
          <i data-lucide="users" class="h-5 w-5"></i>
          <span>Customers</span>
        <% end %>

        <!-- Services -->
        <div data-controller="dropdown">

          <button type="button"
                  data-action="click->dropdown#toggle"
                  class="
            flex w-full items-center justify-between gap-3 rounded-xl px-4 py-3 text-sm transition
            <%= ["services", "service_categories"].include?(controller_name) ?
                                           "bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-950/30" :
                                           "font-medium text-slate-300 hover:bg-white/10 hover:text-white" %>
          ">

            <div class="flex items-center gap-3">
              <i data-lucide="briefcase-business" class="h-5 w-5"></i>
              <span>Services</span>
            </div>

            <i data-dropdown-target="icon"
               data-lucide="chevron-down"
               class="h-4 w-4 transition-transform">
            </i>

          </button>


          <div data-dropdown-target="menu"
               class="
         mt-2 space-y-1 pl-4
         <%= ["services", "service_categories"].include?(controller_name) ? "" : "hidden" %>
       ">


            <%= link_to business_services_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "services" && action_name == "index" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              All Services
            <% end %>


            <%= link_to new_business_service_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "services" && action_name == "new" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Add New Service
            <% end %>


            <%= link_to business_service_categories_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "service_categories" && action_name == "index" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              All Service Categories
            <% end %>


            <%= link_to new_business_service_category_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "service_categories" && action_name == "new" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Add Service Category
            <% end %>


          </div>

        </div>

        <!-- Opening Hours -->
        <div data-controller="dropdown">

          <button type="button"
                  data-action="click->dropdown#toggle"
                  class="
            flex w-full items-center justify-between gap-3 rounded-xl px-4 py-3 text-sm transition
            <%= ["opening_hours", "blocked_times"].include?(controller_name) ?
                                           "bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-950/30" :
                                           "font-medium text-slate-300 hover:bg-white/10 hover:text-white" %>
          ">

            <div class="flex items-center gap-3">
              <i data-lucide="clock-3" class="h-5 w-5"></i>
              <span>Opening Hours</span>
            </div>

            <i data-dropdown-target="icon"
               data-lucide="chevron-down"
               class="h-4 w-4 transition-transform">
            </i>

          </button>


          <div data-dropdown-target="menu"
               class="
         mt-2 space-y-1 pl-4
         <%= ["opening_hours", "blocked_times"].include?(controller_name) ? "" : "hidden" %>
       ">


            <%= link_to business_opening_hours_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "opening_hours" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Edit Opening Hours
            <% end %>


            <%= link_to business_blocked_times_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "blocked_times" && action_name == "index" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Add Blocked Time
            <% end %>


          </div>

        </div>

        <!-- Settings -->
        <div data-controller="dropdown">

          <button type="button"
                  data-action="click->dropdown#toggle"
                  class="
            flex w-full items-center justify-between gap-3 rounded-xl px-4 py-3 text-sm transition
            <%= ["settings", "website_settings", "payments", "calendar_sync", "consultation_forms", "email_templates", "agreements"].include?(controller_name) ?
                                           "bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-950/30" :
                                           "font-medium text-slate-300 hover:bg-white/10 hover:text-white" %>
          ">

            <div class="flex items-center gap-3">
              <i data-lucide="settings" class="h-5 w-5"></i>
              <span>Settings</span>
            </div>

            <i data-dropdown-target="icon"
               data-lucide="chevron-down"
               class="h-4 w-4 transition-transform">
            </i>

          </button>


          <div data-dropdown-target="menu"
               class="
         mt-2 space-y-1 pl-4
         <%= ["settings", "website_settings", "payments", "calendar_sync", "consultation_forms", "email_templates", "agreements"].include?(controller_name) ? "" : "hidden" %>
       ">


            <%= link_to business_settings_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "settings" && action_name == "index" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              All Settings
            <% end %>

            <%= link_to business_general_settings_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "settings" && action_name == "general_settings" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              General Settings
            <% end %>


            <%= link_to business_website_settings_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "website_settings" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Website Settings
            <% end %>


            <%= link_to business_payments_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "payments" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Payments
            <% end %>


            <%= link_to business_calendar_sync_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "settings" && action_name == "calendar_sync" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Calendar Sync
            <% end %>


            <%= link_to business_consultation_form_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "settings" && action_name == "consultation_form" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Consultation Forms
            <% end %>


            <%= link_to business_email_templates_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "settings" && action_name == "email_templates" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Email Templates
            <% end %>


            <%= link_to business_agreements_path,
                        class: [
                          "block rounded-lg px-4 py-2 text-sm transition",
                          controller_name == "agreements" ?
                            "bg-white/10 font-semibold text-white" :
                            "text-slate-400 hover:bg-white/10 hover:text-white"
                        ] do %>
              Agreements
            <% end %>


          </div>

        </div>
      </nav>

      <!-- Sidebar user -->
      <div >
        <div class="flex-1 space-y-2 px-4 py-6">
          <%= link_to "http://" + current_user.business.page_address + ".securemyslot.co.uk",
                      class: [
                        "flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition font-medium text-slate-300 hover:bg-white/10 hover:text-white"
                      ] do %>
            <i data-lucide="globe" class="h-5 w-5"></i>
            <span>View Public Website</span>
          <% end %>

          <%= link_to business_download_qr_code_path(url: "http://" + current_user.business.page_address + ".securemyslot.co.uk"),
                      class: [
                        "flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition",
                        controller_name == "qr_code" ?
                          "bg-indigo-600 font-semibold text-white shadow-lg shadow-indigo-950/30" :
                          "font-medium text-slate-300 hover:bg-white/10 hover:text-white"
                      ] do %>
            <i data-lucide="qr-code" class="h-5 w-5"></i>
            <span>Download QR Code</span>
          <% end %>


        </div>
        <div class="border-t border-white/10 p-4">
          <div class="mb-4 flex items-center gap-3 rounded-xl bg-white/5 p-3">
            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-sm font-semibold"
            >
              JD
            </div>

            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold">
                <%= current_user.first_name %> <%= current_user.last_name %>
              </p>

              <p class="truncate text-xs text-slate-400">
                <%= current_user.email %>
              </p>
            </div>
          </div>

          <%= button_to destroy_user_session_path,
                        method: :delete,
                        class: "flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-300 transition hover:bg-red-500/10 hover:text-red-300" do %>
            <i data-lucide="log-out" class="h-5 w-5"></i>
            Sign out
          <% end %>
        </div>
      </div>
    </aside>
    <div class="lg:pl-72">
      <!-- Header -->
      <header
        class="sticky top-0 z-30 flex h-20 items-center justify-between border-b border-slate-200 bg-white/90 px-4 backdrop-blur sm:px-6 lg:px-8"
      >
        <div class="flex items-center gap-4">
          <button
            id="openSidebar"
            type="button"
            aria-label="Open navigation"
            class="rounded-xl border border-slate-200 p-2.5 text-slate-600 transition hover:bg-slate-100 lg:hidden"
          >
            <i data-lucide="menu" class="h-5 w-5"></i>
          </button>

          <div>
            <h1 class="text-xl font-bold tracking-tight sm:text-2xl">
              Dashboard
            </h1>

            <p class="hidden text-sm text-slate-500 sm:block">
              Here is what is happening with your business today.
            </p>
          </div>
        </div>

        <button
          type="button"
          class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 transition hover:bg-slate-50"
        >
          <div
            class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700"
          >
            <%= current_user.first_name[0] %><%= current_user.last_name[0] %>
          </div>

          <div class="hidden text-left sm:block">
            <p class="text-sm font-semibold">
              <%= current_user.first_name %> <%= current_user.last_name %>
            </p>

            <p class="text-xs text-slate-500">
              Business owner
            </p>
          </div>

          <i
            data-lucide="chevron-down"
            class="hidden h-4 w-4 text-slate-400 sm:block"
          ></i>
        </button>
      </header>
      <%= yield %>
    </div>

  </div>
  <script>
      function initialiseDashboard() {
          lucide.createIcons();

          const sidebar = document.getElementById("sidebar");
          const sidebarOverlay = document.getElementById("sidebarOverlay");
          const openSidebarButton = document.getElementById("openSidebar");
          const closeSidebarButton = document.getElementById("closeSidebar");

          if (
              !sidebar ||
              !sidebarOverlay ||
              !openSidebarButton ||
              !closeSidebarButton
          ) {
              return;
          }

          function openSidebar() {
              sidebar.classList.remove("-translate-x-full");
              sidebarOverlay.classList.remove("hidden");
              document.body.classList.add("overflow-hidden");
          }

          function closeSidebar() {
              sidebar.classList.add("-translate-x-full");
              sidebarOverlay.classList.add("hidden");
              document.body.classList.remove("overflow-hidden");
          }

          openSidebarButton.onclick = openSidebar;
          closeSidebarButton.onclick = closeSidebar;
          sidebarOverlay.onclick = closeSidebar;

          window.onresize = () => {
              if (window.innerWidth >= 1024) {
                  sidebarOverlay.classList.add("hidden");
                  document.body.classList.remove("overflow-hidden");
              }
          };
      }

      document.addEventListener("turbo:load", initialiseDashboard);
  </script>
</body>
</html>
