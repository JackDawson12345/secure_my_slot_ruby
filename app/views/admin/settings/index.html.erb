<!-- Admin Settings -->
<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Settings
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Manage your admin account details and password.
      </p>
    </div>

    <button
      type="submit"
      form="settingsForm"
      class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 sm:w-auto"
    >
      <i data-lucide="save" class="h-4 w-4"></i>
      Save changes
    </button>
  </section>


  <div class="mt-8">

    <%= form_with model: current_user,
                  url: admin_settings_path,
                  method: :patch,
                  id: "settingsForm" do |f| %>


      <!-- Account details -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <div class="flex items-start gap-3">

            <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
              <i data-lucide="user-round" class="h-5 w-5"></i>
            </div>

            <div>
              <h3 class="text-lg font-bold text-slate-900">
                Account details
              </h3>

              <p class="mt-1 text-sm text-slate-500">
                Update the information used to access your admin account.
              </p>
            </div>

          </div>
        </div>


        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">

          <div>
            <%= f.label :first_name,
                        "First name",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

            <%= f.text_field :first_name,
                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
          </div>


          <div>
            <%= f.label :last_name,
                        "Last name",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

            <%= f.text_field :last_name,
                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
          </div>


          <div class="sm:col-span-2">

            <%= f.label :email,
                        "Email address",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

            <%= f.email_field :email,
                              class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

          </div>

        </div>

      </section>


    <% end %>


    <!-- Password -->
    <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">

        <div class="flex items-start gap-3">

          <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
            <i data-lucide="lock-keyhole" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="text-lg font-bold text-slate-900">
              Change password
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Update your password to keep your account secure.
            </p>
          </div>

        </div>

      </div>


      <%= form_with url: admin_password_path,
                    method: :patch do |password_form| %>

        <div class="grid gap-5 p-5 sm:p-6">

          <div>
            <%= password_form.label :password,
                                    "New password",
                                    class: "mb-2 block text-sm font-semibold text-slate-700" %>

            <%= password_form.password_field :password,
                                             placeholder: "Enter new password",
                                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
          </div>


          <div>
            <%= password_form.label :password_confirmation,
                                    "Confirm password",
                                    class: "mb-2 block text-sm font-semibold text-slate-700" %>

            <%= password_form.password_field :password_confirmation,
                                             placeholder: "Repeat new password",
                                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
          </div>


          <div>
            <%= password_form.submit "Update password",
                                     class: "inline-flex items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
          </div>

        </div>

      <% end %>

    </section>


    <!-- Bottom actions -->
    <div class="mt-8 flex justify-end rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <button
        type="submit"
        form="settingsForm"
        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
      >
        <i data-lucide="save" class="h-4 w-4"></i>
        Save changes
      </button>

    </div>


  </div>

</main>