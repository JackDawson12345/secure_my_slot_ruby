<%= form_with(
      model: @service,
      url: @service.persisted? ?
             admin_customer_service_path(@customer, @service) :
             admin_customer_services_path(@customer),
      method: @service.persisted? ? :patch : :post,
      class: "space-y-6",
      data: {
        controller: "deposit service-times"
      }
    ) do |form| %>

  <% if @service.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
      <div class="flex items-start gap-3">
        <i
          data-lucide="circle-alert"
          class="mt-0.5 h-5 w-5 shrink-0 text-red-600"
        ></i>

        <div>
          <h3 class="font-semibold text-red-800">
            Please correct the following:
          </h3>

          <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-red-700">
            <% @service.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <p class="block text-sm font-semibold text-slate-700">
      Service icon
    </p>

    <p class="mt-1 text-xs text-slate-500">
      Choose an icon that best represents this service.
    </p>

    <div class="mt-4 grid grid-cols-5 gap-2 sm:grid-cols-12">
      <% Service::ICONS.each do |icon_name, icon_label| %>
        <% input_id = "service_icon_#{icon_name}" %>

        <label
          for="<%= input_id %>"
          title="<%= icon_label %>"
          class="group relative cursor-pointer"
        >
          <%= form.radio_button(
                :icon,
                icon_name,
                id: input_id,
                class: "peer sr-only"
              ) %>

          <span
            class="flex aspect-square items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 transition group-hover:border-indigo-300 group-hover:bg-indigo-50 group-hover:text-indigo-600 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-600 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-200"
          >
            <i
              data-lucide="<%= icon_name %>"
              class="h-5 w-5"
            ></i>
          </span>

          <span class="sr-only">
            <%= icon_label %>
          </span>

          <span
            class="pointer-events-none absolute -right-1 -top-1 hidden h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-white shadow-sm peer-checked:flex"
          >
            <i data-lucide="check" class="h-3 w-3"></i>
          </span>
        </label>
      <% end %>
    </div>

    <p class="mt-3 text-xs text-slate-500">
      Hover over an icon to see its meaning.
    </p>
  </div>


  <% if @business.feature_enabled?(:service_images) %>
    <div data-controller="image-preview">
      <%= form.label :image,
                     "Service image",
                     class: "block text-sm font-semibold text-slate-700" %>

      <p class="mt-1 text-xs text-slate-500">
        Upload an image that represents this service.
      </p>

      <div class="mt-4 flex flex-wrap items-start gap-5">
        <% if @service.image.attached? %>
          <%= image_tag(
                @service.image.variant(resize_to_fill: [160, 160]),
                data: { image_preview_target: "image" },
                class: "h-40 w-40 rounded-2xl border border-slate-200 object-cover"
              ) %>
        <% else %>
          <div
            data-image-preview-target="placeholder"
            class="flex h-40 w-40 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 text-sm text-slate-400"
          >
            No image
          </div>

          <img
            data-image-preview-target="image"
            class="hidden h-40 w-40 rounded-2xl border border-slate-200 object-cover"
          >
        <% end %>

        <div class="flex flex-col gap-3">
          <%= form.file_field(
                :image,
                accept: "image/png,image/jpeg,image/webp",
                data: {
                  image_preview_target: "input",
                  action: "change->image-preview#show"
                },
                class: "block text-sm text-slate-600 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100"
              ) %>

          <% if @service.persisted? && @service.image.attached? %>
            <%= button_to(
                  "Remove image",
                  remove_image_admin_customer_service_path(@customer, @service),
                  method: :delete,
                  form: {
                    data: { turbo_confirm: "Remove this service image?" }
                  },
                  class: "text-left text-sm font-semibold text-red-600 hover:text-red-700"
                ) %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>


  <div class="mt-6">
    <%= form.label(
          :name,
          "Service name",
          class: "block text-sm font-semibold text-slate-700"
        ) %>

    <%= form.text_field(
          :name,
          required: true,
          autofocus: true,
          placeholder: "For example, Standard Appointment",
          class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
        ) %>
  </div>

  <div class="mt-6">
    <%= form.label(
          :description,
          class: "block text-sm font-semibold text-slate-700"
        ) %>

    <%= form.text_area(
          :description,
          rows: 5,
          placeholder: "Describe what is included in this service...",
          class: "mt-2 w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
        ) %>
  </div>


  <% if @business.feature_enabled?(:service_categories) %>
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5 mt-6 mb-6">
      <div class="flex items-start gap-3">
        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-slate-500 shadow-sm ring-1 ring-slate-200">
          <i data-lucide="tags" class="h-4 w-4"></i>
        </div>

        <div class="min-w-0 flex-1">
          <%= form.label(
                :service_category_id,
                "Service category",
                class: "block text-sm font-semibold text-slate-700"
              ) %>

          <p class="mt-1 text-xs text-slate-500">
            Organise this service into a category.
          </p>

          <%= form.collection_select(
                :service_category_id,
                @business.service_categories.order(:name),
                :id,
                :name,
                { include_blank: "No category" },
                class: "mt-4 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>
        </div>
      </div>
    </div>
  <% end %>


  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label(
            :price,
            "Price (£)",
            class: "block text-sm font-semibold text-slate-700"
          ) %>

      <%= form.number_field(
            :price,
            min: 0,
            step: 0.01,
            required: true,
            placeholder: "0.00",
            class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          ) %>
    </div>

    <div>
      <%= form.label(
            :minutes_duration,
            "Duration",
            class: "block text-sm font-semibold text-slate-700"
          ) %>

      <%= form.number_field(
            :minutes_duration,
            min: 5,
            step: 5,
            required: true,
            placeholder: "30",
            class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          ) %>

      <p class="mt-2 text-xs text-slate-500">
        Enter the duration in minutes.
      </p>
    </div>
  </div>

  <% if @business.stripe_ready? %>
    <div
      class="rounded-xl border border-slate-200 bg-slate-50 p-5"
      data-controller="deposit"
    >
      <div class="flex items-start gap-3">
        <%= form.check_box(
              :deposit_enabled,
              class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500",
              data: {
                deposit_target: "checkbox",
                action: "deposit#toggle"
              }
            ) %>

        <div class="flex-1">
          <%= form.label(
                :deposit_enabled,
                "Require a deposit",
                class: "block cursor-pointer text-sm font-semibold text-slate-700"
              ) %>

          <p class="mt-1 text-xs text-slate-500">
            Customers will need to pay a deposit when booking this service.
          </p>
        </div>
      </div>

      <div
        class="mt-5 <%= 'hidden' unless @service.deposit_enabled? %>"
        data-deposit-target="container"
      >
        <%= form.label(
              :deposit,
              "Deposit amount (£)",
              class: "block text-sm font-semibold text-slate-700"
            ) %>

        <%= form.number_field(
              :deposit,
              min: 0.01,
              step: 0.01,
              max: @service.price,
              placeholder: "0.00",
              disabled: !@service.deposit_enabled?,
              data: {
                deposit_target: "input"
              },
              class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 disabled:cursor-not-allowed disabled:bg-slate-100"
            ) %>

        <p class="mt-2 text-xs text-slate-500">
          The deposit cannot be greater than the full service price.
        </p>
      </div>
    </div>
  <% end %>


  <% if @business.feature_enabled?(:service_times) %>
    <% has_custom_times = @service.service_times.any?(&:persisted?) ||
                          @service.service_times.any? { |time| time.start_time.present? || time.end_time.present? } %>

    <div class="rounded-xl border border-slate-200 bg-slate-50 p-5 mt-6 mb-6">
      <div class="flex items-start gap-3">
        <%= form.check_box(
              :custom_service_times,
              {
                checked: has_custom_times,
                class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500",
                data: {
                  service_times_target: "checkbox",
                  action: "service-times#toggle"
                }
              },
              "1",
              "0"
            ) %>

        <div class="flex-1">
          <%= form.label(
                :custom_service_times,
                "Set custom service times",
                class: "block cursor-pointer text-sm font-semibold text-slate-700"
              ) %>

          <p class="mt-1 text-xs text-slate-500">
            Restrict this service to specific opening times.
            When disabled, the service will use the business's
            normal opening hours.
          </p>
        </div>
      </div>

      <div
        class="mt-5 <%= 'hidden' unless has_custom_times %>"
        data-service-times-target="container"
      >
        <%= form.fields_for :service_times do |time_form| %>
          <div class="mb-4 grid gap-5 sm:grid-cols-2">
            <div>
              <%= time_form.label(
                    :start_time,
                    "Available from",
                    class: "block text-sm font-semibold text-slate-700"
                  ) %>

              <%= time_form.time_field(
                    :start_time,
                    disabled: !has_custom_times,
                    data: { service_times_target: "input" },
                    class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                  ) %>
            </div>

            <div>
              <%= time_form.label(
                    :end_time,
                    "Available until",
                    class: "block text-sm font-semibold text-slate-700"
                  ) %>

              <%= time_form.time_field(
                    :end_time,
                    disabled: !has_custom_times,
                    data: { service_times_target: "input" },
                    class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                  ) %>
            </div>
          </div>
        <% end %>

        <p class="mt-2 text-xs text-slate-500">
          Customers can only book this service between the selected times.
        </p>
      </div>
    </div>
  <% end %>


  <div>
    <%= form.label(
          :business_agent_ids,
          "Assigned agents",
          class: "block text-sm font-semibold text-slate-700"
        ) %>

    <p class="mt-1 text-xs text-slate-500">
      Select which staff members can provide this service.
    </p>

    <%= hidden_field_tag "service[business_agent_ids][]", "" %>

    <% if @agents.any? %>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <% @agents.each do |agent| %>
          <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-indigo-300">
            <%= check_box_tag(
                  "service[business_agent_ids][]",
                  agent.id,
                  @service.business_agents.include?(agent),
                  id: "agent_#{agent.id}",
                  class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                ) %>

            <div>
              <p class="text-sm font-semibold text-slate-900">
                <%= agent.user.full_name %>
              </p>

              <p class="text-xs text-slate-500">
                <%= agent.user.email %>
              </p>
            </div>
          </label>
        <% end %>
      </div>
    <% else %>
      <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-5 text-sm text-slate-500">
        This business has no active agents to assign.
      </div>
    <% end %>
  </div>



  <div class="mt-6">
    <%= form.label(
          :status,
          class: "block text-sm font-semibold text-slate-700"
        ) %>

    <%= form.select(
          :status,
          Service::STATUSES.map { |status| [status.titleize, status] },
          {},
          class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
        ) %>

    <p class="mt-2 text-xs text-slate-500">
      Inactive services will not be available for new bookings.
    </p>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
    <%= link_to(
          "Cancel",
          admin_customer_path(@customer, tab: "services"),
          class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        ) %>

    <%= form.submit(
          @service.persisted? ? "Update service" : "Create service",
          class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        ) %>
  </div>
<% end %>