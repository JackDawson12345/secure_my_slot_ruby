<main class="p-4 sm:p-6 lg:p-8">
  <nav class="mb-5 flex items-center gap-2 text-sm text-slate-500">
    <%= link_to(
          "Customers",
          admin_customers_path,
          class: "hover:text-indigo-600"
        ) %>

    <i data-lucide="chevron-right" class="h-4 w-4"></i>

    <%= link_to(
          @business.business_name,
          admin_customer_path(@customer, tab: "website_settings"),
          class: "hover:text-indigo-600"
        ) %>

    <i data-lucide="chevron-right" class="h-4 w-4"></i>

    <span class="font-medium text-slate-900">
      Edit website
    </span>
  </nav>

  <section class=" overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-5 sm:p-6">
      <h1 class="text-2xl font-bold text-slate-900">
        Edit website settings
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        Manage the public booking page content.
      </p>
    </div>

    <div class="p-5 sm:p-6">
      <%= form_with(
            model: @website,
            url: admin_customer_website_settings_path(@customer),
            method: :patch,
            class: "space-y-6"
          ) do |form| %>

        <% if @website.errors.any? %>
          <div class="rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="font-semibold text-red-900">
              Please correct the following:
            </p>

            <ul class="mt-2 list-inside list-disc text-sm text-red-700">
              <% @website.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label(
                :colour,
                "Website colour",
                class: "block text-sm font-semibold text-slate-700"
              ) %>

          <%= form.select(
                :colour,
                options_for_select(
                  %w[
                    indigo
                    violet
                    blue
                    emerald
                    amber
                    rose
                    slate
                  ].map { |colour| [colour.titleize, colour] },
                  @website.colour
                ),
                {},
                class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>
        </div>

        <% [
             [:hero, "Hero section"],
             [:services, "Services section"],
             [:about_us, "About section"],
             [:visit, "Visit section"]
           ].each do |field, label| %>
          <div>
            <%= form.label(
                  field,
                  label,
                  class: "block text-sm font-semibold text-slate-700"
                ) %>

            <%= form.text_area(
                  field,
                  rows: 6,
                  class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm leading-6 text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                ) %>
          </div>
        <% end %>

        <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
          <%= link_to(
                "Cancel",
                admin_customer_path(@customer, tab: "website_settings"),
                class: "inline-flex items-center justify-center rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50"
              ) %>

          <%= form.submit(
                "Save website settings",
                class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"
              ) %>
        </div>
      <% end %>
    </div>
  </section>
</main>