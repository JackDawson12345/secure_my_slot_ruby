<% owner_name = [
  @customer.first_name,
  @customer.last_name
].compact_blank.join(" ") %>

<% owner_name = @customer.email.split("@").first.titleize if owner_name.blank? %>

<% initials = [
  @customer.first_name,
  @customer.last_name
].compact_blank.filter_map { |name| name.first }.join.upcase %>

<% initials = owner_name
  .split
  .filter_map { |name| name.first }
  .first(2)
  .join
  .upcase if initials.blank? %>

<% booking_page_live =
     @business&.business_setting&.booking_page_live? %>

<% tabs = [
  {
    key: "overview",
    label: "Overview",
    icon: "layout-dashboard"
  },
  {
    key: "bookings",
    label: "Bookings",
    icon: "calendar-days",
    count: @total_bookings
  },
  {
    key: "customers",
    label: "Customers",
    icon: "users",
    count: @total_booking_customers
  },
  {
    key: "services",
    label: "Services",
    icon: "briefcase-business",
    count: @total_services
  },
  {
    key: "opening_hours",
    label: "Opening hours",
    icon: "clock-3"
  },
  {
    key: "website_settings",
    label: "Website",
    icon: "monitor"
  },
  {
    key: "settings",
    label: "Settings",
    icon: "settings"
  }
] %>

<main class="p-4 sm:p-6 lg:p-8">
  <!-- Breadcrumb -->
  <nav class="mb-5 flex items-center gap-2 text-sm text-slate-500">
    <%= link_to(
          "Customers",
          admin_customers_path,
          class: "transition hover:text-indigo-600"
        ) %>

    <i data-lucide="chevron-right" class="h-4 w-4"></i>

    <span class="font-medium text-slate-900">
      <%= @business&.business_name.presence || owner_name %>
    </span>
  </nav>

  <!-- Header -->
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-col gap-6 p-5 sm:p-7 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex min-w-0 items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-100 text-lg font-bold text-indigo-700 sm:h-16 sm:w-16">
          <%= initials.presence || "BU" %>
        </div>

        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="truncate text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              <%= @business&.business_name.presence || "Business not configured" %>
            </h1>

            <% if booking_page_live %>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Booking page live
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                Booking page offline
              </span>
            <% end %>
          </div>

          <p class="mt-2 text-sm text-slate-500">
            Account owner:
            <span class="font-medium text-slate-700">
              <%= owner_name %>
            </span>
          </p>

          <p class="mt-1 text-sm text-slate-500">
            Joined <%= @customer.created_at.strftime("%-d %B %Y") %>
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <%= mail_to(
              @customer.email,
              class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
            ) do %>
          <i data-lucide="mail" class="h-4 w-4"></i>
          Email customer
        <% end %>

        <% if @business&.page_address.present? %>
          <%= link_to(
                "http://#{@business.page_address}.lvh.me:3000",
                target: "_blank",
                rel: "noopener",
                class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700"
              ) do %>
            <i data-lucide="external-link" class="h-4 w-4"></i>
            View booking page
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Tabs -->
    <div class="border-t border-slate-200">
      <nav class="flex overflow-x-auto px-4 sm:px-6" aria-label="Customer sections">
        <% tabs.each do |tab| %>
          <% active = @active_tab == tab[:key] %>

          <%= link_to(
                admin_customer_path(
                  @customer,
                  tab: tab[:key]
                ),
                class: [
                  "inline-flex shrink-0 items-center gap-2 border-b-2 px-3 py-4 text-sm font-semibold transition sm:px-4",
                  active ?
                    "border-indigo-600 text-indigo-600" :
                    "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-800"
                ].join(" "),
                aria: {
                  current: active ? "page" : nil
                }
              ) do %>
            <i
              data-lucide="<%= tab[:icon] %>"
              class="h-4 w-4"
            ></i>

            <span><%= tab[:label] %></span>

            <% if tab[:count].present? %>
              <span class="<%= active ? "bg-indigo-50 text-indigo-700" : "bg-slate-100 text-slate-600" %> rounded-full px-2 py-0.5 text-xs">
                <%= tab[:count] %>
              </span>
            <% end %>
          <% end %>
        <% end %>
      </nav>
    </div>
  </section>

  <% if @business.blank? %>
    <section class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-6">
      <div class="flex items-start gap-3">
        <i
          data-lucide="triangle-alert"
          class="mt-0.5 h-5 w-5 shrink-0 text-amber-600"
        ></i>

        <div>
          <h2 class="font-semibold text-amber-900">
            Business profile not configured
          </h2>

          <p class="mt-1 text-sm text-amber-800">
            This user has a business role but does not currently have an
            associated business record.
          </p>
        </div>
      </div>
    </section>
  <% else %>
    <!-- Overview -->
    <% if @active_tab == "overview" %>
      <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">
                Total bookings
              </p>

              <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
                <%= @total_bookings %>
              </p>
            </div>

            <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
              <i data-lucide="calendar-days" class="h-5 w-5"></i>
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">
                Booking customers
              </p>

              <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
                <%= @total_booking_customers %>
              </p>
            </div>

            <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
              <i data-lucide="users" class="h-5 w-5"></i>
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">
                Services
              </p>

              <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
                <%= @total_services %>
              </p>
            </div>

            <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
              <i data-lucide="briefcase-business" class="h-5 w-5"></i>
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">
                Upcoming bookings
              </p>

              <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
                <%= @upcoming_bookings.size %>
              </p>
            </div>

            <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
              <i data-lucide="calendar-clock" class="h-5 w-5"></i>
            </div>
          </div>
        </article>
      </section>

      <section class="mt-6 grid gap-6 xl:grid-cols-3">
        <!-- Account information -->
        <article class="rounded-2xl border border-slate-200 bg-white shadow-sm xl:col-span-2">
          <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
            <h2 class="font-bold text-slate-900">
              Account information
            </h2>
          </div>

          <dl class="grid gap-x-8 gap-y-6 p-5 sm:grid-cols-2 sm:p-6">
            <div>
              <dt class="text-sm font-medium text-slate-500">
                Account owner
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= owner_name %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Email address
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @customer.email %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Phone number
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @customer.phone_number.presence || "Not provided" %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Role
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @customer.role.to_s.titleize %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Business name
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @business.business_name %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Booking page address
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @business.page_address.presence || "Not configured" %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Account created
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @customer.created_at.strftime("%-d %B %Y at %-I:%M %p") %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Last updated
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @customer.updated_at.strftime("%-d %B %Y at %-I:%M %p") %>
              </dd>
            </div>
          </dl>
        </article>

        <!-- Business information -->
        <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="font-bold text-slate-900">
              Business details
            </h2>
          </div>

          <dl class="space-y-5 p-5">
            <div>
              <dt class="text-sm font-medium text-slate-500">
                Category
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @business.business_setting&.business_category.presence ||
                      "Not provided" %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Business email
              </dt>

              <dd class="mt-1 break-all text-sm font-semibold text-slate-900">
                <%= @business.business_setting&.business_email.presence ||
                      @customer.email %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Business phone
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= @business.business_setting&.phone_number.presence ||
                      @customer.phone_number.presence ||
                      "Not provided" %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Address
              </dt>

              <dd class="mt-1 text-sm font-semibold leading-6 text-slate-900">
                <% address_parts = [
                  @business.business_setting&.address_line_1,
                  @business.business_setting&.address_line_2,
                  @business.business_setting&.town_or_city,
                  @business.business_setting&.postcode,
                  @business.business_setting&.country
                ].compact_blank %>

                <%= address_parts.any? ?
                      safe_join(address_parts, tag.br) :
                      "Not provided" %>
              </dd>
            </div>
          </dl>
        </article>
      </section>

      <!-- Recent bookings -->
      <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 sm:px-6">
          <div>
            <h2 class="font-bold text-slate-900">
              Recent bookings
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              The latest bookings received by this business.
            </p>
          </div>

          <%= link_to(
                "View all",
                admin_customer_path(@customer, tab: "bookings"),
                class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700"
              ) %>
        </div>

        <div class="divide-y divide-slate-100">
          <% @bookings.first(5).each do |booking| %>
            <% booking_customer_name = [
              booking.user&.first_name,
              booking.user&.last_name
            ].compact_blank.join(" ") %>

            <% booking_customer_name =
                 booking.user&.email.presence ||
                 "Unknown customer" if booking_customer_name.blank? %>

            <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
              <div>
                <p class="font-semibold text-slate-900">
                  <%= booking_customer_name %>
                </p>

                <p class="mt-1 text-sm text-slate-500">
                  <%= booking.service&.name || "Service unavailable" %>
                </p>
              </div>

              <div class="sm:text-right">
                <p class="text-sm font-semibold text-slate-900">
                  <%= booking.date.strftime("%-d %B %Y") %>
                </p>

                <p class="mt-1 text-sm text-slate-500">
                  <%= booking.time.strftime("%-I:%M %p") %>
                </p>
              </div>
            </div>
          <% end %>

          <% if @bookings.empty? %>
            <div class="px-5 py-12 text-center">
              <p class="font-semibold text-slate-900">
                No bookings yet
              </p>

              <p class="mt-1 text-sm text-slate-500">
                Bookings will appear here once customers make appointments.
              </p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Bookings -->
    <% if @active_tab == "bookings" %>
      <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold text-slate-900">
            Bookings
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            All bookings received by this business.
          </p>
        </div>

        <div class="hidden overflow-x-auto md:block">
          <table class="min-w-full">
            <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Customer
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Service
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Date
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Time
              </th>

              <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Status
              </th>
            </tr>
            </thead>

            <tbody class="divide-y divide-slate-100">
            <% @bookings.each do |booking| %>
              <% booking_customer_name = [
                booking.user&.first_name,
                booking.user&.last_name
              ].compact_blank.join(" ") %>

              <% booking_customer_name =
                   booking.user&.email.presence ||
                   "Unknown customer" if booking_customer_name.blank? %>

              <% starts_at =
                   if booking.date.present? && booking.time.present?
                     Time.zone.parse(
                       "#{booking.date} #{booking.time.strftime('%H:%M')}"
                     )
                   end %>

              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4">
                  <p class="text-sm font-semibold text-slate-900">
                    <%= booking_customer_name %>
                  </p>

                  <p class="mt-0.5 text-xs text-slate-500">
                    <%= booking.user&.email %>
                  </p>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-700">
                  <%= booking.service&.name || "Service unavailable" %>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-slate-900">
                  <%= booking.date.strftime("%-d %B %Y") %>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-700">
                  <%= booking.time.strftime("%-I:%M %p") %>
                </td>

                <td class="whitespace-nowrap px-6 py-4">
                  <% if starts_at&.future? %>
                      <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
                        Upcoming
                      </span>
                  <% else %>
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                        Completed
                      </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>

        <div class="divide-y divide-slate-100 md:hidden">
          <% @bookings.each do |booking| %>
            <% booking_customer_name = [
              booking.user&.first_name,
              booking.user&.last_name
            ].compact_blank.join(" ") %>

            <% booking_customer_name =
                 booking.user&.email.presence ||
                 "Unknown customer" if booking_customer_name.blank? %>

            <article class="p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold text-slate-900">
                    <%= booking_customer_name %>
                  </p>

                  <p class="mt-1 text-sm text-slate-500">
                    <%= booking.service&.name || "Service unavailable" %>
                  </p>
                </div>

                <p class="shrink-0 text-sm font-semibold text-slate-900">
                  <%= booking.time.strftime("%-I:%M %p") %>
                </p>
              </div>

              <p class="mt-4 text-sm text-slate-500">
                <%= booking.date.strftime("%-d %B %Y") %>
              </p>
            </article>
          <% end %>
        </div>

        <% if @bookings.empty? %>
          <div class="px-5 py-14 text-center">
            <i
              data-lucide="calendar-x"
              class="mx-auto h-8 w-8 text-slate-400"
            ></i>

            <p class="mt-4 font-semibold text-slate-900">
              No bookings
            </p>

            <p class="mt-1 text-sm text-slate-500">
              This business has not received any bookings.
            </p>
          </div>
        <% end %>
      </section>
    <% end %>

    <!-- Customers -->
    <% if @active_tab == "customers" %>
      <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold text-slate-900">
            Booking customers
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Customers who have booked with this business.
          </p>
        </div>

        <div class="divide-y divide-slate-100">
          <% @booking_customers.each do |booking_customer| %>
            <% customer_name = [
              booking_customer.first_name,
              booking_customer.last_name
            ].compact_blank.join(" ") %>

            <% customer_name =
                 booking_customer.email.split("@").first.titleize if customer_name.blank? %>

            <% customer_bookings = @bookings.select do |booking|
              booking.user_id == booking_customer.id
            end %>

            <% last_booking = customer_bookings.max_by do |booking|
              [
                booking.date,
                booking.time
              ]
            end %>

            <article class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
              <div>
                <p class="font-semibold text-slate-900">
                  <%= customer_name %>
                </p>

                <p class="mt-1 text-sm text-slate-500">
                  <%= booking_customer.email %>
                </p>

                <% if booking_customer.phone_number.present? %>
                  <p class="mt-1 text-sm text-slate-500">
                    <%= booking_customer.phone_number %>
                  </p>
                <% end %>
              </div>

              <div class="flex gap-8 sm:text-right">
                <div>
                  <p class="text-xs font-medium uppercase tracking-wider text-slate-500">
                    Bookings
                  </p>

                  <p class="mt-1 font-semibold text-slate-900">
                    <%= customer_bookings.size %>
                  </p>
                </div>

                <div>
                  <p class="text-xs font-medium uppercase tracking-wider text-slate-500">
                    Last booking
                  </p>

                  <p class="mt-1 font-semibold text-slate-900">
                    <%= last_booking&.date&.strftime("%-d %B %Y") ||
                          "None" %>
                  </p>
                </div>
              </div>
            </article>
          <% end %>

          <% if @booking_customers.empty? %>
            <div class="px-5 py-14 text-center">
              <i
                data-lucide="users"
                class="mx-auto h-8 w-8 text-slate-400"
              ></i>

              <p class="mt-4 font-semibold text-slate-900">
                No booking customers
              </p>

              <p class="mt-1 text-sm text-slate-500">
                Customers will appear after they make a booking.
              </p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Services -->
    <% if @active_tab == "services" %>
      <section class="mt-8">
        <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-lg font-bold text-slate-900">
              Services
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Services offered by this business.
            </p>
          </div>

          <%= link_to(
                new_admin_customer_service_path(@customer),
                class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700"
              ) do %>
            <i data-lucide="plus" class="h-4 w-4"></i>
            Add service
          <% end %>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <% @services.each do |service| %>
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="font-bold text-slate-900">
                    <%= service.name %>
                  </h3>

                  <% if service.respond_to?(:description) &&
                        service.description.present? %>
                    <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-500">
                      <%= service.description %>
                    </p>
                  <% end %>
                </div>

                <div class="rounded-xl bg-indigo-50 p-2.5 text-indigo-600">
                  <i
                    data-lucide="<%= service.icon.presence || 'calendar-check' %>"
                    class="h-6 w-6"
                  ></i>
                </div>
              </div>

              <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-slate-100 pt-4">
                <div>
                  <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">
                    Duration
                  </dt>

                  <dd class="mt-1 text-sm font-semibold text-slate-900">
                    <%= service.respond_to?(:minutes_duration) ?
                          "#{service.minutes_duration} minutes" :
                          "Not available" %>
                  </dd>
                </div>

                <div>
                  <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">
                    Price
                  </dt>

                  <dd class="mt-1 text-sm font-semibold text-slate-900">
                    <% if service.respond_to?(:price) && service.price.present? %>
                      <%= number_to_currency(
                            service.price,
                            unit: "£"
                          ) %>
                    <% else %>
                      Not available
                    <% end %>
                  </dd>
                </div>
              </dl>

              <div class="mt-5 flex items-center gap-3 border-t border-slate-100 pt-4">
                <%= link_to(
                      edit_admin_customer_service_path(@customer, service),
                      class: "inline-flex flex-1 items-center justify-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    ) do %>
                  <i data-lucide="pencil" class="h-4 w-4"></i>
                  Edit
                <% end %>

                <%= button_to(
                      admin_customer_service_path(@customer, service),
                      method: :delete,
                      form: {
                        class: "flex-1",
                        data: {
                          turbo_confirm: "Are you sure you want to remove #{service.name}?"
                        }
                      },
                      class: "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-red-200 px-3 py-2 text-sm font-semibold text-red-600 transition hover:bg-red-50"
                    ) do %>
                  <i data-lucide="trash-2" class="h-4 w-4"></i>
                  Remove
                <% end %>
              </div>
            </article>
          <% end %>
        </div>

        <% if @services.empty? %>
          <div class="rounded-2xl border border-slate-200 bg-white px-5 py-14 text-center shadow-sm">
            <i
              data-lucide="briefcase-business"
              class="mx-auto h-8 w-8 text-slate-400"
            ></i>

            <p class="mt-4 font-semibold text-slate-900">
              No services
            </p>

            <p class="mt-1 text-sm text-slate-500">
              This business has not created any services.
            </p>
          </div>
        <% end %>
      </section>
    <% end %>

    <!-- Opening hours -->
    <% if @active_tab == "opening_hours" %>
      <% days = %w[
           monday
           tuesday
           wednesday
           thursday
           friday
           saturday
           sunday
         ] %>

      <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6 flex justify-between items-center">
          <div>
            <h2 class="text-lg font-bold text-slate-900">
              Opening hours
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Current weekly booking availability.
            </p>
          </div>

          <%= link_to(
                edit_admin_customer_opening_hours_path(@customer),
                class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"
              ) do %>
            <i data-lucide="pencil" class="h-4 w-4"></i>
            Edit opening hours
          <% end %>
        </div>

        <div class="divide-y divide-slate-100">
          <% days.each do |day| %>
            <% opening_hour = @opening_hours.find do |record|
              record.day_of_week.to_s == day
            end %>

            <div class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
              <p class="font-semibold text-slate-900">
                <%= day.titleize %>
              </p>

              <% if opening_hour&.open? %>
                <p class="text-sm font-semibold text-slate-700">
                  <%= opening_hour.opens_at.strftime("%-I:%M %p") %>
                  <span class="mx-1 text-slate-400">to</span>
                  <%= opening_hour.closes_at.strftime("%-I:%M %p") %>
                </p>
              <% else %>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                  Closed
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Website settings -->
    <% if @active_tab == "website_settings" %>
      <% website = @business.business_website %>

      <section class="mt-8 grid gap-6 xl:grid-cols-3">
        <article class="rounded-2xl border border-slate-200 bg-white shadow-sm xl:col-span-2">
          <div class="border-b border-slate-200 px-5 py-5 sm:px-6 flex justify-between items-center">
            <div>
              <h2 class="text-lg font-bold text-slate-900">
                Website content
              </h2>

              <p class="mt-1 text-sm text-slate-500">
                Content configured for the public booking page.
              </p>
            </div>

            <%= link_to(
                  edit_admin_customer_website_settings_path(@customer),
                  class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"
                ) do %>
              <i data-lucide="pencil" class="h-4 w-4"></i>
              Edit website
            <% end %>
          </div>

          <% if website.present? %>
            <dl class="divide-y divide-slate-100">
              <div class="px-5 py-5 sm:px-6">
                <dt class="text-sm font-semibold text-slate-900">
                  Hero section
                </dt>

                <dd class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600">
                  <%= website.hero.presence || "Not configured" %>
                </dd>
              </div>

              <div class="px-5 py-5 sm:px-6">
                <dt class="text-sm font-semibold text-slate-900">
                  Services section
                </dt>

                <dd class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600">
                  <%= website.services.presence || "Not configured" %>
                </dd>
              </div>

              <div class="px-5 py-5 sm:px-6">
                <dt class="text-sm font-semibold text-slate-900">
                  About section
                </dt>

                <dd class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600">
                  <%= website.about_us.presence || "Not configured" %>
                </dd>
              </div>

              <div class="px-5 py-5 sm:px-6">
                <dt class="text-sm font-semibold text-slate-900">
                  Visit section
                </dt>

                <dd class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600">
                  <%= website.visit.presence || "Not configured" %>
                </dd>
              </div>
            </dl>
          <% else %>
            <div class="px-5 py-14 text-center">
              <i
                data-lucide="monitor-x"
                class="mx-auto h-8 w-8 text-slate-400"
              ></i>

              <p class="mt-4 font-semibold text-slate-900">
                No website settings
              </p>

              <p class="mt-1 text-sm text-slate-500">
                This business has not configured its booking website.
              </p>
            </div>
          <% end %>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-5">
            <h2 class="font-bold text-slate-900">
              Website details
            </h2>
          </div>

          <dl class="space-y-5 p-5">
            <div>
              <dt class="text-sm font-medium text-slate-500">
                Page address
              </dt>

              <dd class="mt-1 break-all text-sm font-semibold text-slate-900">
                <%= @business.page_address.presence || "Not configured" %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Colour
              </dt>

              <dd class="mt-1 text-sm font-semibold text-slate-900">
                <%= website&.colour&.titleize || "Not configured" %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-slate-500">
                Status
              </dt>

              <dd class="mt-2">
                <% if booking_page_live %>
                  <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                    Live
                  </span>
                <% else %>
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                    Offline
                  </span>
                <% end %>
              </dd>
            </div>
          </dl>
        </article>
      </section>
    <% end %>

    <!-- Settings -->
    <% if @active_tab == "settings" %>
      <% settings = @business.business_setting %>

      <section class="mt-8 space-y-6">
        <!-- Subscription -->
        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="flex flex-col gap-4 border-b border-slate-200 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div>
              <h2 class="text-lg font-bold text-slate-900">
                Subscription
              </h2>

              <p class="mt-1 text-sm text-slate-500">
                The current subscription access for this business.
              </p>
            </div>

            <%= link_to(
                  edit_admin_customer_settings_path(@customer),
                  class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"
                ) do %>
              <i data-lucide="pencil" class="h-4 w-4"></i>
              Edit settings
            <% end %>
          </div>

          <div class="flex flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div class="flex items-start gap-3">
              <div class="<%= @business.subscribed? ? "bg-emerald-50 text-emerald-600" : "bg-slate-100 text-slate-500" %> flex h-11 w-11 shrink-0 items-center justify-center rounded-xl">
                <i
                  data-lucide="<%= @business.subscribed? ? "badge-check" : "badge-x" %>"
                  class="h-5 w-5"
                ></i>
              </div>

              <div>
                <p class="font-semibold text-slate-900">
                  Active subscription
                </p>

                <p class="mt-1 text-sm text-slate-500">
                  <% if @business.subscribed? %>
                    This business currently has access to subscribed features.
                  <% else %>
                    This business does not currently have subscription access.
                  <% end %>
                </p>
              </div>
            </div>

            <% if @business.subscribed? %>
          <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Enabled
          </span>
            <% else %>
          <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
            Disabled
          </span>
            <% end %>
          </div>
        </article>

        <div class="grid gap-6 xl:grid-cols-2">
          <!-- Booking settings -->
          <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <h2 class="text-lg font-bold text-slate-900">
                Booking settings
              </h2>

              <p class="mt-1 text-sm text-slate-500">
                Current booking and notification preferences.
              </p>
            </div>

            <% if settings.present? %>
              <dl class="divide-y divide-slate-100">
                <% [
                     [
                       "Booking page live",
                       settings.booking_page_live
                     ],
                     [
                       "Automatically confirm bookings",
                       settings.automatically_confirm_bookings
                     ],
                     [
                       "Allow customer cancellations",
                       settings.allow_customer_cancellations
                     ],
                     [
                       "Require customer phone number",
                       settings.require_customer_phone_number
                     ],
                     [
                       "New booking notifications",
                       settings.new_booking_notifications
                     ],
                     [
                       "Cancellation notifications",
                       settings.cancellation_notifications
                     ],
                     [
                       "Daily appointment summary",
                       settings.daily_appointment_summary
                     ]
                   ].each do |label, enabled| %>
                  <div class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
                    <dt class="text-sm font-medium text-slate-700">
                      <%= label %>
                    </dt>

                    <dd>
                      <% if enabled %>
                    <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                      Enabled
                    </span>
                      <% else %>
                    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                      Disabled
                    </span>
                      <% end %>
                    </dd>
                  </div>
                <% end %>
              </dl>
            <% else %>
              <div class="px-5 py-14 text-center">
                <p class="font-semibold text-slate-900">
                  Settings not configured
                </p>
              </div>
            <% end %>
          </article>

          <!-- Cancellation settings -->
          <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <h2 class="text-lg font-bold text-slate-900">
                Cancellation settings
              </h2>

              <p class="mt-1 text-sm text-slate-500">
                Current cancellation and booking-page status.
              </p>
            </div>

            <dl class="space-y-6 p-5 sm:p-6">
              <div>
                <dt class="text-sm font-medium text-slate-500">
                  Cancellation notice
                </dt>

                <dd class="mt-1 text-lg font-bold text-slate-900">
                  <% if settings&.cancellation_notice_hours.present? %>
                    <%= pluralize(
                          settings.cancellation_notice_hours,
                          "hour"
                        ) %>
                  <% else %>
                    Not configured
                  <% end %>
                </dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-slate-500">
                  Booking page
                </dt>

                <dd class="mt-2">
                  <% if settings&.booking_page_live? %>
                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                  Accepting bookings
                </span>
                  <% else %>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                  Not accepting bookings
                </span>
                  <% end %>
                </dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-slate-500">
                  Subscription access
                </dt>

                <dd class="mt-2">
                  <% if @business.subscribed? %>
                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                  Subscribed
                </span>
                  <% else %>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                  Not subscribed
                </span>
                  <% end %>
                </dd>
              </div>
            </dl>
          </article>
        </div>
      </section>
    <% end %>
  <% end %>
</main>