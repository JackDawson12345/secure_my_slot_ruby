<!-- Customers content -->
<main class="p-4 sm:p-6 lg:p-8">
  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Customers
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Manage business customers, account details and booking activity.
      </p>
    </div>

    <%= link_to(
          new_admin_customer_path,
          class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700"
        ) do %>
      <i data-lucide="plus" class="h-4 w-4"></i>
      Add customer
    <% end %>
  </section>

  <!-- Customer statistics -->
  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Total customers -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Total Customers
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @total_customers %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="users" class="h-5 w-5"></i>
        </div>
      </div>

      <div class="mt-4 flex items-center gap-1 text-sm">
        <i
          data-lucide="trending-up"
          class="h-4 w-4 text-emerald-600"
        ></i>

        <span class="font-medium text-emerald-600">
          <%= @new_customers_this_month %> new
        </span>

        <span class="text-slate-500">
          this month
        </span>
      </div>
    </article>

    <!-- Active customers -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Live Booking Pages
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @active_customers %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="globe-2" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Currently accepting bookings
      </p>
    </article>

    <!-- New customers -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            New This Month
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @new_customers_this_month %>
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="user-plus" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Accounts created this month
      </p>
    </article>

    <!-- Total bookings -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Total Bookings
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @total_bookings %>
          </p>
        </div>

        <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
          <i data-lucide="calendar-check" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Across all customer accounts
      </p>
    </article>
  </section>

  <!-- Customers list -->
  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <!-- Toolbar -->
    <div class="border-b border-slate-200 p-5 sm:p-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h3 class="text-lg font-bold text-slate-900">
            All customers
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            View business details, services and booking activity.
          </p>
        </div>

        <%= form_with(
              url: admin_customers_path,
              method: :get,
              class: "flex flex-col gap-3 sm:flex-row",
              local: true
            ) do |form| %>
          <!-- Search -->
          <div class="relative min-w-0 sm:w-72">
            <i
              data-lucide="search"
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
            ></i>

            <%= form.search_field(
                  :query,
                  value: params[:query],
                  placeholder: "Search customers...",
                  class: "w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                ) %>
          </div>

          <!-- Status filter -->
          <%= form.select(
                :status,
                options_for_select(
                  [
                    ["All statuses", ""],
                    ["Booking page live", "live"],
                    ["Booking page offline", "offline"]
                  ],
                  params[:status]
                ),
                {},
                class: "rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>

          <%= form.submit(
                "Search",
                class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700"
              ) %>

          <% if params[:query].present? || params[:status].present? %>
            <%= link_to(
                  "Reset",
                  admin_customers_path,
                  class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                ) %>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Desktop table -->
    <div class="hidden overflow-x-auto lg:block">
      <table class="min-w-full">
        <thead class="bg-slate-50">
        <tr>
          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Business
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Contact
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Services
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Bookings
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Last Booking
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Joined
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Status
          </th>
        </tr>
        </thead>

        <tbody class="divide-y divide-slate-100 bg-white">
        <% @customers.each do |customer| %>
          <% business = customer.business %>

          <% full_name = [
            customer.first_name,
            customer.last_name
          ].compact_blank.join(" ") %>

          <% full_name = customer.email.split("@").first.titleize if full_name.blank? %>

          <% initials = [
            customer.first_name,
            customer.last_name
          ].compact_blank.filter_map { |name| name.first }.join.upcase %>

          <% initials = full_name.split.filter_map { |name| name.first }.first(2).join.upcase if initials.blank? %>

          <% bookings = business&.bookings || [] %>
          <% last_booking = bookings.max_by(&:created_at) %>
          <% booking_page_live = business&.business_setting&.booking_page_live? %>

          <tr class="transition hover:bg-slate-50">
            <!-- Business -->
            <td class="whitespace-nowrap px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
                  <%= initials.presence || "BU" %>
                </div>

                <div>
                  <p class="text-sm font-semibold text-slate-900">
                    <%= link_to(
                          business&.business_name.presence || "Business not configured",
                          admin_customer_path(customer),
                          class: "transition hover:text-indigo-600"
                        ) %>
                  </p>

                  <p class="mt-0.5 text-xs text-slate-500">
                    <% if business&.page_address.present? %>
                      /<%= business.page_address %>
                    <% else %>
                      No booking page address
                    <% end %>
                  </p>
                </div>
              </div>
            </td>

            <!-- Contact -->
            <td class="whitespace-nowrap px-6 py-4">
              <p class="text-sm font-medium text-slate-900">
                <%= full_name %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= customer.email %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= customer.phone_number.presence || "No phone number" %>
              </p>
            </td>

            <!-- Services -->
            <td class="whitespace-nowrap px-6 py-4">
              <p class="text-sm font-semibold text-slate-900">
                <%= business&.services&.size || 0 %>
              </p>
            </td>

            <!-- Bookings -->
            <td class="whitespace-nowrap px-6 py-4">
              <p class="text-sm font-semibold text-slate-900">
                <%= bookings.size %>
              </p>
            </td>

            <!-- Last booking -->
            <td class="whitespace-nowrap px-6 py-4">
              <% if last_booking.present? %>
                <p class="text-sm font-medium text-slate-900">
                  <%= last_booking.date.strftime("%-d %B %Y") %>
                </p>

                <% if last_booking.service.present? %>
                  <p class="mt-0.5 text-xs text-slate-500">
                    <%= last_booking.service.name %>
                  </p>
                <% end %>
              <% else %>
                <p class="text-sm text-slate-400">
                  No bookings
                </p>
              <% end %>
            </td>

            <!-- Joined -->
            <td class="whitespace-nowrap px-6 py-4">
              <p class="text-sm font-medium text-slate-900">
                <%= customer.created_at.strftime("%-d %B %Y") %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= time_ago_in_words(customer.created_at) %> ago
              </p>
            </td>

            <!-- Status -->
            <td class="whitespace-nowrap px-6 py-4">
              <% if booking_page_live %>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    Live
                  </span>
              <% else %>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                    Offline
                  </span>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @customers.empty? %>
          <tr>
            <td colspan="7" class="px-6 py-16 text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
                <i data-lucide="users" class="h-6 w-6"></i>
              </div>

              <p class="mt-4 font-semibold text-slate-900">
                No customers found
              </p>

              <p class="mt-1 text-sm text-slate-500">
                No customer accounts match the selected filters.
              </p>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile customer cards -->
    <div class="divide-y divide-slate-100 lg:hidden">
      <% @customers.each do |customer| %>
        <% business = customer.business %>

        <% full_name = [
          customer.first_name,
          customer.last_name
        ].compact_blank.join(" ") %>

        <% full_name = customer.email.split("@").first.titleize if full_name.blank? %>

        <% initials = [
          customer.first_name,
          customer.last_name
        ].compact_blank.filter_map { |name| name.first }.join.upcase %>

        <% initials = full_name.split.filter_map { |name| name.first }.first(2).join.upcase if initials.blank? %>

        <% bookings = business&.bookings || [] %>
        <% last_booking = bookings.max_by(&:created_at) %>
        <% booking_page_live = business&.business_setting&.booking_page_live? %>

        <article class="p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="flex min-w-0 items-center gap-3">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
                <%= initials.presence || "BU" %>
              </div>

              <div class="min-w-0">
                <p class="truncate font-semibold text-slate-900">
                  <%= link_to(
                        business&.business_name.presence || "Business not configured",
                        admin_customer_path(customer),
                        class: "transition hover:text-indigo-600"
                      ) %>
                </p>

                <p class="mt-0.5 truncate text-sm text-slate-500">
                  <%= full_name %>
                </p>

                <p class="mt-0.5 truncate text-xs text-slate-400">
                  <%= customer.email %>
                </p>
              </div>
            </div>

            <% if booking_page_live %>
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                Live
              </span>
            <% else %>
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                Offline
              </span>
            <% end %>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-slate-50 p-3">
              <p class="text-xs font-medium text-slate-500">
                Services
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-900">
                <%= business&.services&.size || 0 %>
              </p>
            </div>

            <div class="rounded-xl bg-slate-50 p-3">
              <p class="text-xs font-medium text-slate-500">
                Bookings
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-900">
                <%= bookings.size %>
              </p>
            </div>
          </div>

          <div class="mt-4 flex items-end justify-between gap-4">
            <div>
              <p class="text-xs font-medium text-slate-500">
                Joined
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-900">
                <%= customer.created_at.strftime("%-d %B %Y") %>
              </p>
            </div>

            <% if last_booking.present? %>
              <div class="text-right">
                <p class="text-xs font-medium text-slate-500">
                  Last booking
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-900">
                  <%= last_booking.date.strftime("%-d %B %Y") %>
                </p>
              </div>
            <% else %>
              <p class="text-right text-xs text-slate-400">
                No bookings
              </p>
            <% end %>
          </div>
        </article>
      <% end %>

      <% if @customers.empty? %>
        <div class="px-5 py-14 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
            <i data-lucide="users" class="h-6 w-6"></i>
          </div>

          <p class="mt-4 font-semibold text-slate-900">
            No customers found
          </p>

          <p class="mt-1 text-sm text-slate-500">
            No customer accounts match the selected filters.
          </p>
        </div>
      <% end %>
    </div>

    <!-- Customer count -->
    <% if @customers.any? %>
      <div class="border-t border-slate-200 px-5 py-4 sm:px-6">
        <p class="text-sm text-slate-500">
          Showing
          <span class="font-semibold text-slate-900">
            <%= @customers.size %>
          </span>
          <%= "customer".pluralize(@customers.size) %>
        </p>
      </div>
    <% end %>
  </section>
</main>