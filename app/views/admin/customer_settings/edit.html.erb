<main class="p-4 sm:p-6 lg:p-8">
  <nav class="mb-5 flex items-center gap-2 text-sm text-slate-500">
    <%= link_to(
          "Customers",
          admin_customers_path,
          class: "hover:text-indigo-600"
        ) %>

    <i data-lucide="chevron-right" class="h-4 w-4"></i>

    <%= link_to(
          @business.business_name,
          admin_customer_path(@customer, tab: "settings"),
          class: "hover:text-indigo-600"
        ) %>

    <i data-lucide="chevron-right" class="h-4 w-4"></i>

    <span class="font-medium text-slate-900">
      Edit settings
    </span>
  </nav>

  <%= form_with(
        model: @settings,
        url: admin_customer_settings_path(@customer),
        method: :patch,
        class: " space-y-6"
      ) do |form| %>

    <% if @settings.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 p-4">
        <p class="font-semibold text-red-900">
          Please correct the following:
        </p>

        <ul class="mt-2 list-inside list-disc text-sm text-red-700">
          <% @settings.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Business information -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 p-5 sm:p-6">
        <h1 class="text-xl font-bold text-slate-900">
          Business information
        </h1>

        <p class="mt-1 text-sm text-slate-500">
          Manage the business contact and address details.
        </p>
      </div>

      <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">
        <div>
          <%= form.label(
                :business_name,
                class: "block text-sm font-semibold text-slate-700"
              ) %>

          <%= form.text_field(
                :business_name,
                class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>
        </div>

        <div>
          <%= form.label(
                :business_category,
                class: "block text-sm font-semibold text-slate-700"
              ) %>

          <%= form.text_field(
                :business_category,
                class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>
        </div>

        <div>
          <%= form.label(
                :business_email,
                class: "block text-sm font-semibold text-slate-700"
              ) %>

          <%= form.email_field(
                :business_email,
                class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>
        </div>

        <div>
          <%= form.label(
                :phone_number,
                class: "block text-sm font-semibold text-slate-700"
              ) %>

          <%= form.telephone_field(
                :phone_number,
                class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>
        </div>

        <div class="sm:col-span-2">
          <%= form.label(
                :business_description,
                class: "block text-sm font-semibold text-slate-700"
              ) %>

          <%= form.text_area(
                :business_description,
                rows: 5,
                class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm leading-6 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>
        </div>

        <% [
             [:address_line_1, "Address line 1"],
             [:address_line_2, "Address line 2"],
             [:town_or_city, "Town or city"],
             [:postcode, "Postcode"],
             [:country, "Country"]
           ].each do |field, label| %>
          <div>
            <%= form.label(
                  field,
                  label,
                  class: "block text-sm font-semibold text-slate-700"
                ) %>

            <%= form.text_field(
                  field,
                  class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                ) %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Subscription settings -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 p-5 sm:p-6">
        <h2 class="text-xl font-bold text-slate-900">
          Subscription
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Control whether this business has access to subscribed features.
        </p>
      </div>

      <label class="flex items-start justify-between gap-5 p-5 sm:px-6">
    <span>
      <span class="block text-sm font-semibold text-slate-900">
        Active subscription
      </span>

      <span class="mt-1 block text-sm text-slate-500">
        Enable or disable subscription access for this business.
      </span>
    </span>

        <span>
          <%= hidden_field_tag(
                "business[subscribed]",
                "0"
              ) %>

          <%= check_box_tag(
                "business[subscribed]",
                "1",
                @business.subscribed?,
                id: "business_subscribed",
                class: "mt-1 h-5 w-5 shrink-0 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
              ) %>
        </span>
      </label>
    </section>

    <!-- Booking settings -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 p-5 sm:p-6">
        <h2 class="text-xl font-bold text-slate-900">
          Booking settings
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Control how bookings are accepted and managed.
        </p>
      </div>

      <div class="divide-y divide-slate-100">
        <% [
             [
               :booking_page_live,
               "Booking page live",
               "Allow customers to access and use the booking page."
             ],
             [
               :automatically_confirm_bookings,
               "Automatically confirm bookings",
               "Confirm new bookings without manual approval."
             ],
             [
               :allow_customer_cancellations,
               "Allow customer cancellations",
               "Allow customers to cancel their own appointments."
             ],
             [
               :require_customer_phone_number,
               "Require customer phone number",
               "Make a phone number mandatory when booking."
             ],
             [
               :new_booking_notifications,
               "New booking notifications",
               "Notify the business when a booking is received."
             ],
             [
               :cancellation_notifications,
               "Cancellation notifications",
               "Notify the business when a booking is cancelled."
             ],
             [
               :daily_appointment_summary,
               "Daily appointment summary",
               "Send a daily summary of scheduled appointments."
             ]
           ].each do |field, title, description| %>
          <label class="flex items-start justify-between gap-5 p-5 sm:px-6">
            <span>
              <span class="block text-sm font-semibold text-slate-900">
                <%= title %>
              </span>

              <span class="mt-1 block text-sm text-slate-500">
                <%= description %>
              </span>
            </span>

            <%= form.check_box(
                  field,
                  class: "mt-1 h-5 w-5 shrink-0 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                ) %>
          </label>
        <% end %>
      </div>

      <div class="border-t border-slate-200 p-5 sm:p-6">
        <%= form.label(
              :cancellation_notice_hours,
              "Cancellation notice period",
              class: "block text-sm font-semibold text-slate-700"
            ) %>

        <div class="mt-2 flex max-w-sm items-center gap-3">
          <%= form.number_field(
                :cancellation_notice_hours,
                min: 0,
                step: 1,
                class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              ) %>

          <span class="text-sm font-medium text-slate-500">
            hours
          </span>
        </div>
      </div>
    </section>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <%= link_to(
            "Cancel",
            admin_customer_path(@customer, tab: "settings"),
            class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50"
          ) %>

      <%= form.submit(
            "Save settings",
            class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"
          ) %>
    </div>
  <% end %>
</main>