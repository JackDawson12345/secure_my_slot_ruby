<div class="min-h-screen bg-slate-50 px-4 py-12 sm:px-6 lg:px-8">

  <div class="mx-auto max-w-xl">

    <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

      <div class="px-6 py-10 text-center sm:px-10">

        <!-- Success Icon -->
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
          <i
            data-lucide="check"
            class="h-8 w-8 text-emerald-600"
          ></i>
        </div>

        <!-- Heading -->
        <h1 class="mt-6 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Payment successful
        </h1>

        <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-slate-500 sm:text-base">
          Your payment has been received successfully. Thank you for your payment.
        </p>


        <!-- Payment Amount -->
        <div class="mt-8 rounded-2xl bg-emerald-50 px-6 py-5">

          <p class="text-sm font-medium text-emerald-700">
            Amount paid
          </p>

          <p class="mt-1 text-3xl font-bold text-emerald-700">
            <%= number_to_currency(@booking.payment_link_amount, unit: "£") %>
          </p>

        </div>


        <!-- Booking Details -->
        <div class="mt-8 rounded-2xl border border-slate-200 text-left">

          <div class="border-b border-slate-100 px-5 py-4">
            <h2 class="font-semibold text-slate-900">
              Booking details
            </h2>
          </div>

          <div class="divide-y divide-slate-100">

            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <span class="text-sm text-slate-500">
                Business
              </span>

              <span class="text-right text-sm font-semibold text-slate-900">
                <%= @business.business_name %>
              </span>
            </div>

            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <span class="text-sm text-slate-500">
                Service
              </span>

              <span class="text-right text-sm font-semibold text-slate-900">
                <%= @booking.service.name %>
              </span>
            </div>

            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <span class="text-sm text-slate-500">
                Date
              </span>

              <span class="text-right text-sm font-semibold text-slate-900">
                <%= @booking.date.strftime("%d %B %Y") %>
              </span>
            </div>

            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <span class="text-sm text-slate-500">
                Time
              </span>

              <span class="text-right text-sm font-semibold text-slate-900">
                <%= @booking.time.strftime("%H:%M") %>
              </span>
            </div>

            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <span class="text-sm text-slate-500">
                Booking reference
              </span>

              <span class="text-right text-sm font-semibold text-slate-900">
                #<%= @booking.id %>
              </span>
            </div>

          </div>

        </div>


        <!-- Confirmation -->
        <div class="mt-6 flex items-start gap-3 rounded-2xl bg-slate-50 p-4 text-left">

          <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white shadow-sm">
            <i
              data-lucide="shield-check"
              class="h-4 w-4 text-slate-600"
            ></i>
          </div>

          <div>
            <p class="text-sm font-semibold text-slate-900">
              Payment confirmed
            </p>

            <p class="mt-1 text-sm leading-5 text-slate-500">
              Your payment has been securely processed and added to your booking.
            </p>
          </div>

        </div>

      </div>


      <!-- Footer -->
      <div class="border-t border-slate-100 bg-slate-50 px-6 py-5 text-center">

        <p class="text-xs text-slate-400">
          Secure payment powered by Secure My Slot
        </p>

      </div>

    </div>

  </div>

</div>