              >
                <i data-lucide="calendar-range" class="h-6 w-6"></i>
              </span>

          <h3 class="mt-6 text-xl font-bold text-slate-950">
            Online appointment booking
          </h3>

          <p class="mt-3 leading-7 text-slate-600">
            Give customers a branded booking page where they can choose a
            service, date and available time slot.
          </p>
        </article>

        <!-- Feature 2 -->
        <article
          class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-lg"
        >
              <span
                class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-600 transition group-hover:bg-violet-600 group-hover:text-white"
              >
                <i data-lucide="clock-arrow-up" class="h-6 w-6"></i>
              </span>

          <h3 class="mt-6 text-xl font-bold text-slate-950">
            Flexible working hours
          </h3>

          <p class="mt-3 leading-7 text-slate-600">
            Set opening hours, breaks and closed days so customers only see
            appointments that are genuinely available.
          </p>
        </article>

        <!-- Feature 3 -->
        <article
          class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-lg"
        >
              <span
                class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 transition group-hover:bg-emerald-600 group-hover:text-white"
              >
                <i data-lucide="users-round" class="h-6 w-6"></i>
              </span>

          <h3 class="mt-6 text-xl font-bold text-slate-950">
            Customer management
          </h3>

          <p class="mt-3 leading-7 text-slate-600">
