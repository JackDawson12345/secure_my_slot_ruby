    ></div>

    <div
      class="pointer-events-none absolute -left-40 top-28 h-96 w-96 rounded-full bg-indigo-200/40 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -right-40 top-10 h-96 w-96 rounded-full bg-violet-200/40 blur-3xl"
    ></div>

    <div
      class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-2 lg:px-8 lg:py-28"
    >
      <!-- Hero content -->
      <div>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm"
        >
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-indigo-400 opacity-75"
                ></span>

                <span
                  class="relative inline-flex h-2 w-2 rounded-full bg-indigo-600"
                ></span>
              </span>

          Online booking for modern businesses
        </div>

        <h1
          class="mt-6 max-w-3xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl lg:leading-[1.08]"
        >
          Make booking appointments

          <span class="text-indigo-600">
                simple for everyone.
              </span>
        </h1>

        <p
          class="mt-6 max-w-2xl text-lg leading-8 text-slate-600"
        >
          SecureMySlot gives businesses everything they need to manage
          services, availability, customers and appointments while giving
          customers a quick and convenient way to book online.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">

          <%= link_to business_sign_up_path, class: 'inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2' do %>
            Create your business account
            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          <% end %>

          <a
            href="#businesses"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-50"
