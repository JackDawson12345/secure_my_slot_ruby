<main>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-slate-50">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-0 h-[520px] bg-gradient-to-b from-indigo-50 via-slate-50 to-transparent"
    ></div>

    <div
      class="pointer-events-none absolute -left-40 top-28 h-96 w-96 rounded-full bg-indigo-200/40 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -right-40 top-10 h-96 w-96 rounded-full bg-violet-200/40 blur-3xl"
    ></div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm"
        >
          <i data-lucide="message-circle" class="h-4 w-4"></i>
          Contact SecureMySlot
        </span>

        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl lg:leading-[1.08]">
          Need help? Get in touch with
          <span class="text-indigo-600">SecureMySlot.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600">
          Have a question about SecureMySlot, need help with your account or
          want to know more about our booking platform? Send us a message and
          our team will be happy to help.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact section -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <!-- Contact information -->
      <div>
        <span
          class="inline-flex rounded-full bg-indigo-50 px-3 py-1.5 text-sm font-semibold text-indigo-700"
        >
          We're here to help
        </span>

        <h2 class="mt-5 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          How can we help?
        </h2>

        <p class="mt-5 text-lg leading-8 text-slate-600">
          If you have a question about using SecureMySlot, setting up your
          business account or managing your bookings, send us a message using
          the form.
        </p>

        <div class="mt-10 space-y-5">
          <div class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600"
            >
              <i data-lucide="circle-help" class="h-5 w-5"></i>
            </span>

            <div>
              <h3 class="font-bold text-slate-950">
                General enquiries
              </h3>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Ask us anything about SecureMySlot, our platform or how the
                booking system works.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600"
            >
              <i data-lucide="settings-2" class="h-5 w-5"></i>
            </span>

            <div>
              <h3 class="font-bold text-slate-950">
                Account support
              </h3>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Get help with your SecureMySlot account, business settings,
                services or availability.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600"
            >
              <i data-lucide="calendar-check-2" class="h-5 w-5"></i>
            </span>

            <div>
              <h3 class="font-bold text-slate-950">
                Booking support
              </h3>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Need help understanding bookings, availability or customer
                appointment management? Let us know.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600"
            >
              <i data-lucide="briefcase-business" class="h-5 w-5"></i>
            </span>

            <div>
              <h3 class="font-bold text-slate-950">
                Business enquiries
              </h3>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Thinking about using SecureMySlot for your business? Contact us
                and we can help you get started.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 rounded-2xl bg-slate-50 p-6">
          <div class="flex items-start gap-4">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm"
            >
              <i data-lucide="clock-3" class="h-5 w-5"></i>
            </span>

            <div>
              <h3 class="font-bold text-slate-950">
                Send us a message at any time
              </h3>

              <p class="mt-1 text-sm leading-6 text-slate-600">
                Submit your enquiry through the form and a member of the
                SecureMySlot team will respond as soon as possible.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="relative">
        <div
          class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-indigo-200/50 to-violet-200/30 blur-2xl"
        ></div>

        <div class="relative rounded-3xl border border-slate-200 bg-white p-6 shadow-xl sm:p-8 lg:p-10">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
              Send us a message
            </h2>

            <p class="mt-3 leading-7 text-slate-600">
              Fill in the form below and tell us how we can help.
            </p>
          </div>

          <%= form_with url: contact_path, method: :post, class: "mt-8 space-y-6" do |f| %>
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <%= f.label :first_name,
                            "First name",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <%= f.text_field :first_name,
                                 required: true,
                                 autocomplete: "given-name",
                                 placeholder: "Your first name",
                                 class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>

              <div>
                <%= f.label :last_name,
                            "Last name",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <%= f.text_field :last_name,
                                 required: true,
                                 autocomplete: "family-name",
                                 placeholder: "Your last name",
                                 class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>
            </div>

            <div>
              <%= f.label :email,
                          "Email address",
                          class: "mb-2 block text-sm font-semibold text-slate-700" %>

              <%= f.email_field :email,
                                required: true,
                                autocomplete: "email",
                                placeholder: "you@example.com",
                                class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
            </div>

            <div>
              <%= f.label :business_name,
                          "Business name",
                          class: "mb-2 block text-sm font-semibold text-slate-700" %>

              <%= f.text_field :business_name,
                               placeholder: "Your business name (optional)",
                               class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
            </div>

            <div>
              <%= f.label :enquiry_type,
                          "What can we help with?",
                          class: "mb-2 block text-sm font-semibold text-slate-700" %>

              <%= f.select :enquiry_type,
                           [
                             ["General enquiry", "general"],
                             ["Account support", "account_support"],
                             ["Booking support", "booking_support"],
                             ["Business enquiry", "business_enquiry"],
                             ["Technical issue", "technical_issue"],
                             ["Other", "other"]
                           ],
                           { prompt: "Select an option" },
                           {
                             required: true,
                             class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                           } %>
            </div>

            <div>
              <%= f.label :subject,
                          "Subject",
                          class: "mb-2 block text-sm font-semibold text-slate-700" %>

              <%= f.text_field :subject,
                               required: true,
                               placeholder: "How can we help?",
                               class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
            </div>

            <div>
              <%= f.label :message,
                          "Message",
                          class: "mb-2 block text-sm font-semibold text-slate-700" %>

              <%= f.text_area :message,
                              required: true,
                              rows: 7,
                              placeholder: "Tell us a little more about your enquiry...",
                              class: "w-full resize-none rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm leading-6 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
            </div>

            <div class="flex items-start gap-3">
              <%= f.check_box :privacy_accepted,
                              required: true,
                              class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>

              <%= f.label :privacy_accepted,
                          class: "text-sm leading-6 text-slate-600" do %>
                I understand that the information I provide will be used to
                respond to my enquiry.
              <% end %>
            </div>

            <%= f.submit "Send message",
                         class: "inline-flex w-full cursor-pointer items-center justify-center rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto" %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Support features -->
  <section class="bg-slate-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-flex rounded-full bg-indigo-100 px-3 py-1.5 text-sm font-semibold text-indigo-700"
        >
          SecureMySlot support
        </span>

        <h2 class="mt-5 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Help with every part of your booking account
        </h2>

        <p class="mt-4 text-lg leading-8 text-slate-600">
          From getting started to managing your day-to-day bookings, you can
          contact us when you need help with SecureMySlot.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600"
          >
            <i data-lucide="rocket" class="h-6 w-6"></i>
          </span>

          <h3 class="mt-6 text-xl font-bold text-slate-950">
            Getting started
          </h3>

          <p class="mt-3 leading-7 text-slate-600">
            Need help setting up your business, adding services or configuring
            your booking page? Send us your questions.
          </p>
        </article>

        <article class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-600"
          >
            <i data-lucide="calendar-cog" class="h-6 w-6"></i>
          </span>

          <h3 class="mt-6 text-xl font-bold text-slate-950">
            Managing availability
          </h3>

          <p class="mt-3 leading-7 text-slate-600">
            Contact us if you need assistance with working hours, breaks,
            appointment availability or booking settings.
          </p>
        </article>

        <article class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"
          >
            <i data-lucide="headphones" class="h-6 w-6"></i>
          </span>

          <h3 class="mt-6 text-xl font-bold text-slate-950">
            Ongoing support
          </h3>

          <p class="mt-3 leading-7 text-slate-600">
            If something does not look right or you need help using a feature,
            get in touch and tell us what is happening.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Existing customer -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm lg:grid lg:grid-cols-2"
      >
        <div class="p-8 sm:p-10 lg:p-12">
          <span
            class="inline-flex rounded-full bg-indigo-50 px-3 py-1.5 text-sm font-semibold text-indigo-700"
          >
            Already using SecureMySlot?
          </span>

          <h2 class="mt-5 text-3xl font-bold tracking-tight text-slate-950">
            Include as much detail as possible
          </h2>

          <p class="mt-5 leading-8 text-slate-600">
            If you are contacting us about an existing account, including
            details such as your business name and the issue you are
            experiencing can help us understand your enquiry more quickly.
          </p>

          <a
            href="/login"
            class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            Sign in to your account
            <i data-lucide="log-in" class="h-4 w-4"></i>
          </a>
        </div>

        <div class="bg-slate-950 p-8 text-white sm:p-10 lg:p-12">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-500/15 text-indigo-300"
          >
            <i data-lucide="lightbulb" class="h-6 w-6"></i>
          </span>

          <h3 class="mt-6 text-2xl font-bold">
            Useful information to include
          </h3>

          <div class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <i data-lucide="check" class="mt-1 h-5 w-5 shrink-0 text-indigo-300"></i>
              <p class="leading-7 text-slate-300">
                The email address connected to your account
              </p>
            </div>

            <div class="flex items-start gap-3">
              <i data-lucide="check" class="mt-1 h-5 w-5 shrink-0 text-indigo-300"></i>
              <p class="leading-7 text-slate-300">
                Your business name
              </p>
            </div>

            <div class="flex items-start gap-3">
              <i data-lucide="check" class="mt-1 h-5 w-5 shrink-0 text-indigo-300"></i>
              <p class="leading-7 text-slate-300">
                What you were trying to do when the issue occurred
              </p>
            </div>

            <div class="flex items-start gap-3">
              <i data-lucide="check" class="mt-1 h-5 w-5 shrink-0 text-indigo-300"></i>
              <p class="leading-7 text-slate-300">
                Any error message or relevant information you can provide
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8">
    <div
      class="relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-indigo-600 px-6 py-14 text-center text-white shadow-xl sm:px-12 sm:py-16"
    >
      <div
        class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl"
      ></div>

      <div
        class="pointer-events-none absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-violet-400/30 blur-3xl"
      ></div>

      <div class="relative mx-auto max-w-3xl">
        <span
          class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15"
        >
          <i data-lucide="calendar-check-2" class="h-7 w-7"></i>
        </span>

        <h2 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">
          Looking for an easier way to manage bookings?
        </h2>

        <p class="mt-4 text-lg leading-8 text-indigo-100">
          Create your SecureMySlot business account, configure your services
          and start accepting appointments online.
        </p>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <%= link_to business_sign_up_path,
                      class: "inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-50" do %>
            Create your business account
            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          <% end %>

          <a
            href="/login"
            class="inline-flex items-center justify-center rounded-xl border border-white/30 bg-white/10 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/20"
          >
            Sign in
          </a>
        </div>
      </div>
    </div>
  </section>
</main>