<main class="bg-slate-50">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[500px] bg-gradient-to-b from-indigo-50 via-slate-50 to-transparent"></div>

    <div class="relative mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="text-center">

        <span class="inline-flex rounded-full bg-indigo-50 px-3 py-1.5 text-sm font-semibold text-indigo-700">
          Secure My Slot Policies
        </span>

        <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Platform policies and guidelines
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600">
          These policies explain how Secure My Slot works, the responsibilities
          of businesses and customers, and the standards we expect from everyone
          using our platform.
        </p>

      </div>
    </div>
  </section>


  <!-- Policies -->
  <section class="pb-20">
    <div class="mx-auto max-w-5xl space-y-6 px-4 sm:px-6 lg:px-8">


      <!-- Introduction -->
      <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-950">
          Introduction
        </h2>

        <p class="mt-4 leading-7 text-slate-600">
          Secure My Slot helps businesses manage appointments and gives customers
          a simple way to discover services and make bookings online.
        </p>

        <p class="mt-4 leading-7 text-slate-600">
          By creating an account or using Secure My Slot, you agree to use the
          platform responsibly and follow these policies.
        </p>
      </div>


      <% policies = [
        {
          title: "Booking Policy",
          content: [
            "Secure My Slot allows customers to browse businesses, view available services and make appointments through the platform.",
            "<strong>Businesses are responsible for:</strong>",
            "<ul class='mt-3 list-disc space-y-2 pl-5'>
              <li>Keeping service information accurate and up to date.</li>
              <li>Maintaining correct availability, opening hours and booking settings.</li>
              <li>Honouring confirmed bookings made through Secure My Slot.</li>
              <li>Providing accurate pricing and service information.</li>
            </ul>",
            "<strong class='block mt-5'>Customers are responsible for:</strong>",
            "<ul class='mt-3 list-disc space-y-2 pl-5'>
              <li>Providing accurate booking information.</li>
              <li>Arriving on time for appointments.</li>
              <li>Following individual business booking requirements.</li>
              <li>Cancelling or rescheduling when unable to attend.</li>
            </ul>"
          ]
        },

        {
          title: "Cancellation Policy",
          content: [
            "Cancellation requirements may vary depending on the business you are booking with.",
            "<strong>Businesses can set their own cancellation terms, including:</strong>",
            "<ul class='mt-3 list-disc space-y-2 pl-5'>
              <li>Cancellation notice periods.</li>
              <li>Refund eligibility.</li>
              <li>Deposits or payment requirements.</li>
            </ul>",
            "Any disputes relating to cancellations, refunds or service delivery should first be resolved directly between the customer and the business."
          ]
        },

        {
          title: "Payment Policy",
          content: [
            "Some businesses may require payment during booking, while others may allow payment directly at the appointment.",
            "<ul class='mt-3 list-disc space-y-2 pl-5'>
              <li>Payment details are handled securely through payment providers.</li>
              <li>Businesses are responsible for pricing and refund policies.</li>
              <li>Customers must ensure payment details are accurate.</li>
            </ul>"
          ]
        },

        {
          title: "Business Responsibilities",
          content: [
            "<ul class='list-disc space-y-2 pl-5'>
              <li>Provide genuine and accurate business information.</li>
              <li>Deliver services professionally and safely.</li>
              <li>Maintain suitable customer communication.</li>
              <li>Protect customer information.</li>
              <li>Follow relevant laws and regulations.</li>
            </ul>"
          ]
        },

        {
          title: "Customer Responsibilities",
          content: [
            "<ul class='list-disc space-y-2 pl-5'>
              <li>Provide accurate personal information.</li>
              <li>Use Secure My Slot only for genuine bookings.</li>
              <li>Avoid creating false appointments.</li>
              <li>Treat businesses and staff respectfully.</li>
              <li>Keep account details secure.</li>
            </ul>"
          ]
        },

        {
          title: "Account Policy",
          content: [
            "Users are responsible for keeping their account information secure.",
            "<ul class='mt-3 list-disc space-y-2 pl-5'>
              <li>Use a secure password.</li>
              <li>Keep login details confidential.</li>
              <li>Notify us if your account may have been accessed without permission.</li>
            </ul>"
          ]
        },

        {
          title: "Reviews and Feedback Policy",
          content: [
            "Reviews should be honest and based on genuine experiences.",
            "<ul class='mt-3 list-disc space-y-2 pl-5'>
              <li>No false or misleading information.</li>
              <li>No offensive or abusive content.</li>
              <li>No personal information about individuals.</li>
              <li>No content intended to unfairly damage a business.</li>
            </ul>"
          ]
        },

        {
          title: "Privacy Policy",
          content: [
            "Personal information is handled in accordance with applicable data protection laws, including UK GDPR requirements.",
            "<ul class='mt-3 list-disc space-y-2 pl-5'>
              <li>Providing booking services.</li>
              <li>Managing user accounts.</li>
              <li>Sending booking updates.</li>
              <li>Improving platform functionality.</li>
              <li>Maintaining security.</li>
            </ul>"
          ]
        },

        {
          title: "Platform Availability",
          content: [
            "We aim to keep Secure My Slot available and reliable, however interruptions may occur due to maintenance, updates, third-party services or circumstances outside our control."
          ]
        },

        {
          title: "Changes To These Policies",
          content: [
            "We may update these policies from time to time to reflect changes to our platform, services or legal requirements."
          ]
        }
      ] %>


      <% policies.each do |policy| %>

        <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">

          <h2 class="text-2xl font-bold text-slate-950">
            <%= policy[:title] %>
          </h2>

          <div class="mt-4 space-y-4 leading-7 text-slate-600">
            <% policy[:content].each do |paragraph| %>
              <%= raw paragraph %>
            <% end %>
          </div>

        </div>

      <% end %>


      <!-- Contact -->
      <div class="rounded-3xl bg-slate-950 p-8 text-white">

        <h2 class="text-2xl font-bold">
          Contact Us
        </h2>

        <p class="mt-4 text-slate-300">
          If you have any questions about these policies or need support,
          please contact us.
        </p>

        <div class="mt-5">
          <p class="font-semibold">
            Secure My Slot
          </p>

          <a href="mailto:support@securemyslot.co.uk"
             class="mt-2 inline-block text-indigo-300 hover:text-indigo-200">
            support@securemyslot.co.uk
          </a>
        </div>

      </div>


    </div>
  </section>

</main>