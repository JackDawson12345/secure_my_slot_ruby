        font-size: 24px;
        font-weight: 700;
        color: #0f172a;
    }


    /* Buttons */

    .fc .fc-button {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 8px 16px;
        font-weight: 600;
        box-shadow: none;
    }

    .fc .fc-button:hover {
        background: #f8fafc;
    }

    .fc .fc-button-primary:not(:disabled).fc-button-active {
        background: #4f46e5;
        border-color: #4f46e5;
