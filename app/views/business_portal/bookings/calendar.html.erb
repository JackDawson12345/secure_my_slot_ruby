        padding: 5px;
    }


    /* Today */

    .fc .fc-day-today {
        background: #eef2ff !important;
    }


    .fc .fc-day-today .fc-daygrid-day-number {
        background: #4f46e5;
        color: white;
        border-radius: 50%;
