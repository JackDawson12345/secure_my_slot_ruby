<%# app/views/business_portal/bookings/show.html.erb %>
<%
  starts_at = Time.zone.parse("#{@booking.date} #{@booking.time}")
  ends_at = starts_at + @booking.service.minutes_duration.minutes

  google_calendar_url = "https://calendar.google.com/calendar/render?" + {
    action: "TEMPLATE",
    text: @booking.service.name,
    dates: "#{starts_at.utc.strftime('%Y%m%dT%H%M%SZ')}/#{ends_at.utc.strftime('%Y%m%dT%H%M%SZ')}",
    details: "Appointment with #{@booking.user.first_name} #{@booking.user.last_name}. Amount Due: #{number_to_currency((@booking.service.price - @booking.amount_paid), unit: "£", precision: 2)}",
    location: @booking.business.address
  }.to_query
%>


<main class="p-4 sm:p-6 lg:p-8">

  <!-- Header -->
  <div class="mb-8 flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 text-sm text-slate-500">
        <%= link_to "Bookings", business_bookings_path, class: "hover:text-slate-700" %>
        <i data-lucide="chevron-right" class="h-4 w-4"></i>
        <span class="text-slate-700">Booking details</span>
      </div>

      <h1 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
        <%= @booking.service&.name || "Booking" %>
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        <%= @booking.date.strftime("%A, %-d %B %Y") %> at <%= @booking.time.strftime("%-I:%M %P") %>
      </p>
    </div>

    <%= link_to business_bookings_path,
                class: "hidden items-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 sm:inline-flex" do %>
      <i data-lucide="arrow-left" class="h-4 w-4"></i>
      Back to bookings
    <% end %>
  </div>

  <!-- Flash messages -->
  <%= render 'business_portal/shared/flash_messages' %>

  <div class="grid gap-6 xl:grid-cols-[1fr_340px] mt-8">

    <div class="space-y-6">

      <!-- Appointment -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold">Appointment</h2>
        </div>

        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:px-6">
          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-indigo-50 p-2 text-indigo-600">
              <i data-lucide="briefcase-business" class="h-5 w-5"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-500">Service</p>
              <p class="font-semibold text-slate-900"><%= @booking.service&.name || "—" %></p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-blue-50 p-2 text-blue-600">
              <i data-lucide="clock-3" class="h-5 w-5"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-500">Duration</p>
              <p class="font-semibold text-slate-900">
                <%= @booking.service&.minutes_duration ? "#{@booking.service.minutes_duration} minutes" : "—" %>
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-violet-50 p-2 text-violet-600">
              <i data-lucide="calendar-days" class="h-5 w-5"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-500">Date</p>
              <p class="font-semibold text-slate-900"><%= @booking.date.strftime("%-d %B %Y") %></p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-emerald-50 p-2 text-emerald-600">
              <i data-lucide="wallet-cards" class="h-5 w-5"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-500">Price</p>
              <p class="font-semibold text-slate-900">
                <%= @booking.service ? number_to_currency(@booking.service.price, unit: "£") : "—" %>
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-violet-50 p-2 text-violet-600">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="ticket-percent" aria-hidden="true" class="lucide lucide-ticket-percent h-5 w-5"><path d="M2 9a3 3 0 1 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 1 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path><path d="M9 9h.01"></path><path d="m15 9-6 6"></path><path d="M15 15h.01"></path></svg>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-500">Coupon</p>
              <% coupon = ServiceCoupon.find_by(business_id: current_user.business.id, id: @booking.coupon) %>

              <p class="font-semibold text-slate-900">
                <%= coupon.present? ? coupon.code : "-" %>
              </p>

            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-emerald-50 p-2 text-emerald-600">
              <i data-lucide="wallet-cards" class="h-5 w-5"></i>
            </div>
            <div>
              <p class="text-sm font-medium text-slate-500">Coupon Price</p>
              <p class="font-semibold text-slate-900">
                <%= number_to_currency(@booking.amount, unit: "£") %>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Customer -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold">Customer</h2>
        </div>

        <% user = @booking.user %>
        <% customer_name = [user.first_name, user.last_name].compact.join(" ") %>
        <% customer_name = user.email.split("@").first.titleize if customer_name.blank? %>
        <% initials = [user.first_name, user.last_name].compact.filter_map { |n| n.first }.join.upcase %>
        <% initials = customer_name.split.map { |n| n.first }.first(2).join.upcase if initials.blank? %>

        <div class="flex items-center gap-4 p-5 sm:px-6">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-lg font-semibold text-indigo-700">
            <%= initials %>
          </div>

          <div>
            <p class="font-semibold text-slate-900"><%= customer_name %></p>
            <p class="text-sm text-slate-500"><%= user.email %></p>
          </div>
        </div>
      </section>

      <!-- Notes -->
      <% if @booking.notes.present? %>
        <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-200 px-5 py-4 sm:px-6">
            <div class="flex items-center gap-2">
              <i data-lucide="notebook-pen" class="h-4 w-4 text-slate-400"></i>

              <h3 class="font-bold text-slate-900">
                Your notes
              </h3>
            </div>
          </div>

          <div class="p-5 sm:p-6">
            <p class="whitespace-pre-line text-sm leading-6 text-slate-600">
              <%= @booking.notes %>
            </p>
          </div>
        </section>
      <% end %>

      <!-- Agreements -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-5 sm:px-6">
          <div class="flex items-center gap-2">
            <i data-lucide="file-signature" class="h-5 w-5 text-slate-400"></i>
            <h2 class="text-lg font-bold text-slate-900">Agreements</h2>
          </div>
        </div>

        <div class="p-5 sm:px-6">

          <% if @agreements.present? %>

            <div class="divide-y divide-slate-100">

              <% @agreements.each do |agreement| %>

                <% status = AgreementStatus.find_by(
                  agreement: agreement,
                  booking: @booking,
                  business: current_user.business
                ) %>

                <div class="flex flex-col gap-4 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between">

                  <div>
                    <p class="font-semibold text-slate-900">
                      <%= agreement.name %>
                    </p>

                    <p class="mt-1 text-sm text-slate-500">
                      Customer agreement
                    </p>
                  </div>


                  <div class="flex items-center gap-3">

                    <% if status.present? %>

                      <% status_classes =
                           case status.status
                           when "signed"
                             "bg-emerald-50 text-emerald-700"
                           when "pending"
                             "bg-amber-50 text-amber-700"
                           else
                             "bg-slate-100 text-slate-600"
                           end
                      %>

                      <span class="rounded-full px-3 py-1 text-xs font-semibold <%= status_classes %>">
                        <%= status.status.titleize %>
                      </span>


                      <% if status.status == "signed" %>

                        <%= link_to "Show Agreement",
                                    business_booking_agreement_show_path(
                                      id: @booking.id,
                                      token: status.token
                                    ),
                                    class: "rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>

                      <% end %>


                    <% else %>

                      <%= link_to "Send Agreement",
                                  business_send_agreement_path(
                                    agreement,
                                    business_id: current_user.business.id,
                                    booking_id: @booking.id
                                  ),
                                  data: { turbo_method: :patch },
                                  class: "rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>

                    <% end %>

                  </div>

                </div>

              <% end %>

            </div>

          <% else %>

            <div class="flex flex-col items-center justify-center py-8 text-center">

              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="file-signature" class="h-5 w-5"></i>
              </div>

              <p class="mt-3 font-semibold text-slate-900">
                No agreements found
              </p>

              <p class="mt-1 text-sm text-slate-500">
                There are currently no agreements available for this booking.
              </p>

            </div>

          <% end %>

        </div>
      </section>

      <!-- Consultation Form -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold">Consultation Form</h2>

          <% if @booking.consultation_responses.present? %>
            <%= link_to business_booking_consultation_pdf_path(@booking, format: :pdf),
                        class: "inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
              <i data-lucide="download" class="h-4 w-4"></i>
              Download PDF
            <% end %>
          <% end %>
        </div>

        <div class="p-5 sm:px-6">
          <% consultation_responses = @booking.consultation_responses || [] %>

          <% if consultation_responses.any? %>
            <div class="divide-y divide-slate-100">
              <% consultation_responses.each do |response| %>
                <div class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[220px_1fr] sm:gap-6">
                  <p class="text-sm font-medium text-slate-500">
                    <%= response["label"] %>
                  </p>

                  <p class="text-sm font-semibold text-slate-900 whitespace-pre-wrap break-words">
                    <%= response["value"].presence || "Not provided" %>
                  </p>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="flex flex-col items-center justify-center py-8 text-center">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i data-lucide="clipboard-list" class="h-5 w-5"></i>
              </div>

              <p class="mt-3 font-semibold text-slate-900">
                No consultation form submitted
              </p>

              <p class="mt-1 text-sm text-slate-500">
                This customer has not provided any consultation information.
              </p>
            </div>
          <% end %>
        </div>
      </section>


      <!-- Image Uploads -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
              <i data-lucide="image-plus" class="h-5 w-5"></i>
            </div>

            <div>
              <h2 class="text-lg font-bold text-slate-900">
                Uploaded Images
              </h2>

              <p class="mt-1 text-sm text-slate-500">
                Images uploaded by the customer to help you prepare for their appointment.
              </p>
            </div>
          </div>
        </div>


        <div class="p-5 sm:p-6">


          <!-- Example uploaded images placeholder -->
          <% if @booking.images.attached? %>

            <div class="mt-6"
                 data-controller="image-lightbox">

              <div class="mb-4 flex items-center justify-between">
                <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500">
                  Uploaded images
                </h3>

                <span class="text-xs font-medium text-slate-400">
                  <%= @booking.images.count %> / 10 images
                </span>
              </div>


              <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">

                <% @booking.images.each do |image| %>

                  <div class="group relative aspect-square overflow-hidden rounded-xl border border-slate-200 bg-slate-100">

                    <%= image_tag image,
                                  class: "h-full w-full cursor-pointer object-cover transition group-hover:scale-105",
                                  data: {
                                    action: "click->image-lightbox#open",
                                    image_lightbox_url_value: url_for(image)
                                  } %>


                    <!-- Actions -->
                    <div class="absolute inset-x-2 bottom-2 flex gap-2 opacity-0 transition group-hover:opacity-100">

                      <button type="button"
                              class="flex flex-1 items-center justify-center gap-2 rounded-lg bg-white/90 px-3 py-2 text-xs font-semibold text-slate-700 shadow"
                              data-action="click->image-lightbox#open"
                              data-image-lightbox-url-value="<%= url_for(image) %>">

                        <i data-lucide="maximize-2" class="h-4 w-4"></i>
                        View

                      </button>


                      <%= link_to rails_blob_path(image, disposition: "attachment"),
                                  class: "flex flex-1 items-center justify-center gap-2 rounded-lg bg-white/90 px-3 py-2 text-xs font-semibold text-slate-700 shadow" do %>

                        <i data-lucide="download" class="h-4 w-4"></i>
                        Download

                      <% end %>

                    </div>

                  </div>

                <% end %>

              </div>


              <!-- Lightbox -->
              <div data-image-lightbox-target="modal"
                   class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-5">

                <button type="button"
                        class="absolute right-5 top-5 rounded-full bg-white/10 p-3 text-white"
                        data-action="click->image-lightbox#close">

                  <i data-lucide="x" class="h-6 w-6"></i>

                </button>


                <img data-image-lightbox-target="image"
                     class="max-h-full max-w-full rounded-xl object-contain">

              </div>

            </div>

          <% end %>

        </div>

      </section>

    </div>

    <!-- Status sidebar -->
    <aside class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:sticky xl:top-8">
        <h2 class="text-lg font-bold">Status</h2>

        <% status_classes =
             case @booking.status
             when "confirmed" then "bg-emerald-50 text-emerald-700"
             when "pending" then "bg-amber-50 text-amber-700"
             when "canceled", "cancelled" then "bg-rose-50 text-rose-700"
             else "bg-slate-100 text-slate-600"
             end
        %>

        <span class="mt-4 inline-flex rounded-full px-3 py-1.5 text-sm font-semibold <%= status_classes %>">
          <%= @booking.status.titleize %>
        </span>

        <div class="mt-6 space-y-3">

          <% if @booking.status == "pending" %>
            <%= button_to business_booking_status_path(@booking),
                          method: :patch,
                          params: { status: "confirmed" },
                          class: "flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700" do %>
              <i data-lucide="check" class="h-4 w-4"></i>
              Confirm booking
            <% end %>
          <% end %>

          <% if @booking.status == "confirmed" %>
            <%= button_to business_booking_status_path(@booking),
                          method: :patch,
                          params: { status: "completed" },
                          class: "flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700",
                          form: {
                            data: {
                              turbo_confirm: "Are you sure you want to mark this booking as completed?"
                            }
                          } do %>
              <i data-lucide="circle-check-big" class="h-4 w-4"></i>
              Mark as completed
            <% end %>
          <% end %>

          <% if @booking.status == "completed" %>
            <%= button_to business_booking_status_path(@booking),
                          method: :patch,
                          params: { status: "confirmed" },
                          class: "flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50",
                          form: {
                            data: {
                              turbo_confirm: "Put this booking back to confirmed?"
                            }
                          } do %>
              <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
              Move back to confirmed
            <% end %>
          <% end %>

        </div>

        <div class="mt-6 space-y-3 border-t border-slate-100 pt-5 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-500">Booking ID</span>
            <span class="font-semibold text-slate-900">#<%= @booking.id %></span>
          </div>

          <div class="flex justify-between">
            <span class="text-slate-500">Created</span>
            <span class="font-semibold text-slate-900"><%= @booking.created_at.strftime("%-d %b %Y") %></span>
          </div>
        </div>

        <%= link_to business_bookings_path,
                    class: "mt-6 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-50" do %>
          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Back to bookings
        <% end %>

        <%= link_to "Add to Google Calendar",
                    google_calendar_url,
                    target: "_blank",
                    rel: "noopener",
                    class: "flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 font-semibold w-full mt-4 text-white hover:bg-blue-700" %>

      </div>
    </aside>

  </div>
</main>
