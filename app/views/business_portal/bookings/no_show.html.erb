<main class="p-4 sm:p-6 lg:p-8">

  <div class="">

    <!-- Back -->
    <div class="mb-6">
      <%= link_to business_booking_path(@booking),
                  class: "inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-slate-900" do %>

        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Back to booking

      <% end %>
    </div>


    <!-- Header -->
    <div class="mb-8">

      <p class="text-sm font-medium text-rose-600">
        Booking #<%= @booking.id %>
      </p>

      <h1 class="mt-1 text-2xl font-bold text-slate-900 sm:text-3xl">
        Mark as no show
      </h1>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        Mark this appointment as a no show and choose how much to charge the customer.
      </p>

    </div>


    <!-- Booking -->
    <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

      <h2 class="text-lg font-bold text-slate-900">
        Booking details
      </h2>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">

        <div>
          <p class="text-sm text-slate-500">Customer</p>

          <p class="mt-1 font-semibold text-slate-900">
            <%= @booking.user.first_name %>
            <%= @booking.user.last_name %>
          </p>
        </div>

        <div>
          <p class="text-sm text-slate-500">Service</p>

          <p class="mt-1 font-semibold text-slate-900">
            <%= @booking.service.name %>
          </p>
        </div>

        <div>
          <p class="text-sm text-slate-500">Date</p>

          <p class="mt-1 font-semibold text-slate-900">
            <%= @booking.date.strftime("%d %B %Y") %>
          </p>
        </div>

        <div>
          <p class="text-sm text-slate-500">Time</p>

          <p class="mt-1 font-semibold text-slate-900">
            <%= @booking.time.strftime("%H:%M") %>
          </p>
        </div>

      </div>

    </section>


    <!-- No Show Fee -->
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

      <div class="flex items-start gap-4">

        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-rose-50">
          <i data-lucide="user-x" class="h-5 w-5 text-rose-600"></i>
        </div>

        <div>
          <h2 class="font-bold text-slate-900">
            No show fee
          </h2>

          <p class="mt-1 text-sm leading-6 text-slate-500">
            Enter the amount you would like to charge this customer.
          </p>
        </div>

      </div>


      <% if @has_saved_card %>

        <%= form_with url: business_charge_no_show_fee_path(@booking),
                      method: :post,
                      data: {
                        turbo_confirm: "Are you sure you want to charge this customer a no show fee?"
                      } do |form| %>

          <%= form.label :no_show_fee,
                         "Amount to charge",
                         class: "block text-sm font-semibold text-slate-700" %>

          <div class="relative mt-2">

            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
              <span class="text-slate-500">£</span>
            </div>

            <%= form.number_field :no_show_fee,
                                  min: "0.01",
                                  step: "0.01",
                                  placeholder: "0.00",
                                  required: true,
                                  autofocus: true,
                                  class: "block w-full rounded-xl border border-slate-300 py-3 pl-9 pr-4 text-lg font-semibold text-slate-900 outline-none transition focus:border-rose-500 focus:ring-2 focus:ring-rose-100" %>

          </div>

          <p class="mt-2 text-sm text-slate-500">
            Enter the amount you want to charge for the missed appointment.
          </p>


          <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">

            <div class="flex gap-3">

              <i data-lucide="triangle-alert"
                 class="mt-0.5 h-5 w-5 shrink-0 text-amber-600"></i>

              <div>

                <p class="text-sm font-semibold text-amber-900">
                  This charge will be taken immediately
                </p>

                <p class="mt-1 text-sm leading-6 text-amber-800">
                  The customer's saved payment method will be charged using Stripe. Check the amount carefully before continuing.
                </p>

              </div>

            </div>

          </div>


          <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

            <%= link_to business_booking_path(@booking),
                        class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>

              <i data-lucide="x" class="h-4 w-4"></i>

              Cancel

            <% end %>


            <%= form.button type: "submit",
                            class: "inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-rose-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2" do %>

              <i data-lucide="credit-card" class="h-4 w-4"></i>

              Charge No Show Fee

            <% end %>

          </div>

        <% end %>


      <% else %>

        <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">

          <div class="flex gap-3">

            <i data-lucide="credit-card"
               class="mt-0.5 h-5 w-5 shrink-0 text-amber-600"></i>

            <div>
              <p class="font-semibold text-amber-900">
                No saved payment method
              </p>

              <p class="mt-1 text-sm leading-6 text-amber-800">
                This customer doesn't have a saved payment method available for this business.
              </p>
            </div>

          </div>

        </div>

      <% end %>

    </section>

  </div>

</main>