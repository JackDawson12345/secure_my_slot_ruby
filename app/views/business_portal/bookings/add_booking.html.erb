<%# app/views/business_portal/bookings/add_booking.html.erb %>

<main class="p-4 sm:p-6 lg:p-8">

  <!-- Header -->
  <div class="mb-8 flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 text-sm text-slate-500">
        <%= link_to "Bookings", business_bookings_path, class: "hover:text-slate-700" %>
        <i data-lucide="chevron-right" class="h-4 w-4"></i>
        <span class="text-slate-700">Add booking</span>
      </div>

      <h1 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
        Add a booking
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        Create a new appointment on behalf of a customer.
      </p>
    </div>

    <%= link_to business_bookings_path,
                class: "hidden items-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 sm:inline-flex" do %>
      <i data-lucide="arrow-left" class="h-4 w-4"></i>
      Back to bookings
    <% end %>
  </div>

  <% if flash[:alert] %>
    <div class="mb-6 flex items-center gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm font-medium text-rose-700">
      <i data-lucide="alert-circle" class="h-5 w-5 shrink-0"></i>
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with model: @booking || Booking.new,
                url: business_add_booking_path,
                method: :post,
                local: true,
                class: "grid gap-6 xl:grid-cols-[1fr_340px]",
                id: "booking-form" do |form| %>

    <div class="space-y-6">

      <!-- Service -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold">Select a service</h2>
          <p class="mt-1 text-sm text-slate-500">Choose which service this appointment is for.</p>
        </div>

        <div class="grid gap-3 p-5 sm:grid-cols-2 sm:px-6">
          <% @business.services.each do |service| %>
            <div>
              <input
                class="service-radio peer sr-only"
                type="radio"
                name="booking[service_id]"
                id="service-<%= service.id %>"
                value="<%= service.id %>"
                data-duration="<%= service.minutes_duration %>"
                data-price="<%= service.price %>"
                required
              >

              <label
                for="service-<%= service.id %>"
                class="flex cursor-pointer items-center justify-between gap-4 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-200 hover:bg-indigo-50 peer-checked:border-indigo-500 peer-checked:bg-indigo-50 peer-checked:ring-1 peer-checked:ring-indigo-500"
              >
                <div>
                  <span class="block font-semibold text-slate-900"><%= service.name %></span>
                  <span class="text-sm text-slate-500"><%= service.minutes_duration %> minutes</span>
                </div>

                <span class="font-bold text-slate-900">
                  <%= number_to_currency(service.price, unit: "£") %>
                </span>
              </label>
            </div>
          <% end %>
        </div>
      </section>

      <% if @agents.any? %>
        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

          <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
            <h2 class="text-lg font-bold">Select an agent</h2>
            <p class="mt-1 text-sm text-slate-500">
              Choose who will carry out this appointment.
            </p>
          </div>

          <div class="grid gap-3 p-5 sm:grid-cols-2 sm:px-6">

            <% if @allow_any_agent %>
              <div>
                <input
                  type="radio"
                  name="booking[agent_selection]"
                  id="agent-any"
                  value="any"
                  class="agent-radio peer sr-only"
                  required
                >

                <label
                  for="agent-any"
                  class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-200 hover:bg-indigo-50 peer-checked:border-indigo-500 peer-checked:bg-indigo-50 peer-checked:ring-1 peer-checked:ring-indigo-500"
                >
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                    <i data-lucide="users" class="h-5 w-5"></i>
                  </div>

                  <div>
              <span class="block font-semibold text-slate-900">
                Any available agent
              </span>
                    <span class="text-sm text-slate-500">
                Automatically assign an agent
              </span>
                  </div>
                </label>
              </div>
            <% end %>

            <% @agents.each do |agent| %>
              <div>
                <input
                  type="radio"
                  name="booking[agent_selection]"
                  id="agent-<%= agent.id %>"
                  value="<%= agent.id %>"
                  class="agent-radio peer sr-only"
                  required
                >

                <label
                  for="agent-<%= agent.id %>"
                  class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-200 hover:bg-indigo-50 peer-checked:border-indigo-500 peer-checked:bg-indigo-50 peer-checked:ring-1 peer-checked:ring-indigo-500"
                >
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
                    <i data-lucide="user-round" class="h-5 w-5"></i>
                  </div>

                  <div>
              <span class="block font-semibold text-slate-900">
                <%= [agent.user.first_name, agent.user.last_name].compact.join(" ") %>
              </span>

                    <span class="text-sm text-slate-500">
                Available team member
              </span>
                  </div>
                </label>
              </div>
            <% end %>

          </div>
        </section>
      <% end %>

      <!-- Date & time -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold">Date & time</h2>
          <p class="mt-1 text-sm text-slate-500">Pick an available slot for this appointment.</p>
        </div>

        <div class="p-5 sm:px-6">
          <label class="text-sm font-semibold text-slate-700">Date</label>

          <input
            type="date"
            name="booking[date]"
            id="booking-date"
            class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
            required
          >

          <p class="mt-6 text-sm font-semibold text-slate-700">Available times</p>

          <div id="time-options" class="mt-3">
            <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-200 bg-slate-50 px-6 py-10 text-center">
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-indigo-600 shadow-sm">
                <i data-lucide="calendar-clock" class="h-5 w-5"></i>
              </div>

              <p class="mt-4 text-sm font-semibold text-slate-900">
                Choose a service and date
              </p>

              <p class="mt-1 max-w-sm text-sm text-slate-500">
                Available appointment times will appear here.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Customer details -->
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-bold">Customer details</h2>
          <p class="mt-1 text-sm text-slate-500">Who is this booking for?</p>
        </div>

        <div class="grid gap-4 p-5 sm:grid-cols-2 sm:px-6">
          <input type="text" name="booking[first_name]" placeholder="First name"
                 class="rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" required>

          <input type="text" name="booking[last_name]" placeholder="Last name"
                 class="rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" required>

          <input type="email" name="booking[email]" placeholder="Email"
                 class="rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" required>

          <input type="tel" name="booking[phone_number]" placeholder="Phone number"
                 class="rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" required>

          <textarea name="booking[notes]" placeholder="Additional notes" rows="3"
                    class="sm:col-span-2 rounded-xl border border-slate-200 px-4 py-3 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"></textarea>
        </div>
      </section>

    </div>

    <!-- Summary -->
    <aside>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:sticky xl:top-8">
        <h2 class="text-lg font-bold">Booking summary</h2>

        <div class="mt-5 space-y-4">
          <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
            <span class="text-sm font-medium text-slate-500">Service</span>
            <span id="summary-service" class="text-right text-sm font-semibold text-slate-900">Not selected</span>
          </div>

          <% if @agents.any? %>
            <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
              <span class="text-sm font-medium text-slate-500">
                Agent
              </span>

              <span
                id="summary-agent"
                class="text-right text-sm font-semibold text-slate-900"
              >
                Not selected
              </span>
            </div>
          <% end %>

          <div class="flex justify-between text-sm">
            <span class="font-medium text-slate-500">Date</span>
            <span id="summary-date" class="font-semibold text-slate-900">Not selected</span>
          </div>

          <div class="flex justify-between text-sm">
            <span class="font-medium text-slate-500">Time</span>
            <span id="summary-time" class="font-semibold text-slate-900">Not selected</span>
          </div>

          <div class="flex justify-between text-sm">
            <span class="font-medium text-slate-500">Duration</span>
            <span id="summary-duration" class="font-semibold text-slate-900">Not selected</span>
          </div>

          <div class="flex items-center justify-between border-t border-slate-100 pt-4">
            <span class="font-bold text-slate-900">Total</span>
            <span id="summary-price" class="text-2xl font-bold text-slate-900">£0</span>
          </div>
        </div>

        <button
          type="submit"
          class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
        >
          <i data-lucide="check" class="h-4 w-4"></i>
          Confirm booking
        </button>

        <%= link_to "Cancel", business_bookings_path,
                    class: "mt-3 flex w-full items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-500 transition hover:bg-slate-50" %>
      </div>
    </aside>

  <% end %>
</main>

<script>

    document.addEventListener("turbo:load", () => {
        const form = document.getElementById("booking-form");
        if (!form) return;

        const dateInput = document.getElementById("booking-date");
        const timeOptions = document.getElementById("time-options");

        const serviceInputs = document.querySelectorAll(".service-radio");
        const agentInputs = document.querySelectorAll(".agent-radio");

        const summaryService = document.getElementById("summary-service");
        const summaryAgent = document.getElementById("summary-agent");
        const summaryDate = document.getElementById("summary-date");
        const summaryTime = document.getElementById("summary-time");
        const summaryDuration = document.getElementById("summary-duration");
        const summaryPrice = document.getElementById("summary-price");

        const businessId = "<%= @business.id %>";

        let selectedServiceId = null;
        let selectedAgent = null;
        let requestController = null;

        const hasAgents = agentInputs.length > 0;

        function clearTimes(message = "Choose a service, agent and date") {
            if (requestController) {
                requestController.abort();
                requestController = null;
            }

            summaryTime.textContent = "Not selected";

            timeOptions.className = "mt-3";

            timeOptions.innerHTML = `
      <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-6 py-8 text-center">
        <p class="text-sm font-semibold text-slate-700">
          ${message}
        </p>
      </div>
    `;
        }

        serviceInputs.forEach((input) => {
            input.addEventListener("change", () => {
                selectedServiceId = input.value;

                const label = document.querySelector(
                    `label[for="${input.id}"]`
                );

                summaryService.textContent =
                    label.querySelector("span").textContent.trim();

                summaryDuration.textContent =
                    `${input.dataset.duration} minutes`;

                summaryPrice.textContent =
                    new Intl.NumberFormat("en-GB", {
                        style: "currency",
                        currency: "GBP"
                    }).format(Number(input.dataset.price));

                loadTimes();
            });
        });

        agentInputs.forEach((input) => {
            input.addEventListener("change", () => {
                selectedAgent = input.value;

                const label = document.querySelector(
                    `label[for="${input.id}"]`
                );

                summaryAgent.textContent =
                    label.querySelector("span").textContent.trim();

                loadTimes();
            });
        });

        dateInput.addEventListener("change", () => {
            if (dateInput.value) {
                const date = new Date(`${dateInput.value}T12:00:00`);

                summaryDate.textContent =
                    date.toLocaleDateString("en-GB", {
                        weekday: "short",
                        day: "numeric",
                        month: "long",
                        year: "numeric"
                    });
            } else {
                summaryDate.textContent = "Not selected";
            }

            loadTimes();
        });

        async function loadTimes() {
            if (
                !selectedServiceId ||
                !dateInput.value ||
                (hasAgents && !selectedAgent)
            ) {
                clearTimes("Choose a service, agent and date");
                return;
            }

            clearTimes("Loading available times...");

            const controller = new AbortController();
            requestController = controller;

            const params = new URLSearchParams({
                business_id: businessId,
                service_id: selectedServiceId,
                date: dateInput.value
            });

            if (selectedAgent) {
                params.set("agent_selection", selectedAgent);
            }

            try {
                const response = await fetch(
                    `/booking_slots?${params.toString()}`,
                    { signal: controller.signal }
                );

                const times = await response.json();

                if (!response.ok) {
                    throw new Error(
                        times.error || "Unable to load appointment times."
                    );
                }

                if (requestController !== controller) return;

                timeOptions.innerHTML = "";

                if (!Array.isArray(times) || times.length === 0) {
                    clearTimes("No available appointments for this selection.");
                    return;
                }

                timeOptions.className =
                    "mt-3 grid grid-cols-3 gap-2 sm:grid-cols-4";

                times.forEach((time, index) => {
                    const wrapper = document.createElement("div");

                    const input = document.createElement("input");
                    input.type = "radio";
                    input.name = "booking[time]";
                    input.id = `booking-time-${index}`;
                    input.value = time;
                    input.required = true;
                    input.className = "time-radio peer sr-only";

                    const label = document.createElement("label");
                    label.htmlFor = input.id;
                    label.textContent = time;

                    label.className =
                        "block cursor-pointer rounded-xl border border-slate-200 " +
                        "px-3 py-2.5 text-center text-sm font-semibold " +
                        "text-slate-700 transition hover:border-indigo-300 " +
                        "peer-checked:border-indigo-500 " +
                        "peer-checked:bg-indigo-50 " +
                        "peer-checked:text-indigo-700";

                    input.addEventListener("change", () => {
                        summaryTime.textContent = time;
                    });

                    wrapper.appendChild(input);
                    wrapper.appendChild(label);
                    timeOptions.appendChild(wrapper);
                });

            } catch (error) {
                if (error.name === "AbortError") return;

                clearTimes(error.message || "Unable to load times.");
            }
        }

        if (window.lucide) {
            lucide.createIcons();
        }
    });

</script>