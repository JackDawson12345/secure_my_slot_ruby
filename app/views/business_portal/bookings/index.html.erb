<!-- Bookings page content -->
<main class="p-4 sm:p-6 lg:p-8">
  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Bookings
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Manage booking details, appointments and booking history.
      </p>
    </div>

    <%= link_to business_add_booking_path,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto" do %>
      <i data-lucide="calendar-plus" class="h-4 w-4"></i>
      Add Booking
    <% end %>
  </section>

  <!-- Booking statistics -->
  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Today -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Today
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            12
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="calendar-days" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        9 confirmed, 3 pending
      </p>
    </article>

    <!-- Upcoming -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Upcoming
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            46
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="clock-3" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Over the next 7 days
      </p>
    </article>

    <!-- Completed -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Completed
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            128
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="circle-check-big" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        This month
      </p>
    </article>

    <!-- Cancelled -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Cancelled
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            8
          </p>
        </div>

        <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
          <i data-lucide="calendar-x" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        This month
      </p>
    </article>
  </section>

  <!-- Booking filters and list -->
  <section
    class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  >
    <!-- Filter toolbar -->
    <div class="border-b border-slate-200 p-5 sm:p-6">
      <div
        class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between"
      >
        <!-- Status tabs -->
        <div
          class="flex w-full gap-1 overflow-x-auto rounded-xl bg-slate-100 p-1 xl:w-auto"
        >
          <button
            type="button"
            class="shrink-0 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-900 shadow-sm"
          >
            All bookings
          </button>

          <button
            type="button"
            class="shrink-0 rounded-lg px-4 py-2 text-sm font-medium text-slate-500 transition hover:bg-white hover:text-slate-900"
          >
            Confirmed
          </button>

          <button
            type="button"
            class="shrink-0 rounded-lg px-4 py-2 text-sm font-medium text-slate-500 transition hover:bg-white hover:text-slate-900"
          >
            Pending
          </button>


          <button
            type="button"
            class="shrink-0 rounded-lg px-4 py-2 text-sm font-medium text-slate-500 transition hover:bg-white hover:text-slate-900"
          >
            Cancelled
          </button>
        </div>

        <!-- Search and filter buttons -->
        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="relative min-w-0 sm:w-72">
            <i
              data-lucide="search"
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
            ></i>

            <input
              type="search"
              placeholder="Search bookings..."
              class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              />
          </div>

          <button
            type="button"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            <i data-lucide="calendar-range" class="h-4 w-4"></i>
            Date
          </button>

          <button
            type="button"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
          >
            <i data-lucide="sliders-horizontal" class="h-4 w-4"></i>
            Filters
          </button>
        </div>
      </div>
    </div>

    <!-- Desktop bookings table -->
    <div class="hidden overflow-x-auto lg:block">
      <table class="min-w-full">
        <thead class="bg-slate-50">
        <tr>
          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Customer
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Service
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Date and time
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Price
          </th>

          <th
            scope="col"
            class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
          >
            Status
          </th>

          <th scope="col" class="px-6 py-4">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
        </thead>

        <tbody class="divide-y divide-slate-100 bg-white">
          <% @bookings.each do |booking| %>
            <!-- Booking 1 -->
            <tr class="transition hover:bg-slate-50">
            <td class="whitespace-nowrap px-6 py-4">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700"
                >
                  <%= booking.user.first_name[0] %><%= booking.user.last_name[0] %>
                </div>

                <div>
                  <p class="text-sm font-semibold text-slate-900">
                    <%= booking.user.first_name %> <%= booking.user.last_name %>
                  </p>

                  <p class="mt-0.5 text-xs text-slate-500">
                    <%= booking.user.email %>
                  </p>
                </div>
              </div>
            </td>

            <td class="whitespace-nowrap px-6 py-4">
              <p class="text-sm font-medium text-slate-900">
                <%= booking.service.name %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= booking.service.minutes_duration %> minutes
              </p>
            </td>

            <td class="whitespace-nowrap px-6 py-4">
              <p class="text-sm font-medium text-slate-900">
                <%= booking.date.strftime("%A, %-d %B") %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= booking.time.strftime("%-I:%M %P") %>
              </p>
            </td>

            <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold">
              <%= number_to_currency(booking.service.price, unit: "£") %>
            </td>

              <%
                status_classes = case booking.status
                                 when "confirmed"
                                   "bg-emerald-50 text-emerald-700"
                                 when "pending"
                                   "bg-yellow-50 text-yellow-700"
                                 when "canceled"
                                   "bg-red-50 text-red-700"
                                 else
                                   "bg-slate-50 text-slate-700"
                                 end

                dot_classes = case booking.status
                              when "confirmed"
                                "bg-emerald-500"
                              when "pending"
                                "bg-yellow-500"
                              when "canceled"
                                "bg-red-500"
                              else
                                "bg-slate-500"
                              end
              %>

              <td class="whitespace-nowrap px-6 py-4">
  <span
    class="capitalize inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold <%= status_classes %>"
  >
    <span class="h-1.5 w-1.5 rounded-full <%= dot_classes %>"></span>

    <%= booking.status.capitalize %>
  </span>
              </td>

            <td class="whitespace-nowrap px-6 py-4 text-right">
              <%= link_to business_booking_path(booking), aria: { label: "Open booking options" },
                          class: "rounded-lg p-2 text-slate-400 transition" do %>
                <i data-lucide="ellipsis" class="h-5 w-5"></i>
              <% end %>
            </td>
          </tr>
          <% end %>

        </tbody>
      </table>
    </div>

    <!-- Mobile booking cards -->
    <div class="divide-y divide-slate-100 lg:hidden">
      <!-- Mobile booking 1 -->
      <article class="p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-center gap-3">
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700"
            >
              OT
            </div>

            <div class="min-w-0">
              <p class="truncate font-semibold text-slate-900">
                Olivia Thompson
              </p>

              <p class="mt-0.5 truncate text-sm text-slate-500">
                Initial Consultation
              </p>
            </div>
          </div>

          <button
            type="button"
            aria-label="Open booking options"
            class="rounded-lg p-2 text-slate-400 hover:bg-slate-100"
          >
            <i data-lucide="ellipsis" class="h-5 w-5"></i>
          </button>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-xl bg-slate-50 p-3">
            <p class="text-xs font-medium text-slate-500">
              Date
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              27 July
            </p>
          </div>

          <div class="rounded-xl bg-slate-50 p-3">
            <p class="text-xs font-medium text-slate-500">
              Time
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              9:30 am
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          Confirmed
        </span>

          <p class="text-sm font-bold text-slate-900">
            £45.00
          </p>
        </div>
      </article>

      <!-- Mobile booking 2 -->
      <article class="p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-center gap-3">
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-semibold text-blue-700"
            >
              JW
            </div>

            <div class="min-w-0">
              <p class="truncate font-semibold text-slate-900">
                James Wilson
              </p>

              <p class="mt-0.5 truncate text-sm text-slate-500">
                Follow-up Appointment
              </p>
            </div>
          </div>

          <button
            type="button"
            aria-label="Open booking options"
            class="rounded-lg p-2 text-slate-400 hover:bg-slate-100"
          >
            <i data-lucide="ellipsis" class="h-5 w-5"></i>
          </button>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-xl bg-slate-50 p-3">
            <p class="text-xs font-medium text-slate-500">
              Date
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              27 July
            </p>
          </div>

          <div class="rounded-xl bg-slate-50 p-3">
            <p class="text-xs font-medium text-slate-500">
              Time
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              11:00 am
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
          Pending
        </span>

          <p class="text-sm font-bold text-slate-900">
            £30.00
          </p>
        </div>
      </article>

      <!-- Mobile booking 3 -->
      <article class="p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-center gap-3">
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-violet-100 text-sm font-semibold text-violet-700"
            >
              ED
            </div>

            <div class="min-w-0">
              <p class="truncate font-semibold text-slate-900">
                Emily Davies
              </p>

              <p class="mt-0.5 truncate text-sm text-slate-500">
                Standard Appointment
              </p>
            </div>
          </div>

          <button
            type="button"
            aria-label="Open booking options"
            class="rounded-lg p-2 text-slate-400 hover:bg-slate-100"
          >
            <i data-lucide="ellipsis" class="h-5 w-5"></i>
          </button>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-xl bg-slate-50 p-3">
            <p class="text-xs font-medium text-slate-500">
              Date
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              27 July
            </p>
          </div>

          <div class="rounded-xl bg-slate-50 p-3">
            <p class="text-xs font-medium text-slate-500">
              Time
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              1:30 pm
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          Confirmed
        </span>

          <p class="text-sm font-bold text-slate-900">
            £40.00
          </p>
        </div>
      </article>
    </div>

    <!-- Pagination -->
    <div
      class="flex flex-col gap-4 border-t border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <p class="text-sm text-slate-500">
        Showing
        <span class="font-semibold text-slate-900">1</span>
        to
        <span class="font-semibold text-slate-900">5</span>
        of
        <span class="font-semibold text-slate-900">194</span>
        bookings
      </p>

      <div class="flex items-center gap-2">
        <button
          type="button"
          disabled
          class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-400 disabled:cursor-not-allowed"
        >
          <i data-lucide="chevron-left" class="h-4 w-4"></i>
          Previous
        </button>

        <button
          type="button"
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-sm font-semibold text-white"
        >
          1
        </button>

        <button
          type="button"
          class="hidden h-9 w-9 items-center justify-center rounded-lg text-sm font-medium text-slate-600 transition hover:bg-slate-100 sm:flex"
        >
          2
        </button>

        <button
          type="button"
          class="hidden h-9 w-9 items-center justify-center rounded-lg text-sm font-medium text-slate-600 transition hover:bg-slate-100 sm:flex"
        >
          3
        </button>

        <button
          type="button"
          class="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
        >
          Next
          <i data-lucide="chevron-right" class="h-4 w-4"></i>
        </button>
      </div>
    </div>
  </section>
</main>
