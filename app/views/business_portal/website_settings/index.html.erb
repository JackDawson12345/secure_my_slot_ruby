<%
  available_icons = [
    ["calendar-check", "Calendar"],
    ["calendar-days", "Appointments"],
    ["clock-3", "Opening times"],
    ["map-pin", "Location"],
    ["navigation", "Directions"],
    ["phone", "Phone"],
    ["mail", "Email"],
    ["badge-check", "Trusted"],
    ["circle-check-big", "Confirmed"],
    ["star", "Quality"],
    ["heart", "Care"],
    ["sparkles", "Premium"],
    ["shield-check", "Secure"],
    ["circle-pound-sterling", "Pricing"],
    ["wallet-cards", "Payment"],
    ["users", "Customers"],
    ["user-round-check", "Professional"],
    ["briefcase-business", "Business"],
    ["house", "Home"],
    ["building-2", "Premises"],
    ["scissors", "Barbering"],
    ["wrench", "Repairs"],
    ["hammer", "Trades"],
    ["camera", "Photography"],
    ["dumbbell", "Fitness"],
    ["graduation-cap", "Training"],
    ["car", "Transport"],
    ["truck", "Delivery"],
    ["message-circle", "Consultation"],
    ["thumbs-up", "Recommended"]
  ]

  colour_schemes = [
    {
      value: "blue",
      name: "Ocean Blue",
      description: "Professional and dependable",
      colours: [
        "bg-blue-900",
        "bg-blue-700",
        "bg-blue-500",
        "bg-blue-300"
      ]
    },
    {
      value: "indigo",
      name: "Modern Indigo",
      description: "Clean and contemporary",
      colours: [
        "bg-indigo-900",
        "bg-indigo-700",
        "bg-indigo-500",
        "bg-indigo-300"
      ]
    },
    {
      value: "violet",
      name: "Creative Violet",
      description: "Bold and distinctive",
      colours: [
        "bg-violet-900",
        "bg-violet-700",
        "bg-violet-500",
        "bg-violet-300"
      ]
    },
    {
      value: "purple",
      name: "Deep Purple",
      description: "Premium and confident",
      colours: [
        "bg-purple-900",
        "bg-purple-700",
        "bg-purple-500",
        "bg-purple-300"
      ]
    },
    {
      value: "pink",
      name: "Rose Pink",
      description: "Friendly and expressive",
      colours: [
        "bg-pink-900",
        "bg-pink-700",
        "bg-pink-500",
        "bg-pink-300"
      ]
    },
    {
      value: "rose",
      name: "Warm Rose",
      description: "Welcoming and personal",
      colours: [
        "bg-rose-900",
        "bg-rose-700",
        "bg-rose-500",
        "bg-rose-300"
      ]
    },
    {
      value: "red",
      name: "Strong Red",
      description: "Energetic and direct",
      colours: [
        "bg-red-900",
        "bg-red-700",
        "bg-red-500",
        "bg-red-300"
      ]
    },
    {
      value: "orange",
      name: "Bright Orange",
      description: "Warm and energetic",
      colours: [
        "bg-orange-900",
        "bg-orange-700",
        "bg-orange-500",
        "bg-orange-300"
      ]
    },
    {
      value: "amber",
      name: "Golden Amber",
      description: "Positive and approachable",
      colours: [
        "bg-amber-900",
        "bg-amber-700",
        "bg-amber-500",
        "bg-amber-300"
      ]
    },
    {
      value: "emerald",
      name: "Fresh Emerald",
      description: "Natural and trustworthy",
      colours: [
        "bg-emerald-900",
        "bg-emerald-700",
        "bg-emerald-500",
        "bg-emerald-300"
      ]
    },
    {
      value: "green",
      name: "Natural Green",
      description: "Calm and established",
      colours: [
        "bg-green-900",
        "bg-green-700",
        "bg-green-500",
        "bg-green-300"
      ]
    },
    {
      value: "teal",
      name: "Calm Teal",
      description: "Balanced and professional",
      colours: [
        "bg-teal-900",
        "bg-teal-700",
        "bg-teal-500",
        "bg-teal-300"
      ]
    },
    {
      value: "cyan",
      name: "Clear Cyan",
      description: "Fresh and modern",
      colours: [
        "bg-cyan-900",
        "bg-cyan-700",
        "bg-cyan-500",
        "bg-cyan-300"
      ]
    },
    {
      value: "slate",
      name: "Classic Slate",
      description: "Neutral and sophisticated",
      colours: [
        "bg-slate-900",
        "bg-slate-700",
        "bg-slate-500",
        "bg-slate-300"
      ]
    }
  ]

  hero = @business_website.hero || {}
  services = @business_website.services || {}
  about_us = @business_website.about_us || {}
  visit = @business_website.visit || {}

  hero_info_boxes = hero.fetch("info_boxes", [])
  about_icon_boxes = about_us.fetch("icon_boxes", [])
%>

<main class="p-4 sm:p-6 lg:p-8">
  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Website settings
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Update the content displayed on your public website.
      </p>
    </div>

    <button
      type="submit"
      form="websiteSettingsForm"
      class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
    >
      <i data-lucide="save" class="h-4 w-4"></i>
      Save changes
    </button>
  </section>

  <!-- Validation errors -->
  <% if @business_website.errors.any? %>
    <div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 p-5">
      <div class="flex items-start gap-3">
        <div class="rounded-xl bg-white p-2 text-rose-600">
          <i data-lucide="circle-alert" class="h-5 w-5"></i>
        </div>

        <div>
          <h3 class="font-semibold text-rose-800">
            Website settings could not be saved
          </h3>

          <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-rose-700">
            <% @business_website.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <%= form_with model: @business_website,
                scope: :business_website,
                url: business_website_settings_path,
                method: :patch,
                multipart: true,
                id: "websiteSettingsForm",
                class: "mt-8 space-y-8" do |form| %>

    <!-- Hero section -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
            <i data-lucide="layout-template" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="text-lg font-bold text-slate-900">
              Hero section
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Update the main heading and introductory content at the top of your website.
            </p>
          </div>
        </div>
      </div>

      <div class="grid gap-6 p-5 sm:p-6">
        <div>
          <%= label_tag "business_website_hero_title",
                        "Title",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_field_tag "business_website[hero][title]",
                             hero["title"],
                             id: "business_website_hero_title",
                             placeholder: "Enter your main website heading",
                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>

        <div>
          <%= label_tag "business_website_hero_sentence",
                        "Introduction",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_area_tag "business_website[hero][sentence]",
                            hero["sentence"],
                            id: "business_website_hero_sentence",
                            rows: 3,
                            placeholder: "Write a short introduction to your business",
                            class: "w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>

        <div data-controller="image-preview">
          <%= form.label :hero_image,
                         "Hero image",
                         class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <div class="mb-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
            <% if @business_website.hero_image.attached? %>
              <%= image_tag @business_website.hero_image,
                            data: { image_preview_target: "image" },
                            class: "h-64 w-full object-cover",
                            alt: "Hero image preview" %>
            <% else %>
              <div
                data-image-preview-target="placeholder"
                class="flex h-64 items-center justify-center text-slate-400"
              >
                <div class="text-center">
                  <i data-lucide="image" class="mx-auto h-8 w-8"></i>

                  <p class="mt-2 text-sm font-medium">
                    No hero image uploaded
                  </p>
                </div>
              </div>

              <img
                data-image-preview-target="image"
                class="hidden h-64 w-full object-cover"
                alt="Hero image preview"
              >
            <% end %>
          </div>

          <%= form.file_field :hero_image,
                              accept: "image/png,image/jpeg,image/webp",
                              data: {
                                image_preview_target: "input",
                                action: "change->image-preview#show"
                              },
                              class: "block w-full cursor-pointer rounded-xl border border-slate-200 bg-white text-sm text-slate-700 file:mr-4 file:border-0 file:bg-indigo-50 file:px-4 file:py-3 file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" %>

          <p class="mt-2 text-xs text-slate-500">
            Upload a JPG, PNG or WebP image.
          </p>
        </div>

        <!-- Hero information boxes -->
        <div>
          <div class="mb-4">
            <h4 class="text-base font-bold text-slate-900">
              Information boxes
            </h4>

            <p class="mt-1 text-sm text-slate-500">
              Select an icon and enter a short benefit or piece of information.
            </p>
          </div>

          <div class="grid gap-5 xl:grid-cols-3">
            <% hero_info_boxes.each_with_index do |info_box, index| %>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <div class="mb-5 flex items-center justify-between">
                  <p class="font-semibold text-slate-900">
                    Information box <%= index + 1 %>
                  </p>

                  <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-500">
                    <%= index + 1 %> of <%= hero_info_boxes.length %>
                  </span>
                </div>

                <div class="space-y-5">
                  <!-- Icon picker -->
                  <div>
                    <p class="mb-3 block text-sm font-semibold text-slate-700">
                      Select an icon
                    </p>

                    <div class="grid grid-cols-5 gap-2">
                      <% available_icons.each do |icon_name, icon_label| %>
                        <% input_id = "hero_info_box_#{index}_icon_#{icon_name}" %>

                        <label
                          for="<%= input_id %>"
                          title="<%= icon_label %>"
                          class="group relative cursor-pointer"
                        >
                          <%= radio_button_tag(
                                "business_website[hero][info_boxes][#{index}][icon]",
                                icon_name,
                                info_box["icon"] == icon_name,
                                id: input_id,
                                class: "peer sr-only"
                              ) %>

                          <span
                            class="flex aspect-square items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 transition group-hover:border-indigo-300 group-hover:bg-indigo-50 group-hover:text-indigo-600 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200"
                          >
                            <i
                              data-lucide="<%= icon_name %>"
                              class="h-5 w-5"
                            ></i>
                          </span>

                          <span class="sr-only">
                            <%= icon_label %>
                          </span>

                          <span
                            class="pointer-events-none absolute -right-1 -top-1 hidden h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-white shadow-sm peer-checked:flex"
                          >
                            <i data-lucide="check" class="h-3 w-3"></i>
                          </span>
                        </label>
                      <% end %>
                    </div>

                    <p class="mt-3 text-xs text-slate-500">
                      Hover over an icon to see its meaning.
                    </p>
                  </div>

                  <!-- Information box title -->
                  <div>
                    <%= label_tag "hero_info_box_#{index}_title",
                                  "Text",
                                  class: "mb-2 block text-sm font-semibold text-slate-700" %>

                    <%= text_field_tag(
                          "business_website[hero][info_boxes][#{index}][title]",
                          info_box["title"],
                          id: "hero_info_box_#{index}_title",
                          placeholder: "Example: Instant confirmation",
                          class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                        ) %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <!-- Services section -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
            <i data-lucide="briefcase-business" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="text-lg font-bold text-slate-900">
              Services section
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Introduce the services available from your business.
            </p>
          </div>
        </div>
      </div>

      <div class="grid gap-5 p-5 sm:p-6">
        <div>
          <%= label_tag "business_website_services_title",
                        "Title",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_field_tag "business_website[services][title]",
                             services["title"],
                             id: "business_website_services_title",
                             placeholder: "Example: Choose the right appointment",
                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>

        <div>
          <%= label_tag "business_website_services_sentence",
                        "Introduction",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_area_tag "business_website[services][sentence]",
                            services["sentence"],
                            id: "business_website_services_sentence",
                            rows: 3,
                            placeholder: "Add a short introduction to your services",
                            class: "w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>
      </div>
    </section>

    <!-- About us section -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
            <i data-lucide="users" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="text-lg font-bold text-slate-900">
              About us section
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Tell customers more about your business and what makes it different.
            </p>
          </div>
        </div>
      </div>

      <div class="grid gap-6 p-5 sm:p-6">
        <div>
          <%= label_tag "business_website_about_title",
                        "Title",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_field_tag "business_website[about_us][title]",
                             about_us["title"],
                             id: "business_website_about_title",
                             placeholder: "Example: Professional service you can trust",
                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>

        <div>
          <%= label_tag "business_website_about_paragraph",
                        "Paragraph",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_area_tag "business_website[about_us][paragraph]",
                            about_us["paragraph"],
                            id: "business_website_about_paragraph",
                            rows: 5,
                            placeholder: "Tell customers about your business, experience and approach",
                            class: "w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>

        <!-- About feature boxes -->
        <div>
          <div class="mb-4">
            <h4 class="text-base font-bold text-slate-900">
              Business features
            </h4>

            <p class="mt-1 text-sm text-slate-500">
              Add four reasons customers should choose your business.
            </p>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            <% about_icon_boxes.each_with_index do |icon_box, index| %>
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <div class="mb-5 flex items-center justify-between">
                  <p class="font-semibold text-slate-900">
                    Feature box <%= index + 1 %>
                  </p>

                  <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-500">
                    <%= index + 1 %> of <%= about_icon_boxes.length %>
                  </span>
                </div>

                <div class="space-y-4">
                  <div>
                    <%= label_tag "about_icon_box_#{index}_title",
                                  "Title",
                                  class: "mb-2 block text-sm font-semibold text-slate-700" %>

                    <%= text_field_tag(
                          "business_website[about_us][icon_boxes][#{index}][title]",
                          icon_box["title"],
                          id: "about_icon_box_#{index}_title",
                          placeholder: "Example: Experienced professionals",
                          class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                        ) %>
                  </div>

                  <div>
                    <%= label_tag "about_icon_box_#{index}_sentence",
                                  "Description",
                                  class: "mb-2 block text-sm font-semibold text-slate-700" %>

                    <%= text_area_tag(
                          "business_website[about_us][icon_boxes][#{index}][sentence]",
                          icon_box["sentence"],
                          id: "about_icon_box_#{index}_sentence",
                          rows: 3,
                          placeholder: "Add a short description",
                          class: "w-full resize-none rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                        ) %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div data-controller="image-preview">
          <%= form.label :about_image,
                         "About us image",
                         class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <div class="mb-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
            <% if @business_website.about_image.attached? %>
              <%= image_tag @business_website.about_image,
                            data: { image_preview_target: "image" },
                            class: "h-64 w-full object-cover",
                            alt: "About us image preview" %>
            <% else %>
              <div
                data-image-preview-target="placeholder"
                class="flex h-64 items-center justify-center text-slate-400"
              >
                <div class="text-center">
                  <i data-lucide="image" class="mx-auto h-8 w-8"></i>

                  <p class="mt-2 text-sm font-medium">
                    No about us image uploaded
                  </p>
                </div>
              </div>

              <img
                data-image-preview-target="image"
                class="hidden h-64 w-full object-cover"
                alt="About us image preview"
              >
            <% end %>
          </div>

          <%= form.file_field :about_image,
                              accept: "image/png,image/jpeg,image/webp",
                              data: {
                                image_preview_target: "input",
                                action: "change->image-preview#show"
                              },
                              class: "block w-full cursor-pointer rounded-xl border border-slate-200 bg-white text-sm text-slate-700 file:mr-4 file:border-0 file:bg-violet-50 file:px-4 file:py-3 file:font-semibold file:text-violet-700 hover:file:bg-violet-100" %>

          <p class="mt-2 text-xs text-slate-500">
            Upload a JPG, PNG or WebP image.
          </p>
        </div>
      </div>
    </section>

    <!-- Visit section -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
            <i data-lucide="map-pin" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="text-lg font-bold text-slate-900">
              Visit section
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Add a heading and message above your location and opening hours.
            </p>
          </div>
        </div>
      </div>

      <div class="grid gap-5 p-5 sm:p-6">
        <div>
          <%= label_tag "business_website_visit_title",
                        "Title",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_field_tag "business_website[visit][title]",
                             visit["title"],
                             id: "business_website_visit_title",
                             placeholder: "Example: Plan your visit",
                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>

        <div>
          <%= label_tag "business_website_visit_sentence",
                        "Introduction",
                        class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <%= text_area_tag "business_website[visit][sentence]",
                            visit["sentence"],
                            id: "business_website_visit_sentence",
                            rows: 3,
                            placeholder: "Add a short message for customers planning their visit",
                            class: "w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        </div>
      </div>
    </section>

    <!-- Colour scheme section -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-fuchsia-50 p-3 text-fuchsia-600">
            <i data-lucide="palette" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="text-lg font-bold text-slate-900">
              Website colour scheme
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Choose the colour palette used across your public website.
            </p>
          </div>
        </div>
      </div>

      <div class="p-5 sm:p-6">
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <% colour_schemes.each do |scheme| %>
            <% input_id = "business_website_colour_#{scheme[:value]}" %>

            <label
              for="<%= input_id %>"
              class="group relative cursor-pointer"
            >
              <%= form.radio_button(
                    :colour,
                    scheme[:value],
                    id: input_id,
                    class: "peer sr-only"
                  ) %>

              <div
                class="h-full rounded-2xl border-2 border-slate-200 bg-white p-4 transition hover:border-slate-300 hover:shadow-sm peer-checked:border-indigo-600 peer-checked:ring-4 peer-checked:ring-indigo-100 peer-focus-visible:ring-4 peer-focus-visible:ring-indigo-100"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="font-semibold text-slate-900">
                      <%= scheme[:name] %>
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                      <%= scheme[:description] %>
                    </p>
                  </div>

                  <span
                    class="hidden h-6 w-6 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-white peer-checked:flex"
                  >
                <i data-lucide="check" class="h-4 w-4"></i>
              </span>
                </div>

                <div class="mt-4 flex overflow-hidden rounded-xl">
                  <% scheme[:colours].each do |colour_class| %>
                    <div class="<%= colour_class %> h-12 flex-1"></div>
                  <% end %>
                </div>

                <div class="mt-4 rounded-xl bg-slate-50 p-3">
                  <div class="flex items-center gap-3">
                    <div class="<%= scheme[:colours][1] %> h-9 w-9 rounded-lg"></div>

                    <div class="min-w-0 flex-1">
                      <div class="<%= scheme[:colours][0] %> h-2.5 w-2/3 rounded-full"></div>
                      <div class="<%= scheme[:colours][3] %> mt-2 h-2 w-full rounded-full"></div>
                    </div>

                    <div class="<%= scheme[:colours][2] %> h-8 w-16 rounded-lg"></div>
                  </div>
                </div>
              </div>
            </label>
          <% end %>
        </div>

        <p class="mt-5 text-xs leading-5 text-slate-500">
          The selected colour scheme controls buttons, links, icons, backgrounds and highlighted areas on your public website.
        </p>
      </div>
    </section>

    <!-- Bottom actions -->
    <div class="flex flex-col-reverse gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-end">
      <button
        type="reset"
        class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
      >
        Discard changes
      </button>

      <button
        type="submit"
        class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
      >
        <i data-lucide="save" class="h-4 w-4"></i>
        Save changes
      </button>
    </div>
  <% end %>
</main>