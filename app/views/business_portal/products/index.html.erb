<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Products
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Create and manage the products available to your customers.
      </p>
    </div>


    <%= link_to new_business_product_path,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 sm:w-auto" do %>

      <i data-lucide="plus" class="h-4 w-4"></i>
      Add product

    <% end %>

  </section>


  <%= render 'business_portal/shared/flash_messages' %>


  <!-- Statistics -->

  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Total Products
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @total_products %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="package" class="h-5 w-5"></i>
        </div>

      </div>

      <p class="mt-4 text-sm text-slate-500">
        Products in your catalogue
      </p>

    </article>



    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Active Products
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @active_products_count %>
          </p>
        </div>


        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="circle-check" class="h-5 w-5"></i>
        </div>

      </div>


      <p class="mt-4 text-sm text-slate-500">
        Available for customers
      </p>

    </article>




    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Featured Products
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @featured_products_count %>
          </p>
        </div>


        <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
          <i data-lucide="star" class="h-5 w-5"></i>
        </div>

      </div>


      <p class="mt-4 text-sm text-slate-500">
        Highlighted products
      </p>

    </article>




    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Out Of Stock
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @products.where(stock_count: 0).count %>
          </p>
        </div>


        <div class="rounded-xl bg-red-50 p-3 text-red-600">
          <i data-lucide="boxes" class="h-5 w-5"></i>
        </div>

      </div>


      <p class="mt-4 text-sm text-slate-500">
        Products needing attention
      </p>

    </article>


  </section>



  <!-- Products panel -->

  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


    <div class="border-b border-slate-200 p-5 sm:p-6">

      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

        <div>
          <h3 class="text-lg font-bold text-slate-900">
            All products
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Manage product details, pricing, stock and availability.
          </p>
        </div>


        <%= link_to new_business_product_path,
                    class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700" do %>

          <i data-lucide="plus" class="h-4 w-4"></i>
          Add product

        <% end %>


      </div>

    </div>



    <% if @products.any? %>


      <div class="grid gap-5 p-5 sm:grid-cols-2 xl:grid-cols-3 sm:p-6">


        <% @products.each do |product| %>


          <article class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md">


            <div class="flex items-start justify-between">

              <% if product.featured_image.attached? %>

                <%= image_tag product.featured_image,
                              class:"h-20 w-20 rounded-2xl object-cover border border-slate-200"%>
              <% else %>

                <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600">

                  <i data-lucide="package" class="h-7 w-7"></i>

                </div>

              <% end %>


              <%= link_to business_product_path(product),
                          class:"rounded-lg p-2 text-slate-400 hover:bg-slate-100" do %>

                <i data-lucide="ellipsis" class="h-5 w-5"></i>

              <% end %>


            </div>



            <div class="mt-7">


              <div class="flex items-start justify-between gap-3">

                <h4 class="font-bold text-slate-900">
                  <%= product.name %>
                </h4>


                <% if product.status == "active" %>

                  <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                    Active
                  </span>

                <% else %>

                  <span class="rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600">
                    Inactive
                  </span>

                <% end %>


              </div>



              <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">
                <%= product.short_description.presence || "No description added." %>
              </p>



              <% if product.featured? %>

                <div class="mt-3 inline-flex items-center gap-1 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">

                  <i data-lucide="star" class="h-3.5 w-3.5"></i>
                  Featured

                </div>

              <% end %>


            </div>



            <div class="mt-5 grid grid-cols-2 gap-3">


              <div class="rounded-xl bg-slate-50 p-3">

                <p class="text-xs font-medium text-slate-500">
                  Price
                </p>


                <p class="mt-1 text-sm font-semibold text-slate-900">

                  <%= number_to_currency(product.sale_price.presence || product.regular_price, unit:"£") %>

                </p>


              </div>



              <div class="rounded-xl bg-slate-50 p-3">

                <p class="text-xs font-medium text-slate-500">
                  Stock
                </p>


                <p class="mt-1 text-sm font-semibold text-slate-900">

                  <% if product.manage_stock? %>
                    <%= product.stock_count %>
                  <% else %>
                    Unlimited
                  <% end %>

                </p>

              </div>


            </div>



            <div class="mt-5 border-t border-slate-100 pt-4 flex justify-between">


              <%= link_to "View product",
                          business_product_path(product),
                          class:"text-sm font-semibold text-slate-500" %>



              <%= link_to edit_business_product_path(product),
                          class:"inline-flex items-center gap-1 text-sm font-semibold text-indigo-600" do %>

                Edit
                <i data-lucide="arrow-right" class="h-4 w-4"></i>

              <% end %>


            </div>


          </article>


        <% end %>


      </div>


    <% else %>


      <div class="px-5 py-16 text-center sm:px-6">


        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">

          <i data-lucide="package" class="h-6 w-6"></i>

        </div>


        <h3 class="mt-4 text-lg font-bold text-slate-900">
          No products yet
        </h3>


        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
          Add your first product so customers can browse and purchase your items.
        </p>


        <%= link_to "Add your first product",
                    new_business_product_path,
                    class:"mt-6 inline-flex rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white" %>


      </div>


    <% end %>


  </section>


</main>