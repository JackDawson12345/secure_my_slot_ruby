<main class="p-4 sm:p-6 lg:p-8">


  <!-- Header -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

    <div>

      <div class="flex items-center gap-3">

        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Order #<%= @order.id %>
        </h2>


        <%
          status_classes =
            case @order.status
            when "completed"
              "bg-emerald-50 text-emerald-700"
            when "pending"
              "bg-amber-50 text-amber-700"
            when "cancelled"
              "bg-rose-50 text-rose-700"
            else
              "bg-slate-100 text-slate-700"
            end
        %>


        <span class="rounded-full px-3 py-1 text-xs font-semibold capitalize <%= status_classes %>">
          <%= @order.status %>
        </span>

      </div>


      <p class="mt-2 text-sm text-slate-500">
        Created <%= @order.created_at.strftime("%A %-d %B %Y at %H:%M") %>
      </p>

    </div>



    <%= link_to orders_business_products_path,
                class:"inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50" do %>

      <i data-lucide="arrow-left" class="h-4 w-4"></i>

      Back to orders

    <% end %>


  </section>




  <div class="mt-8 grid gap-6 lg:grid-cols-3">



    <!-- Main -->
    <div class="space-y-6 lg:col-span-2">


      <!-- Products -->
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">


        <div class="border-b border-slate-200 px-6 py-5">

          <h3 class="text-lg font-bold text-slate-900">
            Order items
          </h3>

        </div>



        <div class="divide-y divide-slate-100">


          <% @order.order_items.each do |item| %>


            <div class="flex items-center gap-5 px-6 py-5">


              <!-- Product Image -->
              <div class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-slate-50">


                <% if item.product.featured_image.attached? %>

                  <%= image_tag item.product.featured_image,
                                class:"h-full w-full object-cover" %>


                <% else %>

                  <i data-lucide="package"
                     class="h-8 w-8 text-slate-400">
                  </i>

                <% end %>


              </div>




              <!-- Product Details -->
              <div class="flex-1">


                <p class="font-semibold text-slate-900">
                  <%= item.product.name %>
                </p>


                <p class="mt-1 text-sm text-slate-500">
                  Quantity: <%= item.quantity %>
                </p>


                <% if item.product.short_description.present? %>

                  <p class="mt-2 text-xs text-slate-500 line-clamp-2">
                    <%= strip_tags(item.product.short_description.to_s) %>
                  </p>

                <% end %>


              </div>




              <!-- Price -->
              <div class="text-right">


                <p class="font-bold text-slate-900">

                  <%= number_to_currency(
                        item.price * item.quantity,
                        unit: "£"
                      ) %>

                </p>


                <p class="mt-1 text-xs text-slate-500">

                  <%= number_to_currency(
                        item.price,
                        unit: "£"
                      ) %> each

                </p>


              </div>


            </div>


          <% end %>



          <% if @order.order_items.empty? %>

            <div class="px-6 py-12 text-center">

              <p class="font-semibold text-slate-900">
                No products found
              </p>

            </div>

          <% end %>


        </div>


      </section>





      <!-- Customer -->
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">


        <div class="border-b border-slate-200 px-6 py-5">

          <h3 class="text-lg font-bold text-slate-900">
            Customer details
          </h3>

        </div>



        <div class="grid gap-5 px-6 py-6 sm:grid-cols-2">


          <div>

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Name
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.user.full_name rescue @order.user.email %>
            </p>

          </div>



          <div>

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Email
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.user.email %>
            </p>

          </div>


          <% if @order.user.phone_number.present? %>

            <div>

              <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Phone
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-900">
                <%= @order.user.phone_number %>
              </p>

            </div>

          <% end %>


        </div>




      </section>

      <!-- Billing Address -->
      <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">


        <div class="border-b border-slate-200 px-6 py-5">

          <h3 class="text-lg font-bold text-slate-900">
            Billing Address
          </h3>

        </div>
        <div class="grid gap-5 px-6 py-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Address Line One
            </p>
            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.address_line_1 %>
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Address Line Two
            </p>
            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.address_line_2.presence || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Town / City
            </p>
            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.town %>
            </p>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
              Postcode
            </p>
            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.postcode %>
            </p>
          </div>



        </div>




      </section>



    </div>





    <!-- Sidebar -->
    <aside class="space-y-6">



      <!-- Payment -->
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">


        <h3 class="text-lg font-bold text-slate-900">
          Payment
        </h3>


        <div class="mt-5 space-y-4">


          <div class="flex justify-between">

            <span class="text-sm text-slate-500">
              Method
            </span>

            <span class="text-sm font-semibold capitalize text-slate-900">
              <%= @order.payment_method %>
            </span>

          </div>



          <div class="flex justify-between">

            <span class="text-sm text-slate-500">
              Status
            </span>

            <span class="text-sm font-semibold capitalize text-slate-900">
              <%= @order.payment_status %>
            </span>

          </div>



          <div class="border-t border-slate-100 pt-4 flex justify-between">

            <span class="font-semibold text-slate-900">
              Total
            </span>

            <span class="text-xl font-black text-slate-900">
              <%= number_to_currency(@order.amount, unit:"£") %>
            </span>

          </div>


        </div>


      </section>

      <!-- Order information -->
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">


        <h3 class="text-lg font-bold text-slate-900">
          Order information
        </h3>


        <div class="mt-5 space-y-4">


          <div>

            <p class="text-xs uppercase tracking-wide text-slate-400">
              Order ID
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.public_id || @order.id %>
            </p>

          </div>



          <div>

            <p class="text-xs uppercase tracking-wide text-slate-400">
              Created
            </p>

            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @order.created_at.strftime("%d/%m/%Y") %>
            </p>

          </div>


        </div>


      </section>

      <!-- Update Status -->
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

        <h3 class="text-lg font-bold text-slate-900">
          Update Status
        </h3>

        <div class="mt-5 space-y-4">
          <% if @order.cancelled? %>

            <%= link_to business_product_update_status_path(@order, status: "pending"),
                        data: { turbo_method: :patch },
                        class: 'flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700' do %>
              Mark As Pending
            <% end %>


          <% elsif @order.pending? %>

            <%= link_to business_product_update_status_path(@order, status: "confirmed"),
                        data: { turbo_method: :patch },
                        class: 'flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700' do %>
              Mark As Confirmed
            <% end %>

            <%= link_to business_product_update_status_path(@order, status: "cancelled"),
                        data: { turbo_method: :patch },
                        class: 'flex w-full items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700' do %>
              Mark As Cancelled
            <% end %>


          <% elsif @order.confirmed? %>

            <%= link_to business_product_update_status_path(@order, status: "completed"),
                        data: { turbo_method: :patch },
                        class: 'flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700' do %>
              Mark As Completed
            <% end %>

            <%= link_to business_product_update_status_path(@order, status: "cancelled"),
                        data: { turbo_method: :patch },
                        class: 'flex w-full items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700' do %>
              Mark As Cancelled
            <% end %>


          <% elsif @order.completed? %>

            <%= link_to business_product_update_status_path(@order, status: "confirmed"),
                        data: { turbo_method: :patch },
                        class: 'flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700' do %>
              Mark As Confirmed
            <% end %>

            <%= link_to business_product_update_status_path(@order, status: "cancelled"),
                        data: { turbo_method: :patch },
                        class: 'flex w-full items-center justify-center gap-2 rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700' do %>
              Mark As Cancelled
            <% end %>

          <% end %>
        </div>


      </section>

    </aside>



  </div>


</main>