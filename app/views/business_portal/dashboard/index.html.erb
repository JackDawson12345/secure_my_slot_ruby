<!-- Dashboard content -->
<main class="p-4 sm:p-6 lg:p-8">
  <!-- Welcome banner -->
  <section
    class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 p-6 text-white shadow-lg shadow-indigo-200 sm:p-8"
  >
    <div
      class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center"
    >
      <div>
        <p class="mb-2 text-sm font-medium text-indigo-100">
          <%= Date.current.strftime("%A, %-d %B") %>
        </p>

        <h2 class="text-2xl font-bold sm:text-3xl">
          Welcome back, <%= current_user.first_name.presence || "there" %>
        </h2>

        <p class="mt-2 max-w-xl text-sm leading-6 text-indigo-100 sm:text-base">
          <% if @next_booking.present? %>
            You have
            <%= pluralize(@today_bookings_count, "booking") %>
            today. Your next appointment is with
            <%= [
                  @next_booking.user.first_name,
                  @next_booking.user.last_name
                ].compact.join(" ") %>
            at
            <%= @next_booking.time.strftime("%-I:%M %P") %>.
          <% elsif @today_bookings_count.positive? %>
            You had
            <%= pluralize(@today_bookings_count, "booking") %>
            today. There are no more appointments scheduled.
          <% else %>
            You have no bookings scheduled for today.
          <% end %>
        </p>
      </div>

      <%# Welcome banner button %>
      <%= link_to business_add_booking_path,
                  class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 sm:w-auto" do %>
        <i data-lucide="plus" class="h-4 w-4"></i>
        Add booking
      <% end %>
    </div>
  </section>

  <!-- Statistics -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Card 1 -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Today's Bookings
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @today_bookings_count %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="calendar-days" class="h-5 w-5"></i>
        </div>
      </div>

      <div class="mt-4 flex items-center gap-1 text-sm">
        <% if @today_bookings_difference.positive? %>
          <i
            data-lucide="trending-up"
            class="h-4 w-4 text-emerald-600"
          ></i>

          <span class="font-medium text-emerald-600">
            <%= @today_bookings_difference %> more
          </span>
        <% elsif @today_bookings_difference.negative? %>
          <i
            data-lucide="trending-down"
            class="h-4 w-4 text-rose-600"
          ></i>

          <span class="font-medium text-rose-600">
            <%= @today_bookings_difference.abs %> fewer
          </span>
        <% else %>
          <i
            data-lucide="minus"
            class="h-4 w-4 text-slate-500"
          ></i>

          <span class="font-medium text-slate-600">
      No change
    </span>
        <% end %>

        <span class="text-slate-500">
    than yesterday
  </span>
      </div>
    </article>

    <!-- Card 2 -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            This Week
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @this_week_bookings_count %>
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="clock-3" class="h-5 w-5"></i>
        </div>
      </div>

      <div class="mt-4 flex items-center gap-1 text-sm">
        <% if @weekly_percentage_change.positive? %>
          <i
            data-lucide="trending-up"
            class="h-4 w-4 text-emerald-600"
          ></i>

          <span class="font-medium text-emerald-600">
            <%= @weekly_percentage_change %>%
          </span>
        <% elsif @weekly_percentage_change.negative? %>
          <i
            data-lucide="trending-down"
            class="h-4 w-4 text-rose-600"
          ></i>

          <span class="font-medium text-rose-600">
            <%= @weekly_percentage_change.abs %>%
          </span>
        <% else %>
          <i
            data-lucide="minus"
            class="h-4 w-4 text-slate-500"
          ></i>

          <span class="font-medium text-slate-600">
      0%
    </span>
        <% end %>

        <span class="text-slate-500">
    from last week
  </span>
      </div>
    </article>

    <!-- Card 3 -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Total Customers
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @total_customers %>
          </p>
        </div>

        <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
          <i data-lucide="users" class="h-5 w-5"></i>
        </div>
      </div>

      <div class="mt-4 flex items-center gap-1 text-sm">
        <i
          data-lucide="user-plus"
          class="h-4 w-4 text-emerald-600"
        ></i>

        <span class="font-medium text-emerald-600">
          <%= @new_customers_this_month %> new
              </span>

        <span class="text-slate-500">
                this month
              </span>
      </div>
    </article>

    <!-- Card 4 -->
    <article
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Monthly Revenue
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= number_to_currency(
                  @monthly_revenue,
                  unit: "£",
                  precision: 2
                ) %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="wallet-cards" class="h-5 w-5"></i>
        </div>
      </div>

      <div class="mt-4 flex items-center gap-1 text-sm">
        <% if @monthly_revenue_percentage_change.positive? %>
          <i
            data-lucide="trending-up"
            class="h-4 w-4 text-emerald-600"
          ></i>

          <span class="font-medium text-emerald-600">
            <%= @monthly_revenue_percentage_change %>%
          </span>
        <% elsif @monthly_revenue_percentage_change.negative? %>
          <i
            data-lucide="trending-down"
            class="h-4 w-4 text-rose-600"
          ></i>

          <span class="font-medium text-rose-600">
            <%= @monthly_revenue_percentage_change.abs %>%
          </span>
        <% else %>
          <i
            data-lucide="minus"
            class="h-4 w-4 text-slate-500"
          ></i>

          <span class="font-medium text-slate-600">
      0%
    </span>
        <% end %>

        <span class="text-slate-500">
    from last month
  </span>
      </div>
    </article>
  </section>

  <!-- Lower content -->
  <div class="mt-8 grid gap-8 xl:grid-cols-[1fr_340px]">
    <!-- Appointments -->
    <section
      class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >
      <div
        class="flex items-center justify-between border-b border-slate-200 px-5 py-5 sm:px-6"
      >
        <div>
          <h2 class="text-lg font-bold">
            Today's appointments
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Your upcoming bookings for today.
          </p>
        </div>

        <a
          href="#"
          class="text-sm font-semibold text-indigo-600 hover:text-indigo-700"
        >
          View all
        </a>
      </div>

      <div class="divide-y divide-slate-100">
        <% @today_bookings.each do |booking| %>
          <% user = booking.user %>

          <% customer_name = [
            user.first_name,
            user.last_name
          ].compact.join(" ") %>

          <% customer_name =
               user.email.split("@").first.titleize if customer_name.blank?
          %>

          <% initials = [
            user.first_name,
            user.last_name
          ].compact.filter_map { |name| name.first }.join.upcase %>

          <% initials =
               customer_name.split.map { |name| name.first }.first(2).join.upcase if initials.blank?
          %>

          <% status_classes =
               case booking.status
               when "confirmed"
                 "bg-emerald-50 text-emerald-700"
               when "pending"
                 "bg-amber-50 text-amber-700"
               when "canceled", "cancelled"
                 "bg-rose-50 text-rose-700"
               else
                 "bg-slate-100 text-slate-600"
               end
          %>

          <div class="flex items-center gap-4 px-5 py-4 transition hover:bg-slate-50 sm:px-6">
            <div class="hidden w-16 rounded-xl bg-slate-100 px-2 py-3 text-center sm:block">
              <p class="text-sm font-bold text-slate-800">
                <%= booking.time.strftime("%-I:%M") %>
              </p>

              <p class="mt-0.5 text-xs text-slate-500">
                <%= booking.time.strftime("%P") %>
              </p>
            </div>

            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700">
              <%= initials %>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate font-semibold">
                  <%= customer_name %>
                </p>

                <span class="hidden rounded-full px-2.5 py-1 text-xs font-semibold sm:inline-flex <%= status_classes %>">
                  <%= booking.status.titleize %>
                </span>
              </div>

              <p class="mt-1 truncate text-sm text-slate-500">
          <span class="sm:hidden">
            <%= booking.time.strftime("%-I:%M %P") %> ·
          </span>

                <%= booking.service&.name || "Booking" %>
              </p>
            </div>

            <%= link_to business_booking_path(booking), aria: { label: "View #{customer_name}'s booking" },
                        class: "rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" do %>
              <i data-lucide="chevron-right" class="h-5 w-5"></i>
            <% end %>
          </div>
        <% end %>

        <% if @today_bookings.empty? %>
          <div class="px-5 py-12 text-center sm:px-6">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500">
              <i data-lucide="calendar-x" class="h-6 w-6"></i>
            </div>

            <p class="mt-4 font-semibold text-slate-900">
              No appointments today
            </p>

            <p class="mt-1 text-sm text-slate-500">
              There are no bookings scheduled for today.
            </p>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Right column -->
    <aside class="space-y-6">
      <!-- Quick actions -->
      <section
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
      >
        <div>
          <h2 class="text-lg font-bold">
            Quick actions
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Manage your business.
          </p>
        </div>

        <div class="mt-5 space-y-3">
          <%= link_to business_add_booking_path,
                      class: "flex w-full items-center gap-3 rounded-xl border border-slate-200 p-3 text-left transition hover:border-indigo-200 hover:bg-indigo-50" do %>
            <div class="rounded-lg bg-indigo-100 p-2 text-indigo-600">
              <i data-lucide="calendar-plus" class="h-5 w-5"></i>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold">Add appointment</p>
              <p class="text-xs text-slate-500">Create a new booking</p>
            </div>
            <i data-lucide="chevron-right" class="h-4 w-4 text-slate-400"></i>
          <% end %>

          <button
            type="button"
            class="flex w-full items-center gap-3 rounded-xl border border-slate-200 p-3 text-left transition hover:border-indigo-200 hover:bg-indigo-50"
          >
            <div class="rounded-lg bg-blue-100 p-2 text-blue-600">
              <i data-lucide="briefcase-business" class="h-5 w-5"></i>
            </div>

            <div class="flex-1">
              <p class="text-sm font-semibold">
                Add service
              </p>

              <p class="text-xs text-slate-500">
                Create a new service
              </p>
            </div>

            <i
              data-lucide="chevron-right"
              class="h-4 w-4 text-slate-400"
            ></i>
          </button>

          <button
            type="button"
            class="flex w-full items-center gap-3 rounded-xl border border-slate-200 p-3 text-left transition hover:border-indigo-200 hover:bg-indigo-50"
          >
            <div class="rounded-lg bg-violet-100 p-2 text-violet-600">
              <i data-lucide="clock-3" class="h-5 w-5"></i>
            </div>

            <div class="flex-1">
              <p class="text-sm font-semibold">
                Update availability
              </p>

              <p class="text-xs text-slate-500">
                Change your opening hours
              </p>
            </div>

            <i
              data-lucide="chevron-right"
              class="h-4 w-4 text-slate-400"
            ></i>
          </button>

          <button
            type="button"
            class="flex w-full items-center gap-3 rounded-xl border border-slate-200 p-3 text-left transition hover:border-indigo-200 hover:bg-indigo-50"
          >
            <div class="rounded-lg bg-rose-100 p-2 text-rose-600">
              <i data-lucide="calendar-x" class="h-5 w-5"></i>
            </div>

            <div class="flex-1">
              <p class="text-sm font-semibold">
                Block time slot
              </p>

              <p class="text-xs text-slate-500">
                Make a period unavailable
              </p>
            </div>

            <i
              data-lucide="chevron-right"
              class="h-4 w-4 text-slate-400"
            ></i>
          </button>
        </div>
      </section>

      <section class="rounded-2xl bg-slate-950 p-5 text-white shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-400">
              Next booking
            </p>

            <p class="mt-2 text-3xl font-bold">
              <% if @next_booking.present? %>
                <%= @next_booking.time.strftime("%-I:%M %P") %>
              <% else %>
                None
              <% end %>
            </p>
          </div>

          <div class="rounded-xl bg-white/10 p-3">
            <i data-lucide="clock-3" class="h-5 w-5"></i>
          </div>
        </div>

        <div class="mt-5 border-t border-white/10 pt-5">
          <% if @next_booking.present? %>
            <% next_customer_name = [
              @next_booking.user.first_name,
              @next_booking.user.last_name
            ].compact.join(" ") %>

            <% next_customer_name =
                 @next_booking.user.email.split("@").first.titleize if next_customer_name.blank?
            %>

            <p class="font-semibold">
              <%= next_customer_name %>
            </p>

            <p class="mt-1 text-sm text-slate-400">
              <%= @next_booking.service&.name || "Booking" %>
            </p>

            <button
              type="button"
              class="mt-5 w-full rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
            >
              View appointment
            </button>
          <% else %>
            <p class="text-sm text-slate-400">
              There are no more bookings scheduled today.
            </p>
          <% end %>
        </div>
      </section>
    </aside>
  </div>
</main>