<%# app/views/business_portal/opening_hours/_booking_settings_fields.html.erb %>

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <%= form.hidden_field :id if form.object.persisted? %>

  <div>
    <h3 class="text-lg font-bold text-slate-900">
      Booking settings
    </h3>

    <p class="mt-1 text-sm text-slate-500">
      Control how appointments use your availability.
    </p>
  </div>

  <div class="mt-5 space-y-5">
    <div>
      <%= form.label(
            :booking_interval_minutes,
            "Booking interval",
            class: "mb-2 block text-sm font-semibold text-slate-700"
          ) %>

      <%= form.select(
            :booking_interval_minutes,
            options_for_select(
              BusinessBookingSetting::BOOKING_INTERVALS.map do |minutes|
                ["#{minutes} minutes", minutes]
              end,
              form.object.booking_interval_minutes
            ),
            {},
            class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          ) %>

      <p class="mt-2 text-xs leading-5 text-slate-500">
        Controls the times customers can select.
      </p>
    </div>

    <div>
      <%= form.label(
            :minimum_notice_minutes,
            "Minimum booking notice",
            class: "mb-2 block text-sm font-semibold text-slate-700"
          ) %>

      <%= form.select(
            :minimum_notice_minutes,
            options_for_select(
              [
                ["1 hour", 60],
                ["2 hours", 120],
                ["4 hours", 240],
                ["12 hours", 720],
                ["24 hours", 1_440]
              ],
              form.object.minimum_notice_minutes
            ),
            {},
            class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          ) %>
    </div>

    <div>
      <%= form.label(
            :advance_booking_days,
            "Advance booking period",
            class: "mb-2 block text-sm font-semibold text-slate-700"
          ) %>

      <%= form.select(
            :advance_booking_days,
            options_for_select(
              BusinessBookingSetting::ADVANCE_BOOKING_OPTIONS.map do |days|
                ["#{days} days", days]
              end,
              form.object.advance_booking_days
            ),
            {},
            class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          ) %>
    </div>

    <div>
      <%= form.label(
            :buffer_minutes,
            "Time between appointments",
            class: "mb-2 block text-sm font-semibold text-slate-700"
          ) %>

      <%= form.select(
            :buffer_minutes,
            options_for_select(
              [
                ["No buffer", 0],
                ["5 minutes", 5],
                ["10 minutes", 10],
                ["15 minutes", 15],
                ["30 minutes", 30]
              ],
              form.object.buffer_minutes
            ),
            {},
            class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
          ) %>
    </div>
  </div>
</section>