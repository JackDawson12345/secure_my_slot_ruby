<%# app/views/business_portal/opening_hours/index.html.erb %>

<main
  class="p-4 sm:p-6 lg:p-8"
  data-controller="opening-hours nested-form"
>
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Opening Hours
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Set your weekly availability, breaks and booking preferences.
      </p>
    </div>

    <button
      type="submit"
      form="openingHoursForm"
      class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
    >
      <i data-lucide="save" class="h-4 w-4"></i>
      Save changes
    </button>
  </section>

  <% if flash[:notice].present? %>
    <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-700">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-medium text-rose-700">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if @business.errors.any? %>
    <section class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-5">
      <h3 class="font-semibold text-rose-800">
        The opening hours could not be saved
      </h3>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-700">
        <% @business.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

        <% @opening_hours.each do |opening_hour| %>
          <% opening_hour.errors.full_messages.each do |message| %>
            <li>
              <%= opening_hour.day_name %>: <%= message %>
            </li>
          <% end %>

          <% opening_hour.breaks.each do |break_record| %>
            <% break_record.errors.full_messages.each do |message| %>
              <li>
                <%= opening_hour.day_name %> break: <%= message %>
              </li>
            <% end %>
          <% end %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="mt-8 flex flex-col gap-4 rounded-2xl border border-indigo-100 bg-indigo-50 p-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-start gap-3">
      <div class="rounded-xl bg-indigo-100 p-2.5 text-indigo-600">
        <i data-lucide="info" class="h-5 w-5"></i>
      </div>

      <div>
        <h3 class="font-semibold text-indigo-950">
          Customer booking availability
        </h3>

        <p class="mt-1 text-sm leading-6 text-indigo-700">
          Customers will only be able to book appointments during the
          opening hours you set below.
        </p>
      </div>
    </div>

    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-indigo-700 shadow-sm">
      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
      Online booking active
    </span>
  </section>

  <%= form_with(
        model: @business,
        url: business_opening_hours_path,
        method: :patch,
        id: "openingHoursForm",
        class: "mt-8"
      ) do |form| %>
    <div class="grid gap-8 xl:grid-cols-[1fr_340px]">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <h3 class="text-lg font-bold text-slate-900">
            Weekly hours
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Choose which days you are open and set the available times.
          </p>
        </div>

        <div class="divide-y divide-slate-100">
          <%= form.fields_for :opening_hours, @opening_hours do |hours_form| %>
            <%= render(
                  "opening_hour_fields",
                  form: hours_form,
                  opening_hour: hours_form.object
                ) %>
          <% end %>
        </div>
      </section>

      <aside class="space-y-6">
        <%= form.fields_for :booking_setting, @booking_setting do |settings_form| %>
          <%= render "booking_settings_fields", form: settings_form %>
        <% end %>

        <%= render(
              "weekly_summary",
              opening_hours: @opening_hours
            ) %>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-slate-900">
                Blocked time
              </h3>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Add holidays, appointments or unavailable periods.
              </p>
            </div>

            <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
              <i data-lucide="calendar-x" class="h-5 w-5"></i>
            </div>
          </div>

          <button
            type="button"
            class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
          >
            <i data-lucide="plus" class="h-4 w-4"></i>
            Add blocked time
          </button>
        </section>
      </aside>
    </div>

    <div class="mt-8 sm:hidden">
      <%= form.button(
        type: "submit",
        class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
      ) do %>
        <i data-lucide="save" class="h-4 w-4"></i>
        Save opening hours
      <% end %>
    </div>
  <% end %>
</main>