<%# app/views/business_portal/opening_hours/_weekly_summary.html.erb %>

<%
  open_hours = opening_hours.select(&:open?)
  closed_hours = opening_hours.reject(&:open?)

  total_minutes = open_hours.sum(&:duration_minutes)
  total_hours = total_minutes / 60.0

  total_breaks = open_hours.sum do |opening_hour|
    opening_hour.breaks.reject(&:marked_for_destruction?).count
  end

  closed_days = closed_hours.map(&:day_name).join(", ")
%>

<section class="rounded-2xl bg-slate-950 p-5 text-white shadow-sm">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-sm font-medium text-slate-400">
        Weekly availability
      </p>

      <p class="mt-2 text-3xl font-bold">
        <%= number_with_precision(
              total_hours,
              precision: total_hours % 1 == 0 ? 0 : 1
            ) %>
        hrs
      </p>
    </div>

    <div class="rounded-xl bg-white/10 p-3">
      <i data-lucide="clock-3" class="h-5 w-5"></i>
    </div>
  </div>

  <div class="mt-5 border-t border-white/10 pt-5">
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-400">
        Open days
      </span>

      <span class="font-semibold">
        <%= open_hours.count %> days
      </span>
    </div>

    <div class="mt-3 flex items-center justify-between gap-4 text-sm">
      <span class="text-slate-400">
        Closed days
      </span>

      <span class="text-right font-semibold">
        <%= closed_days.presence || "None" %>
      </span>
    </div>

    <div class="mt-3 flex items-center justify-between text-sm">
      <span class="text-slate-400">
        Scheduled breaks
      </span>

      <span class="font-semibold">
        <%= total_breaks %>
      </span>
    </div>
  </div>
</section>