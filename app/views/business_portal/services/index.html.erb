<!-- Services content -->
<main class="p-4 sm:p-6 lg:p-8">
  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Services
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Create and manage the services available to your customers.
      </p>
    </div>

    <%= link_to new_business_service_path,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto" do %>
      <i data-lucide="plus" class="h-4 w-4"></i>
      Add service
    <% end %>
  </section>

  <!-- Service statistics -->
  <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Total services -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Total Services
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @total_services %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="briefcase-business" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <%= pluralize(@active_services_count, "active service") %>,
        <%= pluralize(@inactive_services_count, "inactive service") %>
      </p>
    </article>

    <!-- Active services -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Active Services
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @active_services_count %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="circle-check" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Available for customer bookings
      </p>
    </article>

    <!-- Average price -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Average Price
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= number_to_currency(@average_price, unit: "£") %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="badge-pound-sterling" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Across active services
      </p>
    </article>

    <!-- Inactive services -->
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Inactive Services
          </p>

          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            <%= @inactive_services_count %>
          </p>
        </div>

        <div class="rounded-xl bg-slate-100 p-3 text-slate-600">
          <i data-lucide="circle-pause" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Hidden from new bookings
      </p>
    </article>
  </section>

  <!-- Services panel -->
  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <!-- Toolbar -->
    <div class="border-b border-slate-200 p-5 sm:p-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h3 class="text-lg font-bold text-slate-900">
            All services
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Update service details, duration, price and availability.
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <div class="relative min-w-0 sm:w-72">
            <i
              data-lucide="search"
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
            ></i>

            <input
              type="search"
              placeholder="Search services..."
              data-controller="service-search"
              data-action="input->service-search#filter"
              class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              />
          </div>
        </div>
      </div>
    </div>

    <% if @services.any? %>
      <!-- Services grid -->
      <div
        class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6 xl:grid-cols-3"
        data-service-search-target="list"
      >
        <% @services.each do |service| %>
          <article
            class="<%= service.status == "active" ? "bg-white" : "bg-slate-50" %> group rounded-2xl border border-slate-200 p-5 transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md"
            data-service-search-target="item"
            data-service-name="<%= service.name.downcase %>"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="<%= service.status == "active" ? "bg-indigo-50 text-indigo-600" : "bg-slate-200 text-slate-600" %> rounded-xl p-3">
                <i
                  data-lucide="<%= service.icon.presence || 'calendar-check' %>"
                  class="h-6 w-6"
                ></i>
              </div>

              <%= link_to business_service_path(service),
                          aria: { label: "View #{service.name}" },
                          class: "rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" do %>
                <i data-lucide="ellipsis" class="h-5 w-5"></i>
              <% end %>
            </div>

            <div class="mt-5">
              <div class="flex items-start justify-between gap-3">
                <h4 class="font-bold text-slate-900">
                  <%= service.name %>
                </h4>

                <% if service.status == "active" %>
                  <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    Active
                  </span>
                <% else %>
                  <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                    Inactive
                  </span>
                <% end %>
              </div>

              <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">
                <%= service.description.presence || "No description has been added for this service." %>
              </p>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-3">
              <div class="<%= service.status == "active" ? "bg-slate-50" : "bg-white" %> rounded-xl p-3">
                <p class="text-xs font-medium text-slate-500">
                  Duration
                </p>

                <div class="mt-1 flex items-center gap-1.5">
                  <i
                    data-lucide="clock-3"
                    class="h-4 w-4 text-slate-400"
                  ></i>

                  <p class="text-sm font-semibold text-slate-900">
                    <%= service.minutes_duration %> minutes
                  </p>
                </div>
              </div>

              <div class="<%= service.status == "active" ? "bg-slate-50" : "bg-white" %> rounded-xl p-3">
                <p class="text-xs font-medium text-slate-500">
                  Price
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-900">
                  <%= number_to_currency(service.price, unit: "£") %>
                </p>
              </div>
            </div>

            <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">
              <%= link_to business_service_path(service),
                          class: "text-sm font-semibold text-slate-500 transition hover:text-slate-700" do %>
                View service
              <% end %>

              <%= link_to edit_business_service_path(service),
                          class: "inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 transition hover:text-indigo-700" do %>
                Edit service
                <i data-lucide="arrow-right" class="h-4 w-4"></i>
              <% end %>
            </div>
          </article>
        <% end %>

        <!-- Add new service card -->
        <%= link_to new_business_service_path,
                    class: "flex min-h-80 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-6 text-center transition hover:border-indigo-300 hover:bg-indigo-50" do %>
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-indigo-600 shadow-sm">
            <i data-lucide="plus" class="h-6 w-6"></i>
          </div>

          <p class="mt-4 font-bold text-slate-900">
            Add a new service
          </p>

          <p class="mt-2 max-w-xs text-sm leading-6 text-slate-500">
            Create another service and make it available for customers to book.
          </p>
        <% end %>
      </div>
    <% else %>
      <!-- Empty state -->
      <div class="px-5 py-16 text-center sm:px-6">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
          <i data-lucide="briefcase-business" class="h-6 w-6"></i>
        </div>

        <h3 class="mt-4 text-lg font-bold text-slate-900">
          No services yet
        </h3>

        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
          Add your first service so customers can see what you offer and begin making bookings.
        </p>

        <%= link_to new_business_service_path,
                    class: "mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700" do %>
          <i data-lucide="plus" class="h-4 w-4"></i>
          Add your first service
        <% end %>
      </div>
    <% end %>
  </section>
</main>