<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section
    class="overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-indigo-700 px-6 py-8 text-white shadow-sm sm:px-8"
  >
    <div class="max-w-3xl">

      <div class="flex items-center gap-3">

        <div class="rounded-xl bg-white/10 p-3 backdrop-blur">
          <i data-lucide="credit-card" class="h-6 w-6"></i>
        </div>

        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
          Payments
        </h2>

      </div>

      <p class="mt-3 text-sm leading-6 text-indigo-100 sm:text-base">
        Connect a payment provider to securely accept online payments from customers when they make a booking.
      </p>

    </div>
  </section>


  <!-- Payment integrations -->
  <section class="mt-8 grid gap-6 lg:grid-cols-2">


    <!-- Stripe -->
    <div
      class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >

      <div class="flex items-start justify-between">

        <div class="rounded-2xl bg-violet-50 p-4 text-violet-600 transition group-hover:bg-violet-100">
          <i data-lucide="credit-card" class="h-7 w-7"></i>
        </div>


        <% if @business.stripe_ready? %>

          <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">
            Connected
          </span>

        <% elsif @business.stripe_account_id.present? %>

          <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
            Setup incomplete
          </span>

        <% else %>

          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
            Available
          </span>

        <% end %>

      </div>


      <div class="mt-6">

        <h3 class="text-xl font-bold text-slate-900">
          Stripe
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Connect Stripe to accept secure card payments directly through your SecureMySlot booking page.
        </p>


        <!-- Stripe connected -->
        <% if @business.stripe_ready? %>

          <div class="mt-4 rounded-xl bg-slate-50 p-4">

            <div class="flex items-center gap-3">

              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-green-50 text-green-600">
                <i data-lucide="circle-check" class="h-5 w-5"></i>
              </div>

              <div>

                <p class="text-sm font-medium text-slate-700">
                  Stripe account connected
                </p>

                <p class="mt-1 text-sm text-slate-500">
                  Your account is ready to accept payments.
                </p>

              </div>

            </div>

          </div>


          <!-- Stripe onboarding started but incomplete -->
        <% elsif @business.stripe_account_id.present? %>

          <div class="mt-4 rounded-xl bg-amber-50 p-4">

            <div class="flex items-center gap-3">

              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-600">
                <i data-lucide="circle-alert" class="h-5 w-5"></i>
              </div>

              <div>

                <p class="text-sm font-medium text-amber-800">
                  Stripe setup incomplete
                </p>

                <p class="mt-1 text-sm text-amber-700">
                  Complete your Stripe account setup before accepting online payments.
                </p>

              </div>

            </div>

          </div>

        <% end %>

      </div>


      <!-- Stripe actions -->
      <div class="mt-auto pt-6">

        <% if @business.stripe_ready? %>

          <div class="flex flex-wrap gap-3">

            <%= link_to business_stripe_dashboard_path,
                        class: "inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700" do %>

              Manage Stripe

              <i data-lucide="external-link" class="h-4 w-4"></i>

            <% end %>


            <%= link_to business_stripe_disconnect_path,
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Are you sure you want to disconnect Stripe?"
                        },
                        class: "inline-flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-semibold text-red-700 transition hover:bg-red-100" do %>

              Disconnect

              <i data-lucide="unlink" class="h-4 w-4"></i>

            <% end %>

          </div>


        <% elsif @business.stripe_account_id.present? %>

          <%= link_to business_payments_stripe_path,
                      class: "inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700" do %>

            Continue Stripe setup

            <i data-lucide="arrow-right" class="h-4 w-4"></i>

          <% end %>


        <% else %>

          <%= link_to business_payments_stripe_path,
                      class: "inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700" do %>

            Connect Stripe

            <i data-lucide="arrow-right" class="h-4 w-4"></i>

          <% end %>

        <% end %>

      </div>

    </div>


    <!-- PayPal -->
    <div
      class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >

      <div class="flex items-start justify-between">

        <div class="rounded-2xl bg-blue-50 p-4 text-blue-600 transition group-hover:bg-blue-100">
          <i data-lucide="wallet-cards" class="h-7 w-7"></i>
        </div>

        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
          Coming soon
        </span>

      </div>


      <div class="mt-6">

        <h3 class="text-xl font-bold text-slate-900">
          PayPal
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          PayPal support is coming soon, giving your customers another secure way to pay for their bookings online.
        </p>

      </div>


      <div class="mt-auto pt-6">

        <button
          type="button"
          disabled
          class="inline-flex cursor-not-allowed items-center gap-2 rounded-xl bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-400"
        >

          Coming soon

          <i data-lucide="clock" class="h-4 w-4"></i>

        </button>

      </div>

    </div>

  </section>


  <!-- Payment information -->
  <section class="mt-8">

    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">

        <div class="shrink-0 rounded-2xl bg-indigo-50 p-4 text-indigo-600">
          <i data-lucide="shield-check" class="h-7 w-7"></i>
        </div>


        <div class="flex-1">

          <h3 class="text-lg font-bold text-slate-900">
            Secure online payments
          </h3>

          <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-500">
            Payments are processed securely by your connected payment provider. SecureMySlot does not store your customers' card details.
          </p>


          <div class="mt-5 grid gap-5 sm:grid-cols-3">


            <!-- Secure checkout -->
            <div class="flex items-start gap-3">

              <i
                data-lucide="lock-keyhole"
                class="mt-0.5 h-5 w-5 shrink-0 text-indigo-600"
              ></i>

              <div>

                <p class="text-sm font-semibold text-slate-800">
                  Secure checkout
                </p>

                <p class="mt-1 text-xs leading-5 text-slate-500">
                  Payment information is handled securely by the payment provider.
                </p>

              </div>

            </div>


            <!-- Direct payouts -->
            <div class="flex items-start gap-3">

              <i
                data-lucide="banknote"
                class="mt-0.5 h-5 w-5 shrink-0 text-indigo-600"
              ></i>

              <div>

                <p class="text-sm font-semibold text-slate-800">
                  Direct payouts
                </p>

                <p class="mt-1 text-xs leading-5 text-slate-500">
                  Funds are paid directly into the account linked to your payment provider.
                </p>

              </div>

            </div>


            <!-- Control -->
            <div class="flex items-start gap-3">

              <i
                data-lucide="settings-2"
                class="mt-0.5 h-5 w-5 shrink-0 text-indigo-600"
              ></i>

              <div>

                <p class="text-sm font-semibold text-slate-800">
                  You're in control
                </p>

                <p class="mt-1 text-xs leading-5 text-slate-500">
                  Manage your payment connection at any time from your business account.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </section>

</main>