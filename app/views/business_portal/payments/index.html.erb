<main class="p-4 sm:p-6 lg:p-8">
  <!-- Header banner -->
  <section class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 p-6 text-white shadow-lg shadow-indigo-200 sm:p-8">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
      <div>
        <p class="mb-2 text-sm font-medium text-indigo-100">
          Payments
        </p>

        <h1 class="text-2xl font-bold sm:text-3xl">
          Manage your payments
        </h1>

        <p class="mt-2 max-w-2xl text-sm leading-6 text-indigo-100 sm:text-base">
          Connect your Stripe account to securely accept online payments
          from customers when they make a booking.
        </p>
      </div>

      <% if @business.stripe_ready? %>
        <div class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-emerald-700 shadow-sm lg:w-auto">
          <i data-lucide="circle-check" class="h-4 w-4"></i>
          Stripe connected
        </div>
      <% elsif @business.stripe_connected? %>
        <%= button_to business_payments_connect_path,
                      method: :post,
                      data: { turbo: false },
                      class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 lg:w-auto" do %>
          <i data-lucide="external-link" class="h-4 w-4"></i>
          Continue Stripe setup
        <% end %>
      <% else %>
        <%= button_to business_payments_connect_path,
                      method: :post,
                      data: { turbo: false },
                      class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50 lg:w-auto" do %>
          <i data-lucide="link" class="h-4 w-4"></i>
          Connect Stripe
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Stripe status cards -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Stripe account
          </p>

          <p class="mt-3 text-lg font-bold text-slate-900">
            <%= @business.stripe_connected? ? "Connected" : "Not connected" %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="badge-pound-sterling" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <% if @business.stripe_connected? %>
          Your Stripe account has been created.
        <% else %>
          Connect an account to get started.
        <% end %>
      </p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Details submitted
          </p>

          <p class="mt-3 text-lg font-bold text-slate-900">
            <%= @business.stripe_details_submitted? ? "Complete" : "Incomplete" %>
          </p>
        </div>

        <div class="<%= @business.stripe_details_submitted? ? "bg-emerald-50 text-emerald-600" : "bg-amber-50 text-amber-600" %> rounded-xl p-3">
          <i
            data-lucide="<%= @business.stripe_details_submitted? ? "circle-check" : "circle-alert" %>"
            class="h-5 w-5"
          ></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <% if @business.stripe_details_submitted? %>
          Stripe has received your business details.
        <% else %>
          More information may be required.
        <% end %>
      </p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Online payments
          </p>

          <p class="mt-3 text-lg font-bold text-slate-900">
            <%= @business.stripe_charges_enabled? ? "Enabled" : "Disabled" %>
          </p>
        </div>

        <div class="<%= @business.stripe_charges_enabled? ? "bg-emerald-50 text-emerald-600" : "bg-slate-100 text-slate-500" %> rounded-xl p-3">
          <i data-lucide="credit-card" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <% if @business.stripe_charges_enabled? %>
          Customers can make card payments.
        <% else %>
          Card payments are not available yet.
        <% end %>
      </p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Bank payouts
          </p>

          <p class="mt-3 text-lg font-bold text-slate-900">
            <%= @business.stripe_payouts_enabled? ? "Enabled" : "Disabled" %>
          </p>
        </div>

        <div class="<%= @business.stripe_payouts_enabled? ? "bg-emerald-50 text-emerald-600" : "bg-slate-100 text-slate-500" %> rounded-xl p-3">
          <i data-lucide="landmark" class="h-5 w-5"></i>
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <% if @business.stripe_payouts_enabled? %>
          Stripe can send funds to your bank.
        <% else %>
          Bank payouts are not available yet.
        <% end %>
      </p>
    </article>
  </section>

  <!-- Main content -->
  <div class="mt-8 grid gap-8 xl:grid-cols-[1fr_360px]">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <h2 class="text-lg font-bold text-slate-900">
          Stripe payment setup
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Complete the steps below before accepting booking payments.
        </p>
      </div>

      <div class="divide-y divide-slate-100">
        <!-- Step one -->
        <div class="flex items-start gap-4 p-5 sm:p-6">
          <div class="<%= @business.stripe_connected? ? "bg-emerald-50 text-emerald-600" : "bg-indigo-50 text-indigo-600" %> flex h-10 w-10 shrink-0 items-center justify-center rounded-xl">
            <% if @business.stripe_connected? %>
              <i data-lucide="check" class="h-5 w-5"></i>
            <% else %>
              <span class="text-sm font-bold">1</span>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
              <div>
                <h3 class="font-semibold text-slate-900">
                  Create your Stripe account
                </h3>

                <p class="mt-1 text-sm leading-6 text-slate-500">
                  Stripe will securely collect your business and contact details.
                </p>
              </div>

              <% if @business.stripe_connected? %>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Complete
                </span>
              <% else %>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                  Required
                </span>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Step two -->
        <div class="flex items-start gap-4 p-5 sm:p-6">
          <div class="<%= @business.stripe_details_submitted? ? "bg-emerald-50 text-emerald-600" : "bg-slate-100 text-slate-500" %> flex h-10 w-10 shrink-0 items-center justify-center rounded-xl">
            <% if @business.stripe_details_submitted? %>
              <i data-lucide="check" class="h-5 w-5"></i>
            <% else %>
              <span class="text-sm font-bold">2</span>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
              <div>
                <h3 class="font-semibold text-slate-900">
                  Verify your business
                </h3>

                <p class="mt-1 text-sm leading-6 text-slate-500">
                  Provide any identity, company or banking information requested by Stripe.
                </p>
              </div>

              <% if @business.stripe_details_submitted? %>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Complete
                </span>
              <% else %>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                  <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                  Waiting
                </span>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Step three -->
        <div class="flex items-start gap-4 p-5 sm:p-6">
          <div class="<%= @business.stripe_ready? ? "bg-emerald-50 text-emerald-600" : "bg-slate-100 text-slate-500" %> flex h-10 w-10 shrink-0 items-center justify-center rounded-xl">
            <% if @business.stripe_ready? %>
              <i data-lucide="check" class="h-5 w-5"></i>
            <% else %>
              <span class="text-sm font-bold">3</span>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
              <div>
                <h3 class="font-semibold text-slate-900">
                  Start accepting payments
                </h3>

                <p class="mt-1 text-sm leading-6 text-slate-500">
                  Online booking payments will become available after Stripe approves your account.
                </p>
              </div>

              <% if @business.stripe_ready? %>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Ready
                </span>
              <% else %>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                  <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                  Waiting
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stripe connection panel -->
    <aside>
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900">
              Stripe account
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-500">
              Payments and payouts are handled securely by Stripe.
            </p>
          </div>

          <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
            <i data-lucide="badge-pound-sterling" class="h-5 w-5"></i>
          </div>
        </div>

        <% if @business.stripe_ready? %>
          <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 text-emerald-600">
                <i data-lucide="circle-check" class="h-5 w-5"></i>
              </div>

              <div>
                <p class="text-sm font-semibold text-emerald-900">
                  Stripe is connected
                </p>

                <p class="mt-1 text-sm leading-5 text-emerald-700">
                  Your account is ready to accept payments and receive payouts.
                </p>
              </div>
            </div>
          </div>

          <div class="mt-5 rounded-xl bg-slate-50 p-4">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
              Stripe account ID
            </p>

            <p class="mt-2 break-all font-mono text-sm font-semibold text-slate-900">
              <%= @business.stripe_account_id %>
            </p>
          </div>

          <div class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white">
            <i data-lucide="shield-check" class="h-4 w-4"></i>
            Account ready
          </div>
        <% elsif @business.stripe_connected? %>
          <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 text-amber-600">
                <i data-lucide="circle-alert" class="h-5 w-5"></i>
              </div>

              <div>
                <p class="text-sm font-semibold text-amber-900">
                  Stripe setup is incomplete
                </p>

                <p class="mt-1 text-sm leading-5 text-amber-700">
                  Complete the remaining steps before taking payments.
                </p>
              </div>
            </div>
          </div>

          <%= button_to business_payments_connect_path,
                        method: :post,
                        data: { turbo: false },
                        class: "mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
            <i data-lucide="external-link" class="h-4 w-4"></i>
            Continue Stripe setup
          <% end %>
        <% else %>
          <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 text-amber-600">
                <i data-lucide="circle-alert" class="h-5 w-5"></i>
              </div>

              <div>
                <p class="text-sm font-semibold text-amber-900">
                  Stripe is not connected
                </p>

                <p class="mt-1 text-sm leading-5 text-amber-700">
                  Connect an account before customers can pay online.
                </p>
              </div>
            </div>
          </div>

          <%= button_to business_payments_connect_path,
                        method: :post,
                        data: { turbo: false },
                        class: "mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
            <i data-lucide="link" class="h-4 w-4"></i>
            Connect with Stripe
          <% end %>
        <% end %>

        <p class="mt-3 text-center text-xs leading-5 text-slate-500">
          You will be redirected to Stripe to securely manage your account.
        </p>
      </section>

      <section class="mt-6 rounded-2xl bg-slate-950 p-5 text-white shadow-sm">
        <div class="flex items-start gap-4">
          <div class="rounded-xl bg-white/10 p-3">
            <i data-lucide="shield-check" class="h-5 w-5"></i>
          </div>

          <div>
            <h2 class="font-semibold">
              Secure payments
            </h2>

            <p class="mt-2 text-sm leading-6 text-slate-400">
              Stripe securely manages customer card details, identity checks
              and payments outside of SecureMySlot.
            </p>
          </div>
        </div>
      </section>
    </aside>
  </div>
</main>