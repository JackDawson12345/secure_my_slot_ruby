<main class="flex min-h-[calc(100vh-4rem)] items-center justify-center p-4 sm:p-6 lg:p-8">
  <section class="w-full max-w-2xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="p-6 text-center sm:p-10">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
        <i data-lucide="check" class="h-8 w-8"></i>
      </div>

      <p class="mt-6 text-sm font-semibold uppercase tracking-wide text-indigo-600">
        Registration received
      </p>

      <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
        Thank you for signing up
      </h1>

      <p class="mx-auto mt-4 max-w-lg text-base leading-7 text-slate-600">
        We have received your business registration. A member of our team will
        be in touch to finalise your account and help you complete the setup
        process.
      </p>

      <div class="mt-8 rounded-2xl bg-indigo-50 p-5 text-left">
        <div class="flex items-start gap-4">
          <div class="shrink-0 rounded-xl bg-white p-3 text-indigo-600 shadow-sm">
            <i data-lucide="clock-3" class="h-5 w-5"></i>
          </div>

          <div>
            <h2 class="font-semibold text-slate-950">
              What happens next?
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-600">
              Please allow up to 24 working hours for a member of our team to
              contact you. We may need to confirm a few details before your
              business account can be fully activated.
            </p>
          </div>
        </div>
      </div>

      <p class="mt-6 text-sm text-slate-500">
        You can safely close this page. We will contact you using the details
        provided during registration.
      </p>

      <div class="mt-8">
        <%= link_to root_path,
                    class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 sm:w-auto" do %>
          <i data-lucide="house" class="h-4 w-4"></i>
          Return to homepage
        <% end %>
      </div>
    </div>
  </section>
</main>