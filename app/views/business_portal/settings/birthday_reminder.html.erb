<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div class="w-full items-center flex justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Birthday Reminders
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Create a personalised birthday message that will be sent to your customers.
        </p>
      </div>
      <div>
        <%= link_to business_general_settings_path,
                    class: "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 sm:w-auto" do %>

          <i data-lucide="arrow-left" class="h-4 w-4"></i>
          Back to settings

        <% end %>
      </div>
    </div>


  </section>

  <!-- Flash messages -->
  <%= render 'business_portal/shared/flash_messages' %>


  <div class="mt-8 space-y-8"
       data-controller="birthday-preview">


    <!-- Birthday message -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">

        <div class="flex items-start gap-3">

          <div class="rounded-xl bg-pink-50 p-3 text-pink-600">
            <i data-lucide="cake" class="h-5 w-5"></i>
          </div>


          <div>

            <h3 class="text-lg font-bold text-slate-900">
              Birthday message
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Add the message customers will receive on their birthday.
            </p>

          </div>

        </div>

      </div>


      <div class="p-5 sm:p-6">

        <%= form_with model: @birthday_reminder_message,
                      url: business_update_birthday_reminder_path,
                      method: :patch,
                      id: "birthdayReminderForm" do |f| %>


          <%= f.label :text,
                      "Message",
                      class: "mb-2 block text-sm font-semibold text-slate-700" %>


          <%= f.text_area :text,
                          id: "birthdayMessage",
                          rows: 6,
                          data: {
                            birthday_preview_target: "input",
                            action: "input->birthday-preview#update"
                          },
                          class: "w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>


          <p class="mt-3 text-xs leading-5 text-slate-500">
            You can personalise messages using customer details such as their name.
          </p>

        <% end %>

      </div>

    </section>



    <!-- Preview -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">

        <div class="flex items-start gap-3">

          <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
            <i data-lucide="message-circle" class="h-5 w-5"></i>
          </div>


          <div>

            <h3 class="text-lg font-bold text-slate-900">
              Message preview
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              See how your birthday reminder will appear to customers.
            </p>

          </div>

        </div>

      </div>


      <div class="p-5 sm:p-6">

        <div class="rounded-2xl bg-slate-50 p-5">

          <p
            class="whitespace-pre-line text-sm leading-6 text-slate-700"
            data-birthday-preview-target="preview"
          >
          </p>

        </div>

      </div>

    </section>



    <!-- Actions -->
    <div class="flex flex-col-reverse gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-end">



      <%= link_to business_general_settings_path,
                  class: "inline-flex items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
        Cancel
      <% end %>


      <button
        type="submit"
        form="birthdayReminderForm"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
      >

        <i data-lucide="save" class="h-4 w-4"></i>
        Save reminder

      </button>

    </div>


  </div>

</main>