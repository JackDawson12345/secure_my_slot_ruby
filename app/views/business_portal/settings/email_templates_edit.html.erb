<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section
    class="overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-indigo-700 px-6 py-8 text-white shadow-sm sm:px-8"
  >
    <div class="max-w-3xl">

      <div class="flex items-center gap-3">

        <div class="rounded-xl bg-white/10 p-3 backdrop-blur">
          <i data-lucide="mail-edit" class="h-6 w-6"></i>
        </div>

        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
          Edit email template
        </h2>

      </div>


      <p class="mt-3 text-sm leading-6 text-indigo-100 sm:text-base">
        Customise the email your customers receive when they
        <%= @email_template.template_type == "confirmation" ? "confirm a booking" : "are reminded about an upcoming appointment" %>.
      </p>

    </div>
  </section>


  <!-- Flash messages -->
  <%= render 'business_portal/shared/flash_messages' %>


  <section class="mt-8 grid gap-6 lg:grid-cols-3">


    <!-- Form -->
    <div class="lg:col-span-2 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">

      <%= form_with model: @email_template,
                    url: business_update_email_template_path(@email_template.template_type),
                    method: :patch,
                    class: "space-y-6" do |form| %>


        <!-- Template type -->
        <div>

          <label class="block text-sm font-semibold text-slate-700">
            Template type
          </label>


          <div class="mt-2 rounded-xl bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700">
            <%= @email_template.template_type.titleize %>
          </div>

        </div>



        <!-- Subject -->
        <div>

          <%= form.label :subject,
                         class: "block text-sm font-semibold text-slate-700" %>


          <%= form.text_field :subject,
                              class: "mt-2 block w-full rounded-xl border-slate-200 px-4 py-3 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500",
                              placeholder: "Email subject" %>

        </div>



        <!-- Body -->
        <div>

          <%= form.label :body,
                         class: "block text-sm font-semibold text-slate-700" %>


          <%= form.text_area :body,
                             rows: 12,
                             class: "mt-2 block w-full rounded-xl border-slate-200 px-4 py-3 text-sm leading-6 shadow-sm focus:border-indigo-500 focus:ring-indigo-500",
                             placeholder: "Write your email content here..." %>

        </div>



        <div class="flex items-center gap-3 pt-2">

          <%= form.submit "Save template",
                          class: "inline-flex cursor-pointer items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700" %>


          <%= link_to business_email_templates_path,
                      class: "inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>

            Cancel

          <% end %>

        </div>


      <% end %>

    </div>



    <!-- Variables -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm h-fit">

      <div class="flex items-center gap-3">

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="code-2" class="h-5 w-5"></i>
        </div>


        <h3 class="text-lg font-bold text-slate-900">
          Available variables
        </h3>

      </div>


      <p class="mt-3 text-sm leading-6 text-slate-500">
        Use these placeholders in your email. They will automatically be replaced with booking details.
      </p>


      <div class="mt-5 space-y-3">


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{customer_name}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Customer's name
          </p>

        </div>


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{business_name}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Business name
          </p>

        </div>


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{service_name}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Booked service
          </p>

        </div>


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{appointment_date}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Appointment date
          </p>

        </div>


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{appointment_time}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Appointment time
          </p>

        </div>


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{remaining_balance}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Remaining balance to pay
          </p>

        </div>


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{consultation_required}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Shows consultation form section when required
          </p>

        </div>


        <div class="rounded-xl bg-slate-50 px-4 py-3">

          <code class="text-sm font-medium text-indigo-600">
            {{consultation_form_url}}
          </code>

          <p class="mt-1 text-xs text-slate-500">
            Link for customer to complete their consultation form
          </p>

        </div>


      </div>

    </div>


  </section>


</main>