<div
  draggable="true"
  data-builder-type="<%= type %>"
  data-action="dragstart->form-builder#dragStart"
  class="group cursor-grab rounded-xl border border-slate-200 bg-white p-3 transition hover:border-slate-300 hover:bg-slate-50 hover:shadow-sm active:cursor-grabbing"
>

  <div class="flex items-center gap-3">

    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 transition group-hover:bg-slate-200">

      <% if icon == "row" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <rect
            x="3"
            y="5"
            width="18"
            height="14"
            rx="2"
            stroke-width="1.7"
            />

          <path
            d="M3 12h18"
            stroke-width="1.7"
            />
        </svg>

      <% elsif icon == "column" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <rect
            x="3"
            y="5"
            width="18"
            height="14"
            rx="2"
            stroke-width="1.7"
            />

          <path
            d="M12 5v14"
            stroke-width="1.7"
            />
        </svg>

      <% elsif icon == "label" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.7"
            d="M5 7h14M5 12h9M5 17h6"
            />
        </svg>

      <% elsif icon == "text" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <rect
            x="3"
            y="6"
            width="18"
            height="12"
            rx="2"
            stroke-width="1.7"
            />

          <path
            d="M7 10h6"
            stroke-width="1.7"
            stroke-linecap="round"
            />
        </svg>

      <% elsif icon == "number" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-width="1.7"
            d="M9 4L7 20M17 4l-2 16M4 9h16M3 15h16"
            />
        </svg>

      <% elsif icon == "textarea" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <rect
            x="3"
            y="4"
            width="18"
            height="16"
            rx="2"
            stroke-width="1.7"
            />

          <path
            d="M7 9h10M7 13h8"
            stroke-width="1.7"
            stroke-linecap="round"
            />
        </svg>

      <% elsif icon == "select" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <rect
            x="3"
            y="6"
            width="18"
            height="12"
            rx="2"
            stroke-width="1.7"
            />

          <path
            d="m16 10 2 2-2 2"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            />
        </svg>

      <% elsif icon == "submit" %>

        <svg
          class="h-5 w-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <rect
            x="4"
            y="7"
            width="16"
            height="10"
            rx="2"
            stroke-width="1.7"
            />

          <path
            d="m10 10 3 2-3 2"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            />
        </svg>

      <% end %>

    </div>


    <div class="min-w-0 flex-1">

      <p class="text-sm font-medium text-slate-800">
        <%= title %>
      </p>

      <p class="mt-0.5 truncate text-xs text-slate-400">
        <%= description %>
      </p>

    </div>


    <div class="text-slate-300">

      <svg
        class="h-5 w-5"
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <circle cx="8" cy="7" r="1.2" />
        <circle cx="16" cy="7" r="1.2" />

        <circle cx="8" cy="12" r="1.2" />
        <circle cx="16" cy="12" r="1.2" />

        <circle cx="8" cy="17" r="1.2" />
        <circle cx="16" cy="17" r="1.2" />
      </svg>

    </div>

  </div>

</div>