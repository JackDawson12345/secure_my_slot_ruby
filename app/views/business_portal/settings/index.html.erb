<main class="p-4 sm:p-6 lg:p-8">

  <!-- Page heading -->
  <section
    class="overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-indigo-700 px-6 py-8 text-white shadow-sm sm:px-8"
  >
    <div class="max-w-3xl">

      <div class="flex items-center gap-3">
        <div class="rounded-xl bg-white/10 p-3 backdrop-blur">
          <i data-lucide="settings" class="h-6 w-6"></i>
        </div>

        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
          Settings
        </h2>
      </div>

      <p class="mt-3 text-sm leading-6 text-indigo-100 sm:text-base">
        Manage your website, business preferences, payments and calendar connections from one place.
      </p>

    </div>
  </section>


  <!-- Settings cards -->
  <section class="mt-8 grid gap-6 lg:grid-cols-2">

    <!-- General -->
    <div
      class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >

      <div class="flex items-start justify-between">

        <div class="rounded-2xl bg-blue-50 p-4 text-blue-600 transition group-hover:bg-blue-100">
          <i data-lucide="sliders-horizontal" class="h-7 w-7"></i>
        </div>


        <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">
          Configured
        </span>

      </div>


      <div class="mt-6">

        <h3 class="text-xl font-bold text-slate-900">
          General settings
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Update your business details, booking rules, notifications and account preferences.
        </p>

      </div>


      <div class="mt-auto pt-6">

        <a
          href="<%= business_general_settings_path %>"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
        >
          Manage settings
          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>

      </div>

    </div>

    <!-- Website -->
    <div
      class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >

      <div class="flex items-start justify-between">

        <div class="rounded-2xl bg-indigo-50 p-4 text-indigo-600 transition group-hover:bg-indigo-100">
          <i data-lucide="globe-2" class="h-7 w-7"></i>
        </div>


        <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">
          Active
        </span>

      </div>


      <div class="mt-6">

        <h3 class="text-xl font-bold text-slate-900">
          Website settings
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Customise your public booking website, branding, colours, content and customer booking experience.
        </p>

      </div>


      <div class="mt-auto pt-6">

        <a
          href="<%= business_website_settings_path %>"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
        >
          Manage website
          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>

      </div>

    </div>

    <!-- Payments -->
    <div
      class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >

      <div class="flex items-start justify-between">

        <div class="rounded-2xl bg-emerald-50 p-4 text-emerald-600 transition group-hover:bg-emerald-100">
          <i data-lucide="credit-card" class="h-7 w-7"></i>
        </div>


        <% if @business.stripe_ready? %>

  <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">
    Connected
  </span>

        <% elsif @business.stripe_connected? %>

  <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
    Setup incomplete
  </span>

        <% else %>

  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
    Not connected
  </span>

        <% end %>

      </div>


      <div class="mt-6">

        <h3 class="text-xl font-bold text-slate-900">
          Payments
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          <% if @business.stripe_ready? %>
            Stripe is connected and customers can pay online when booking appointments.
          <% elsif @business.stripe_connected? %>
            Your Stripe account has been created but still needs setup before payments can be accepted.
          <% else %>
            Connect payments, manage payouts and allow customers to pay for appointments online.
          <% end %>
        </p>

      </div>


      <div class="mt-auto pt-6">

        <a
          href="<%= business_payments_path %>"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
        >
          <% if @business.stripe_ready? %>
            Manage payments
          <% elsif @business.stripe_connected? %>
            Continue setup
          <% else %>
            Setup payments
          <% end %>
          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>

      </div>

    </div>

    <!-- Calendar -->
    <div
      class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >

      <div class="flex items-start justify-between">

        <div class="rounded-2xl bg-violet-50 p-4 text-violet-600 transition group-hover:bg-violet-100">
          <i data-lucide="calendar-sync" class="h-7 w-7"></i>
        </div>


        <% if @business.calendar_connection.present? %>

      <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">
        Connected
      </span>

        <% else %>

      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
        Not connected
      </span>

        <% end %>

      </div>


      <div class="mt-6">

        <h3 class="text-xl font-bold text-slate-900">
          Calendar sync
        </h3>


        <p class="mt-2 text-sm leading-6 text-slate-500">

          <% if @business.calendar_connection.present? %>

            Google Calendar is connected and your availability is being synchronised.

          <% else %>

            Connect Google Calendar to automatically block unavailable times and prevent double bookings.

          <% end %>

        </p>


        <% if @business.calendar_connection.present? %>

          <div class="mt-4 rounded-xl bg-slate-50 p-4">

            <p class="text-sm font-medium text-slate-700">
              Connected account
            </p>

            <p class="mt-1 text-sm text-slate-500">
              <%= @business.calendar_connection.email %>
            </p>


            <% if @business.calendar_connection.last_synced_at.present? %>

              <p class="mt-2 text-xs text-slate-400">
                Last synced:
                <%= time_ago_in_words(@business.calendar_connection.last_synced_at) %> ago
              </p>

            <% end %>

          </div>

        <% end %>

      </div>


      <div class="mt-auto pt-6">


        <a
          href="<%= business_calendar_sync_path %>"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
        >

          <% if @business.calendar_connection.present? %>
            Manage calendar
          <% else %>
            Connect calendar
          <% end %>

          <i data-lucide="arrow-right" class="h-4 w-4"></i>

        </a>


      </div>

    </div>

    <!-- Consultation form -->
    <div
      class="group flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
    >

      <div class="flex items-start justify-between">

        <div class="rounded-2xl bg-amber-50 p-4 text-amber-600 transition group-hover:bg-amber-100">
          <i data-lucide="clipboard-list" class="h-7 w-7"></i>
        </div>

        <% if @business.consultation_form.present? %>

      <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">
        Created
      </span>

        <% else %>

      <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
        Not created
      </span>

        <% end %>

      </div>


      <div class="mt-6">

        <h3 class="text-xl font-bold text-slate-900">
          Consultation form
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          <% if @business.consultation_form.present? %>
            Manage the consultation form customers complete when making a booking.
          <% else %>
            Create a custom consultation form to collect important information from customers during the booking process.
          <% end %>
        </p>

      </div>


      <div class="mt-auto pt-6">

        <a
          href="<%= business_consultation_form_path %>"
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
        >
          <% if @business.consultation_form.present? %>
            Manage form
          <% else %>
            Create form
          <% end %>

          <i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>

      </div>

    </div>


  </section>

</main>