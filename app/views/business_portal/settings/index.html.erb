<!-- Settings content -->
<main class="p-4 sm:p-6 lg:p-8">
  <!-- Page heading -->
  <section
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Settings
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Update your business information, booking preferences and account.
      </p>
    </div>

    <button
      type="submit"
      form="settingsForm"
      class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
    >
      <i data-lucide="save" class="h-4 w-4"></i>
      Save changes
    </button>
  </section>

  <div class="mt-8 grid gap-8 xl:grid-cols-[240px_minmax(0,1fr)]">
    <!-- Settings navigation -->
    <aside>
      <nav
        class="sticky top-28 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm"
      >
        <button
          type="button"
          class="flex w-full items-center gap-3 rounded-xl bg-indigo-50 px-4 py-3 text-left text-sm font-semibold text-indigo-700"
        >
          <i data-lucide="building-2" class="h-5 w-5"></i>
          Business details
        </button>

        <button
          type="button"
          class="mt-1 flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="calendar-cog" class="h-5 w-5"></i>
          Booking settings
        </button>

        <button
          type="button"
          class="mt-1 flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="bell" class="h-5 w-5"></i>
          Notifications
        </button>

        <button
          type="button"
          class="mt-1 flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="user-round" class="h-5 w-5"></i>
          Account
        </button>

        <button
          type="button"
          class="mt-1 flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="shield-check" class="h-5 w-5"></i>
          Security
        </button>

        <button
          type="button"
          class="mt-1 flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="credit-card" class="h-5 w-5"></i>
          Billing
        </button>
      </nav>
    </aside>

    <!-- Settings panels -->
    <div class="space-y-8">

      <%= form_with model: @settings,
                    url: business_settings_path,
                    method: :patch,
                    id: "settingsForm" do |f| %>

        <div class="space-y-8">
          <!-- Business details -->
          <section
            class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
          >
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <div class="flex items-start gap-3">
                <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                  <i data-lucide="building-2" class="h-5 w-5"></i>
                </div>

                <div>
                  <h3 class="text-lg font-bold text-slate-900">
                    Business details
                  </h3>

                  <p class="mt-1 text-sm text-slate-500">
                    Update the information displayed to your customers.
                  </p>
                </div>
              </div>
            </div>

            <div class="p-5 sm:p-6">
              <!-- Business logo -->
              <div
                class="flex flex-col gap-5 border-b border-slate-100 pb-6 sm:flex-row sm:items-center"
                data-controller="logo-preview"
              >
                <!-- Logo preview -->
                <div
                  class="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-indigo-100 text-2xl font-bold text-indigo-700"
                >
                  <img
                    data-logo-preview-target="preview"
                    class="<%= @settings.logo.attached? ? '' : 'hidden' %> h-full w-full object-contain p-2"
                    src="<%= url_for(@settings.logo) if @settings.logo.attached? %>"
                    alt="<%= @settings.business_name %> logo preview"
                  >

                  <span
                    data-logo-preview-target="initials"
                    class="<%= @settings.logo.attached? ? 'hidden' : '' %>"
                  >
                    <%= @settings.business_name
                                 .to_s
                                 .split
                                 .first(2)
                                 .map { |word| word.first }
                                 .join
                                 .upcase
                                 .presence || "BL" %>
                  </span>
                </div>

                <div class="min-w-0">
                  <h4 class="font-semibold text-slate-900">
                    Business logo
                  </h4>

                  <p class="mt-1 text-sm leading-6 text-slate-500">
                    Upload a square logo. PNG, JPG or WebP files are supported.
                  </p>

                  <!-- Selected file confirmation -->
                  <div
                    data-logo-preview-target="message"
                    class="mt-3 hidden rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3"
                  >
                    <div class="flex items-start gap-3">
                      <i
                        data-lucide="image-check"
                        class="mt-0.5 h-5 w-5 shrink-0 text-indigo-600"
                      ></i>


                    </div>
                  </div>

                  <!-- Error message -->
                  <div
                    data-logo-preview-target="error"
                    class="mt-3 hidden rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700"
                  ></div>

                  <div class="mt-3 flex flex-wrap gap-3">
                    <label
                      class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    >
                      <i data-lucide="upload" class="h-4 w-4"></i>

                      <span data-logo-preview-target="buttonText">
                        <%= @settings.logo.attached? ? "Replace logo" : "Upload logo" %>
                      </span>

                      <%= f.file_field :logo,
                                       accept: "image/png,image/jpeg,image/webp",
                                       class: "hidden",
                                       data: {
                                         logo_preview_target: "input",
                                         action: "change->logo-preview#preview"
                                       } %>
                    </label>

                    <!-- Clear newly selected file before saving -->
                    <button
                      type="button"
                      data-logo-preview-target="clearButton"
                      data-action="logo-preview#clear"
                      class="hidden items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-100"
                    >
                      <i data-lucide="x" class="h-4 w-4"></i>
                      Cancel selection
                    </button>

                    <% if @settings.logo.attached? %>
                      <%= link_to business_settings_logo_path,
                                  data: {
                                    turbo_method: :delete,
                                    turbo_confirm: "Are you sure you want to remove this logo?"
                                  },
                                  class: "inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold text-rose-600 transition hover:bg-rose-50" do %>
                        <i data-lucide="trash-2" class="h-4 w-4"></i>
                        Remove
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Business fields -->
              <div class="mt-6 grid gap-5 sm:grid-cols-2">
                <div class="sm:col-span-2">
                  <label
                    for="businessName"
                    class="mb-2 block text-sm font-semibold text-slate-700"
                  >
                    Business name
                  </label>

                  <%= f.text_field :business_name,
                                   id: "businessName",
                                   class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" %>
                </div>

                <div>
                  <%= f.label :business_category,
                              "Business category",
                              class: "mb-2 block text-sm font-semibold text-slate-700" %>

                  <%= f.select :business_category,
                               [
                                 ["Barber", "Barber"],
                                 ["Hairdresser", "Hairdresser"],
                                 ["Beauty and Nails", "Beauty and Nails"],
                                 ["Personal Trainer", "Personal Trainer"],
                                 ["Coach", "Coach"],
                                 ["Tutor", "Tutor"],
                                 ["Consultant", "Consultant"],
                                 ["Therapist", "Therapist"],
                                 ["Photographer", "Photographer"],
                                 ["Cleaner", "Cleaner"],
                                 ["Tradesperson", "Tradesperson"],
                                 ["Other", "Other"]
                               ],
                               {},
                               id: "businessCategory",
                               class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
                </div>

                <div>
                  <label
                    for="businessPhone"
                    class="mb-2 block text-sm font-semibold text-slate-700"
                  >
                    Phone number
                  </label>

                  <%= f.telephone_field :phone_number,
                                        class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900" %>
                </div>

                <div class="sm:col-span-2">
                  <label
                    for="businessEmail"
                    class="mb-2 block text-sm font-semibold text-slate-700"
                  >
                    Business email
                  </label>

                  <%= f.email_field :business_email,
                                    class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900" %>
                </div>

                <div class="sm:col-span-2">
                  <label
                    for="businessDescription"
                    class="mb-2 block text-sm font-semibold text-slate-700"
                  >
                    Business description
                  </label>

                  <%= f.text_area :business_description,
                                  rows: 4,
                                  class: "w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900" %>

                  <p class="mt-2 text-xs text-slate-500">
                    This description may appear on your public booking page.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Business address -->
          <section
            class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
          >
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <div class="flex items-start gap-3">
                <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
                  <i data-lucide="map-pin" class="h-5 w-5"></i>
                </div>

                <div>
                  <h3 class="text-lg font-bold text-slate-900">
                    Business address
                  </h3>

                  <p class="mt-1 text-sm text-slate-500">
                    Add the location customers should visit.
                  </p>
                </div>
              </div>
            </div>

            <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">
              <div class="sm:col-span-2">
                <label
                  for="addressLineOne"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Address line 1
                </label>

                <%= f.text_field :address_line_1,
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900" %>
              </div>

              <div class="sm:col-span-2">
                <label
                  for="addressLineTwo"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Address line 2
                  <span class="font-normal text-slate-400">
                    (optional)
                  </span>
                </label>

                <%= f.text_field :address_line_2,
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900" %>
              </div>

              <div>
                <label
                  for="businessCity"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Town or city
                </label>

                <%= f.text_field :town_or_city,
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900" %>
              </div>

              <div>
                <label
                  for="businessPostcode"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Postcode
                </label>

                <%= f.text_field :postcode,
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900" %>
              </div>

              <div class="sm:col-span-2">
                <%= f.label :country,
                            "Country",
                            class: "mb-2 block text-sm font-semibold text-slate-700" %>

                <%= f.select :country,
                             [
                               ["England", "England"],
                               ["Scotland", "Scotland"],
                               ["Wales", "Wales"],
                               ["Northern Ireland", "Northern Ireland"],
                               ["Ireland", "Ireland"]
                             ],
                             {},
                             class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>
            </div>
          </section>

          <!-- Booking page -->
          <section
            class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
          >
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <div class="flex items-start gap-3">
                <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
                  <i data-lucide="globe-2" class="h-5 w-5"></i>
                </div>

                <div>
                  <h3 class="text-lg font-bold text-slate-900">
                    Public booking page
                  </h3>

                  <p class="mt-1 text-sm text-slate-500">
                    Manage your booking page address and visibility.
                  </p>
                </div>
              </div>
            </div>

            <div class="p-5 sm:p-6">
              <label
                for="domainName"
                class="mb-2 block text-sm font-semibold text-slate-700"
              >
                Booking page address
              </label>

              <div
                class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50 sm:flex-row"
              >

                <div
                  class="min-w-0 flex-1 px-4 py-3 text-sm text-slate-700"
                >
                  <%= @business.page_address %>
                </div>


                <div
                  class="flex items-center border-t border-slate-200 bg-slate-100 px-4 py-3 text-sm text-slate-500 sm:border-l sm:border-t-0"
                >
                  .securemyslot.co.uk
                </div>

              </div>

              <div
                class="mt-4 flex flex-col gap-3 rounded-xl bg-slate-50 p-4 sm:flex-row sm:items-center sm:justify-between"
              >
                <div>
                  <p class="text-sm font-semibold text-slate-900">
                    Public booking page
                  </p>

                  <p class="mt-1 text-xs leading-5 text-slate-500">
                    Allow customers to view your services and book online.
                  </p>
                </div>

                <label class="relative inline-flex cursor-pointer items-center">
                  <%= f.check_box :booking_page_live,
                                  class: "peer sr-only" %>

                  <span
                    class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"
                  ></span>
                </label>
              </div>

              <a
                href="http://<%= @business.page_address %>.lvh.me:3000"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 transition hover:text-indigo-700"
              >
                <i data-lucide="external-link" class="h-4 w-4"></i>
                View public booking page
              </a>
            </div>
          </section>

          <!-- Booking preferences -->
          <section
            class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
          >
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <div class="flex items-start gap-3">
                <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
                  <i data-lucide="calendar-cog" class="h-5 w-5"></i>
                </div>

                <div>
                  <h3 class="text-lg font-bold text-slate-900">
                    Booking preferences
                  </h3>

                  <p class="mt-1 text-sm text-slate-500">
                    Control how new customer bookings are handled.
                  </p>
                </div>
              </div>
            </div>

            <div class="divide-y divide-slate-100">
              <div
                class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
              >
                <div>
                  <p class="font-semibold text-slate-900">
                    Automatically confirm bookings
                  </p>

                  <p class="mt-1 text-sm leading-6 text-slate-500">
                    New bookings will be confirmed without manual approval.
                  </p>
                </div>

                <label class="relative inline-flex cursor-pointer items-center">
                  <%= f.check_box :automatically_confirm_bookings,
                                  class: "peer sr-only" %>

                  <span
                    class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"
                  ></span>
                </label>
              </div>

              <div
                class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
              >
                <div>
                  <p class="font-semibold text-slate-900">
                    Allow customer cancellations
                  </p>

                  <p class="mt-1 text-sm leading-6 text-slate-500">
                    Customers can cancel their own appointments online.
                  </p>
                </div>

                <label class="relative inline-flex cursor-pointer items-center">
                  <%= f.check_box :allow_customer_cancellations,
                                  class: "peer sr-only" %>

                  <span
                    class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"
                  ></span>
                </label>
              </div>

              <div
                class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
              >
                <div>
                  <p class="font-semibold text-slate-900">
                    Require customer phone number
                  </p>

                  <p class="mt-1 text-sm leading-6 text-slate-500">
                    Customers must provide a phone number when booking.
                  </p>
                </div>

                <label class="relative inline-flex cursor-pointer items-center">
                  <%= f.check_box :require_customer_phone_number,
                                  class: "peer sr-only" %>

                  <span
                    class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"
                  ></span>
                </label>
              </div>

              <div class="grid gap-5 p-5 sm:grid-cols-1 sm:p-6">
                <div>
                  <label
                    for="cancellationNotice"
                    class="mb-2 block text-sm font-semibold text-slate-700"
                  >
                    Cancellation notice
                  </label>

                  <%= f.select :cancellation_notice_hours,
                               [
                                 ["1 hour", 1],
                                 ["2 hours", 2],
                                 ["4 hours", 4],
                                 ["24 hours", 24],
                                 ["48 hours", 48]
                               ],
                               {},
                               class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
                </div>
              </div>
            </div>
          </section>

          <!-- Notifications -->
          <section
            class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
          >
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <div class="flex items-start gap-3">
                <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
                  <i data-lucide="bell" class="h-5 w-5"></i>
                </div>

                <div>
                  <h3 class="text-lg font-bold text-slate-900">
                    Notifications
                  </h3>

                  <p class="mt-1 text-sm text-slate-500">
                    Choose which updates you receive.
                  </p>
                </div>
              </div>
            </div>

            <div class="divide-y divide-slate-100">
              <div
                class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
              >
                <div>
                  <p class="font-semibold text-slate-900">
                    New booking notifications
                  </p>

                  <p class="mt-1 text-sm text-slate-500">
                    Receive an email whenever a customer makes a booking.
                  </p>
                </div>

                <label class="relative inline-flex cursor-pointer items-center">
                  <%= f.check_box :new_booking_notifications,
                                  class: "peer sr-only" %>

                  <span
                    class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"
                  ></span>
                </label>
              </div>

              <div
                class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
              >
                <div>
                  <p class="font-semibold text-slate-900">
                    Cancellation notifications
                  </p>

                  <p class="mt-1 text-sm text-slate-500">
                    Receive an email when a customer cancels an appointment.
                  </p>
                </div>

                <label class="relative inline-flex cursor-pointer items-center">
                  <%= f.check_box :cancellation_notifications,
                                  class: "peer sr-only" %>

                  <span
                    class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"
                  ></span>
                </label>
              </div>

              <div
                class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
              >
                <div>
                  <p class="font-semibold text-slate-900">
                    Daily appointment summary
                  </p>

                  <p class="mt-1 text-sm text-slate-500">
                    Receive a morning summary of your appointments.
                  </p>
                </div>

                <label class="relative inline-flex cursor-pointer items-center">
                  <%= f.check_box :daily_appointment_summary,
                                  class: "peer sr-only" %>

                  <span
                    class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5"
                  ></span>
                </label>
              </div>
            </div>
          </section>

          <!-- Account -->
          <section
            class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
          >
            <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
              <div class="flex items-start gap-3">
                <div class="rounded-xl bg-slate-100 p-3 text-slate-600">
                  <i data-lucide="user-round" class="h-5 w-5"></i>
                </div>

                <div>
                  <h3 class="text-lg font-bold text-slate-900">
                    Account details
                  </h3>

                  <p class="mt-1 text-sm text-slate-500">
                    Manage the account used to access your dashboard.
                  </p>
                </div>
              </div>
            </div>

            <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6">
              <div>
                <label
                  for="firstName"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  First name
                </label>

                <%= f.text_field :first_name,
                                 value: @user.first_name,
                                 name: "first_name",
                                 id: "firstName",
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>

              <div>
                <label
                  for="lastName"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Last name
                </label>

                <%= f.text_field :last_name,
                                 value: @user.last_name,
                                 name: "last_name",
                                 id: "lastName",
                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>

              <div class="sm:col-span-2">
                <label
                  for="accountEmail"
                  class="mb-2 block text-sm font-semibold text-slate-700"
                >
                  Login email
                </label>

                <%= f.email_field :email,
                                  value: @user.email,
                                  name: "email",
                                  id: "accountEmail",
                                  class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
              </div>
            </div>
          </section>
        </div>

      <% end %>
      <%# ^ settingsForm closes here -- everything below is OUTSIDE it %>

      <!-- Password -->
      <section
        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
      >
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
          <div class="flex items-start gap-3">

            <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
              <i data-lucide="lock-keyhole" class="h-5 w-5"></i>
            </div>

            <div>
              <h3 class="text-lg font-bold text-slate-900">
                Change password
              </h3>

              <p class="mt-1 text-sm text-slate-500">
                Use a strong password that you do not use elsewhere.
              </p>
            </div>

          </div>
        </div>


        <%= form_with url: business_password_path,
                      method: :patch do |password_form| %>


          <div class="grid gap-5 p-5 sm:p-6">
            <div>

              <%= password_form.label :current_password,
                                      "Current password",
                                      class: "mb-2 block text-sm font-semibold text-slate-700" %>


              <%= password_form.password_field :current_password,
                                               placeholder: "Enter current password",
                                               class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

            </div>



            <div class="grid gap-5 sm:grid-cols-2">

              <div>

                <%= password_form.label :password,
                                        "New password",
                                        class: "mb-2 block text-sm font-semibold text-slate-700" %>


                <%= password_form.password_field :password,
                                                 placeholder: "Enter new password",
                                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

              </div>



              <div>

                <%= password_form.label :password_confirmation,
                                        "Confirm new password",
                                        class: "mb-2 block text-sm font-semibold text-slate-700" %>


                <%= password_form.password_field :password_confirmation,
                                                 placeholder: "Repeat new password",
                                                 class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

              </div>

            </div>



            <div>

              <%= password_form.submit "Update password",
                                       class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>

            </div>
          </div>


        <% end %>

      </section>

      <!-- Danger zone -->
      <section
        class="overflow-hidden rounded-2xl border border-rose-200 bg-white shadow-sm"
      >
        <div class="border-b border-rose-100 bg-rose-50 px-5 py-5 sm:px-6">
          <div class="flex items-start gap-3">
            <div class="rounded-xl bg-white p-3 text-rose-600">
              <i data-lucide="triangle-alert" class="h-5 w-5"></i>
            </div>

            <div>
              <h3 class="text-lg font-bold text-rose-900">
                Danger zone
              </h3>

              <p class="mt-1 text-sm text-rose-700">
                These actions may permanently affect your account.
              </p>
            </div>
          </div>
        </div>

        <div
          class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
        >
          <div>
            <p class="font-semibold text-slate-900">
              Delete business account
            </p>

            <p class="mt-1 text-sm leading-6 text-slate-500">
              Permanently delete your business, services, customers and
              bookings.
            </p>
          </div>

          <button
            type="button"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-rose-200 px-4 py-2.5 text-sm font-semibold text-rose-600 transition hover:bg-rose-50"
          >
            <i data-lucide="trash-2" class="h-4 w-4"></i>
            Delete account
          </button>
        </div>
      </section>

      <!-- Bottom actions (bound to settingsForm since it's now outside that form) -->
      <div
        class="flex flex-col-reverse gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-end"
      >
        <button
          type="reset"
          form="settingsForm"
          class="inline-flex items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          Discard changes
        </button>

        <button
          type="submit"
          form="settingsForm"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          <i data-lucide="save" class="h-4 w-4"></i>
          Save changes
        </button>
      </div>
    </div>
  </div>
</main>
