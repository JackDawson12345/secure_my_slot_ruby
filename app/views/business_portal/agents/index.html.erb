<main class="p-4 sm:p-6 lg:p-8">

  <!-- Header -->
  <section
    class="overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 to-indigo-700 px-6 py-8 text-white shadow-sm sm:px-8"
  >
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">

      <div>
        <div class="flex items-center gap-3">
          <div class="rounded-xl bg-white/10 p-3 backdrop-blur">
            <i data-lucide="users" class="h-6 w-6"></i>
          </div>

          <div>
            <h1 class="text-2xl font-bold">
              Agents
            </h1>

            <p class="mt-1 text-sm text-indigo-100">
              Manage the team members who can be assigned to bookings.
            </p>
          </div>
        </div>
      </div>

      <%= link_to new_business_agent_path,
                  class: "inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50" do %>

        <i data-lucide="user-plus" class="h-4 w-4"></i>
        Add Agent

      <% end %>

    </div>
  </section>


  <!-- Agents -->
  <section class="mt-6">

    <% if @business_agents.any? %>

      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">

        <% @business_agents.each do |agent| %>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

            <div class="flex items-start justify-between gap-4">

              <div class="flex items-center gap-3">

                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo-50 font-semibold text-indigo-700">
                  <%= agent.user.first_name&.first&.upcase %><%= agent.user.last_name&.first&.upcase %>
                </div>

                <div>
                  <h2 class="font-semibold text-slate-900">
                    <%= agent.user.full_name %>
                  </h2>

                  <p class="mt-0.5 text-sm text-slate-500">
                    <%= agent.user.email %>
                  </p>
                </div>

              </div>

            </div>

            <div class="mt-5 space-y-3 border-t border-slate-100 pt-4">

              <% if agent.user.phone_number.present? %>
                <div class="flex items-center gap-2 text-sm text-slate-600">
                  <i data-lucide="phone" class="h-4 w-4 text-slate-400"></i>
                  <%= agent.user.phone_number %>
                </div>
              <% end %>

            </div>

            <div class="mt-5 flex gap-2">

              <%= link_to edit_business_agent_path(agent),
                          class: "inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" do %>

                <i data-lucide="pencil" class="h-4 w-4"></i>
                Edit

              <% end %>

              <%= button_to business_agent_path(agent),
                            method: :delete,
                            data: {
                              turbo_confirm: "Are you sure you want to remove this agent?"
                            },
                            class: "inline-flex items-center justify-center rounded-xl bg-red-50 px-3 py-2 text-red-600 transition hover:bg-red-100" do %>

                <i data-lucide="trash-2" class="h-4 w-4"></i>

              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">

        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100">
          <i data-lucide="users" class="h-6 w-6 text-slate-500"></i>
        </div>

        <h2 class="mt-4 font-semibold text-slate-900">
          No agents yet
        </h2>

        <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">
          Add team members to your business so bookings can be assigned to them.
        </p>

        <%= link_to new_business_agent_path,
                    class: "mt-5 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700" do %>

          <i data-lucide="user-plus" class="h-4 w-4"></i>
          Add your first agent

        <% end %>

      </div>

    <% end %>

  </section>

</main>