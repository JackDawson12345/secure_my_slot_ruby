<div class="relative">

  <div class="<%= 'pointer-events-none opacity-50' unless current_user.business.feature_enabled?(:agents) %>">
    <main class="p-4 sm:p-6 lg:p-8">

      <!-- Header -->
      <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Agents
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Manage the team members who can be assigned to bookings.
          </p>
        </div>

        <%= link_to new_business_agent_path,
                    class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto" do %>
          <i data-lucide="user-plus" class="h-4 w-4"></i>
          Add Agent
        <% end %>
      </section>

      <%= render 'business_portal/shared/flash_messages' %>


      <!-- Main Content -->
      <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1fr)_340px]">

        <!-- LEFT: Agents -->
        <section>

          <% if @business_agents.any? %>

            <div class="grid gap-4 sm:grid-cols-2">

              <% @business_agents.each do |agent| %>

                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                  <div class="flex items-start justify-between gap-4">

                    <div class="flex min-w-0 items-center gap-3">

                      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo-50 font-semibold text-indigo-700">
                        <%= agent.user.first_name&.first&.upcase %><%= agent.user.last_name&.first&.upcase %>
                      </div>

                      <div class="min-w-0">
                        <h4 class="truncate font-semibold text-slate-900">
                          <%= agent.user.full_name %>
                        </h4>

                        <p class="mt-0.5 truncate text-sm text-slate-500">
                          <%= agent.user.email %>
                        </p>
                      </div>

                    </div>

                  </div>


                  <% if agent.user.phone_number.present? %>
                    <div class="mt-5 border-t border-slate-100 pt-4">

                      <div class="flex items-center gap-2 text-sm text-slate-600">
                        <i data-lucide="phone" class="h-4 w-4 text-slate-400"></i>

                        <%= agent.user.phone_number %>
                      </div>

                    </div>
                  <% end %>


                  <div class="mt-5 flex gap-2">

                    <%= link_to edit_business_agent_path(agent),
                                class: "inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" do %>

                      <i data-lucide="pencil" class="h-4 w-4"></i>
                      Edit

                    <% end %>


                    <%= button_to business_agent_path(agent),
                                  method: :delete,
                                  data: {
                                    turbo_confirm: "Are you sure you want to remove this agent?"
                                  },
                                  class: "inline-flex items-center justify-center rounded-xl bg-red-50 px-3 py-2 text-red-600 transition hover:bg-red-100" do %>

                      <i data-lucide="trash-2" class="h-4 w-4"></i>

                    <% end %>

                  </div>

                </div>

              <% end %>

            </div>

          <% else %>

            <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">

              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100">
                <i data-lucide="users" class="h-6 w-6 text-slate-500"></i>
              </div>

              <h3 class="mt-4 font-semibold text-slate-900">
                No agents yet
              </h3>

              <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">
                Add team members to your business so bookings can be assigned to them.
              </p>

              <%= link_to new_business_agent_path,
                          class: "mt-5 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700" do %>

                <i data-lucide="user-plus" class="h-4 w-4"></i>
                Add your first agent

              <% end %>

            </div>

          <% end %>

        </section>


        <!-- RIGHT: Agent Settings -->
        <aside class="space-y-6">

          <%= form_with(
                model: @agent_setting,
                url: update_settings_business_agents_path,
                method: :patch
              ) do |form| %>

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

              <!-- Header -->
              <div class="p-5">

                <div class="flex items-start justify-between gap-4">

                  <div>
                    <h3 class="text-lg font-bold text-slate-900">
                      Agent Settings
                    </h3>

                    <p class="mt-1 text-sm leading-6 text-slate-500">
                      Control how bookings are assigned to your team.
                    </p>
                  </div>

                  <div class="shrink-0 rounded-xl bg-indigo-50 p-3 text-indigo-600">
                    <i data-lucide="settings-2" class="h-5 w-5"></i>
                  </div>

                </div>

              </div>


              <div class="border-t border-slate-100">

                <!-- Customer Agent Selection -->
                <div class="p-5">

                  <label class="text-sm font-semibold text-slate-900">
                    Customer agent selection
                  </label>

                  <p class="mt-1 text-xs leading-5 text-slate-500">
                    Choose how customers select an agent when making a booking.
                  </p>


                  <div class="mt-4 space-y-3">

                    <!-- Allow Any Agent -->
                    <label class="relative flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-3.5 transition hover:border-indigo-200 has-[:checked]:border-indigo-200 has-[:checked]:bg-indigo-50/50">

                      <%= form.radio_button(
                            :agent_selection,
                            :allow_any,
                            class: "mt-0.5 h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-500"
                          ) %>

                      <div>
    <span class="block text-sm font-semibold text-slate-900">
      Allow "Any agent"
    </span>

                        <span class="mt-0.5 block text-xs leading-5 text-slate-500">
      Customers can choose a specific agent or select Any agent.
    </span>
                      </div>

                    </label>


                    <!-- Require Selection -->
                    <label class="relative flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-3.5 transition hover:border-indigo-200 has-[:checked]:border-indigo-200 has-[:checked]:bg-indigo-50/50">

                      <%= form.radio_button(
                            :agent_selection,
                            :require_selection,
                            class: "mt-0.5 h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-500"
                          ) %>

                      <div>
    <span class="block text-sm font-semibold text-slate-900">
      Require agent selection
    </span>

                        <span class="mt-0.5 block text-xs leading-5 text-slate-500">
      Customers must choose a specific agent before continuing.
    </span>
                      </div>

                    </label>

                  </div>

                </div>


                <!-- Booking Visibility -->
                <div class="border-t border-slate-100 p-5">

                  <%= form.label(
                        :booking_visibility,
                        "Booking visibility",
                        class: "text-sm font-semibold text-slate-900"
                      ) %>

                  <p class="mt-1 text-xs leading-5 text-slate-500">
                    Control which bookings agents can view in their portal.
                  </p>


                  <div class="relative mt-3">

                    <%= form.select(
                          :booking_visibility,
                          [
                            ["Assigned bookings only", "assigned_only"],
                            ["All business bookings", "all_bookings"]
                          ],
                          {},
                          class: "w-full appearance-none rounded-xl border border-slate-200 bg-white px-3 py-2.5 pr-9 text-sm font-medium text-slate-700 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20"
                        ) %>

                    <i
                      data-lucide="chevron-down"
                      class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                    ></i>

                  </div>

                </div>


                <!-- Allow Reassignment -->
                <div class="border-t border-slate-100 p-5">

                  <div class="flex items-start justify-between gap-4">

                    <div class="pr-2">
                      <h4 class="text-sm font-semibold text-slate-900">
                        Allow agent reassignment
                      </h4>

                      <p class="mt-1 text-xs leading-5 text-slate-500">
                        Allow bookings to be moved from one agent to another.
                      </p>
                    </div>


                    <label class="relative mt-0.5 inline-flex cursor-pointer items-center">

                      <%= form.check_box(
                            :allow_reassignment,
                            {
                              class: "peer sr-only"
                            },
                            "1",
                            "0"
                          ) %>

                      <div class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-500 peer-focus:ring-offset-2"></div>

                      <div class="pointer-events-none absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow-sm transition-transform peer-checked:translate-x-5"></div>

                    </label>

                  </div>

                </div>

              </div>


              <!-- Save -->
              <div class="border-t border-slate-100 bg-slate-50/70 p-5">

                <%= form.button(
                  type: "submit",
                  class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                ) do %>

                  <i data-lucide="save" class="h-4 w-4"></i>
                  Save Settings

                <% end %>

              </div>

            </section>

          <% end %>


          <!-- Info -->
          <section class="rounded-2xl border border-indigo-100 bg-indigo-50 p-5">

            <div class="flex items-start gap-3">

              <div class="shrink-0 rounded-xl bg-indigo-100 p-2.5 text-indigo-600">
                <i data-lucide="info" class="h-5 w-5"></i>
              </div>

              <div>
                <h3 class="text-sm font-semibold text-indigo-950">
                  Agent assignment
                </h3>

                <p class="mt-1 text-xs leading-5 text-indigo-700">
                  Every booking must have an agent. Customers can either choose their preferred agent or, when enabled, select Any agent.
                </p>
              </div>

            </div>

          </section>

        </aside>

      </div>

    </main>
  </div>
  <% unless current_user.business.feature_enabled?(:agents) %>
    <%= render 'business_portal/shared/upgrade_overlay',
               title: 'Add Booking Agents',
               message: 'Upgrade to Pro Plus to add individual agents and allow them to manage and take their own bookings.'
    %>
  <% end %>
</div>

