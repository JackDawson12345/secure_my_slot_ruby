<%= form_with model: agent,
              url: agent.persisted? ?
                     business_agent_path(agent) :
                     business_agents_path,
              class: "space-y-6" do |form| %>

  <% if agent.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">
      <div class="flex items-start gap-3">

        <i
          data-lucide="circle-alert"
          class="mt-0.5 h-5 w-5 shrink-0 text-red-600"
        ></i>

        <div>
          <h3 class="font-semibold text-red-800">
            Please correct the following:
          </h3>

          <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-red-700">
            <% agent.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>

      </div>
    </div>
  <% end %>


  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

    <div>
      <h2 class="text-lg font-semibold text-slate-900">
        Agent details
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Enter the details of the team member you want to add.
      </p>
    </div>


    <div class="mt-6 grid gap-5 sm:grid-cols-2">

      <div>
        <%= form.label :first_name,
                       class: "block text-sm font-semibold text-slate-700" %>

        <%= form.text_field :first_name,
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>


      <div>
        <%= form.label :last_name,
                       class: "block text-sm font-semibold text-slate-700" %>

        <%= form.text_field :last_name,
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>


      <div>
        <%= form.label :email,
                       class: "block text-sm font-semibold text-slate-700" %>

        <%= form.email_field :email,
                             required: true,
                             class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>


      <div>
        <%= form.label :phone_number,
                       class: "block text-sm font-semibold text-slate-700" %>

        <%= form.telephone_field :phone_number,
                                 class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
      </div>

    </div>

  </div>


  <div class="flex items-center justify-end gap-3">

    <%= link_to "Cancel",
                business_agents_path,
                class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-100" %>

    <%= form.submit agent.persisted? ? "Save Changes" : "Add Agent",
                    class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700" %>

  </div>

<% end %>