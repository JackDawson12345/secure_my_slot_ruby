<div class="space-y-6">


  <!-- Primary Colour -->

  <% if template.settings["allow_primary_colour"] %>

    <div>

      <label class="block text-sm font-semibold text-slate-700">
        Primary Colour
      </label>

      <p class="mt-1 text-sm text-slate-500">
        Used for the main design elements.
      </p>


      <div class="mt-4 flex items-center gap-3">


        <%= color_field_tag "social_post[settings][primary_colour]",
                            social_post.settings["primary_colour"],
                            data: {
                              action: "input->social-post-editor#updateColour",
                              social_post_style_key: "primary_colour"
                            },
                            class: "h-12 w-16 cursor-pointer rounded-xl border border-slate-200 bg-white p-1" %>


        <%= text_field_tag "primary_colour_display",
                           social_post.settings["primary_colour"],
                           data: {
                             action: "input->social-post-editor#updateColourText",
                             social_post_style_key: "primary_colour"
                           },
                           class: "flex-1 rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>


      </div>

    </div>

  <% end %>



  <!-- Accent Colour -->

  <% if template.settings["allow_accent_colour"] %>

    <div>

      <label class="block text-sm font-semibold text-slate-700">
        Accent Colour
      </label>

      <p class="mt-1 text-sm text-slate-500">
        Used for highlights and secondary design elements.
      </p>


      <div class="mt-4 flex items-center gap-3">

        <%= color_field_tag "social_post[settings][accent_colour]",
                            social_post.settings["accent_colour"],
                            data: {
                              action: "input->social-post-editor#updateColour",
                              social_post_style_key: "accent_colour"
                            },
                            class: "h-12 w-16 cursor-pointer rounded-xl border border-slate-200 bg-white p-1" %>


        <%= text_field_tag "accent_colour_display",
                           social_post.settings["accent_colour"],
                           data: {
                             social_post_style_key: "accent_colour",
                             action: "input->social-post-editor#updateColourText"
                           },
                           class: "flex-1 rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>


      </div>

    </div>

  <% end %>



  <!-- Design Restrictions -->

  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">

    <div class="flex gap-3">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-slate-500 shadow-sm">

        <i data-lucide="lock" class="h-5 w-5"></i>

      </div>


      <div>

        <h4 class="text-sm font-bold text-slate-900">
          Template styling
        </h4>


        <p class="mt-1 text-sm leading-6 text-slate-500">
          Font styles, sizing and layout are controlled by the template to keep your posts looking consistent.
        </p>

      </div>

    </div>

  </div>


</div>