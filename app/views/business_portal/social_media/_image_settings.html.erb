<div class="space-y-8">


  <!-- ========================================= -->
  <!-- POST IMAGE -->
  <!-- ========================================= -->

  <% if template.settings["allow_image"] %>

    <div>

      <label class="block text-sm font-semibold text-slate-700">
        Post Image
      </label>

      <p class="mt-1 text-sm text-slate-500">
        Upload an image to include in this design.
      </p>


      <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6">

        <div class="text-center">

          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm">

            <i data-lucide="image-plus" class="h-5 w-5"></i>

          </div>


          <h4 class="mt-4 text-sm font-bold text-slate-900">
            Upload an image
          </h4>


          <p class="mt-1 text-xs text-slate-500">
            Recommended size: 1080 × 1080px
          </p>


          <%= file_field_tag "social_post[image]",
                             accept: "image/png,image/jpeg,image/webp",
                             data: {
                               action: "change->social-post-editor#updateImage"
                             },
                             class: "mt-5 block w-full cursor-pointer text-sm text-slate-500 file:mr-4 file:rounded-xl file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-600 hover:file:bg-indigo-100" %>

        </div>

      </div>


      <% if social_post.image.attached? %>

        <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-4">

          <p class="mb-3 text-sm font-semibold text-slate-700">
            Current Image
          </p>


          <div class="overflow-hidden rounded-xl">

            <%= image_tag social_post.image,
                          class: "aspect-square w-full object-cover" %>

          </div>

        </div>

      <% end %>


    </div>


  <% else %>


    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center">

      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm">

        <i data-lucide="image-off" class="h-5 w-5"></i>

      </div>


      <h4 class="mt-4 text-sm font-bold text-slate-900">
        Image not applicable
      </h4>


      <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
        This template does not include an image area.
      </p>

    </div>


  <% end %>




  <!-- ========================================= -->
  <!-- BUSINESS LOGO -->
  <!-- ========================================= -->


  <% if template.settings["allow_logo"] %>


    <div class="border-t border-slate-200 pt-8">


      <label class="block text-sm font-semibold text-slate-700">
        Business Logo
      </label>


      <p class="mt-1 text-sm text-slate-500">
        Upload your logo to appear on the post.
      </p>



      <div class="mt-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6">


        <div class="text-center">


          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-white text-indigo-600 shadow-sm">

            <i data-lucide="sparkles" class="h-5 w-5"></i>

          </div>


          <h4 class="mt-4 text-sm font-bold text-slate-900">
            Upload logo
          </h4>


          <p class="mt-1 text-xs text-slate-500">
            PNG with transparency recommended.
          </p>


          <%= file_field_tag "social_post[logo]",
                             accept: "image/png,image/jpeg,image/webp",
                             data: {
                               action: "change->social-post-editor#updateLogo"
                             },
                             class: "mt-5 block w-full cursor-pointer text-sm text-slate-500 file:mr-4 file:rounded-xl file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-600 hover:file:bg-indigo-100" %>


        </div>


      </div>



      <% if social_post.logo.attached? %>


        <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-4">


          <p class="mb-3 text-sm font-semibold text-slate-700">
            Current Logo
          </p>


          <div class="flex h-32 items-center justify-center rounded-xl bg-slate-50 p-4">

            <%= image_tag social_post.logo,
                          class: "h-full max-w-full object-contain" %>

          </div>


        </div>


      <% end %>


    </div>


  <% else %>


    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center">


      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm">

        <i data-lucide="sparkles" class="h-5 w-5"></i>

      </div>


      <h4 class="mt-4 text-sm font-bold text-slate-900">
        Logo not applicable
      </h4>


      <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
        This template does not include a logo area.
      </p>


    </div>


  <% end %>


</div>