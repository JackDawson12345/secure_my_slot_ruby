<!-- Edit Social Media Post -->
<main
  class="p-4 sm:p-6 lg:p-8"
  data-controller="social-post-editor"
>
  <%= form_with model: social_post,
                url: business_create_social_media_post_path,
                method: :post,
                multipart: true do |form| %>

    <%= form.hidden_field :social_post_template_id,
                          value: template.id %>

  <!-- ========================================= -->
  <!-- PAGE HEADING -->
  <!-- ========================================= -->

  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>

      <div class="mb-2 flex items-center gap-2 text-sm text-slate-500">

        <%= link_to "Social Media",
                    business_new_social_media_post_path,
                    class: "transition hover:text-slate-900" %>

        <i data-lucide="chevron-right" class="h-4 w-4"></i>

        <span>Create Post</span>

        <i data-lucide="chevron-right" class="h-4 w-4"></i>

        <span class="font-medium text-slate-700">
          Edit
        </span>

      </div>


      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Edit Your Post
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Personalise the content and design before saving your post.
      </p>

    </div>


    <%= link_to business_new_social_media_post_path,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 sm:w-auto" do %>

      <i data-lucide="arrow-left" class="h-4 w-4"></i>

      Choose another design

    <% end %>

  </section>



  <!-- ========================================= -->
  <!-- STEPS -->
  <!-- ========================================= -->

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">

    <div class="flex items-center">

      <!-- Step 1 -->
      <div class="flex items-center gap-3">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
          <i data-lucide="check" class="h-5 w-5"></i>
        </div>

        <div class="hidden sm:block">

          <p class="text-sm font-semibold text-slate-900">
            Choose a design
          </p>

          <p class="text-xs text-slate-500">
            <%= template.name %>
          </p>

        </div>

      </div>


      <div class="mx-4 h-px flex-1 bg-indigo-200 sm:mx-6"></div>


      <!-- Step 2 -->
      <div class="flex items-center gap-3">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">
          2
        </div>

        <div class="hidden sm:block">

          <p class="text-sm font-semibold text-slate-900">
            Edit your post
          </p>

          <p class="text-xs text-slate-500">
            Personalise the content
          </p>

        </div>

      </div>


      <div class="mx-4 h-px flex-1 bg-slate-200 sm:mx-6"></div>


      <!-- Step 3 -->
      <div class="flex items-center gap-3">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-400">
          3
        </div>

        <div class="hidden sm:block">

          <p class="text-sm font-semibold text-slate-400">
            Finish
          </p>

          <p class="text-xs text-slate-400">
            Save your post
          </p>

        </div>

      </div>

    </div>

  </section>



  <!-- ========================================= -->
  <!-- EDITOR -->
  <!-- ========================================= -->

  <section class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1.1fr)_minmax(420px,0.9fr)]">


    <!-- ========================================= -->
    <!-- LEFT: PREVIEW -->
    <!-- ========================================= -->

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <!-- Preview Header -->
      <div class="flex items-center justify-between border-b border-slate-200 p-5 sm:p-6">

        <div>

          <h3 class="text-lg font-bold text-slate-900">
            Post Preview
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Preview how your finished design will look.
          </p>

        </div>


        <div class="flex items-center gap-2">

          <div
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600"
            title="Square post"
          >
            <i data-lucide="square" class="h-4 w-4"></i>
          </div>

        </div>

      </div>


      <!-- Preview Area -->
      <div class="bg-slate-100 p-6 sm:p-8 lg:p-10">

        <div class="mx-auto max-w-xl">

          <!-- Actual Template -->
          <div
            class="overflow-hidden rounded-xl shadow-xl"
            data-social-post-editor-target="preview"
          >

            <%= render "business_portal/social_media/templates/#{template.template_key}",
                       post: social_post %>

          </div>


          <!-- Template Info -->
          <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

            <div>

              <div class="flex items-center gap-2">

                <p class="text-sm font-semibold text-slate-900">
                  <%= template.name %>
                </p>

                <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-1 text-[11px] font-semibold text-indigo-600">
                  <%= template.category.to_s.titleize %>
                </span>

              </div>

              <p class="mt-1 text-xs text-slate-500">
                Square Post · 1080 × 1080
              </p>

            </div>

          </div>

        </div>

      </div>

    </div>



    <!-- ========================================= -->
    <!-- RIGHT: CUSTOMISE -->
    <!-- ========================================= -->

    <div class="self-start overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm xl:sticky xl:top-6">

      <!-- Header -->
      <div class="border-b border-slate-200 p-5 sm:p-6">

        <div class="flex items-start justify-between gap-4">

          <div>

            <h3 class="text-lg font-bold text-slate-900">
              Customise Post
            </h3>

            <p class="mt-1 text-sm text-slate-500">
              Make this design your own.
            </p>

          </div>


          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            <i data-lucide="sliders-horizontal" class="h-5 w-5"></i>
          </div>

        </div>

      </div>



      <!-- ========================================= -->
      <!-- TABS -->
      <!-- ========================================= -->

      <div
        class="grid grid-cols-3 border-b border-slate-200"
        data-controller="social-post-tabs"
      >

        <button
          type="button"
          data-action="social-post-tabs#show"
          data-tab="content"
          class="social-tab flex items-center justify-center gap-2 border-b-2 border-indigo-600 px-4 py-4 text-sm font-semibold text-indigo-600"
        >
          <i data-lucide="type" class="h-4 w-4"></i>
          Content
        </button>


        <button
          type="button"
          data-action="social-post-tabs#show"
          data-tab="image"
          class="social-tab flex items-center justify-center gap-2 border-b-2 border-transparent px-4 py-4 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="image" class="h-4 w-4"></i>
          Image
        </button>


        <button
          type="button"
          data-action="social-post-tabs#show"
          data-tab="style"
          class="social-tab flex items-center justify-center gap-2 border-b-2 border-transparent px-4 py-4 text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="palette" class="h-4 w-4"></i>
          Style
        </button>

      </div>



      <!-- ========================================= -->
      <!-- CONTENT AREA -->
      <!-- ========================================= -->

      <div class="p-5 sm:p-6">

        <!-- ========================================= -->
        <!-- CONTENT TAB -->
        <!-- ========================================= -->

        <div data-social-post-tab="content">

          <div class="space-y-6">

            <% template.fields.each do |key, field| %>

              <%
                value = social_post.content&.dig(key.to_s) || field["default"]
                field_type = field["type"]
                max_length = field["max_length"]
              %>


              <!-- ========================================= -->
              <!-- TEXT FIELD -->
              <!-- ========================================= -->

              <% if field_type == "text" %>

                <div>

                  <div class="flex items-center justify-between gap-4">

                    <label
                      for="social_post_content_<%= key %>"
                      class="block text-sm font-semibold text-slate-700"
                    >
                      <%= field["label"] %>
                    </label>

                    <% if max_length.present? %>
                  <span
                    class="text-xs text-slate-400"
                    data-social-post-editor-target="counter"
                    data-social-post-editor-key="<%= key %>"
                  >
                    <%= value.to_s.length %> / <%= max_length %>
                  </span>
                    <% end %>

                  </div>


                  <%= text_field_tag "social_post[content][#{key}]",
                                     value,
                                     id: "social_post_content_#{key}",
                                     maxlength: max_length,
                                     data: {
                                       social_post_editor_target: "field",
                                       social_post_editor_key: key,
                                       action: "input->social-post-editor#update"
                                     },
                                     class: "mt-2 block w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>


                  <% if field["help"].present? %>
                    <p class="mt-2 text-xs leading-5 text-slate-400">
                      <%= field["help"] %>
                    </p>
                  <% end %>

                </div>



                <!-- ========================================= -->
                <!-- TEXTAREA -->
                <!-- ========================================= -->

              <% elsif field_type == "textarea" %>

                <div>

                  <div class="flex items-center justify-between gap-4">

                    <label
                      for="social_post_content_<%= key %>"
                      class="block text-sm font-semibold text-slate-700"
                    >
                      <%= field["label"] %>
                    </label>

                    <% if max_length.present? %>
                  <span
                    class="text-xs text-slate-400"
                    data-social-post-editor-target="counter"
                    data-social-post-editor-key="<%= key %>"
                  >
                    <%= value.to_s.length %> / <%= max_length %>
                  </span>
                    <% end %>

                  </div>


                  <%= text_area_tag "social_post[content][#{key}]",
                                    value,
                                    id: "social_post_content_#{key}",
                                    rows: 4,
                                    maxlength: max_length,
                                    data: {
                                      social_post_editor_target: "field",
                                      social_post_editor_key: key,
                                      action: "input->social-post-editor#update"
                                    },
                                    class: "mt-2 block w-full resize-none rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm leading-6 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>


                  <% if field["help"].present? %>
                    <p class="mt-2 text-xs leading-5 text-slate-400">
                      <%= field["help"] %>
                    </p>
                  <% end %>

                </div>



                <!-- ========================================= -->
                <!-- STAR RATING -->
                <!-- ========================================= -->

              <% elsif field_type == "rating" %>

                <div>

                  <label class="block text-sm font-semibold text-slate-700">
                    <%= field["label"] %>
                  </label>


                  <div class="mt-3 grid grid-cols-5 gap-2">

                    <% 1.upto(5) do |rating| %>

                      <label class="cursor-pointer">

                        <%= radio_button_tag "social_post[content][#{key}]",
                                             rating,
                                             value.to_i == rating,
                                             id: "social_post_content_#{key}_#{rating}",
                                             class: "peer sr-only",
                                             data: {
                                               action: "change->social-post-editor#updateRating"
                                             } %>


                        <div class="flex items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white px-2 py-3 text-slate-400 transition hover:border-amber-300 hover:bg-amber-50 peer-checked:border-amber-300 peer-checked:bg-amber-50 peer-checked:text-amber-500">

                          <i
                            data-lucide="star"
                            class="h-4 w-4"
                          ></i>

                          <span class="text-xs font-bold">
                            <%= rating %>
                          </span>

                        </div>

                      </label>

                    <% end %>

                  </div>


                  <% if field["help"].present? %>
                    <p class="mt-2 text-xs leading-5 text-slate-400">
                      <%= field["help"] %>
                    </p>
                  <% end %>

                </div>

              <% end %>

            <% end %>

          </div>

        </div>

        <!-- ========================================= -->
        <!-- IMAGE TAB -->
        <!-- ========================================= -->

        <div
          class="hidden"
          data-social-post-tab="image"
        >

          <%= render "image_settings",
                     social_post: social_post,
                     template: template %>

        </div>



        <!-- ========================================= -->
        <!-- STYLE TAB -->
        <!-- ========================================= -->

        <div
          class="hidden"
          data-social-post-tab="style"
        >

          <%= render "style_settings",
                     social_post: social_post,
                     template: template %>

        </div>


      </div>



      <!-- ========================================= -->
      <!-- FOOTER ACTIONS -->
      <!-- ========================================= -->

      <div class="border-t border-slate-200 bg-slate-50 p-5 sm:p-6">

        <div class="flex flex-col gap-3 sm:flex-row">

          <button
            type="submit"
            class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
          >
            Continue

            <i data-lucide="arrow-right" class="h-4 w-4"></i>
          </button>

        </div>

      </div>

    </div>

  </section>

  <% end %>
</main>