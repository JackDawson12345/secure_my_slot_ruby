<%
  content = post.content || {}
  settings = post.settings || {}

  business_name = content["business_name"].presence || "YOUR BUSINESS"
  small_heading = content["small_heading"].presence || "Book Online"
  heading = content["heading"].presence || "Appointments Available"
  description = content["description"].presence || "Secure your preferred appointment today. Book online quickly and easily."
  button_text = content["button_text"].presence || "BOOK NOW"
  website = content["website"].presence || "yourbusiness.co.uk"

  primary_colour = settings["primary_colour"].presence || "#4f46e5"
  accent_colour = settings["accent_colour"].presence || "#ffffff"
%>

<!--
  Social Post Template
  Appointments Available

  Always rendered as a square.
-->
<div
  data-social-post-style-background="primary_colour"
  class="relative aspect-square w-full overflow-hidden [container-type:inline-size]"
  style="background-color: <%= primary_colour %>;"
>

  <!-- ========================================= -->
  <!-- BACKGROUND DECORATION -->
  <!-- ========================================= -->

  <div
    class="pointer-events-none absolute -right-[18%] -top-[18%] h-[52%] w-[52%] rounded-full bg-white/[0.08]"
  ></div>

  <div
    class="pointer-events-none absolute -bottom-[23%] -left-[16%] h-[58%] w-[58%] rounded-full bg-white/[0.08]"
  ></div>

  <div
    class="pointer-events-none absolute right-[8%] top-[42%] h-[15%] w-[15%] rounded-full border-[0.25cqw] border-white/10"
  ></div>

  <div
    class="pointer-events-none absolute right-[18%] top-[22%] h-[4%] w-[4%] rounded-full bg-white/10"
  ></div>


  <!-- ========================================= -->
  <!-- POST CONTENT -->
  <!-- ========================================= -->

  <div class="relative flex h-full flex-col p-[7.5%]">


    <!-- ========================================= -->
    <!-- BUSINESS -->
    <!-- ========================================= -->

    <div class="flex items-center gap-[3%]">

      <!-- Logo / Icon -->
      <div
        class="flex aspect-square w-[10%] shrink-0 items-center justify-center overflow-hidden rounded-[18%] bg-white/15 text-white"
      >


        <% if post.respond_to?(:logo) && post.logo.attached? %>

          <%= image_tag post.logo,
                        data: {
                          social_post_logo: true
                        },
                        class: "h-full w-full object-contain p-[14%]",
                        crossorigin: "anonymous",
                        alt: business_name %>


        <% else %>


          <img
            data-social-post-logo
            class="hidden h-full w-full object-contain p-[14%]"
            alt="<%= business_name %>"
          >


          <i
            data-social-post-logo-placeholder
            data-lucide="calendar-check"
            class="h-[48%] w-[48%]"
          ></i>


        <% end %>


      </div>


      <div class="min-w-0">

        <p
          data-social-post-field="business_name"
          class="truncate font-bold uppercase leading-none tracking-[0.12em] text-white"
          style="font-size: 3.1cqw;"
        >
          <%= business_name %>
        </p>

        <p
          class="mt-[1.5%] font-medium text-white/60"
          style="font-size: 2.3cqw;"
        >
          Book online
        </p>

      </div>

    </div>



    <!-- ========================================= -->
    <!-- MAIN MESSAGE -->
    <!-- ========================================= -->

    <div class="my-auto">

      <!-- Small Heading -->
      <div class="flex items-center gap-[2.5%]">

        <span
          data-social-post-style-background="accent_colour"
          class="block h-[0.5cqw] w-[7%] rounded-full bg-white/50"
          style="background-color: <%= accent_colour %>"
        ></span>

        <p
          data-social-post-style-color="accent_colour"
          data-social-post-field="small_heading"
          class="font-bold uppercase leading-none tracking-[0.2em] text-white/65"
          style="font-size: 2.35cqw;
          color: <%= accent_colour %>"
        >
          <%= small_heading %>
        </p>

      </div>


      <!-- Main Heading -->
      <h2
        data-social-post-field="heading"
        class="mt-[4%] max-w-[88%] font-black leading-[0.98] tracking-[-0.045em] text-white"
        style="font-size: 8.7cqw;"
      >
        <%= heading %>
      </h2>


      <!-- Description -->
      <p
        data-social-post-field="description"
        class="mt-[5%] max-w-[74%] font-medium leading-[1.55] text-white/75"
        style="font-size: 3.15cqw;"
      >
        <%= description %>
      </p>

    </div>



    <!-- ========================================= -->
    <!-- FOOTER -->
    <!-- ========================================= -->

    <div class="flex items-end justify-between gap-[5%]">

      <!-- CTA -->
      <div
        data-social-post-field="button_text"
        data-social-post-style-background="accent_colour"
        data-social-post-style-color="primary_colour"
        class="inline-flex shrink-0 items-center justify-center rounded-[1.8cqw] px-[4.5%] py-[2.8%] font-extrabold tracking-[0.04em] shadow-sm"
        style="
        background-color: <%= accent_colour %>;
          color: <%= primary_colour %>;
        "
      >
        <%= button_text %>
      </div>


      <!-- Website -->
      <div class="min-w-0 text-right">

        <p
          class="mb-[1%] font-medium uppercase tracking-[0.14em] text-white/45"
          style="font-size: 1.75cqw;"
        >
          Book online
        </p>

        <p
          data-social-post-style-color="accent_colour"
          data-social-post-field="website"
          class="truncate font-bold text-white"
          style="font-size: 2.35cqw;
          color: <%= accent_colour %>"
        >
          <%= website %>
        </p>

      </div>

    </div>

  </div>

</div>