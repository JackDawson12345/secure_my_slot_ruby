<%
  content = post.content || {}
  settings = post.settings || {}

  business_name = content["business_name"].presence || "YOUR BUSINESS"
  small_heading = content["small_heading"].presence || "LIMITED TIME OFFER"
  offer = content["offer"].presence || "20% OFF"
  heading = content["heading"].presence || "Book Today & Save"
  description = content["description"].presence || "Take advantage of our latest offer and secure your appointment online today."
  button_text = content["button_text"].presence || "BOOK NOW"
  website = content["website"].presence || "yourbusiness.co.uk"

  primary_colour = settings["primary_colour"].presence || "#0f172a"
  accent_colour = settings["accent_colour"].presence || "#34d399"
%>

<!--
  Social Post Template
  Special Offer

  Always rendered as a square.
-->
<div
  class="relative aspect-square w-full overflow-hidden [container-type:inline-size]"
  style="background-color: <%= primary_colour %>;"
>

  <!-- ========================================= -->
  <!-- BACKGROUND -->
  <!-- ========================================= -->

  <!-- Large accent glow -->
  <div
    class="pointer-events-none absolute -right-[18%] -top-[18%] h-[58%] w-[58%] rounded-full opacity-20 blur-[5cqw]"
    style="background-color: <%= accent_colour %>;"
  ></div>

  <!-- Bottom shape -->
  <div
    class="pointer-events-none absolute -bottom-[26%] -left-[18%] h-[58%] w-[58%] rounded-full border-[8cqw] opacity-10"
    style="border-color: <%= accent_colour %>;"
  ></div>

  <!-- Decorative dots -->
  <div class="pointer-events-none absolute right-[8%] top-[44%] grid grid-cols-3 gap-[1.3cqw] opacity-20">

    <% 9.times do %>
      <span
        class="h-[0.8cqw] w-[0.8cqw] rounded-full"
        style="background-color: <%= accent_colour %>;"
      ></span>
    <% end %>

  </div>


  <!-- ========================================= -->
  <!-- CONTENT -->
  <!-- ========================================= -->

  <div class="relative flex h-full flex-col p-[7.5%]">


    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <div class="flex items-center justify-between gap-[4%]">

      <!-- Business -->
      <div class="flex min-w-0 items-center gap-[3cqw]">

        <div
          class="flex aspect-square w-[9.5cqw] shrink-0 items-center justify-center overflow-hidden rounded-[2cqw]"
          style="background-color: <%= accent_colour %>;"
        >

          <% if post.respond_to?(:logo) && post.logo.attached? %>

            <%= image_tag post.logo,
                          class: "h-full w-full object-contain p-[14%]",
                          alt: business_name %>

          <% else %>

            <i
              data-lucide="percent"
              class="h-[4.5cqw] w-[4.5cqw] text-slate-900"
            ></i>

          <% end %>

        </div>


        <div class="min-w-0">

          <p
            class="truncate font-bold uppercase leading-none tracking-[0.12em] text-white"
            style="font-size: 3cqw;"
          >
            <%= business_name %>
          </p>

          <p
            class="mt-[0.7cqw] font-medium text-white/50"
            style="font-size: 2.2cqw;"
          >
            Book online
          </p>

        </div>

      </div>


      <!-- Offer badge -->
      <div
        class="shrink-0 rounded-full border border-white/10 bg-white/5 px-[2.7cqw] py-[1.4cqw] font-bold uppercase tracking-[0.12em]"
        style="
        color: <%= accent_colour %>;
          font-size: 1.9cqw;
        "
      >
        Special Offer
      </div>

    </div>



    <!-- ========================================= -->
    <!-- MAIN -->
    <!-- ========================================= -->

    <div class="my-auto">

      <!-- Small heading -->
      <p
        class="font-bold uppercase tracking-[0.24em]"
        style="
        color: <%= accent_colour %>;
          font-size: 2.25cqw;
        "
      >
        <%= small_heading %>
      </p>


      <!-- Offer -->
      <div class="mt-[2.5%] flex items-end gap-[3%]">

        <h2
          class="font-black leading-[0.85] tracking-[-0.06em] text-white"
          style="font-size: 13.5cqw;"
        >
          <%= offer %>
        </h2>

      </div>


      <!-- Accent line -->
      <div
        class="mt-[4%] h-[0.7cqw] w-[14%] rounded-full"
        style="background-color: <%= accent_colour %>;"
      ></div>


      <!-- Heading -->
      <h3
        class="mt-[4%] max-w-[80%] font-extrabold leading-[1.05] tracking-[-0.035em] text-white"
        style="font-size: 6cqw;"
      >
        <%= heading %>
      </h3>


      <!-- Description -->
      <p
        class="mt-[3.5%] max-w-[72%] font-medium leading-[1.55] text-white/60"
        style="font-size: 2.8cqw;"
      >
        <%= description %>
      </p>

    </div>



    <!-- ========================================= -->
    <!-- FOOTER -->
    <!-- ========================================= -->

    <div class="flex items-end justify-between gap-[5%]">

      <!-- CTA -->
      <div
        class="inline-flex shrink-0 items-center gap-[1.5cqw] rounded-[1.8cqw] px-[4.5%] py-[2.8%] font-extrabold tracking-[0.03em] text-slate-900 shadow-sm"
        style="
        background-color: <%= accent_colour %>;
          font-size: 2.6cqw;
        "
      >
        <%= button_text %>

        <i
          data-lucide="arrow-up-right"
          class="h-[2.8cqw] w-[2.8cqw]"
        ></i>
      </div>


      <!-- Website -->
      <div class="min-w-0 text-right">

        <p
          class="mb-[0.6cqw] uppercase tracking-[0.14em] text-white/35"
          style="font-size: 1.7cqw;"
        >
          Visit us
        </p>

        <p
          class="truncate font-bold text-white"
          style="font-size: 2.3cqw;"
        >
          <%= website %>
        </p>

      </div>

    </div>

  </div>

</div>