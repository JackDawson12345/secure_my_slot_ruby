<%
  content = post.content || {}
  settings = post.settings || {}

  business_name = content["business_name"].presence || "YOUR BUSINESS"
  small_heading = content["small_heading"].presence || "OUR SERVICES"
  heading = content["heading"].presence || "Service Spotlight"
  description = content["description"].presence || "Discover one of our most popular services and book your appointment online today."
  button_text = content["button_text"].presence || "LEARN MORE"
  website = content["website"].presence || "yourbusiness.co.uk"

  primary_colour = settings["primary_colour"].presence || "#7c3aed"
  accent_colour = settings["accent_colour"].presence || "#c4b5fd"
%>

<!--
  Social Post Template
  Service Spotlight

  Always rendered as a square.
-->
<div
  data-social-post-style-background="primary_colour"
  class="relative aspect-square w-full overflow-hidden bg-slate-950 [container-type:inline-size]"
  style="background-color: <%= primary_colour %>"
>

  <!-- ========================================= -->
  <!-- IMAGE AREA -->
  <!-- ========================================= -->

  <div class="absolute inset-x-0 top-0 h-[52%] overflow-hidden">

    <% if post.respond_to?(:image) && post.image.attached? %>

      <%= image_tag post.image,
                    data: {
                      social_post_image: true
                    },
                    class: "h-full w-full object-cover",
                    alt: heading %>

    <% else %>

      <!-- Preview image gets inserted here -->
      <img
        data-social-post-image
        class="hidden h-full w-full object-cover"
        alt="<%= heading %>"
      >


      <!-- Placeholder -->
      <div
        data-social-post-image-placeholder
        class="relative flex h-full w-full items-center justify-center"
      >

        <!-- Decorative circles -->
        <div class="absolute -right-[8%] -top-[20%] h-[65%] w-[65%] rounded-full bg-white/[0.06]"></div>

        <div class="absolute -bottom-[35%] -left-[10%] h-[70%] w-[70%] rounded-full bg-white/[0.05]"></div>


        <div
          class="flex aspect-square w-[18%] items-center justify-center rounded-[3cqw] bg-white/10 text-white"
        >

          <i
            data-lucide="image"
            class="h-[7cqw] w-[7cqw]"
          ></i>

        </div>

      </div>

    <% end %>


    <!-- Image overlay -->
    <div
      data-social-post-style-gradient="primary_colour"
      class="absolute inset-0"
      style="
      --gradient-colour: <%= primary_colour %>;
        background: linear-gradient(
          to top,
            var(--gradient-colour),
            color-mix(in srgb, var(--gradient-colour), transparent 80%),
            transparent
          );
      "
    ></div>


    <!-- Category -->
    <div
      class="absolute left-[7.5%] top-[8%] rounded-full border border-white/20 bg-slate-950/40 px-[3cqw] py-[1.4cqw] font-bold uppercase tracking-[0.16em] text-white backdrop-blur-sm"
      style="font-size: 1.8cqw;"
    >
      <%= small_heading %>
    </div>

  </div>



  <!-- ========================================= -->
  <!-- CONTENT -->
  <!-- ========================================= -->

  <div class="relative flex h-full flex-col p-[7.5%]">


    <!-- Business -->
    <div class="ml-auto flex items-center gap-[2cqw]">

      <div class="text-right">

        <p
          data-social-post-field="business_name"
          class="font-bold uppercase leading-none tracking-[0.12em] text-white"
          style="font-size: 2.4cqw;"
        >
          <%= business_name %>
        </p>

        <p
          class="mt-[0.7cqw] font-medium text-white/60"
          style="font-size: 1.8cqw;"
        >
          Book online
        </p>

      </div>


      <div
        data-social-post-style-background="primary_colour"
        class="flex aspect-square w-[8cqw] shrink-0 items-center justify-center overflow-hidden rounded-[1.8cqw] text-white"
        style="background-color: <%= primary_colour %>;"
      >


        <% if post.respond_to?(:logo) && post.logo.attached? %>

          <%= image_tag post.logo,
                        data: {
                          social_post_logo: true
                        },
                        class: "h-full w-full object-contain p-[14%]",
                        alt: business_name %>


        <% else %>


          <img
            data-social-post-logo
            class="hidden h-full w-full object-contain p-[14%]"
            alt="<%= business_name %>"
          >


          <i
            data-social-post-logo-placeholder
            data-lucide="sparkles"
            class="h-[3.7cqw] w-[3.7cqw]"
          ></i>


        <% end %>


      </div>

    </div>



    <!-- Spacer -->
    <div class="h-[38%] shrink-0"></div>



    <!-- Main Content -->
    <div>

      <!-- Accent -->
      <div class="flex items-center gap-[2.5%]">

        <div
          data-social-post-style-background="accent_colour"
          class="h-[0.6cqw] w-[9%] rounded-full"
          style="background-color: <%= accent_colour %>;"
        ></div>

        <p
          data-social-post-field="small_heading"
          data-social-post-style-color="accent_colour"
          class="font-bold uppercase tracking-[0.18em]"
          style="
          color: <%= accent_colour %>;
            font-size: 2cqw;
          "
        >
          Featured Service
        </p>

      </div>


      <!-- Heading -->
      <h2
        data-social-post-field="heading"
        class="mt-[3%] max-w-[88%] font-black leading-[0.98] tracking-[-0.045em] text-white"
        style="font-size: 7.4cqw;"
      >
        <%= heading %>
      </h2>


      <!-- Description -->
      <p
        data-social-post-field="description"
        class="mt-[3.5%] max-w-[82%] font-medium leading-[1.5] text-slate-400"
        style="font-size: 2.65cqw;"
      >
        <%= description %>
      </p>

    </div>



    <!-- Footer -->
    <div class="mt-auto flex items-end justify-between gap-[5%]">

      <!-- CTA -->
      <div
        data-social-post-field="button_text"
        data-social-post-style-background="accent_colour"
        class="inline-flex shrink-0 items-center gap-[1.4cqw] rounded-[1.7cqw] px-[4%] py-[2.5%] font-extrabold tracking-[0.04em] text-white"
        style="
        background-color: <%= accent_colour %>;
          font-size: 2.4cqw;
        "
      >
        <%= button_text %>

        <i
          data-lucide="arrow-right"
          class="h-[2.6cqw] w-[2.6cqw]"
        ></i>
      </div>


      <!-- Website -->
      <div class="min-w-0 max-w-[45%] text-right">

        <p
          class="uppercase tracking-[0.14em] text-slate-600"
          style="font-size: 1.5cqw;"
        >
          Find out more
        </p>

        <p
          data-social-post-style-color="accent_colour"
          data-social-post-field="website"
          class="mt-[0.5cqw] truncate font-bold text-white"
          style="font-size: 2.15cqw;
          color: <%= accent_colour %>"
        >
          <%= website %>
        </p>

      </div>

    </div>

  </div>

</div>