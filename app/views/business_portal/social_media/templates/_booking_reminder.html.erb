<%
  content = post.content || {}
  settings = post.settings || {}

  business_name = content["business_name"].presence || "YOUR BUSINESS"
  small_heading = content["small_heading"].presence || "DON'T MISS OUT"
  heading = content["heading"].presence || "Time to Book?"
  description = content["description"].presence || "Appointments can fill up quickly. Book ahead today and secure a time that works for you."
  button_text = content["button_text"].presence || "BOOK ONLINE"
  website = content["website"].presence || "yourbusiness.co.uk"

  primary_colour = settings["primary_colour"].presence || "#0891b2"
  accent_colour = settings["accent_colour"].presence || "#67e8f9"
  background_colour = settings["background_colour"].presence || "#ecfeff"
%>

<!--
  Social Post Template
  Booking Reminder

  Always rendered as a square.
-->
<div
  class="relative aspect-square w-full overflow-hidden [container-type:inline-size]"
  style="background-color: <%= background_colour %>;"
>

  <!-- ========================================= -->
  <!-- BACKGROUND DECORATION -->
  <!-- ========================================= -->

  <!-- Large right panel -->
  <div
    class="pointer-events-none absolute -right-[18%] top-0 h-full w-[58%] -skew-x-12 opacity-[0.07]"
    style="background-color: <%= primary_colour %>;"
  ></div>

  <!-- Top circle -->
  <div
    class="pointer-events-none absolute -right-[8%] -top-[12%] h-[38%] w-[38%] rounded-full opacity-[0.08]"
    style="background-color: <%= primary_colour %>;"
  ></div>

  <!-- Bottom circle -->
  <div
    class="pointer-events-none absolute -bottom-[18%] left-[12%] h-[36%] w-[36%] rounded-full border-[5cqw] opacity-[0.08]"
    style="border-color: <%= primary_colour %>;"
  ></div>

  <!-- Dots -->
  <div class="pointer-events-none absolute right-[8%] top-[45%] grid grid-cols-4 gap-[1.4cqw] opacity-20">

    <% 12.times do %>
      <span
        class="h-[0.75cqw] w-[0.75cqw] rounded-full"
        style="background-color: <%= primary_colour %>;"
      ></span>
    <% end %>

  </div>


  <!-- ========================================= -->
  <!-- CONTENT -->
  <!-- ========================================= -->

  <div class="relative flex h-full flex-col p-[7.5%]">


    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <div class="flex items-center justify-between gap-[4%]">

      <!-- Business -->
      <div class="flex min-w-0 items-center gap-[3cqw]">

        <div
          class="flex aspect-square w-[9.5cqw] shrink-0 items-center justify-center overflow-hidden rounded-[2cqw] text-white"
          style="background-color: <%= primary_colour %>;"
        >

          <% if post.respond_to?(:logo) && post.logo.attached? %>

            <%= image_tag post.logo,
                          class: "h-full w-full object-contain p-[14%]",
                          alt: business_name %>

          <% else %>

            <i
              data-lucide="calendar-clock"
              class="h-[4.5cqw] w-[4.5cqw]"
            ></i>

          <% end %>

        </div>


        <div class="min-w-0">

          <p
            class="truncate font-bold uppercase leading-none tracking-[0.12em] text-slate-900"
            style="font-size: 3cqw;"
          >
            <%= business_name %>
          </p>

          <p
            class="mt-[0.7cqw] font-medium text-slate-500"
            style="font-size: 2.2cqw;"
          >
            Online booking
          </p>

        </div>

      </div>


      <!-- Badge -->
      <div
        class="shrink-0 rounded-full px-[2.8cqw] py-[1.4cqw] font-bold uppercase tracking-[0.14em]"
        style="
        background-color: <%= primary_colour %>12;
          color: <%= primary_colour %>;
          font-size: 1.75cqw;
        "
      >
        Reminder
      </div>

    </div>



    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <div class="my-auto">

      <!-- Calendar Graphic -->
      <div
        class="relative flex aspect-square w-[19%] items-center justify-center rounded-[3cqw] shadow-sm"
        style="background-color: <%= primary_colour %>;"
      >

        <i
          data-lucide="calendar-days"
          class="h-[8cqw] w-[8cqw] text-white"
        ></i>


        <!-- Notification -->
        <div
          class="absolute -right-[1.5cqw] -top-[1.5cqw] flex aspect-square w-[5.5cqw] items-center justify-center rounded-full border-[0.8cqw] font-black"
          style="
          border-color: <%= background_colour %>;
            background-color: <%= accent_colour %>;
            color: #164e63;
            font-size: 2.2cqw;
          "
        >
          !
        </div>

      </div>


      <!-- Small Heading -->
      <p
        class="mt-[5%] font-extrabold uppercase tracking-[0.2em]"
        style="
        color: <%= primary_colour %>;
          font-size: 2.25cqw;
        "
      >
        <%= small_heading %>
      </p>


      <!-- Heading -->
      <h2
        class="mt-[2.5%] max-w-[80%] font-black leading-[0.98] tracking-[-0.05em] text-slate-900"
        style="font-size: 8.2cqw;"
      >
        <%= heading %>
      </h2>


      <!-- Description -->
      <p
        class="mt-[4%] max-w-[70%] font-medium leading-[1.55] text-slate-600"
        style="font-size: 2.9cqw;"
      >
        <%= description %>
      </p>

    </div>



    <!-- ========================================= -->
    <!-- FOOTER -->
    <!-- ========================================= -->

    <div class="flex items-end justify-between gap-[5%]">

      <!-- CTA -->
      <div
        class="inline-flex shrink-0 items-center gap-[1.5cqw] rounded-[1.8cqw] px-[4.5%] py-[2.8%] font-extrabold tracking-[0.04em] text-white shadow-sm"
        style="
        background-color: <%= primary_colour %>;
          font-size: 2.5cqw;
        "
      >
        <%= button_text %>

        <i
          data-lucide="arrow-up-right"
          class="h-[2.7cqw] w-[2.7cqw]"
        ></i>
      </div>


      <!-- Website -->
      <div class="min-w-0 max-w-[43%] text-right">

        <p
          class="uppercase tracking-[0.14em] text-slate-400"
          style="font-size: 1.6cqw;"
        >
          Book your appointment
        </p>

        <p
          class="mt-[0.5cqw] truncate font-bold text-slate-900"
          style="font-size: 2.2cqw;"
        >
          <%= website %>
        </p>

      </div>

    </div>

  </div>

</div>