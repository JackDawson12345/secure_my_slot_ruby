<!-- Social Media Post -->
<main class="p-4 sm:p-6 lg:p-8 bg-[#F8FAFC]">

  <!-- Page heading -->
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>
      <div class="mb-2 flex items-center gap-2 text-sm text-slate-500">
        <span>Social Media</span>
        <i data-lucide="chevron-right" class="h-4 w-4"></i>
        <span class="font-medium text-slate-700">Appointments Available</span>
      </div>

      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Appointments Available
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Your social media post is ready to use.
      </p>
    </div>


    <div class="flex flex-col gap-3 sm:flex-row">

      <%= link_to business_edit_social_media_post_path, class: 'inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50' do %>
        <i data-lucide="pencil" class="h-4 w-4"></i>
        Edit Post
      <% end %>

    </div>

  </section>

  <!-- Main Content -->
  <section class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.05fr)_minmax(400px,0.95fr)]">


    <!-- ========================================= -->
    <!-- POST PREVIEW -->
    <!-- ========================================= -->

    <div
      data-controller="social-download"
      class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
    >

      <!-- Header -->
      <div class="flex items-center justify-between border-b border-slate-200 p-5 sm:p-6">

        <div>
          <h3 class="text-lg font-bold text-slate-900">
            Your Post
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Preview your finished social media design.
          </p>
        </div>


        <button
          type="button"
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition hover:bg-slate-50 hover:text-slate-900"
        >
          <i data-lucide="maximize-2" class="h-4 w-4"></i>
        </button>

      </div>


      <!-- Preview -->
      <div class="bg-slate-100 p-6 sm:p-8 lg:p-10">

        <div class="mx-auto max-w-xl">

          <!-- Generated Social Image -->
          <!-- Preview -->
          <div
            data-social-download-target="post"
            class="aspect-square w-full"
          >

            <%= render "business_portal/social_media/templates/#{@social_post.social_post_template.template_key}",
                       post: @social_post %>

          </div>


          <!-- Image Details -->
          <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

            <div>

              <div class="flex items-center gap-2">

                <p class="text-sm font-semibold text-slate-900">
                  Appointments Available
                </p>

                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Ready
                </span>

              </div>

              <p class="mt-1 text-xs text-slate-500">
                Square Post · 1080 × 1080 · PNG
              </p>

            </div>


            <button
              type="button"
              data-social-download-target="button"
              data-action="click->social-download#download"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
              style="z-index: 999"
            >
              <i data-lucide="download" class="h-4 w-4"></i>
              Download Image
            </button>

          </div>

        </div>

      </div>

    </div>



    <!-- ========================================= -->
    <!-- RIGHT SIDE -->
    <!-- ========================================= -->

    <div class="space-y-6">


      <!-- Caption Generator -->
      <div
        data-controller="social-caption"
        data-social-caption-url="<%= business_generate_social_media_caption_path(@social_post) %>"
        data-social-hashtag-url="<%= business_generate_social_media_hashtags_path(@social_post) %>"
        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
      >

        <div class="border-b border-slate-200 p-5 sm:p-6">

          <div class="flex items-start gap-3">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
              <i data-lucide="sparkles" class="h-5 w-5"></i>
            </div>

            <div>
              <h3 class="font-bold text-slate-900">
                Social Caption
              </h3>

              <p class="mt-1 text-sm leading-6 text-slate-500">
                Create a caption to use alongside your post.
              </p>
            </div>

          </div>

        </div>


        <div class="p-5 sm:p-6">

          <!-- Platform -->
          <div>

            <label class="text-sm font-semibold text-slate-700">
              Create for
            </label>

            <div class="mt-3 grid grid-cols-2 gap-3">

              <button
                type="button"
                data-social-caption-target="platform"
                data-platform="facebook"
                data-action="click->social-caption#selectPlatform"
                class="flex items-center justify-center gap-2 rounded-xl border-2 border-indigo-500 bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-700"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" id="Facebook-1--Streamline-Core" height="16" width="16">
                  <desc>
                    Facebook 1 Streamline Icon: https://streamlinehq.com
                  </desc>
                  <g id="facebook-1--media-facebook-social">
                    <path id="Vector" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M0.5 12.5v-11c0 -0.26522 0.105357 -0.51957 0.292893 -0.707107C0.98043 0.605357 1.23478 0.5 1.5 0.5h11c0.2652 0 0.5196 0.105357 0.7071 0.292893 0.1875 0.187537 0.2929 0.441887 0.2929 0.707107v11c0 0.2652 -0.1054 0.5196 -0.2929 0.7071s-0.4419 0.2929 -0.7071 0.2929h-3V8.76h0.71c0.1618 0 0.3169 -0.06427 0.4313 -0.17866 0.1144 -0.1144 0.1787 -0.26956 0.1787 -0.43134v-0.77c0 -0.08011 -0.0158 -0.15943 -0.0464 -0.23344 -0.0307 -0.07401 -0.0756 -0.14125 -0.1323 -0.1979 -0.0566 -0.05664 -0.1239 -0.10157 -0.1979 -0.13223 -0.074 -0.03065 -0.1533 -0.04643 -0.2334 -0.04643h-0.67v-0.94c0 -0.84 0.38 -0.84 0.76 -0.84h0.49c0.0805 0.00332 0.1607 -0.01109 0.235 -0.04219 0.0743 -0.0311 0.1409 -0.07815 0.195 -0.13781 0.0581 -0.05532 0.1041 -0.12211 0.1351 -0.19612 0.031 -0.07402 0.0463 -0.15365 0.0449 -0.23388v-0.74c0.0027 -0.08143 -0.0107 -0.16259 -0.0395 -0.23883 -0.0287 -0.07625 -0.0721 -0.14609 -0.1279 -0.20553 -0.0557 -0.05943 -0.1226 -0.10731 -0.1968 -0.14088S10.8814 3.00258 10.8 3H9.65c-0.33555 -0.01262 -0.66984 0.04776 -0.97979 0.17696 -0.30994 0.12919 -0.58814 0.32413 -0.81538 0.57134 -0.22725 0.24722 -0.39812 0.54081 -0.50082 0.86051 -0.1027 0.3197 -0.13477 0.65788 -0.09401 0.99119v1.17h-0.64c-0.08094 -0.00133 -0.16134 0.01347 -0.23651 0.04353 -0.07517 0.03006 -0.1436 0.07478 -0.2013 0.13156 -0.05771 0.05678 -0.10354 0.12447 -0.13482 0.19914C6.01609 7.2189 5.99999 7.29905 6 7.38v0.77c-0.00001 0.08095 0.01609 0.1611 0.04737 0.23577 0.03128 0.07467 0.07711 0.14236 0.13482 0.19914 0.0577 0.05678 0.12613 0.1015 0.2013 0.13156 0.07517 0.03006 0.15557 0.04486 0.23651 0.04353h0.64v4.74H1.5c-0.26522 0 -0.51957 -0.1054 -0.707107 -0.2929C0.605357 13.0196 0.5 12.7652 0.5 12.5Z" stroke-width="1"></path>
                  </g>
                </svg>
                Facebook
              </button>

              <button
                type="button"
                data-social-caption-target="platform"
                data-platform="instagram"
                data-action="click->social-caption#selectPlatform"
                class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" id="Instagram--Streamline-Core" height="16" width="16">
                  <desc>
                    Instagram Streamline Icon: https://streamlinehq.com
                  </desc>
                  <g id="instagram">
                    <g id="Group 4546">
                      <path id="Vector" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M10.3332 3.64404c-0.1381 0 -0.25 -0.11193 -0.25 -0.25s0.1119 -0.25 0.25 -0.25" stroke-width="1"></path>
                      <path id="Vector_2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M10.3332 3.64404c0.1381 0 0.25 -0.11193 0.25 -0.25s-0.1119 -0.25 -0.25 -0.25" stroke-width="1"></path>
                    </g>
                    <path id="Rectangle 2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M0.858276 3.43141c0 -1.42103 1.151974 -2.573012 2.573014 -2.573012h6.86141c1.421 0 2.573 1.151982 2.573 2.573012v6.86139c0 1.421 -1.152 2.573 -2.573 2.573H3.43129c-1.42104 0 -2.573014 -1.152 -2.573014 -2.573V3.43141Z" stroke-width="1"></path>
                    <path id="Ellipse 11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M4.312 6.862a2.55 2.55 0 1 0 5.1 0 2.55 2.55 0 1 0 -5.1 0" stroke-width="1"></path>
                  </g>
                </svg>
                Instagram
              </button>

            </div>

          </div>


          <!-- Tone -->
          <div class="mt-6">

            <label class="text-sm font-semibold text-slate-700">
              Tone
            </label>

            <div class="mt-3 flex flex-wrap gap-2">

              <button
                type="button"
                data-social-caption-target="tone"
                data-tone="friendly"
                data-action="click->social-caption#selectTone"
                class="rounded-full bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:border-indigo-600"
              >
                Friendly
              </button>

              <button
                type="button"
                data-social-caption-target="tone"
                data-tone="professional"
                data-action="click->social-caption#selectTone"
                class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:border-indigo-600"
              >
                Professional
              </button>

              <button
                type="button"
                data-social-caption-target="tone"
                data-tone="promotional"
                data-action="click->social-caption#selectTone"
                class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:border-indigo-600"
              >
                Promotional
              </button>

              <button
                type="button"
                data-social-caption-target="tone"
                data-tone="casual"
                data-action="click->social-caption#selectTone"
                class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:border-indigo-600"
              >
                Casual
              </button>

            </div>

          </div>


          <!-- Generate -->
          <button
            type="button"
            data-social-caption-target="button"
            data-action="click->social-caption#generate"
            class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
          >
            <i data-lucide="sparkles" class="h-4 w-4"></i>
            Generate Caption
          </button>


          <!-- Generated Result -->
          <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-4">

            <div class="flex items-center justify-between gap-4">

              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                Your Caption
              </p>

              <button
                type="button"
                data-social-caption-target="regenerateButton"
                data-action="click->social-caption#generate"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-700"
              >
                <i data-lucide="refresh-cw" class="h-3.5 w-3.5"></i>
                Regenerate
              </button>

            </div>


            <p
              data-social-caption-target="result"
              class="mt-3 text-sm leading-6 text-slate-700"
            >
              Click generate caption to create your social media content.
            </p>


            <div class="mt-4 rounded-xl border border-indigo-100 bg-indigo-50 p-4">

              <div class="flex items-center justify-between gap-4">

                <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
                  Hashtags
                </p>


                <button
                  type="button"
                  data-social-caption-target="hashtagButton"
                  data-action="click->social-caption#generateHashtags"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-700"
                >

                  <i data-lucide="hash" class="h-3.5 w-3.5"></i>

                  Generate

                </button>

              </div>


              <p
                data-social-caption-target="hashtags"
                class="mt-3 text-sm font-medium leading-6 text-indigo-600"
              >
                Click generate to create relevant hashtags.
              </p>


            </div>


            <div class="mt-4 flex items-center justify-between border-t border-slate-200 pt-4">

              <span
                data-social-caption-target="counter"
                class="text-xs text-slate-400"
              >
              0 characters
            </span>

              <button
                type="button"
                data-social-caption-target="copyButton"
                data-action="click->social-caption#copy"
                disabled
                class="inline-flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-xs font-semibold text-slate-400 shadow-sm ring-1 ring-slate-200 transition disabled:cursor-not-allowed disabled:opacity-50"
              >
                <i data-lucide="copy" class="h-3.5 w-3.5"></i>
                Copy Caption
              </button>

            </div>

          </div>

        </div>

      </div>



      <!-- Post Details -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <div class="border-b border-slate-200 p-5 sm:p-6">
          <h3 class="font-bold text-slate-900">
            Post Details
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Information about this design.
          </p>
        </div>


        <div class="divide-y divide-slate-100 px-5 sm:px-6">

          <div class="flex items-center justify-between gap-4 py-4">

            <div class="flex items-center gap-3">
              <i data-lucide="layout-template" class="h-4 w-4 text-slate-400"></i>
              <span class="text-sm text-slate-500">Template</span>
            </div>

            <span class="text-sm font-semibold text-slate-900">
              Appointments Available
            </span>

          </div>


          <div class="flex items-center justify-between gap-4 py-4">

            <div class="flex items-center gap-3">
              <i data-lucide="ratio" class="h-4 w-4 text-slate-400"></i>
              <span class="text-sm text-slate-500">Size</span>
            </div>

            <span class="text-sm font-semibold text-slate-900">
              1080 × 1080
            </span>

          </div>


          <div class="flex items-center justify-between gap-4 py-4">

            <div class="flex items-center gap-3">
              <i data-lucide="calendar-days" class="h-4 w-4 text-slate-400"></i>
              <span class="text-sm text-slate-500">Created</span>
            </div>

            <span class="text-sm font-semibold text-slate-900">
              21 Sep 2026
            </span>

          </div>


          <div class="flex items-center justify-between gap-4 py-4">

            <div class="flex items-center gap-3">
              <i data-lucide="file-image" class="h-4 w-4 text-slate-400"></i>
              <span class="text-sm text-slate-500">Format</span>
            </div>

            <span class="text-sm font-semibold text-slate-900">
              PNG
            </span>

          </div>

        </div>

      </div>

    </div>

  </section>

  <!-- ========================================= -->
  <!-- MORE ACTIONS -->
  <!-- ========================================= -->

  <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

    <div class="border-b border-slate-200 p-5 sm:p-6">

      <h3 class="text-lg font-bold text-slate-900">
        More Actions
      </h3>

      <p class="mt-1 text-sm text-slate-500">
        Continue working with this post.
      </p>

    </div>


    <div class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6 lg:grid-cols-3">

      <%= link_to business_edit_social_media_post_path, class: 'group flex items-center gap-4 rounded-2xl border border-slate-200 p-4 text-left transition hover:border-indigo-200 hover:bg-indigo-50/50' do %>
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
          <i data-lucide="pencil" class="h-5 w-5"></i>
        </div>

        <div class="min-w-0 flex-1">
          <p class="font-semibold text-slate-900">
            Edit Post
          </p>

          <p class="mt-1 text-xs leading-5 text-slate-500">
            Change the content or design.
          </p>
        </div>

        <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
      <% end %>

      <!-- Duplicate -->
      <%= link_to business_duplicate_social_media_post_path(@social_post),
                  data: { turbo_method: :patch },
                  class: 'group flex items-center gap-4 rounded-2xl border border-slate-200 p-4 text-left transition hover:border-indigo-200 hover:bg-indigo-50/50' do %>
        <div class="flex h-11 w-11 shrink-0 flex items-center justify-center rounded-xl bg-violet-50 text-violet-600">
          <i data-lucide="copy-plus" class="h-5 w-5"></i>
        </div>

        <div class="min-w-0 flex-1">
          <p class="font-semibold text-slate-900">
            Duplicate Post
          </p>

          <p class="mt-1 text-xs leading-5 text-slate-500">
            Use this post as a starting point.
          </p>
        </div>

        <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
      <% end %>


      <!-- New -->
      <%= link_to business_new_social_media_post_path, class: 'group flex items-center gap-4 rounded-2xl border border-slate-200 p-4 text-left transition hover:border-indigo-200 hover:bg-indigo-50/50' do %>
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cyan-50 text-cyan-600">
          <i data-lucide="plus" class="h-5 w-5"></i>
        </div>

        <div class="min-w-0 flex-1">
          <p class="font-semibold text-slate-900">
            Create Another
          </p>

          <p class="mt-1 text-xs leading-5 text-slate-500">
            Choose another design to customise.
          </p>
        </div>

        <i data-lucide="chevron-right" class="h-5 w-5 text-slate-400"></i>
      <% end %>

    </div>

  </section>

</main>