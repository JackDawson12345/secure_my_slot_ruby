<!-- Social Media content -->
<div class="relative">

  <div class="<%= 'pointer-events-none opacity-50' unless current_user.business.feature_enabled?(:social_media) %>">

    <main class="p-4 sm:p-6 lg:p-8">

      <!-- Page heading -->
      <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Social Media
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Create and manage social media content for your business.
          </p>
        </div>

        <%= link_to business_new_social_media_post_path, class: 'inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto' do %>
          <i data-lucide="plus" class="h-4 w-4"></i>
          Create post
        <% end %>

      </section>


      <!-- Statistics -->
      <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-2">

        <!-- Total Posts -->
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">

            <div>
              <p class="text-sm font-medium text-slate-500">
                Total Posts
              </p>

              <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
                <%= @social_posts.count %>
              </p>
            </div>

            <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
              <i data-lucide="panels-top-left" class="h-5 w-5"></i>
            </div>

          </div>

          <p class="mt-4 text-sm text-slate-500">
            All social posts you've created
          </p>
        </article>


        <!-- This Month -->
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">

            <div>
              <p class="text-sm font-medium text-slate-500">
                This Month
              </p>

              <p class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
                <%= @posts_this_month %>
              </p>
            </div>

            <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
              <i data-lucide="calendar-days" class="h-5 w-5"></i>
            </div>

          </div>

          <p class="mt-4 text-sm text-slate-500">
            Created during <%= Time.current.strftime("%B") %>
          </p>
        </article>

      </section>


      <!-- Posts panel -->
      <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

        <!-- Toolbar -->
        <div class="border-b border-slate-200 p-5 sm:p-6">

          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

            <div>
              <h3 class="text-lg font-bold text-slate-900">
                Your Posts
              </h3>

              <p class="mt-1 text-sm text-slate-500">
                View, edit and manage your social media content.
              </p>
            </div>


            <div class="flex flex-col gap-3 sm:flex-row">

              <!-- Search -->
              <div class="relative min-w-0 sm:w-72">

                <i
                  data-lucide="search"
                  class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                ></i>

                <input
                  type="search"
                  placeholder="Search posts..."
                  class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                >

              </div>


              <!-- Filter -->
              <button
                type="button"
                class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
              >
                <i data-lucide="list-filter" class="h-4 w-4 text-slate-400"></i>
                Filter
              </button>

            </div>

          </div>

        </div>


        <!-- Post grid -->
        <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-6 xl:grid-cols-3">


          <% @social_posts.each do |post| %>
            <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-md">

              <!-- Post Preview -->
              <div class="relative aspect-square bg-slate-100">

                <%= render "business_portal/social_media/templates/#{post.social_post_template.template_key}",
                           post: post %>

              </div>


              <!-- Details -->
              <div class="p-5">
                <h4 class="font-bold text-slate-900">
                  <%= post.social_post_template.name %>
                </h4>

                <!-- Platform -->
                <div class="mt-4 flex flex-wrap gap-2">

              <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" id="Facebook-1--Streamline-Core" height="14" width="14">
                  <desc>
                    Facebook 1 Streamline Icon: https://streamlinehq.com
                  </desc>
                  <g id="facebook-1--media-facebook-social">
                    <path id="Vector" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M0.5 12.5v-11c0 -0.26522 0.105357 -0.51957 0.292893 -0.707107C0.98043 0.605357 1.23478 0.5 1.5 0.5h11c0.2652 0 0.5196 0.105357 0.7071 0.292893 0.1875 0.187537 0.2929 0.441887 0.2929 0.707107v11c0 0.2652 -0.1054 0.5196 -0.2929 0.7071s-0.4419 0.2929 -0.7071 0.2929h-3V8.76h0.71c0.1618 0 0.3169 -0.06427 0.4313 -0.17866 0.1144 -0.1144 0.1787 -0.26956 0.1787 -0.43134v-0.77c0 -0.08011 -0.0158 -0.15943 -0.0464 -0.23344 -0.0307 -0.07401 -0.0756 -0.14125 -0.1323 -0.1979 -0.0566 -0.05664 -0.1239 -0.10157 -0.1979 -0.13223 -0.074 -0.03065 -0.1533 -0.04643 -0.2334 -0.04643h-0.67v-0.94c0 -0.84 0.38 -0.84 0.76 -0.84h0.49c0.0805 0.00332 0.1607 -0.01109 0.235 -0.04219 0.0743 -0.0311 0.1409 -0.07815 0.195 -0.13781 0.0581 -0.05532 0.1041 -0.12211 0.1351 -0.19612 0.031 -0.07402 0.0463 -0.15365 0.0449 -0.23388v-0.74c0.0027 -0.08143 -0.0107 -0.16259 -0.0395 -0.23883 -0.0287 -0.07625 -0.0721 -0.14609 -0.1279 -0.20553 -0.0557 -0.05943 -0.1226 -0.10731 -0.1968 -0.14088S10.8814 3.00258 10.8 3H9.65c-0.33555 -0.01262 -0.66984 0.04776 -0.97979 0.17696 -0.30994 0.12919 -0.58814 0.32413 -0.81538 0.57134 -0.22725 0.24722 -0.39812 0.54081 -0.50082 0.86051 -0.1027 0.3197 -0.13477 0.65788 -0.09401 0.99119v1.17h-0.64c-0.08094 -0.00133 -0.16134 0.01347 -0.23651 0.04353 -0.07517 0.03006 -0.1436 0.07478 -0.2013 0.13156 -0.05771 0.05678 -0.10354 0.12447 -0.13482 0.19914C6.01609 7.2189 5.99999 7.29905 6 7.38v0.77c-0.00001 0.08095 0.01609 0.1611 0.04737 0.23577 0.03128 0.07467 0.07711 0.14236 0.13482 0.19914 0.0577 0.05678 0.12613 0.1015 0.2013 0.13156 0.07517 0.03006 0.15557 0.04486 0.23651 0.04353h0.64v4.74H1.5c-0.26522 0 -0.51957 -0.1054 -0.707107 -0.2929C0.605357 13.0196 0.5 12.7652 0.5 12.5Z" stroke-width="1"></path>
                  </g>
                </svg>
                Facebook
              </span>

                  <span class="inline-flex items-center gap-1.5 rounded-full bg-pink-50 px-3 py-1 text-xs font-semibold text-pink-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" id="Instagram--Streamline-Core" height="14" width="14">
                  <desc>
                    Instagram Streamline Icon: https://streamlinehq.com
                  </desc>
                  <g id="instagram">
                    <g id="Group 4546">
                      <path id="Vector" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M10.3332 3.64404c-0.1381 0 -0.25 -0.11193 -0.25 -0.25s0.1119 -0.25 0.25 -0.25" stroke-width="1"></path>
                      <path id="Vector_2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M10.3332 3.64404c0.1381 0 0.25 -0.11193 0.25 -0.25s-0.1119 -0.25 -0.25 -0.25" stroke-width="1"></path>
                    </g>
                    <path id="Rectangle 2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M0.858276 3.43141c0 -1.42103 1.151974 -2.573012 2.573014 -2.573012h6.86141c1.421 0 2.573 1.151982 2.573 2.573012v6.86139c0 1.421 -1.152 2.573 -2.573 2.573H3.43129c-1.42104 0 -2.573014 -1.152 -2.573014 -2.573V3.43141Z" stroke-width="1"></path>
                    <path id="Ellipse 11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M4.312 6.862a2.55 2.55 0 1 0 5.1 0 2.55 2.55 0 1 0 -5.1 0" stroke-width="1"></path>
                  </g>
                </svg>
                Instagram
              </span>

                </div>


                <!-- Meta -->
                <div class="mt-5 grid grid-cols-2 gap-3">

                  <div class="rounded-xl bg-slate-50 p-3">
                    <p class="text-xs font-medium text-slate-500">
                      Created
                    </p>

                    <p class="mt-1 text-sm font-semibold text-slate-900">
                      <%= post.created_at.strftime("%d %b %Y") %>
                    </p>
                  </div>

                  <div class="rounded-xl bg-slate-50 p-3">
                    <p class="text-xs font-medium text-slate-500">
                      Format
                    </p>

                    <p class="mt-1 text-sm font-semibold text-slate-900">
                      Square Post
                    </p>
                  </div>

                </div>


                <!-- Footer -->
                <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">

                  <%= link_to business_show_social_media_post_path(post), class: 'text-sm font-semibold text-slate-500 transition hover:text-slate-700' do %>
                    View post
                  <% end %>

                  <%= link_to business_edit_social_media_post_path(post), class: 'inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 transition hover:text-indigo-700' do %>
                    Edit post
                    <i data-lucide="arrow-right" class="h-4 w-4"></i>
                  <% end %>

                </div>

              </div>

            </article>
          <% end %>


          <!-- Create New Card -->

          <%= link_to business_new_social_media_post_path, class: 'flex min-h-96 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-6 text-center transition hover:border-indigo-300 hover:bg-indigo-50' do %>
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-indigo-600 shadow-sm">
              <i data-lucide="plus" class="h-6 w-6"></i>
            </div>

            <p class="mt-4 font-bold text-slate-900">
              Create a new post
            </p>

            <p class="mt-2 max-w-xs text-sm leading-6 text-slate-500">
              Create content and graphics ready to use across your social media channels.
            </p>
          <% end %>

        </div>

      </section>

    </main>
  </div>

  <% unless current_user.business.feature_enabled?(:social_media) %>
    <%= render 'business_portal/shared/upgrade_overlay',
               title: 'Create Social Media Posts',
               message: 'Upgrade to Pro or Pro Plus to create branded social media posts for your business.'
    %>
  <% end %>
</div>