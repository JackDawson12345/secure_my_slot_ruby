<%# app/views/business_portal/blocked_times/index.html.erb %>

<main class="p-4 sm:p-6 lg:p-8">
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Blocked Times
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Prevent customers from booking during holidays, appointments or unavailable periods.
      </p>
    </div>

  </section>

  <section class="mt-8 flex flex-col gap-4 rounded-2xl border border-indigo-100 bg-indigo-50 p-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-start gap-3">
      <div class="rounded-xl bg-indigo-100 p-2.5 text-indigo-600">
        <i data-lucide="info" class="h-5 w-5"></i>
      </div>

      <div>
        <h3 class="font-semibold text-indigo-950">
          How blocked times work
        </h3>

        <p class="mt-1 max-w-3xl text-sm leading-6 text-indigo-700">
          Blocked periods are removed from your booking availability. Customers
          will not be able to select appointment times that overlap with them.
        </p>
      </div>
    </div>

    <%= link_to business_opening_hours_path, class: 'inline-flex w-fit items-center gap-2 text-sm font-semibold text-indigo-700 hover:text-indigo-900' do %>
      View opening hours
      <i data-lucide="arrow-right" class="h-4 w-4"></i>
    <% end %>

  </section>

  <div class="mt-8 grid gap-8 xl:grid-cols-[1fr_360px]">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-col gap-4 border-b border-slate-200 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div>
          <h3 class="text-lg font-bold text-slate-900">
            Upcoming blocked times
          </h3>

          <p class="mt-1 text-sm text-slate-500">
            Review and manage your upcoming unavailable periods.
          </p>
        </div>


      </div>

      <div class="divide-y divide-slate-100">
        <% if @upcoming_blocked_times.any? %>
          <% @upcoming_blocked_times.each do |blocked_time| %>
            <article class="p-5 transition hover:bg-slate-50 sm:p-6">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex items-start gap-4">
                  <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-rose-50 text-rose-700">
              <span class="text-xs font-bold uppercase tracking-wide">
                <%= blocked_time.starts_at.strftime("%b") %>
              </span>

                    <span class="text-xl font-bold leading-none">
                      <%= blocked_time.starts_at.strftime("%d") %>
                    </span>
                  </div>

                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="font-bold text-slate-900">
                        <%= blocked_time.title %>
                      </h4>

                      <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= blocked_time.all_day? ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-700" %>">
                        <%= blocked_time.all_day? ? "All day" : "Partial day" %>
                      </span>
                    </div>

                    <div class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500">
                <span class="inline-flex items-center gap-1.5">
                  <i data-lucide="calendar" class="h-4 w-4"></i>

                  <% if blocked_time.starts_at.to_date == blocked_time.ends_at.to_date %>
                    <%= blocked_time.starts_at.strftime("%A, %-d %B %Y") %>
                  <% else %>
                    <%= blocked_time.starts_at.strftime("%-d %B %Y") %>
                    to
                    <%= blocked_time.ends_at.strftime("%-d %B %Y") %>
                  <% end %>
                </span>

                      <span class="inline-flex items-center gap-1.5">
                        <i data-lucide="clock-3" class="h-4 w-4"></i>

                        <% if blocked_time.all_day? %>
                          All day
                        <% else %>
                          <%= blocked_time.starts_at.strftime("%-I:%M %p") %>
                          to
                          <%= blocked_time.ends_at.strftime("%-I:%M %p") %>
                        <% end %>
                      </span>
                    </div>

                    <% if blocked_time.notes.present? %>
                      <p class="mt-3 text-sm leading-6 text-slate-600">
                        <%= blocked_time.notes %>
                      </p>
                    <% end %>
                  </div>
                </div>

                <div class="flex shrink-0 items-center gap-2">
                  <%= link_to(
                        business_edit_blocked_time_path(blocked_time),
                        class: "inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-500 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700",
                        aria: { label: "Edit blocked time" }
                      ) do %>
                    <i data-lucide="pencil" class="h-4 w-4"></i>
                  <% end %>

                  <%= button_to(
                        business_blocked_time_path(blocked_time),
                        method: :delete,
                        form: {
                          data: {
                            turbo_confirm: "Remove this blocked time?"
                          }
                        },
                        class: "inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-500 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600",
                        aria: { label: "Delete blocked time" }
                      ) do %>
                    <i data-lucide="trash-2" class="h-4 w-4"></i>
                  <% end %>
                </div>
              </div>
            </article>
          <% end %>
        <% else %>
          <div class="px-5 py-16 text-center sm:px-6">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
              <i data-lucide="calendar-check" class="h-6 w-6"></i>
            </div>

            <h4 class="mt-4 font-bold text-slate-900">
              No blocked times
            </h4>

            <p class="mx-auto mt-1 max-w-sm text-sm leading-6 text-slate-500">
              Your normal opening hours are currently available for customer
              bookings.
            </p>
          </div>
        <% end %>
      </div>


    </section>

    <aside class="space-y-6">
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold text-slate-900">
              Add blocked time
            </h3>

            <p class="mt-1 text-sm leading-6 text-slate-500">
              Create a new period when bookings should be unavailable.
            </p>
          </div>

          <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
            <i data-lucide="calendar-x" class="h-5 w-5"></i>
          </div>
        </div>

        <%= form_with(
              model: @blocked_time,
              url: business_create_blocked_time_path,
              class: "mt-6 space-y-5"
            ) do |form| %>

          <% if @blocked_time.errors.any? %>
            <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
              <ul class="list-disc space-y-1 pl-5 text-sm text-rose-700">
                <% @blocked_time.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= form.label(
                  :title,
                  "Reason",
                  class: "block text-sm font-semibold text-slate-700"
                ) %>

            <%= form.text_field(
                  :title,
                  placeholder: "For example, holiday",
                  class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                ) %>
          </div>

          <% all_day_checked = if @blocked_time.errors.any?
                                 @blocked_time.all_day?
                               else
                                 @blocked_time.new_record? ? true : @blocked_time.all_day?
                               end %>

          <div data-blocked-time-form>
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4">
              <%= form.check_box(
                    :all_day,
                    { checked: all_day_checked,
                      class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500",
                      data: { blocked_time_all_day: true } },
                    "1",
                    "0"
                  ) %>

              <span>
                <span class="block text-sm font-semibold text-slate-700">
                  All day
                </span>

                <span class="mt-0.5 block text-xs text-slate-500">
                  Block the entire selected day.
                </span>
              </span>
            </label>

            <div class="mt-5">
              <%= form.label(
                    :date,
                    all_day_checked ? "Date" : "Start date",
                    class: "block text-sm font-semibold text-slate-700",
                    data: { blocked_time_date_label: true }
                  ) %>

              <%= form.date_field(
                    :date,
                    value: @blocked_time.date ||
                      @blocked_time.starts_at&.to_date,
                    class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100",
                    data: { blocked_time_start_date: true }
                  ) %>
            </div>

            <div
              class="mt-5 space-y-5 <%= 'hidden' if all_day_checked %>"
              data-blocked-time-range-fields
            >
              <div>
                <%= form.label(
                      :end_date,
                      "End date",
                      class: "block text-sm font-semibold text-slate-700"
                    ) %>

                <%= form.date_field(
                      :end_date,
                      value: @blocked_time.end_date ||
                        @blocked_time.ends_at&.to_date,
                      class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100",
                      data: { blocked_time_end_date: true }
                    ) %>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <%= form.label(
                        :start_time,
                        "Start time",
                        class: "block text-sm font-semibold text-slate-700"
                      ) %>

                  <%= form.time_field(
                        :start_time,
                        value: @blocked_time.start_time ||
                          @blocked_time.starts_at&.strftime("%H:%M"),
                        class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100",
                        data: { blocked_time_start_time: true }
                      ) %>
                </div>

                <div>
                  <%= form.label(
                        :end_time,
                        "End time",
                        class: "block text-sm font-semibold text-slate-700"
                      ) %>

                  <%= form.time_field(
                        :end_time,
                        value: @blocked_time.end_time ||
                          @blocked_time.ends_at&.strftime("%H:%M"),
                        class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100",
                        data: { blocked_time_end_time: true }
                      ) %>
                </div>
              </div>
            </div>
          </div>

          <div>
            <%= form.label(
              :notes,
              class: "block text-sm font-semibold text-slate-700"
            ) do %>
              Notes
              <span class="font-normal text-slate-400">
        Optional
      </span>
            <% end %>

            <%= form.text_area(
                  :notes,
                  rows: 3,
                  placeholder: "Add any internal information",
                  class: "mt-2 block w-full resize-none rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                ) %>
          </div>

          <%= form.button(
            type: "submit",
            class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
          ) do %>
            <i data-lucide="plus" class="h-4 w-4"></i>
            Add blocked time
          <% end %>
        <% end %>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900">
          Availability summary
        </h3>

        <p class="mt-1 text-sm text-slate-500">
          An overview of your current blocked periods.
        </p>

        <div class="mt-5 grid grid-cols-1 gap-3">
          <div class="rounded-xl bg-slate-50 p-4">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-white text-indigo-600 shadow-sm">
              <i data-lucide="calendar-x-2" class="h-4 w-4"></i>
            </div>

            <p class="mt-4 text-2xl font-bold text-slate-900">
              <%= @upcoming_blocked_times.count %>
            </p>

            <p class="mt-1 text-xs font-medium text-slate-500">
              Upcoming blocks
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-amber-100 p-2.5 text-amber-700">
            <i data-lucide="triangle-alert" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="font-semibold text-amber-950">
              Existing bookings
            </h3>

            <p class="mt-1 text-sm leading-6 text-amber-800">
              Blocking a time will not automatically cancel bookings that have
              already been confirmed.
            </p>

            <%= link_to business_bookings_path, class: 'mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-amber-900 hover:text-amber-700' do %>
              View bookings
              <i data-lucide="arrow-right" class="h-4 w-4"></i>
            <% end %>

          </div>
        </div>
      </section>
    </aside>
  </div>
</main>
<script>
    (() => {
        const initialiseBlockedTimeForms = () => {
            document.querySelectorAll("[data-blocked-time-form]").forEach((container) => {
                if (container.dataset.initialised === "true") return;

                const allDay = container.querySelector("[data-blocked-time-all-day]");
                const dateLabel = container.querySelector("[data-blocked-time-date-label]");
                const startDate = container.querySelector("[data-blocked-time-start-date]");
                const endDate = container.querySelector("[data-blocked-time-end-date]");
                const startTime = container.querySelector("[data-blocked-time-start-time]");
                const endTime = container.querySelector("[data-blocked-time-end-time]");
                const rangeFields = container.querySelector("[data-blocked-time-range-fields]");

                if (!allDay || !startDate || !endDate || !rangeFields) return;

                const updateFields = () => {
                    if (allDay.checked) {
                        rangeFields.classList.add("hidden");
                        dateLabel.textContent = "Date";

                        endDate.value = startDate.value;
                        if (startTime) startTime.value = "00:00";
                        if (endTime) endTime.value = "23:59";
                    } else {
                        rangeFields.classList.remove("hidden");
                        dateLabel.textContent = "Start date";

                        if (!endDate.value) endDate.value = startDate.value;
                        if (startTime && !startTime.value) startTime.value = "09:00";
                        if (endTime && !endTime.value) endTime.value = "17:00";
                    }
                };

                allDay.addEventListener("change", updateFields);

                startDate.addEventListener("change", () => {
                    if (allDay.checked || !endDate.value) {
                        endDate.value = startDate.value;
                    }
                });

                container.dataset.initialised = "true";
                updateFields();
            });
        };

        document.addEventListener("turbo:load", initialiseBlockedTimeForms);
        document.addEventListener("DOMContentLoaded", initialiseBlockedTimeForms);
    })();
</script>
