<%# app/views/business_portal/blocked_times/edit.html.erb %>

<main class="p-4 sm:p-6 lg:p-8">
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <%= link_to(
            business_blocked_times_path,
            class: "mb-3 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-indigo-700"
          ) do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Back to blocked times
      <% end %>

      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Edit Blocked Time
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Update the unavailable date, time or internal details.
      </p>
    </div>
  </section>

  <% if flash[:alert].present? %>
    <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-medium text-rose-700">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="mt-8 grid gap-8 xl:grid-cols-[1fr_340px]">
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-5 sm:px-6">
        <h3 class="text-lg font-bold text-slate-900">
          Blocked time details
        </h3>

        <p class="mt-1 text-sm text-slate-500">
          Changes will immediately affect the appointment times customers can book.
        </p>
      </div>

      <div class="p-5 sm:p-6">
        <%= form_with(
              model: @blocked_time,
              url: business_blocked_time_path(@blocked_time),
              method: :patch,
              class: "space-y-6"
            ) do |form| %>

          <% if @blocked_time.errors.any? %>
            <section class="rounded-xl border border-rose-200 bg-rose-50 p-4">
              <h4 class="font-semibold text-rose-800">
                The blocked time could not be updated
              </h4>

              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-rose-700">
                <% @blocked_time.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </section>
          <% end %>

          <div>
            <%= form.label(
                  :title,
                  "Reason",
                  class: "block text-sm font-semibold text-slate-700"
                ) %>

            <%= form.text_field(
                  :title,
                  placeholder: "For example, holiday",
                  class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                ) %>
          </div>

          <div>
            <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-200 hover:bg-indigo-50/50">
              <%= form.check_box(
                    :all_day,
                    class: "mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                  ) %>

              <span>
                <span class="block text-sm font-semibold text-slate-700">
                  All-day block
                </span>

                <span class="mt-1 block text-xs leading-5 text-slate-500">
                  Block all appointment availability across the selected date or date range.
                </span>
              </span>
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <%= form.label(
                    :date,
                    "Start date",
                    class: "block text-sm font-semibold text-slate-700"
                  ) %>

              <%= form.date_field(
                    :date,
                    value: @blocked_time.date.presence ||
                      @blocked_time.starts_at&.to_date,
                    class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                  ) %>
            </div>

            <div>
              <%= form.label(
                    :end_date,
                    "End date",
                    class: "block text-sm font-semibold text-slate-700"
                  ) %>

              <%= form.date_field(
                    :end_date,
                    value: @blocked_time.end_date.presence ||
                      @blocked_time.ends_at&.to_date,
                    class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                  ) %>

              <p class="mt-1.5 text-xs text-slate-400">
                Leave this the same as the start date for a single-day block.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= form.label(
                    :start_time,
                    "Start time",
                    class: "block text-sm font-semibold text-slate-700"
                  ) %>

              <%= form.time_field(
                    :start_time,
                    value: @blocked_time.start_time.presence ||
                      @blocked_time.starts_at&.strftime("%H:%M"),
                    class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                  ) %>
            </div>

            <div>
              <%= form.label(
                    :end_time,
                    "End time",
                    class: "block text-sm font-semibold text-slate-700"
                  ) %>

              <%= form.time_field(
                    :end_time,
                    value: @blocked_time.end_time.presence ||
                      @blocked_time.ends_at&.strftime("%H:%M"),
                    class: "mt-2 block w-full rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                  ) %>
            </div>
          </div>

          <div>
            <%= form.label(
              :notes,
              class: "block text-sm font-semibold text-slate-700"
            ) do %>
              Notes
              <span class="font-normal text-slate-400">
                Optional
              </span>
            <% end %>

            <%= form.text_area(
                  :notes,
                  rows: 4,
                  placeholder: "Add any internal information",
                  class: "mt-2 block w-full resize-none rounded-xl border border-slate-200 px-3.5 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
                ) %>
          </div>

          <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
            <%= link_to(
                  "Cancel",
                  business_blocked_times_path,
                  class: "inline-flex items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-200 hover:bg-indigo-50 hover:text-indigo-700"
                ) %>

            <%= form.button(
              type: "submit",
              class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
            ) do %>
              <i data-lucide="save" class="h-4 w-4"></i>
              Save changes
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <aside class="space-y-6">
      <section class="rounded-2xl border border-indigo-100 bg-indigo-50 p-5">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-indigo-100 p-2.5 text-indigo-600">
            <i data-lucide="info" class="h-5 w-5"></i>
          </div>

          <div>
            <h3 class="font-semibold text-indigo-950">
              Booking availability
            </h3>

            <p class="mt-1 text-sm leading-6 text-indigo-700">
              Appointment slots overlapping this blocked period will be removed
              from the customer booking page.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900">
          Current block
        </h3>

        <div class="mt-5 space-y-4">
          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-slate-100 p-2 text-slate-500">
              <i data-lucide="calendar" class="h-4 w-4"></i>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Date
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-700">
                <% if @blocked_time.starts_at.to_date == @blocked_time.ends_at.to_date %>
                  <%= @blocked_time.starts_at.strftime("%A, %-d %B %Y") %>
                <% else %>
                  <%= @blocked_time.starts_at.strftime("%-d %B %Y") %>
                  to
                  <%= @blocked_time.ends_at.strftime("%-d %B %Y") %>
                <% end %>
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="rounded-lg bg-slate-100 p-2 text-slate-500">
              <i data-lucide="clock-3" class="h-4 w-4"></i>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Time
              </p>

              <p class="mt-1 text-sm font-semibold text-slate-700">
                <% if @blocked_time.all_day? %>
                  All day
                <% else %>
                  <%= @blocked_time.starts_at.strftime("%-I:%M %p") %>
                  to
                  <%= @blocked_time.ends_at.strftime("%-I:%M %p") %>
                <% end %>
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="rounded-2xl border border-rose-200 bg-rose-50 p-5">
        <div class="flex items-start gap-3">
          <div class="rounded-xl bg-rose-100 p-2.5 text-rose-600">
            <i data-lucide="trash-2" class="h-5 w-5"></i>
          </div>

          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-rose-950">
              Delete blocked time
            </h3>

            <p class="mt-1 text-sm leading-6 text-rose-700">
              Removing this block will make the affected times available for
              new bookings again.
            </p>

            <%= button_to(
                  business_delete_blocked_time_path(@blocked_time),
                  method: :delete,
                  form: {
                    class: "mt-4",
                    data: {
                      turbo_confirm: "Are you sure you want to delete this blocked time?"
                    }
                  },
                  class: "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-rose-300 bg-white px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100"
                ) do %>
              <i data-lucide="trash-2" class="h-4 w-4"></i>
              Delete blocked time
            <% end %>
          </div>
        </div>
      </section>
    </aside>
  </div>
</main>