<%= form_with model: [:business, agreement] do |form| %>


  <% if agreement.errors.any? %>

    <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">

      <% agreement.errors.full_messages.each do |message| %>

        <p>
          <%= message %>
        </p>

      <% end %>

    </div>

  <% end %>


  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


    <div class="border-b border-slate-200 px-5 py-5 sm:px-6">

      <div class="flex items-start gap-3">

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="file-signature" class="h-5 w-5"></i>
        </div>


        <div>

          <h3 class="text-lg font-bold text-slate-900">
            Agreement details
          </h3>


          <p class="mt-1 text-sm text-slate-500">
            Create the agreement customers will review and sign.
          </p>

        </div>

      </div>

    </div>



    <div class="space-y-6 p-5 sm:p-6">


      <div>

        <%= form.label :name,
                       "Agreement name",
                       class: "mb-2 block text-sm font-semibold text-slate-700" %>


        <%= form.text_field :name,
                            placeholder: "Example: Consultation Agreement",
                            class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

      </div>



      <div>

        <%= form.label :content,
                       "Agreement content",
                       class: "mb-2 block text-sm font-semibold text-slate-700" %>


        <%= form.text_area :content,
                           rows: 18,
                           placeholder: "Write your agreement here...",
                           class: "w-full resize-y rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>


        <div class="mt-4 rounded-xl border border-indigo-100 bg-indigo-50 p-4">

          <div class="flex items-start gap-3">

            <div class="rounded-lg bg-white p-2 text-indigo-600 shadow-sm">
              <i data-lucide="info" class="h-4 w-4"></i>
            </div>


            <div>

              <p class="text-sm font-semibold text-slate-900">
                Adding signature fields
              </p>


              <p class="mt-1 text-sm leading-6 text-slate-600">
                Add a customer signature box anywhere in your agreement by using the placeholder below.
                The name is used to identify what the customer is signing.
              </p>


              <code class="mt-3 block rounded-lg bg-white px-3 py-2 text-sm font-semibold text-indigo-700">
                {{sign_agreement name="Agreement Section"}}
              </code>


              <p class="mt-3 text-xs leading-5 text-slate-500">
                You can add multiple signature fields throughout the agreement with different names.
              </p>


              <div class="mt-3 space-y-2">

                <div class="rounded-lg bg-white px-3 py-2 text-xs text-slate-600">
                  <code class="font-semibold text-slate-800">
                    {{sign_agreement name="Terms and Conditions"}}
                  </code>
                  <span class="ml-2">
            Customer confirms acceptance of terms
          </span>
                </div>


                <div class="rounded-lg bg-white px-3 py-2 text-xs text-slate-600">
                  <code class="font-semibold text-slate-800">
                    {{sign_agreement name="Payment Agreement"}}
                  </code>
                  <span class="ml-2">
            Customer confirms payment details
          </span>
                </div>

              </div>

            </div>

          </div>

        </div>


      </div>


    </div>


  </section>



  <div class="mt-6 flex justify-end">

    <%= form.submit "Save agreement",
                    class: "inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700" %>

  </div>


<% end %>