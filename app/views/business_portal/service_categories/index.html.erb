<main class="p-4 sm:p-6 lg:p-8">

  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Service Categories
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Organise your services into categories to make them easier for customers to find.
      </p>
    </div>


    <%= link_to new_business_service_category_path,
                class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 sm:w-auto" do %>

      <i data-lucide="plus" class="h-4 w-4"></i>
      Add category

    <% end %>

  </section>


  <%= render 'business_portal/shared/flash_messages' %>


  <section class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


    <div class="border-b border-slate-200 p-5 sm:p-6">

      <h3 class="text-lg font-bold text-slate-900">
        All categories
      </h3>

      <p class="mt-1 text-sm text-slate-500">
        Manage categories used to organise your services.
      </p>

    </div>



    <% if @service_categories.any? %>

      <div class="grid gap-5 p-5 sm:grid-cols-2 lg:grid-cols-3">


        <% @service_categories.each do |category| %>


          <article class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-indigo-200 hover:shadow-md">


            <div class="flex items-start justify-between">

              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">

                <i data-lucide="folder" class="h-6 w-6"></i>

              </div>


              <%= link_to edit_business_service_category_path(category),
                          class: "rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700" do %>

                <i data-lucide="ellipsis" class="h-5 w-5"></i>

              <% end %>

            </div>



            <h4 class="mt-5 font-bold text-slate-900">
              <%= category.name %>
            </h4>


            <p class="mt-2 text-sm text-slate-500">
              <%= pluralize(category.services.count, "service") %>
            </p>



            <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4">

              <%= link_to edit_business_service_category_path(category),
                          class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" do %>

                Edit category

              <% end %>


              <%= link_to business_service_category_path(category),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure you want to delete this category?"
                          },
                          class: "text-sm font-semibold text-red-600 transition hover:text-red-700" do %>

                Delete

              <% end %>

            </div>


          </article>


        <% end %>


        <%= link_to new_business_service_category_path,
                    class: "flex min-h-48 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-6 text-center hover:border-indigo-300 hover:bg-indigo-50" do %>


          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-indigo-600 shadow-sm">

            <i data-lucide="plus" class="h-6 w-6"></i>

          </div>


          <p class="mt-4 font-bold text-slate-900">
            Add category
          </p>


        <% end %>


      </div>


    <% else %>


      <div class="px-5 py-16 text-center">

        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">

          <i data-lucide="folder" class="h-6 w-6"></i>

        </div>


        <h3 class="mt-4 text-lg font-bold text-slate-900">
          No categories yet
        </h3>


        <p class="mt-2 text-sm text-slate-500">
          Create categories to organise your services.
        </p>


      </div>


    <% end %>


  </section>


</main>