<main class="p-4 sm:p-6 lg:p-8">

  <!-- Header -->
  <section class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 p-6 text-white shadow-lg shadow-indigo-200 sm:p-8">

    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">

      <div>
        <p class="mb-2 text-sm font-medium text-indigo-100">
          Reports / Booking reports
        </p>

        <h1 class="text-2xl font-bold sm:text-3xl">
          Booking performance
        </h1>

        <p class="mt-2 max-w-xl text-sm leading-6 text-indigo-100 sm:text-base">
          Analyse your bookings, appointment trends, customer activity and service demand.
        </p>
      </div>


      <div class="rounded-xl bg-white/10 p-4">
        <i data-lucide="calendar-range" class="h-8 w-8"></i>
      </div>

    </div>

  </section>


  <!-- Booking stats -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Total bookings
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @bookings.count %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="calendar-days" class="h-5 w-5"></i>
        </div>

      </div>

    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Completed bookings
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @bookings_completed.count %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="circle-check" class="h-5 w-5"></i>
        </div>

      </div>

    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Cancelled bookings
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @bookings_cancelled.count %>
          </p>
        </div>

        <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
          <i data-lucide="calendar-x" class="h-5 w-5"></i>
        </div>

      </div>

    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex items-start justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Average bookings
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            -
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="chart-line" class="h-5 w-5"></i>
        </div>

      </div>

    </article>


  </section>



  <!-- Reports -->
  <section class="mt-8 grid gap-8 xl:grid-cols-2">


    <!-- Booking trends -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-6 py-5">
        <h2 class="text-lg font-bold">
          Booking trends
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          View booking activity over time.
        </p>
      </div>


      <div class="p-6">
        <div class="h-72">
          <canvas id="bookingChart"></canvas>
        </div>
      </div>

    </article>


    <script>
        document.addEventListener("turbo:load", () => {

            const ctx = document.getElementById("bookingChart");

            if (!ctx) return;

            new Chart(ctx, {
                type: "line",

                data: {
                    labels: [
                        "Mon",
                        "Tue",
                        "Wed",
                        "Thu",
                        "Fri",
                        "Sat",
                        "Sun"
                    ],

                    datasets: [
                        {
                            label: "Bookings",
                            data: <%= @bookings_by_day.to_json.html_safe %>,
                            tension: 0.4,
                            fill: true
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });

        });
    </script>




    <!-- Booking status -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-6 py-5">

        <h2 class="text-lg font-bold">
          Booking status
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Breakdown of appointment outcomes.
        </p>

      </div>


      <div class="space-y-4 p-6">

        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">
            Cancelled
          </span>

          <span class="font-semibold">
            <%= @bookings_cancelled.count  %>
          </span>
        </div>

        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">
            Pending
          </span>

          <span class="font-semibold">
            <%= @bookings_pending.count %>
          </span>
        </div>

        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">
            Confirmed
          </span>

          <span class="font-semibold">
            <%= @bookings_confirmed.count %>
          </span>
        </div>


        <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">
            Completed
          </span>

          <span class="font-semibold">
            <%= @bookings_completed.count %>
          </span>
        </div>


      </div>

    </article>



    <!-- Popular services -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-6 py-5">

        <h2 class="text-lg font-bold">
          Popular services
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          See which services receive the most bookings.
        </p>

      </div>


      <div class="space-y-5 p-6">

        <% @popular_services.each do |service| %>

          <div>
            <div class="mb-2 flex justify-between text-sm">

        <span class="font-medium text-slate-700">
          <%= service[:name] %>
        </span>

              <span class="text-slate-500">
                <%= service[:percentage] %>%
              </span>

            </div>

            <div class="h-3 overflow-hidden rounded-full bg-slate-100">

              <div
                class="h-full rounded-full bg-indigo-500"
                style="width: <%= service[:percentage] %>%">
              </div>

            </div>
          </div>

        <% end %>

      </div>

    </article>




    <!-- Busy periods -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="border-b border-slate-200 px-6 py-5">

        <h2 class="text-lg font-bold">
          Busy periods
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Identify your busiest days and times.
        </p>

      </div>


      <div class="p-6">

        <div class="grid grid-cols-8 gap-2 text-xs text-slate-400">

          <div></div>

          <div class="text-center">9am</div>
          <div class="text-center">11am</div>
          <div class="text-center">1pm</div>
          <div class="text-center">3pm</div>
          <div class="text-center">5pm</div>
          <div class="text-center">7pm</div>

          <div></div>


          <%
            [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri",
              "Sat",
              "Sun"
            ].each_with_index do |day, index|
          %>

            <div class="flex items-center text-xs font-medium text-slate-500">
              <%= day %>
            </div>


            <% @booking_heatmap[index].each do |count| %>

              <%
                colour =
                  case count
                  when 0
                    "bg-slate-100"
                  when 1
                    "bg-indigo-100"
                  when 2
                    "bg-indigo-300"
                  when 3
                    "bg-indigo-500"
                  else
                    "bg-indigo-700"
                  end
              %>

              <div
                class="h-8 rounded-lg <%= colour %>"
                title="<%= count %> bookings">
              </div>

            <% end %>


            <div></div>

          <% end %>

        </div>

      </div>

    </article>


  </section>


</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>