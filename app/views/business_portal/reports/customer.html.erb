<main class="p-4 sm:p-6 lg:p-8">


  <!-- Header -->
  <section class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-violet-600 to-purple-600 p-6 text-white shadow-lg shadow-violet-200 sm:p-8">

    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">

      <div>

        <p class="mb-2 text-sm font-medium text-violet-100">
          Reports / Customer reports
        </p>

        <h1 class="text-2xl font-bold sm:text-3xl">
          Customer insights
        </h1>

        <p class="mt-2 max-w-xl text-sm leading-6 text-violet-100 sm:text-base">
          Understand customer growth, repeat visits and customer engagement.
        </p>

      </div>


      <div class="rounded-xl bg-white/10 p-4">
        <i data-lucide="users-round" class="h-8 w-8"></i>
      </div>


    </div>

  </section>



  <!-- Customer overview -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Total customers
          </p>

          <p class="mt-3 text-3xl font-bold">
            <%= @users.count %>
          </p>
        </div>

        <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
          <i data-lucide="users" class="h-5 w-5"></i>
        </div>

      </div>

    </article>



    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            New customers
          </p>

          <p class="mt-3 text-3xl font-bold">
            <%= @new_customers %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="user-plus" class="h-5 w-5"></i>
        </div>

      </div>

    </article>



    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Returning customers
          </p>

          <p class="mt-3 text-3xl font-bold">
            <%= @returning_customers %>
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="repeat" class="h-5 w-5"></i>
        </div>

      </div>

    </article>



    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>
          <p class="text-sm font-medium text-slate-500">
            Average visits
          </p>

          <p class="mt-3 text-3xl font-bold">
            <%= @average_page_views_per_month %><span class="text-xs">/per month</span>
          </p>
        </div>

        <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
          <i data-lucide="chart-line" class="h-5 w-5"></i>
        </div>

      </div>

    </article>


  </section>





  <!-- Main analytics -->
  <section class="mt-8 grid gap-8 xl:grid-cols-[1.4fr_1fr]">


    <!-- Customer growth -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">


      <div class="border-b border-slate-200 px-6 py-5">

        <h2 class="text-lg font-bold">
          Customer growth
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          New customers added over time.
        </p>

      </div>


      <div class="p-6">

        <div class="h-72">

          <canvas id="customerGrowthChart"></canvas>

        </div>

      </div>


    </article>





    <!-- Customer split -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">


      <div class="border-b border-slate-200 px-6 py-5">

        <h2 class="text-lg font-bold">
          Customer type
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          New versus returning customers.
        </p>

      </div>



      <div class="flex items-center justify-center p-8">

        <div
          class="relative flex h-56 w-56 items-center justify-center rounded-full"
          style="
          background: conic-gradient(
            #8b5cf6 0% <%= @returning_customer_percentage %>%,
              #34d399 <%= @returning_customer_percentage %>% 100%
            );
          "
        >

          <div class="absolute inset-[35px] rounded-full bg-white"></div>

          <div class="relative z-10 text-center">
            <p class="text-3xl font-black">
              <%= @users.count %>
            </p>

            <p class="text-sm text-slate-500">
              Customers
            </p>
          </div>

        </div>

      </div>


      <div class="flex justify-center gap-6 pb-6 text-sm">

        <div class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-full bg-violet-500"></span>
          Returning
        </div>


        <div class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
          New
        </div>

      </div>


    </article>


  </section>





  <!-- Customer table -->
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white shadow-sm">


    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

      <div>

        <h2 class="text-lg font-bold">
          Top customers
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Customers with the highest activity.
        </p>

      </div>


      <button class="text-sm font-semibold text-indigo-600">
        View all
      </button>


    </div>



    <div class="divide-y divide-slate-100">


      <% @top_customers.each do |customer| %>

        <div class="flex items-center justify-between px-6 py-4">


          <div class="flex items-center gap-3">


            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-violet-100 font-semibold text-violet-700">
              <%= customer.first_name[0] %> <%= customer.last_name[0] %>
            </div>


            <div>

              <p class="font-semibold">
                <%= customer.first_name %> <%= customer.last_name %>
              </p>

              <p class="text-sm text-slate-500">
                <%= customer.email %>
              </p>

            </div>


          </div>



          <div class="text-right">

            <p class="font-bold">
              <%= customer.bookings_count %>
            </p>

            <p class="text-xs text-slate-500">
              bookings
            </p>

          </div>


        </div>

      <% end %>


    </div>


  </section>


</main>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    new Chart(document.getElementById("customerGrowthChart"), {
        type: "line",

        data: {
            labels: <%= raw @customer_growth_labels.to_json %>,

            datasets: [{
                label: "New customers",
                data: <%= raw @customer_growth_data.to_json %>,
                tension: 0.4,
                fill: true
            }]
        },

        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: false
                }
            },

            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
</script>