<main class="p-4 sm:p-6 lg:p-8">


  <!-- Header -->
  <section class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-rose-600 to-pink-600 p-6 text-white shadow-lg shadow-rose-200 sm:p-8">

    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">

      <div>

        <p class="mb-2 text-sm font-medium text-rose-100">
          Reports / Staff reports
        </p>

        <h1 class="text-2xl font-bold sm:text-3xl">
          Staff performance
        </h1>

        <p class="mt-2 max-w-xl text-sm leading-6 text-rose-100 sm:text-base">
          Monitor staff workload, appointments and overall performance.
        </p>

      </div>


      <div class="rounded-xl bg-white/10 p-4">
        <i data-lucide="user-check" class="h-8 w-8"></i>
      </div>


    </div>

  </section>





  <!-- Overview cards -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Total staff
          </p>

          <p class="mt-3 text-3xl font-bold">
            -
          </p>

        </div>


        <div class="rounded-xl bg-rose-50 p-3 text-rose-600">
          <i data-lucide="users" class="h-5 w-5"></i>
        </div>

      </div>

    </article>



    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Appointments completed
          </p>

          <p class="mt-3 text-3xl font-bold">
            -
          </p>

        </div>


        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="calendar-check" class="h-5 w-5"></i>
        </div>

      </div>

    </article>



    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Average bookings
          </p>

          <p class="mt-3 text-3xl font-bold">
            -
          </p>

        </div>


        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="chart-column" class="h-5 w-5"></i>
        </div>

      </div>

    </article>



    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

      <div class="flex justify-between">

        <div>

          <p class="text-sm font-medium text-slate-500">
            Average rating
          </p>

          <p class="mt-3 text-3xl font-bold">
            -
          </p>

        </div>


        <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
          <i data-lucide="star" class="h-5 w-5"></i>
        </div>

      </div>

    </article>


  </section>







  <!-- Staff charts -->
  <section class="mt-8 grid gap-8 xl:grid-cols-[1.3fr_1fr]">


    <!-- Workload chart -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">


      <div class="border-b border-slate-200 px-6 py-5">

        <h2 class="text-lg font-bold">
          Staff workload
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Compare appointments handled by each staff member.
        </p>

      </div>


      <div class="p-6">

        <div class="h-72">

          <canvas id="staffWorkloadChart"></canvas>

        </div>

      </div>


    </article>






    <!-- Availability -->
    <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">


      <div class="border-b border-slate-200 px-6 py-5">

        <h2 class="text-lg font-bold">
          Availability summary
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Current staff availability.
        </p>

      </div>



      <div class="space-y-5 p-6">


        <% [
             ["Staff member one", "Available"],
             ["Staff member two", "Busy"],
             ["Staff member three", "Unavailable"]
           ].each do |staff, status| %>


          <div class="flex items-center justify-between rounded-xl bg-slate-50 p-4">

            <div>

              <p class="font-semibold">
                <%= staff %>
              </p>

              <p class="text-sm text-slate-500">
                Today's schedule
              </p>

            </div>


            <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
              <%= status %>
            </span>


          </div>


        <% end %>


      </div>


    </article>


  </section>







  <!-- Staff table -->
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white shadow-sm">


    <div class="border-b border-slate-200 px-6 py-5">

      <h2 class="text-lg font-bold">
        Staff performance breakdown
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Detailed statistics for each team member.
      </p>

    </div>





    <div class="overflow-x-auto">

      <table class="w-full text-left">


        <thead class="bg-slate-50 text-sm text-slate-500">

        <tr>

          <th class="px-6 py-4 font-medium">
            Staff member
          </th>

          <th class="px-6 py-4 font-medium">
            Bookings
          </th>

          <th class="px-6 py-4 font-medium">
            Completed
          </th>

          <th class="px-6 py-4 font-medium">
            Revenue
          </th>

          <th class="px-6 py-4 font-medium">
            Hours
          </th>

        </tr>

        </thead>



        <tbody class="divide-y divide-slate-100">


        <% 5.times do %>

          <tr>


            <td class="px-6 py-4">

              <div class="flex items-center gap-3">

                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-100 font-semibold text-rose-700">
                  JD
                </div>

                <span class="font-semibold">
                  Staff member
                </span>

              </div>

            </td>


            <td class="px-6 py-4 text-slate-600">
              -
            </td>


            <td class="px-6 py-4 text-slate-600">
              -
            </td>


            <td class="px-6 py-4 text-slate-600">
              £-
            </td>


            <td class="px-6 py-4 text-slate-600">
              -
            </td>


          </tr>

        <% end %>


        </tbody>


      </table>


    </div>


  </section>


</main>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {

        const ctx = document.getElementById("staffWorkloadChart");

        if (!ctx) return;


        new Chart(ctx, {

            type: "bar",

            data: {

                labels: [
                    "John",
                    "Sarah",
                    "Mike",
                    "Emma"
                ],

                datasets: [
                    {
                        label: "Bookings",

                        data: [
                            35,
                            52,
                            28,
                            45
                        ],

                        borderRadius: 8

                    }

                ]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,


                plugins: {

                    legend: {
                        display: false
                    }

                },


                scales: {

                    y: {

                        beginAtZero: true

                    }

                }

            }

        });


    });
</script>