<main class="p-4 sm:p-6 lg:p-8">

  <!-- Header -->
  <section class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 p-6 text-white shadow-lg shadow-indigo-200 sm:p-8">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">

      <div>
        <p class="mb-2 text-sm font-medium text-indigo-100">
          Reports
        </p>

        <h1 class="text-2xl font-bold sm:text-3xl">
          Business reports
        </h1>

        <p class="mt-2 max-w-xl text-sm leading-6 text-indigo-100 sm:text-base">
          View insights, performance data and detailed reports to help you understand your business.
        </p>
      </div>

      <div class="rounded-xl bg-white/10 p-4">
        <i data-lucide="chart-column" class="h-8 w-8"></i>
      </div>

    </div>
  </section>


  <!-- Overview cards -->
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Total bookings
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @bookings.count %>
          </p>
        </div>

        <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
          <i data-lucide="calendar-days" class="h-5 w-5"></i>
        </div>
      </div>
    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Revenue
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= number_to_currency(@total_amount, unit: "£", precision: 2) %>
          </p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
          <i data-lucide="wallet" class="h-5 w-5"></i>
        </div>
      </div>
    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Customers
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @users.count %>
          </p>
        </div>

        <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
          <i data-lucide="users" class="h-5 w-5"></i>
        </div>
      </div>
    </article>


    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Conversion rate
          </p>

          <p class="mt-3 text-3xl font-bold tracking-tight">
            <%= @conversion_rate.round(2).to_s %>%
          </p>
        </div>

        <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
          <i data-lucide="trending-up" class="h-5 w-5"></i>
        </div>
      </div>
    </article>

  </section>


  <!-- Report sections -->
  <section class="mt-8">

    <div class="mb-5">
      <h2 class="text-lg font-bold text-slate-900">
        Available reports
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Choose a report to view detailed information.
      </p>
    </div>


    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">


      <!-- Booking Reports -->
      <%= link_to business_booking_reports_path, class: 'group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md' do %>
        <div class="flex items-start justify-between">

          <div class="rounded-xl bg-indigo-50 p-3 text-indigo-600">
            <i data-lucide="calendar-range" class="h-6 w-6"></i>
          </div>

          <i data-lucide="arrow-right"
             class="h-5 w-5 text-slate-400 transition group-hover:text-indigo-600">
          </i>

        </div>

        <h3 class="mt-5 text-lg font-bold">
          Booking reports
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Analyse appointments, cancellations, busy periods and booking trends.
        </p>
      <% end %>

      <!-- Revenue Reports -->
      <%= link_to business_revenue_reports_path, class: 'group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md' do %>
        <div class="flex items-start justify-between">

          <div class="rounded-xl bg-emerald-50 p-3 text-emerald-600">
            <i data-lucide="chart-no-axes-column" class="h-6 w-6"></i>
          </div>

          <i data-lucide="arrow-right"
             class="h-5 w-5 text-slate-400 transition group-hover:text-indigo-600">
          </i>

        </div>

        <h3 class="mt-5 text-lg font-bold">
          Revenue reports
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Review income, payments, service performance and revenue trends.
        </p>
      <% end %>

      <!-- Customer Reports -->
      <%= link_to business_customer_reports_path, class: 'group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md' do %>
        <div class="flex items-start justify-between">

          <div class="rounded-xl bg-violet-50 p-3 text-violet-600">
            <i data-lucide="users-round" class="h-6 w-6"></i>
          </div>

          <i data-lucide="arrow-right"
             class="h-5 w-5 text-slate-400 transition group-hover:text-indigo-600">
          </i>

        </div>

        <h3 class="mt-5 text-lg font-bold">
          Customer reports
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Understand customer growth, repeat visits and customer activity.
        </p>
      <% end %>

      <!-- Service Reports -->
      <%= link_to business_service_reports_path, class: 'group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md' do %>
        <div class="flex items-start justify-between">

          <div class="rounded-xl bg-blue-50 p-3 text-blue-600">
            <i data-lucide="briefcase-business" class="h-6 w-6"></i>
          </div>

          <i data-lucide="arrow-right"
             class="h-5 w-5 text-slate-400 transition group-hover:text-indigo-600">
          </i>

        </div>

        <h3 class="mt-5 text-lg font-bold">
          Service reports
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          See which services perform best and track customer demand.
        </p>
      <% end %>

      <!-- Staff Reports -->
      <%= link_to business_staff_reports_path, class: 'group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md' do %>
        <div class="flex items-start justify-between">

          <div class="rounded-xl bg-amber-50 p-3 text-amber-600">
            <i data-lucide="user-check" class="h-6 w-6"></i>
          </div>

          <i data-lucide="arrow-right"
             class="h-5 w-5 text-slate-400 transition group-hover:text-indigo-600">
          </i>

        </div>

        <h3 class="mt-5 text-lg font-bold">
          Staff reports
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Track staff performance, workload and availability.
        </p>
      <% end %>

      <!-- Website Reports -->
      <%= link_to business_website_reports_path, class: 'group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md' do %>
        <div class="flex items-start justify-between">

          <div class="rounded-xl bg-cyan-50 p-3 text-cyan-600">
            <i data-lucide="globe-2" class="h-6 w-6"></i>
          </div>

          <i data-lucide="arrow-right"
             class="h-5 w-5 text-slate-400 transition group-hover:text-indigo-600">
          </i>

        </div>

        <h3 class="mt-5 text-lg font-bold">
          Website reports
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-500">
          Monitor website performance, visitor activity, enquiries and online engagement.
        </p>
      <% end %>

    </div>

  </section>

</main>