<div class="relative">
  <div class="<%= 'pointer-events-none opacity-50' unless current_user.business.feature_enabled?(:reports) %>">
    <main class="p-4 sm:p-6 lg:p-8">


      <!-- Header -->
      <section class="mb-8 rounded-2xl bg-slate-950 p-6 text-white shadow-lg sm:p-8">

        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">

          <div>

            <p class="mb-2 text-sm font-medium text-slate-400">
              Reports / Revenue reports
            </p>

            <h1 class="text-2xl font-bold sm:text-3xl">
              Revenue overview
            </h1>

            <p class="mt-2 max-w-xl text-sm leading-6 text-slate-400">
              Track income, payments and service performance to understand your business revenue.
            </p>

          </div>

        </div>


      </section>



      <!-- Main revenue card -->
      <section class="grid gap-6 lg:grid-cols-[1.5fr_1fr]">


        <article class="rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 p-6 text-white shadow-lg">

          <div class="flex items-start justify-between">

            <div>

              <p class="text-sm font-medium text-emerald-100">
                Total revenue
              </p>

              <h2 class="mt-4 text-5xl font-black">
                <%= number_to_currency(@total_amounts, unit: "£", precision: 2) %>
              </h2>

              <p class="mt-3 text-sm text-emerald-100">
                Compared with previous period
              </p>

            </div>


            <div class="rounded-xl bg-white/20 p-3">
              <i data-lucide="banknote" class="h-7 w-7"></i>
            </div>


          </div>



          <div class="mt-8 grid grid-cols-2 gap-4">


            <div class="rounded-xl bg-white/10 p-4">

              <p class="text-xs text-emerald-100">
                Average booking value
              </p>

              <p class="mt-2 text-xl font-bold">
                <%= number_to_currency(@average_booking_cost, unit: "£", precision: 2) %>
              </p>

            </div>


            <div class="rounded-xl bg-white/10 p-4">

              <p class="text-xs text-emerald-100">
                Payments received
              </p>

              <p class="mt-2 text-xl font-bold">
                <%= @total_paid.count %>
              </p>

            </div>


          </div>


        </article>




        <!-- Revenue summary -->
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

          <h2 class="text-lg font-bold">
            Revenue breakdown
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Current period summary.
          </p>


          <div class="mt-6 space-y-5">


            <div class="flex items-center justify-between">
          <span class="text-sm text-slate-600">
            Completed bookings
          </span>

              <span class="font-bold">
            <%= number_to_currency(@completed_bookings.sum(:amount), unit: "£", precision: 2) %>
          </span>
            </div>


            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-600">
                Pending Appointments
              </span>

              <span class="font-bold">
                <%= number_to_currency(@pending_bookings.sum(:amount), unit: "£", precision: 2) %>
              </span>
            </div>


            <div class="border-t border-slate-200 pt-4 flex items-center justify-between">
          <span class="font-semibold">
            Net revenue
          </span>

              <span class="text-xl font-black">
            <%= number_to_currency((@pending_bookings.sum(:amount) + @completed_bookings.sum(:amount)), unit: "£", precision: 2) %>
          </span>
            </div>


          </div>


        </article>


      </section>





      <!-- Revenue charts -->
      <section class="mt-8 grid gap-8 xl:grid-cols-2">


        <!-- Revenue chart -->
        <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">


          <div class="border-b border-slate-200 px-6 py-5">

            <h2 class="text-lg font-bold">
              Revenue growth
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Monthly revenue performance.
            </p>

          </div>


          <div class="p-6">

            <div class="h-72">
              <canvas id="revenueChart"></canvas>
            </div>

          </div>


        </article>




        <!-- Revenue by service -->
        <article class="rounded-2xl border border-slate-200 bg-white shadow-sm">

          <div class="border-b border-slate-200 px-6 py-5">

            <h2 class="text-lg font-bold">
              Revenue by service
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Which services generate the most income.
            </p>

          </div>

          <div class="space-y-5 p-6">

            <% if @service_revenue.any? %>

              <% @service_revenue.each do |item| %>

                <div>

                  <div class="mb-2 flex justify-between gap-4 text-sm">

                    <div>
              <span class="font-medium text-slate-700">
                <%= item[:service].name %>
              </span>

                      <span class="ml-2 text-xs text-slate-400">
                        <%= pluralize(item[:booking_count], "booking") %>
                      </span>
                    </div>

                    <span class="font-semibold text-slate-600">
                      <%= number_to_currency(
                            item[:revenue],
                            unit: "£",
                            precision: 2
                          ) %>
                    </span>

                  </div>

                  <div class="h-3 overflow-hidden rounded-full bg-slate-100">

                    <div
                      class="h-full rounded-full bg-emerald-500 transition-all duration-500"
                      style="width: <%= item[:percentage] %>%">
                    </div>

                  </div>

                </div>

              <% end %>

            <% else %>

              <div class="py-8 text-center">

                <p class="text-sm text-slate-500">
                  No service revenue data available yet.
                </p>

              </div>

            <% end %>

          </div>

        </article>


      </section>





      <!-- Transactions -->
      <section class="mt-8 rounded-2xl border border-slate-200 bg-white shadow-sm">


        <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

          <div>

            <h2 class="text-lg font-bold">
              Recent payments
            </h2>

            <p class="mt-1 text-sm text-slate-500">
              Latest revenue activity.
            </p>

          </div>

          <%= link_to business_bookings_path do %>
            <button class="text-sm font-semibold text-indigo-600">
              View all
            </button>
          <% end %>



        </div>



        <div class="divide-y divide-slate-100">


          <% @revenue_bookings.where(payment_status: 'paid').limit(5).each do |booking| %>

            <div class="flex items-center justify-between px-6 py-4">


              <div>

                <p class="font-semibold">
                  <%= booking.user.first_name %> <%= booking.user.last_name %>
                </p>

                <p class="text-sm text-slate-500">
                  <%= booking.service.name %>
                </p>

              </div>


              <div class="text-right">

                <p class="font-bold">
                  <%= number_to_currency(booking.amount, unit: "£", precision: 2) %>
                </p>

                <p class="text-xs text-emerald-600">
                  Paid
                </p>

              </div>


            </div>

          <% end %>


        </div>


      </section>


    </main>
  </div>
  <% unless current_user.business.feature_enabled?(:reports) %>
    <%= render 'business_portal/shared/upgrade_overlay',
               title: 'Unlock Reports & Insights',
               message: 'Upgrade to Pro or Pro Plus to access detailed reports and insights into your bookings, revenue, customers and business performance.'
    %>
  <% end %>
</div>



<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {

        const ctx = document.getElementById("revenueChart");

        if (!ctx) return;


        new Chart(ctx, {

            type: "bar",

            data: {

                labels: <%= raw json_escape(@revenue_labels.to_json) %>,

                datasets: [
                    {
                        label: "Revenue",

                        data: <%= raw json_escape(@revenue_data.to_json) %>,

                        borderRadius: 8,

                    }

                ]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,


                plugins: {

                    legend: {
                        display: false
                    }

                },


                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {

                            callback: function(value) {
                                return "£" + value;
                            }

                        }

                    }

                }

            }

        });


    });
</script>