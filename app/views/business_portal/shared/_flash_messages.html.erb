<!-- Flash messages -->
<% if notice.present? %>
  <div data-flash class="mt-6 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-800">
    <i data-lucide="circle-check" class="mt-0.5 h-5 w-5 shrink-0"></i>

    <p class="text-sm font-medium">
      <%= notice %>
    </p>
  </div>
<% end %>

<% if alert.present? %>
  <div data-flash class="mt-6 flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 p-4 text-rose-800">
    <i data-lucide="circle-alert" class="mt-0.5 h-5 w-5 shrink-0"></i>

    <p class="text-sm font-medium">
      <%= alert %>
    </p>
  </div>
<% end %>

<script>
    setTimeout(() => {
        document.querySelectorAll('[data-flash]').forEach((el) => {
            el.remove();
        });
    }, 5000);
</script>