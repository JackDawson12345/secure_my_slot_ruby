<div class="absolute inset-0 z-50 flex items-center justify-center bg-white/60 backdrop-blur-sm">

  <div class="max-w-xs text-center">

    <i data-lucide="lock"
       class="mx-auto h-8 w-8 text-indigo-600"></i>

    <h3 class="mt-3 text-sm font-bold text-slate-900">
      <%= title %>
    </h3>

    <p class="mt-2 text-xs text-slate-500">
      <%= message %>
    </p>

    <%= link_to "Speak to our marketing specialist",
                "#",
                class: "mt-4 inline-flex rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>

  </div>

</div>