<%= form_with model: [:business, service_coupon],
              class: "space-y-6" do |form| %>


  <% if service_coupon.errors.any? %>

    <div class="rounded-xl border border-red-200 bg-red-50 p-4">

      <div class="flex items-start gap-3">

        <i data-lucide="circle-alert"
           class="mt-0.5 h-5 w-5 text-red-600"></i>


        <div>

          <h3 class="font-semibold text-red-800">
            Please correct the following:
          </h3>


          <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-red-700">

            <% service_coupon.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>

          </ul>

        </div>

      </div>

    </div>

  <% end %>



  <div class="space-y-6" style="margin: 0px !important;">


    <div>

      <%= form.label :name,
                     class: "block text-sm font-semibold text-slate-700" %>


      <%= form.text_field :name,
                          placeholder: "For example, New Customer Discount",
                          class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

    </div>



    <div>

      <%= form.label :code,
                     class: "block text-sm font-semibold text-slate-700" %>


      <%= form.text_field :code,
                          placeholder: "WELCOME10",
                          class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm uppercase text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

    </div>



    <div>

      <%= form.label :coupon_type,
                     class: "block text-sm font-semibold text-slate-700" %>


      <%= form.select :coupon_type,
                      [
                        ["Percentage", "percentage"],
                        ["Fixed Amount", "fixed"]
                      ],
                      {},
                      class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

    </div>



    <div>

      <%= form.label :discount,
                     class: "block text-sm font-semibold text-slate-700" %>


      <%= form.number_field :discount,
                            step: 0.01,
                            placeholder: "10",
                            class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

    </div>




    <div>

      <p class="block text-sm font-semibold text-slate-700">
        Services
      </p>


      <p class="mt-1 text-xs text-slate-500">
        Select which services this coupon can be used against.
      </p>



      <div class="mt-4 space-y-3">


        <% @services.each do |service| %>


          <label class="relative flex cursor-pointer items-center justify-between gap-5 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-indigo-300">


            <div class="flex items-start gap-4">


              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">

                <i data-lucide="<%= service.icon.presence || 'calendar-check' %>"
                   class="h-5 w-5"></i>

              </div>



              <div>

                <p class="font-semibold text-slate-900">
                  <%= service.name %>
                </p>


                <p class="mt-1 text-sm leading-5 text-slate-500">
                  <%= service.description.presence || "No description added." %>
                </p>


                <div class="mt-3 flex flex-wrap gap-2">


                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                    £<%= service.price %>
                  </span>


                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                    <%= service.minutes_duration %> minutes
                  </span>


                  <% if service.service_category.present? %>

                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700">
                      <%= service.service_category.name %>
                    </span>

                  <% end %>


                </div>


              </div>


            </div>




            <div class="shrink-0">

              <label class="relative inline-flex cursor-pointer items-center">

                <%= check_box_tag "service_coupon[services][]",
                                  service.id,
                                  service_coupon.services.to_a.include?(service.id.to_s),
                                  class: "peer sr-only" %>


                <span
                  class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-indigo-600 peer-focus:ring-2 peer-focus:ring-indigo-200 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-5">
    </span>

              </label>

            </div>


          </label>


        <% end %>


        <% if @services.empty? %>

          <div class="rounded-xl bg-slate-50 p-5 text-sm text-slate-500">
            No services available.
          </div>

        <% end %>


      </div>


    </div>





    <div>

      <%= form.label :expires_at,
                     class: "block text-sm font-semibold text-slate-700" %>


      <%= form.datetime_field :expires_at,
                              class: "mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

    </div>




    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">


      <div class="flex items-center gap-3">


        <%= form.check_box :active,
                           class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>


        <%= form.label :active,
                       "Active coupon",
                       class: "text-sm font-semibold text-slate-700" %>


      </div>


      <p class="mt-2 text-xs text-slate-500">
        Inactive coupons cannot be used by customers.
      </p>


    </div>


  </div>





  <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">


    <%= link_to "Cancel",
                business_service_coupons_path,
                class: "inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>


    <%= form.submit service_coupon.persisted? ? "Update coupon" : "Create coupon",
                    class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>


  </div>


<% end %>