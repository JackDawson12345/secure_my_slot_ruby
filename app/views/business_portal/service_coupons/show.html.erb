<main class="p-4 sm:p-6 lg:p-8">

  <div class="mx-auto">


    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

      <%= link_to business_service_coupons_path,
                  class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-indigo-600" do %>
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Back to coupons
      <% end %>


      <div class="flex gap-3">

        <%= link_to edit_business_service_coupon_path(@service_coupon),
                    class: "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
          <i data-lucide="pencil" class="h-4 w-4"></i>
          Edit
        <% end %>


        <%= button_to business_service_coupon_path(@service_coupon),
                      method: :delete,
                      data: {
                        turbo_confirm: "Are you sure you want to delete this coupon?"
                      },
                      class: "inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700" do %>
          <i data-lucide="trash-2" class="h-4 w-4"></i>
          Delete
        <% end %>

      </div>

    </div>



    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


      <header class="border-b border-slate-200 p-6 sm:p-8">

        <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">


          <div class="flex items-start gap-5">


            <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-3xl bg-indigo-50 text-indigo-600">

              <i data-lucide="ticket-percent"
                 class="h-10 w-10"></i>

            </div>


            <div>

              <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                <%= @service_coupon.name %>
              </h1>


              <p class="mt-3 text-sm text-slate-500">
                Coupon code:
                <span class="font-semibold text-slate-700">
                  <%= @service_coupon.code %>
                </span>
              </p>


              <div class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700">

                <i data-lucide="percent"
                   class="h-3.5 w-3.5"></i>

                <%= @service_coupon.coupon_type.humanize %>

              </div>

            </div>

          </div>



          <% if @service_coupon.active? %>

            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">

              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              Active

            </span>

          <% else %>

            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">

              <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
              Inactive

            </span>

          <% end %>


        </div>

      </header>




      <div class="grid gap-5 p-6 sm:grid-cols-2 lg:grid-cols-3 sm:p-8">


        <article class="rounded-xl bg-slate-50 p-5">

          <div class="flex items-center gap-3">

            <div class="rounded-lg bg-white p-2 text-indigo-600 shadow-sm">
              <i data-lucide="badge-percent" class="h-5 w-5"></i>
            </div>


            <div>

              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                Discount
              </p>


              <p class="mt-1 font-bold text-slate-900">

                <%= @service_coupon.discount %>

                <%= "%" if @service_coupon.coupon_type == "percentage" %>

                <%= "£" if @service_coupon.coupon_type == "fixed" %>

              </p>

            </div>

          </div>

        </article>




        <article class="rounded-xl bg-slate-50 p-5">

          <div class="flex items-center gap-3">

            <div class="rounded-lg bg-white p-2 text-emerald-600 shadow-sm">
              <i data-lucide="calendar-clock" class="h-5 w-5"></i>
            </div>


            <div>

              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                Expiry
              </p>


              <p class="mt-1 font-bold text-slate-900">

                <%= @service_coupon.expires_at&.strftime("%d %B %Y") || "No expiry" %>

              </p>

            </div>

          </div>

        </article>




        <article class="rounded-xl bg-slate-50 p-5">

          <div class="flex items-center gap-3">

            <div class="rounded-lg bg-white p-2 text-amber-600 shadow-sm">
              <i data-lucide="briefcase-business" class="h-5 w-5"></i>
            </div>


            <div>

              <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
                Services
              </p>


              <p class="mt-1 font-bold text-slate-900">

                <%= @service_coupon.services.count %>

              </p>


              <p class="mt-1 text-xs text-slate-500">
                Services included
              </p>

            </div>

          </div>

        </article>


      </div>





      <div class="border-t border-slate-200 p-6 sm:p-8">


        <h2 class="text-lg font-bold text-slate-900">
          Applies To
        </h2>


        <div class="mt-4 space-y-2">


          <% @service_coupon.services.each do |service_id| %>

            <% service = current_user.business.services.find_by(id: service_id) %>


            <% if service %>

              <div class="rounded-xl bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700">

                <%= service.name %>

              </div>

            <% end %>


          <% end %>


          <% if @service_coupon.services.blank? %>

            <p class="text-sm text-slate-500">
              No services have been selected.
            </p>

          <% end %>


        </div>


      </div>


    </section>


  </div>

</main>