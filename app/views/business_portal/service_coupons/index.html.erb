<div class="mx-auto max-w-7xl px-5 py-8 lg:px-8">

  <section class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Service Coupons
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Create and manage discount codes for your customers.
      </p>
    </div>

    <div class="flex gap-4">
      <%= link_to new_business_service_coupon_path,
                  class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto" do %>
        <i data-lucide="plus" class="h-4 w-4"></i>
        Add service coupon
      <% end %>
    </div>
  </section>

  <% if @service_coupons.any? %>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">

      <% @service_coupons.each do |coupon| %>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">


          <div class="border-b border-slate-100 p-5">


            <div class="flex items-start justify-between gap-3">


              <div>

                <h3 class="text-lg font-black text-slate-900">
                  <%= coupon.name %>
                </h3>


                <div class="mt-2 inline-flex items-center rounded-lg bg-slate-100 px-3 py-1.5 text-sm font-bold tracking-wide text-slate-700">
                  <%= coupon.code %>
                </div>

              </div>



              <% if coupon.active? %>

                <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-bold text-green-700">
                  Active
                </span>

              <% else %>

                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500">
                  Inactive
                </span>

              <% end %>


            </div>


          </div>



          <div class="space-y-4 p-5">


            <div class="flex items-center justify-between">

              <span class="text-sm text-slate-500">
                Discount
              </span>


              <span class="font-bold text-slate-900">

                <% if coupon.coupon_type == "percentage" %>
                  <%= coupon.discount %>%
                <% else %>
                  £<%= coupon.discount %>
                <% end %>

              </span>

            </div>



            <div class="flex items-center justify-between">

              <span class="text-sm text-slate-500">
                Services
              </span>


              <span class="font-bold text-slate-900">

                <%= coupon.services&.count || 0 %>

              </span>

            </div>



            <div class="flex items-center justify-between">

              <span class="text-sm text-slate-500">
                Expires
              </span>


              <span class="font-bold text-slate-900">

                <%= coupon.expires_at.present? ? coupon.expires_at.strftime("%d %b %Y") : "No expiry" %>

              </span>

            </div>


          </div>



          <div class="flex gap-3 border-t border-slate-100 bg-slate-50 p-4">


            <%= link_to business_service_coupon_path(coupon),
                        class: "flex-1 rounded-xl border border-slate-200 bg-white px-4 py-2 text-center text-sm font-bold text-slate-700 hover:bg-slate-100" do %>

              View

            <% end %>



            <%= link_to edit_business_service_coupon_path(coupon),
                        class: "flex-1 rounded-xl bg-indigo-600 px-4 py-2 text-center text-sm font-bold text-white hover:bg-indigo-700" do %>

              Edit

            <% end %>


          </div>


        </div>


      <% end %>


    </div>


  <% else %>


    <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-sm">


      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-slate-100">

        <i data-lucide="ticket-percent" class="h-7 w-7 text-slate-400"></i>

      </div>


      <h3 class="mt-5 text-lg font-black text-slate-900">
        No coupons yet
      </h3>


      <p class="mt-2 text-sm text-slate-500">
        Create your first service coupon to start offering discounts.
      </p>


      <%= link_to new_business_service_coupon_path,
                  class: "mt-6 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white hover:bg-indigo-700" do %>

        <i data-lucide="plus" class="h-5 w-5"></i>
        Create Coupon

      <% end %>


    </div>


  <% end %>


</div>